		regAccent(markA)

		local markB = Instance.new("Frame", V.minimizeBubbleInner)
		markB.Name = "ModernMarkMiddle"
		markB.AnchorPoint = Vector2.new(0.5, 0.5)
		markB.Position = UDim2.new(0.5, 0, 0.53, 0)
		markB.Size = UDim2.new(0, 20, 0, 4)
		markB.BackgroundColor3 = Color3.fromRGB(210, 214, 224)
		markB.BackgroundTransparency = 0.16
		markB.BorderSizePixel = 0
		markB.ZIndex = 854
		corner(markB, 100)

		local markC = Instance.new("Frame", V.minimizeBubbleInner)
		markC.Name = "ModernMarkAccentBottom"
		markC.AnchorPoint = Vector2.new(0.5, 0.5)
		markC.Position = UDim2.new(0.5, 0, 0.64, 0)
		markC.Size = UDim2.new(0, 13, 0, 4)
		markC.BackgroundColor3 = Library.Theme.Accent
		markC.BackgroundTransparency = 0.18
		markC.BorderSizePixel = 0
		markC.ZIndex = 854
		corner(markC, 100)
		regAccent(markC)

		V.minimizeBubbleDot = Instance.new("Frame", V.minimizeBubble)
		V.minimizeBubbleDot.Name = "StatusDot"
		V.minimizeBubbleDot.AnchorPoint = Vector2.new(1, 1)
		V.minimizeBubbleDot.Position = UDim2.new(1, -7, 1, -7)
		V.minimizeBubbleDot.Size = UDim2.new(0, 11, 0, 11)
		V.minimizeBubbleDot.BackgroundColor3 = Library.Theme.Accent
		V.minimizeBubbleDot.BorderSizePixel = 0
		V.minimizeBubbleDot.ZIndex = 856
		corner(V.minimizeBubbleDot, 100)
		stroke(V.minimizeBubbleDot, Color3.fromRGB(10,10,10), 2)
		regAccent(V.minimizeBubbleDot)

		addTooltip(V.minimizeBubble, "Drag anywhere • click to restore")
		track(V.minimizeBubble.InputBegan:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
				V.bubbleDragging = true
				V.bubbleMoved = false
				V.bubbleDragStart = i.Position
				V.bubbleStartPos = V.minimizeBubble.Position
			end
		end))
		GUI:_registerInputHandler("changed", "bubble-drag", function(i)
			if not V.bubbleDragging or not V.minimizeBubble then return end
			if i.UserInputType ~= Enum.UserInputType.MouseMovement and i.UserInputType ~= Enum.UserInputType.Touch then return end
			local d = i.Position - V.bubbleDragStart
			if math.abs(d.X) > 4 or math.abs(d.Y) > 4 then V.bubbleMoved = true end
			V.minimizeBubble.Position = UDim2.new(V.bubbleStartPos.X.Scale, V.bubbleStartPos.X.Offset + d.X, V.bubbleStartPos.Y.Scale, V.bubbleStartPos.Y.Offset + d.Y)
		end, "bubble")
		GUI:_registerInputHandler("ended", "bubble-drag-end", function(i)
			if i.UserInputType ~= Enum.UserInputType.MouseButton1 and i.UserInputType ~= Enum.UserInputType.Touch then return end
			if not V.bubbleDragging then return end
			V.bubbleDragging = false
			if not V.bubbleMoved then
				if V.doMinimize then V.doMinimize(false) end
			else
				pcall(function() GUI:MarkConfigDirty() end)
			end
		end, "bubble")
		V.minimizeBubble.MouseEnter:Connect(function()
			local hover = (Library.Theme.SurfaceHover or Library.Theme.Surface):Lerp(Library.Theme.Accent, 0.12)
			tw(V.minimizeBubble, {BackgroundColor3 = hover})
			if V.minimizeBubbleStroke then tw(V.minimizeBubbleStroke, {Color = Color3.fromRGB(255,255,255)}) end
			if V.minimizeBubbleGlow then tw(V.minimizeBubbleGlow, {BackgroundTransparency = 0.56}) end
			if V.minimizeBubbleInner then tw(V.minimizeBubbleInner, {Size = UDim2.new(0, 45, 0, 45)}) end
		end)
		V.minimizeBubble.MouseLeave:Connect(function()
			_styleMinimizeBubble()
			if V.minimizeBubbleInner then tw(V.minimizeBubbleInner, {Size = UDim2.new(0, 42, 0, 42)}) end
		end)
		_styleMinimizeBubble()
		return V.minimizeBubble
	end

	local function _showMinimizeBubble(show)
		local b = _createMinimizeBubble()
		if show then
			b.Visible = GUI._open ~= false
			b.Size = UDim2.new(0, 48, 0, 48)
			tw(b, {Size = UDim2.new(0, 62, 0, 62)}, TI_FAST)
		else
			if not b.Visible then return end
			tw(b, {Size = UDim2.new(0, 48, 0, 48)}, TI_FAST, function()
				if b then b.Visible = false; b.Size = UDim2.new(0, 62, 0, 62) end
			end)
		end
	end

	local function _syncOpenVisibility()
		if V.minimized then
			MainWrap.Visible = false
			if V.minimizeBubble then V.minimizeBubble.Visible = GUI._open ~= false end
		else
			MainWrap.Visible = GUI._open ~= false
			if V.minimizeBubble then V.minimizeBubble.Visible = false end
		end
	end


	local function _runTrackedPropertyRestores()
		for i = #GUI._trackedProperties, 1, -1 do
			local item = GUI._trackedProperties[i]
			if item and item.object and item.property ~= nil then
				pcall(function()
					item.object[item.property] = item.value
				end)
			end
		end
		local character = LP and LP.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			for i = #GUI._trackedHumanoidProperties, 1, -1 do
				local item = GUI._trackedHumanoidProperties[i]
				if item and item.property ~= nil and item.value ~= nil then
					pcall(function() humanoid[item.property] = item.value end)
				end
			end
		end
	end

	local function _runTrackedInstanceCleanups()
		for i = #GUI._trackedInstances, 1, -1 do
			local item = GUI._trackedInstances[i]
			local inst = item and item.instance
			if inst then
				local mode = tostring(item.mode or "destroy"):lower()
				pcall(function()
					if mode == "disable" then
						if inst.Enabled ~= nil then inst.Enabled = false end
					elseif mode == "hide" then
						if inst.Visible ~= nil then inst.Visible = false end
					else
						if inst.Destroy then inst:Destroy() end
					end
				end)
			end
		end
	end

	local function _runRegisteredCleanups()
		for i = #GUI._cleanupCallbacks, 1, -1 do
			local item = GUI._cleanupCallbacks[i]
			if item and type(item.callback) == "function" and not item.ran then
				item.ran = true
				pcall(item.callback)
			end
		end
	end

	local function _stopAllActivity()
		if GUI._activityStopped then return end
		GUI._activityStopped = true
		_subLoop = false
		keybindListening = false
		-- v5.78: stop safe UI tasks immediately when the window closes/re-executes.
		if GUI._tasks then
			for _, taskInfo in pairs(GUI._tasks) do
				if taskInfo then
					taskInfo.Running = false
					taskInfo.Stopped = true
					if type(taskInfo.Cleanup) == "function" and not taskInfo._cleanupRan then
						taskInfo._cleanupRan = true
						pcall(taskInfo.Cleanup, taskInfo)
					end
				end
			end
		end
		if GUI._activeKeybind and GUI._activeKeybind._stopListening then
			pcall(function() GUI._activeKeybind:_stopListening(true) end)
		end
		for _, control in ipairs(GUI._toggleControls or {}) do
			if control and control._autoStopOnDestroy ~= false then
				local ok, isOn = pcall(function() return control:Get() end)
				if ok and isOn == true then
					if control._stopForDestroy then
						pcall(function() control:_stopForDestroy() end)
					else
						pcall(function() control:Set(false, true) end)
						if control._callback then pcall(control._callback, false) end
					end
				end
			end
		end
		_runTrackedPropertyRestores()
		_runTrackedInstanceCleanups()
		_runRegisteredCleanups()
		pcall(function() if _ttFrame then _ttFrame.Visible = false end end)
	end


	GUI._runtimeShutdown = _runtimeTrackShutdown(function(reason)
		if _destroyed then return end
		if _runtimeRoot.activeWindow == GUI then
			_runtimeRoot.activeWindow = nil
			_runtimeRoot.activeScreenGui = nil
			_runtimeRoot.activeCharacter = nil
		end
		GUI._closing = true
		_stopAllActivity()
		_destroyed = true
		pcall(function()
			if V.minimizeBubble then V.minimizeBubble:Destroy() end
			if SG then SG:Destroy() end
		end)
	end)

	V.doMinimize = function(forceState)
		if _destroyed then return end
		local target = (forceState == nil) and (not V.minimized) or (forceState == true)
		if target == V.minimized then
			_syncOpenVisibility()
			return
		end
		local sw, sh = getScaledWindowSize()
		V.minimized = target
		if _mainTween then _mainTween:Cancel(); _mainTween = nil end
		if V.minimized then
			_createMinimizeBubble()
			Nav.Visible=false; Content.Visible=false
			MainWrap.Visible = GUI._open ~= false
			_showMinimizeBubble(true)
			_mainTween = tw(MainWrap,{Size=UDim2.new(0,sw,0,0)},TI_FAST,function()
				MainWrap.Visible=false
				if V.minimizeBubble then V.minimizeBubble.Visible = GUI._open ~= false end
			end)
		else
			_showMinimizeBubble(false)
			MainWrap.Visible = GUI._open ~= false
			MainWrap.Size = UDim2.new(0, sw, 0, 0)
			Nav.Visible=false; Content.Visible=false
			_mainTween = tw(MainWrap,{Size=UDim2.new(0,sw,0,sh)},TI_SLOW,function()
				if not V.minimized and not _destroyed then
					Nav.Visible=true; Content.Visible=true
				end
			end)
		end
		pcall(function() GUI:MarkConfigDirty() end)
	end

	function GUI:Destroy()
		if _destroyed then return end
		if _runtimeRoot.activeWindow == GUI then
			_runtimeRoot.activeWindow = nil
			_runtimeRoot.activeScreenGui = nil
			_runtimeRoot.activeCharacter = nil
		end
		GUI._closing = true
		GUI._open = false
		_stopAllActivity()
		_runtimeUntrackShutdown(GUI._runtimeShutdown)
		_destroyed=true; keybindListening=false
		for _, fn in ipairs(GUI._destroyCallbacks or {}) do
			pcall(fn)
		end
		for _,c in ipairs(_connections) do pcall(function() c:Disconnect() end) end
		_connections={}
		if _mainTween then _mainTween:Cancel(); _mainTween = nil end
		if V.minimizeBubble then pcall(function() V.minimizeBubble:Destroy() end); V.minimizeBubble=nil end
		if _ttFrame then pcall(function() _ttFrame.Visible=false end) end
		local sw, sh = getScaledWindowSize()
		if V.minimized then
			V.minimized = false
			Nav.Visible = true; Content.Visible = true
			MainWrap.Size = UDim2.new(0, sw, 0, 34)
			_mainTween = tw(MainWrap, {Size=UDim2.new(0,sw,0,sh)}, TI_SLOW, function()
				task.wait(0.08)
				tw(MainWrap, {Size=UDim2.new(0,sw,0,0)}, TI_FAST, function()
					pcall(function() SG:Destroy() end)
				end)
			end)
		else
			tw(MainWrap, {Size=UDim2.new(0,sw,0,0)}, TI_FAST, function()
				pcall(function() SG:Destroy() end)
			end)
		end
	end

	function GUI:SetTitle(text) _titleText = tostring(text or ""); titleLabel.Text = _titleText end
	function GUI:SetAccent(color, silent)
		if typeof(color) ~= "Color3" then return false end
		-- Only lock manual accent when theme accent following is explicitly disabled.
		GUI._manualAccent = (GUI._themeAccentMode ~= true)
		applyAccentToRegistered(color, true)
		GUI:_RefreshThemeVisuals()
		_styleMiniHUD()
		_styleMinimizeBubble()
		if GUI._FireThemeListeners then GUI:_FireThemeListeners(GUI:GetTheme()) end
		if not silent then pcall(function() GUI:MarkConfigDirty() end) end
		return true
	end
	function GUI:GetAccent() return Library.Theme.Accent end
	function GUI:GetAccentPreset() return _accentPresetFromColor(Library.Theme.Accent) end
	function GUI:UseThemeAccent(silent)
		local themeName = GUI:GetTheme()
		local theme = Library.Themes and Library.Themes[themeName]
		local accent = theme and _themeAccentFor(themeName, theme)
		if typeof(accent) == "Color3" then
			GUI._themeAccentMode = true
			GUI._manualAccent = false
			applyAccentToRegistered(accent, true)
			GUI:_RefreshThemeVisuals()
			_styleMiniHUD()
			_styleMinimizeBubble()
			if GUI._FireThemeListeners then GUI:_FireThemeListeners(themeName) end
			if not silent then pcall(function() GUI:MarkConfigDirty() end) end
			return true
		end
		return false
	end
	function GUI:SetFollowThemeAccent(state, silent)
		GUI._themeAccentMode = state ~= false
		GUI._manualAccent = not GUI._themeAccentMode
		if GUI._themeAccentMode then
			GUI:UseThemeAccent(true)
		end
		if not silent then pcall(function() GUI:MarkConfigDirty() end) end
		return GUI._themeAccentMode
	end
	function GUI:GetFollowThemeAccent()
		return GUI._themeAccentMode == true
	end

	function GUI:SetScale(v, silent)
		currentScale = math.clamp(tonumber(v) or currentScale or 100, 50, 200)
		applyWindowScale(true, V.minimized and 34 or nil)
		if GUI._cfgSyncCallbacks and GUI._cfgSyncCallbacks.scale then pcall(GUI._cfgSyncCallbacks.scale, currentScale) end
		if not silent then pcall(function() GUI:MarkConfigDirty() end) end
		return currentScale
	end
	function GUI:GetScale() return currentScale end
	function GUI:ForceScaleRefresh()
		applyWindowScale(false, V.minimized and 34 or nil)
		if _resizeSnapEnabled then _applyResponsiveScale(true) end
		return MainWrap.AbsoluteSize
	end
	function GUI:SetMiniVisible(state, silent)
		-- The legacy separate top-right HUD is disabled unless explicitly enabled with floatingMiniUI=true/miniUI=true.
		if not V.floatingMiniAllowed then
			V.miniVisible = false
			if V.miniFrame then V.miniFrame.Visible = false end
			if GUI._cfgSyncCallbacks and GUI._cfgSyncCallbacks.miniVisible then pcall(GUI._cfgSyncCallbacks.miniVisible, false) end
			return false
		end
		V.miniVisible = state == true
		if V.miniFrame then V.miniFrame.Visible = V.miniVisible end
		if GUI._cfgSyncCallbacks and GUI._cfgSyncCallbacks.miniVisible then pcall(GUI._cfgSyncCallbacks.miniVisible, V.miniVisible) end
		if not silent then pcall(function() GUI:MarkConfigDirty() end) end
		return V.miniVisible
	end
	function GUI:GetMiniVisible() return V.miniVisible == true end
	function GUI:ToggleMiniHUD()
		return GUI:SetMiniVisible(not V.miniVisible)
	end
	function GUI:SetMiniTitle(text)
		if V.miniTitleLbl then V.miniTitleLbl.Text = tostring(text or "VENTURA"):upper() end
	end
