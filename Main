	function GUI:SetThemeAnimationPreset(preset)
		preset = tostring(preset or "balanced"):lower()
		local presets = {
			calm = {speed = 0.55, intensity = 0.55},
			balanced = {speed = 1.00, intensity = 1.00},
			cinematic = {speed = 0.78, intensity = 1.45},
			hyper = {speed = 1.65, intensity = 1.80},
			low = {speed = 0.35, intensity = 0.35},
			performance = {speed = 0.35, intensity = 0.35},
		}
		local p = presets[preset] or presets.balanced
		GUI:SetAnimationSpeed(p.speed)
		GUI:SetAnimationIntensity(p.intensity)
		return p
	end
