		V.wmFrame.ZIndex = 50
		corner(V.wmFrame, 6); stroke(V.wmFrame, Library.Theme.BorderHover or Library.Theme.Border, 1)
		V.wmAccent = Instance.new("Frame", V.wmFrame)
		V.wmAccent.BackgroundColor3 = Library.Theme.Accent; regAccent(V.wmAccent)
		V.wmAccent.BorderSizePixel = 0
		V.wmAccent.Size = UDim2.new(0, 3, 1, -8)
		V.wmAccent.Position = UDim2.new(0, 6, 0, 4)
		V.wmAccent.ZIndex = 51; corner(V.wmAccent, 3)
		V.wmLbl = Instance.new("TextLabel", V.wmFrame)
		V.wmLbl.Name = "WatermarkText"
