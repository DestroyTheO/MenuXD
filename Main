local function tw(obj, goal, ti, cb)
	-- v5.38: tween guard. Roblox can error if a control is destroyed while an
	-- animation is being created/played. Return a no-op tween so callers remain safe.
	if not obj or type(goal) ~= "table" then
		if cb then task.defer(function() pcall(cb) end) end
		return _NOOP_TWEEN
	end
	local ok, tween = pcall(function()
		return TweenService:Create(obj, ti or TI_FAST, goal)
	end)
	if not ok or not tween then
		if cb then task.defer(function() pcall(cb) end) end
		return _NOOP_TWEEN
	end
	if cb then
		pcall(function()
			tween.Completed:Once(function()
				pcall(cb)
			end)
		end)
	end
	pcall(function() tween:Play() end)
	return tween
end
local function corner(p, r)
	local c = Instance.new("UICorner", p); c.CornerRadius = UDim.new(0, r or 5); return c
end
local function stroke(p, col, thick)
	local s = Instance.new("UIStroke", p)
	s.Color = col or Color3.fromRGB(50,50,50)
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Thickness = thick or 1; return s
end
local function pad(p, t, r, b, l)
	local u = Instance.new("UIPadding", p)
	u.PaddingTop=UDim.new(0,t or 0); u.PaddingRight=UDim.new(0,r or 0)
	u.PaddingBottom=UDim.new(0,b or 0); u.PaddingLeft=UDim.new(0,l or 0)
	return u
end
local function lbl(p, text, size, color, font, xalign)
	local l = Instance.new("TextLabel", p)
	l.BorderSizePixel=0; l.BackgroundTransparency=1
	l.TextSize=size or 13
	l.TextXAlignment=xalign or Enum.TextXAlignment.Left
	l.FontFace=font or Font.new("rbxasset://fonts/families/Ubuntu.json")
	l.TextColor3=color or Color3.fromRGB(210,210,210)
	l.Text=text or ""; l.TextTruncate=Enum.TextTruncate.AtEnd
	l.Size=UDim2.new(1,0,1,0); return l
end
local function validate(defaults, opts)
	opts = opts or {}
	for k,v in pairs(defaults) do if opts[k]==nil then opts[k]=v end end
	return opts
end
local function textWidth(text, size, fontEnum)
	local ok, bounds = pcall(function()
		return TextService:GetTextSize(tostring(text or ""), tonumber(size) or 12, fontEnum or Enum.Font.SourceSans, Vector2.new(10000, 1000))
	end)
	return ok and bounds.X or (#tostring(text or "") * ((tonumber(size) or 12) * 0.55))
end

-- Ventura 4.3 layout/typography helpers
local FONT_UI      = Font.new("rbxasset://fonts/families/Ubuntu.json")
local FONT_UI_MED  = Font.new("rbxasset://fonts/families/Ubuntu.json", Enum.FontWeight.Medium)
local FONT_UI_BOLD = Font.new("rbxasset://fonts/families/Ubuntu.json", Enum.FontWeight.Bold)
local FONT_MONO    = Font.new("rbxasset://fonts/families/RobotoMono.json")
local FONT_MONO_BOLD = Font.new("rbxasset://fonts/families/RobotoMono.json", Enum.FontWeight.Bold)

local function textHeight(text, width, size, fontEnum)
	local ok, bounds = pcall(function()
		return TextService:GetTextSize(tostring(text or ""), tonumber(size) or 12, fontEnum or Enum.Font.SourceSans, Vector2.new(math.max(width, 24), 10000))
	end)
	return ok and bounds.Y or math.max(16, math.ceil(#tostring(text or "") / 42) * 16)
end

local function clampTextWidth(text, size, minW, maxW)
	return math.clamp(math.floor(textWidth(text, size or 12, Enum.Font.SourceSans) + 0.5), minW or 44, maxW or 140)
end

local function safeTween(obj, goal, ti, cb)
	if not obj then return nil end
	return tw(obj, goal, ti, cb)
end

local function hasFileAPI()
	return type(writefile) == "function"
		and type(readfile) == "function"
		and type(isfile) == "function"
		and type(isfolder) == "function"
		and type(makefolder) == "function"
end

local function ensureFolder(path)
	if not hasFileAPI() then return false end
	local ok = pcall(function()
		if not isfolder(path) then makefolder(path) end
	end)
	return ok
end

local _ttFrame, _ttLabel, _ttConn
local function setupTooltip(sg)
	-- Ventura 5.1 tooltip fix:
	-- The old tooltip was always 24px tall, so wrapped/long text could hang outside
	-- the dark background. This version measures + wraps text, then sizes the
	-- background card to fully cover the description.
	_ttFrame = Instance.new("Frame", sg)
	_ttFrame.Name = "_Tooltip"
	_ttFrame.BackgroundColor3 = Color3.fromRGB(12, 12, 12)
	_ttFrame.BorderSizePixel = 0
	_ttFrame.Size = UDim2.new(0, 160, 0, 28)
	_ttFrame.Visible = false
	_ttFrame.ZIndex = 9999
	_ttFrame.ClipsDescendants = false
	corner(_ttFrame, 6)
	stroke(_ttFrame, Color3.fromRGB(70, 70, 70), 1)

	local tipPad = Instance.new("UIPadding", _ttFrame)
	tipPad.PaddingTop = UDim.new(0, 7)
	tipPad.PaddingBottom = UDim.new(0, 7)
	tipPad.PaddingLeft = UDim.new(0, 9)
	tipPad.PaddingRight = UDim.new(0, 9)

	_ttLabel = Instance.new("TextLabel", _ttFrame)
	_ttLabel.Name = "TooltipText"
	_ttLabel.BackgroundTransparency = 1
	_ttLabel.BorderSizePixel = 0
	_ttLabel.TextSize = 11
	_ttLabel.FontFace = Font.new("rbxasset://fonts/families/Ubuntu.json")
	_ttLabel.TextColor3 = Color3.fromRGB(210, 210, 210)
	_ttLabel.TextXAlignment = Enum.TextXAlignment.Left
	_ttLabel.TextYAlignment = Enum.TextYAlignment.Top
	_ttLabel.TextWrapped = true
	_ttLabel.TextTruncate = Enum.TextTruncate.None
	_ttLabel.Size = UDim2.new(1, 0, 1, 0)
	_ttLabel.ZIndex = 10000

	if _ttConn then pcall(function() _ttConn:Disconnect() end) end
	_ttConn = RunService.RenderStepped:Connect(function()
		if _ttFrame and _ttFrame.Visible then
			if UIS:GetFocusedTextBox() then _ttFrame.Visible = false; return end
			local mp = UIS:GetMouseLocation()
			local vp = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1280, 720)
			local w, h = _ttFrame.AbsoluteSize.X, _ttFrame.AbsoluteSize.Y
			local x = mp.X + 16
			local y = mp.Y + 18
			if x + w + 8 > vp.X then x = mp.X - w - 16 end
			if y + h + 8 > vp.Y then y = mp.Y - h - 16 end
			x = math.clamp(x, 6, math.max(6, vp.X - w - 6))
			y = math.clamp(y, 6, math.max(6, vp.Y - h - 6))
			_ttFrame.Position = UDim2.new(0, x, 0, y)
		end
	end)
end

local function _tooltipSizeFor(text)
	text = tostring(text or "")
	local rawW = textWidth(text, 11, Enum.Font.SourceSans)
	local w = math.clamp(math.floor(rawW + 26), 110, 340)
	local innerW = math.max(40, w - 18)
	local h = math.clamp(math.floor(textHeight(text, innerW, 11, Enum.Font.SourceSans) + 17), 28, 190)
	return w, h
end

local function _tooltipTextFromInfo(info)
	if type(info) == "table" then
		local lines = {}
		local function push(label, value)
			if value == nil then return end
			value = tostring(value)
			if value == "" then return end
			if label and label ~= "" then
				table.insert(lines, tostring(label) .. ": " .. value)
			else
				table.insert(lines, value)
			end
		end
		push(nil, info.title or info.name or info.header)
		push(nil, info.description or info.desc or info.text)
		push("Default", info.default)
		push("Current", info.current or info.value)
		push("Key", info.key or info.keybind)
		push("Warning", info.warning or info.warn)
		push("Tip", info.tip or info.hint)
		return table.concat(lines, "\n")
	end
	return tostring(info or "")
end

local function addTooltip(frame, text)
	text = _tooltipTextFromInfo(text)
	if not frame or text == "" or MOBILE then return end
	local showing = false
	local alive = true
	local localConnections = {}

	local function bind(signal, fn)
		local ok, conn = pcall(function()
			return signal:Connect(fn)
		end)
		if ok and conn then
			table.insert(localConnections, conn)
			_runtimeTrackConnection(conn)
		end
		return conn
	end

	local function disconnectLocal()
		for i = #localConnections, 1, -1 do
			local conn = localConnections[i]
			pcall(function()
				if conn and type(conn.Disconnect) == "function" then conn:Disconnect() end
			end)
			localConnections[i] = nil
		end
	end

	local function show()
		if not alive or not _ttLabel or not _ttFrame or UIS:GetFocusedTextBox() then return end
		if not frame or not frame.Parent then alive = false; disconnectLocal(); return end
		showing = true
		_ttLabel.Text = text
		local w, h = _tooltipSizeFor(text)
		_ttFrame.Size = UDim2.new(0, w, 0, h)
		_ttFrame.Visible = true
		_ttFrame.BackgroundTransparency = 0
	end

	local function hide()
		showing = false
		if _ttFrame then _ttFrame.Visible = false end
	end

	bind(frame.MouseEnter, show)
	bind(frame.MouseLeave, hide)
	bind(frame.InputBegan, function(i)
		if i.UserInputType == Enum.UserInputType.MouseMovement then show() end
	end)
	bind(frame.InputEnded, function(i)
		if i.UserInputType == Enum.UserInputType.MouseMovement and showing then hide() end
	end)
	bind(frame.AncestryChanged, function(_, parent)
		if parent == nil then
			alive = false
			if showing then hide() end
			disconnectLocal()
		end
	end)
end

