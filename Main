		GUI._bubbleStars = GUI._bubbleStars or {}
		for i, child in ipairs(V.minimizeBubbleInner:GetChildren()) do
			if child.Name == "BubbleStar" then
				table.insert(GUI._bubbleStars, {
					obj = child,
					baseX = child.Position.X.Scale,
					baseY = child.Position.Y.Scale,
					phase = i * 0.83,
					speed = 0.65 + (i % 4) * 0.18,
					range = 0.035 + (i % 3) * 0.012,
				})
			end
		end
		if not GUI._bubbleStarConnection then
			GUI._bubbleStarClock = 0
			GUI._bubbleStarConnection = RunService.RenderStepped:Connect(function(dt)
				if _destroyed then return end
				GUI._bubbleStarClock = (GUI._bubbleStarClock or 0) + dt
				if not V.minimizeBubble or not V.minimizeBubble.Visible then return end
				for _, d in ipairs(V.minimizeBubbleInner and V.minimizeBubbleInner:GetDescendants() or {}) do
					if d.Name == "BubbleSpaceOrbit" then
						d.Rotation = d.Rotation + (d.AbsoluteSize.X > 30 and 18 or -28) * dt
					end
				end
				for _, item in ipairs(GUI._bubbleStars or {}) do
					local o = item.obj
					if o and o.Parent then
						local t = GUI._bubbleStarClock * item.speed + item.phase
						o.Position = UDim2.fromScale(
							math.clamp(item.baseX + math.sin(t) * item.range, 0.12, 0.88),
							math.clamp(item.baseY + math.cos(t * 0.78) * item.range, 0.12, 0.88)
						)
						o.BackgroundTransparency = 0.06 + (math.sin(t * 1.7) + 1) * 0.22
					end
				end
			end)
			track(GUI._bubbleStarConnection)
		end

		-- Icon-free modern center mark: two soft accent pills + one muted base pill.
		-- We keep minimizeBubbleIcon as an invisible compatibility placeholder so old scripts
		-- calling Window:SetMinimizeIcon(...) do not error, but no emoji/text is rendered.
		V.minimizeBubbleIcon = Instance.new("TextLabel", V.minimizeBubbleInner)
		V.minimizeBubbleIcon.Name = "IconCompatibilityPlaceholder"
		V.minimizeBubbleIcon.BackgroundTransparency = 1
		V.minimizeBubbleIcon.BorderSizePixel = 0
		V.minimizeBubbleIcon.Size = UDim2.new(0, 0, 0, 0)
		V.minimizeBubbleIcon.Text = ""
		V.minimizeBubbleIcon.Visible = false
		V.minimizeBubbleIcon.ZIndex = 854

		local markA = Instance.new("Frame", V.minimizeBubbleInner)
		markA.Name = "ModernMarkAccentTop"
		markA.AnchorPoint = Vector2.new(0.5, 0.5)
		markA.Position = UDim2.new(0.5, 0, 0.40, 0)
		markA.Size = UDim2.new(0, 27, 0, 5)
		markA.BackgroundColor3 = Library.Theme.Accent
		markA.BackgroundTransparency = 0.05
		markA.BorderSizePixel = 0
		markA.ZIndex = 854
