		V.miniFrame.Visible = V.miniVisible
		V.miniFrame.Active = true
		V.miniFrame.ZIndex = 80
		corner(V.miniFrame, 8)
		V.miniStroke = stroke(V.miniFrame, Library.Theme.Border, 1)

		V.miniAccent = Instance.new("Frame", V.miniFrame)
		V.miniAccent.Name = "MiniAccent"
		V.miniAccent.BackgroundColor3 = Library.Theme.Accent
		V.miniAccent.BorderSizePixel = 0
		V.miniAccent.Size = UDim2.new(0, 3, 1, -12)
		V.miniAccent.Position = UDim2.new(0, 6, 0, 6)
		V.miniAccent.ZIndex = 81
		corner(V.miniAccent, 3)
		regAccent(V.miniAccent)

		V.miniTitleLbl = Instance.new("TextLabel", V.miniFrame)
		V.miniTitleLbl.Name = "MiniTitle"
		V.miniTitleLbl.BackgroundTransparency = 1
		V.miniTitleLbl.BorderSizePixel = 0
		V.miniTitleLbl.Position = UDim2.new(0, 16, 0, 4)
		V.miniTitleLbl.Size = UDim2.new(1, -24, 0, 13)
		V.miniTitleLbl.Text = tostring(options.miniTitle or options.name or "VENTURA"):upper()
		V.miniTitleLbl.TextSize = 9
		V.miniTitleLbl.TextColor3 = Library.Theme.TextSecondary
		V.miniTitleLbl.TextXAlignment = Enum.TextXAlignment.Left
		V.miniTitleLbl.TextTruncate = Enum.TextTruncate.AtEnd
		V.miniTitleLbl.FontFace = Font.new("rbxasset://fonts/families/RobotoMono.json", Enum.FontWeight.Bold)
		V.miniTitleLbl.ZIndex = 81

		local row = Instance.new("Frame", V.miniFrame)
		row.Name = "MiniStatsRow"
		row.BackgroundTransparency = 1
		row.BorderSizePixel = 0
		row.Position = UDim2.new(0, 16, 0, 18)
		row.Size = UDim2.new(1, -24, 0, 20)
		row.ZIndex = 81
		local rl = Instance.new("UIListLayout", row)
		rl.FillDirection = Enum.FillDirection.Horizontal
		rl.HorizontalAlignment = Enum.HorizontalAlignment.Left
		rl.VerticalAlignment = Enum.VerticalAlignment.Center
		rl.Padding = UDim.new(0, 6)

		local function pill(name, w)
			local p = Instance.new("Frame", row)
			p.Name = name .. "Pill"
			p.BackgroundColor3 = Library.Theme.Background
			p.BorderSizePixel = 0
			p.Size = UDim2.new(0, w, 0, 18)
			p.ZIndex = 82
			corner(p, 6)
			stroke(p, Color3.fromRGB(45,45,52), 1)
			local t = Instance.new("TextLabel", p)
			t.Name = name .. "Text"
			t.BackgroundTransparency = 1
			t.BorderSizePixel = 0
			t.Size = UDim2.new(1, -8, 1, 0)
			t.Position = UDim2.new(0, 4, 0, 0)
			t.Text = name
			t.TextSize = 10
			t.TextColor3 = Library.Theme.TextPrimary
			t.TextXAlignment = Enum.TextXAlignment.Center
			t.FontFace = Font.new("rbxasset://fonts/families/RobotoMono.json", Enum.FontWeight.Bold)
			t.ZIndex = 83
			return t
		end

		V.miniFpsLbl = pill("FPS", 68)
		V.miniPingLbl = pill("PING", 86)
		_setMiniText()

		V.miniFrame.InputBegan:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
				V.miniDrag = true
				V.miniDragStart = i.Position
				V.miniStartPos = V.miniFrame.Position
			end
		end)
		GUI:_registerInputHandler("changed", "mini-drag", function(i)
			if not V.miniDrag or not V.miniFrame then return end
			if i.UserInputType ~= Enum.UserInputType.MouseMovement and i.UserInputType ~= Enum.UserInputType.Touch then return end
			local d = i.Position - V.miniDragStart
			V.miniFrame.Position = _miniClampPosition(UDim2.new(V.miniStartPos.X.Scale, V.miniStartPos.X.Offset + d.X, V.miniStartPos.Y.Scale, V.miniStartPos.Y.Offset + d.Y))
		end, "mini")
		GUI:_registerInputHandler("ended", "mini-drag-end", function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
				if V.miniDrag then
					V.miniDrag = false
					pcall(function() GUI:MarkConfigDirty() end)
				end
			end
		end, "mini")

		-- Stats are updated by the shared updater above.

		return V.miniFrame
	end

	if V.floatingMiniAllowed then createMiniHUD() end

