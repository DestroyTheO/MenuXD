			searchPlaceholder = "Search colors...",
			maxVisible        = 7,
			multi             = false,
			callback = function(val)
				GUI:SetAccentPreset(val)
			end,
		})

		local transitionToggle = T:Toggle({
			name = "Animated Theme Transitions",
			description = "Fade/tween when switching themes",
			default = true,
			config = false, noConfig = true, save = false, persist = false,
