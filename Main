		function Tab:Hyperlink(opts)
			opts=validate({text="Link",url="",tooltip="",openBrowser=false},opts)
			local f=base("Hyperlink",38); pad(f,0,8,0,10)
			local bStroke=f:FindFirstChildOfClass("UIStroke")
			local ic=Instance.new("ImageLabel",f); ic.BackgroundTransparency=1
			ic.ImageColor3=Library.Theme.Accent; regAccent(ic, "ImageColor3"); ic.AnchorPoint=Vector2.new(0,0.5)
			ic.Image="rbxassetid://11422141677"; ic.Size=UDim2.new(0,13,0,13); ic.Position=UDim2.new(0,0,0.5,0)
			local nl=lbl(f,opts.text,13,Library.Theme.Accent); regAccent(nl, "TextColor3")
			nl.Size=UDim2.new(1,-58,1,0); nl.Position=UDim2.new(0,18,0,0)
			local tag=Instance.new("TextLabel",f)
			tag.BackgroundTransparency=1; tag.AnchorPoint=Vector2.new(1,0.5)
			tag.Size=UDim2.new(0,52,0,16); tag.Position=UDim2.new(1,0,0.5,0)
			tag.TextSize=10; tag.TextXAlignment=Enum.TextXAlignment.Right
			tag.FontFace=Font.new("rbxasset://fonts/families/Ubuntu.json")
			tag.TextColor3=Library.Theme.TextDisabled; tag.Text=opts.openBrowser and "open" or "copy url"
			addTooltip(f, opts.tooltip~="" and opts.tooltip or opts.url)
			f.InputBegan:Connect(function(i)
				if i.UserInputType==Enum.UserInputType.MouseButton1
					or i.UserInputType==Enum.UserInputType.Touch then
					local opened=false
					if opts.openBrowser and opts.url ~= "" then
						opened = pcall(function() GuiService:OpenBrowserWindow(opts.url) end)
					end
					if not opened then pcall(function() setclipboard(opts.url) end) end
					tag.TextColor3=Color3.fromRGB(60,200,90); tag.Text=opened and "opened!" or "copied!"
					task.delay(2,function()
						pcall(function() tag.TextColor3=Library.Theme.TextDisabled; tag.Text=opts.openBrowser and "open" or "copy url" end)
					end)
				end
			end)
			f.MouseEnter:Connect(function()
				tw(f,{BackgroundColor3=Library.Theme.SurfaceHover}); safeTween(bStroke,{Color=Library.Theme.BorderHover})
				tw(nl,{TextColor3=Color3.fromRGB(180,200,255)})
			end)
			f.MouseLeave:Connect(function()
				tw(f,{BackgroundColor3=Library.Theme.Surface}); safeTween(bStroke,{Color=Library.Theme.Border})
				tw(nl,{TextColor3=Library.Theme.Accent})
			end)
			return f
		end



		-- ── NUMBER / PRICE / TOTAL DISPLAY ───────────────────────────────────────
		-- Read-only numeric output for price calculators, totals, balances, counts,
		-- quantities, percentages, and other live values.
		--
		-- Example:
		-- local Total = Tab:NumberDisplay({name="Total", value=0, prefix="$", decimals=2})
		-- Total:Set(149.99)
		function Tab:NumberDisplay(opts)
			opts = validate({
				name = "Total",
				description = "",
				tooltip = "",
				value = 0,
				default = nil,
				prefix = "",
				suffix = "",
				decimals = 0,
				commas = true,
				compact = false,
				icon = "",
				placeholder = "—",
				valueColor = nil,
				formatter = nil,
				valueObject = nil,
			}, opts)

			local Display = {}
			local initial = opts.default ~= nil and opts.default or opts.value
			Display.Value = tonumber(initial) or 0

			local hasDesc = tostring(opts.description or "") ~= ""
			local h = hasDesc and 64 or 52
			Display.frame = base("NumberDisplay", h)
			pad(Display.frame, 0, 8, 0, 10)

			local title, desc = labelPair(Display.frame, opts.name, opts.description, 170, hasDesc and 11 or 17)
			if opts.icon ~= "" then
				title.Text = tostring(opts.icon) .. "  " .. tostring(opts.name)
			end

			local valueBox = Instance.new("Frame", Display.frame)
			valueBox.Name = "NumberDisplayValue"
			valueBox.AnchorPoint = Vector2.new(1, 0.5)
			valueBox.Position = UDim2.new(1, 0, 0.5, 0)
			valueBox.Size = UDim2.new(0, 156, 0, 32)
			valueBox.BackgroundColor3 = Library.Theme.Background
			valueBox.BorderSizePixel = 0
			corner(valueBox, 7)
			stroke(valueBox, Library.Theme.Border)

			local valueLabel = lbl(valueBox, "", 15, opts.valueColor or Library.Theme.Accent,
				Font.new("rbxasset://fonts/families/RobotoMono.json", Enum.FontWeight.Bold))
			valueLabel.Name = "NumberDisplayText"
			valueLabel.Size = UDim2.new(1, -16, 1, 0)
			valueLabel.Position = UDim2.new(0, 8, 0, 0)
			valueLabel.TextXAlignment = Enum.TextXAlignment.Right
			valueLabel.TextTruncate = Enum.TextTruncate.AtEnd
			if not opts.valueColor then regAccent(valueLabel, "TextColor3") end

			local function addCommas(text)
				local sign, whole, frac = text:match("^([%-]?)(%d+)(.*)$")
				if not whole then return text end
				local reversed = whole:reverse():gsub("(%d%d%d)", "%1,")
				whole = reversed:reverse():gsub("^,", "")
				return (sign or "") .. whole .. (frac or "")
			end

			local function compactNumber(n, decimals)
				local abs = math.abs(n)
				local divisor, tag = 1, ""
				if abs >= 1e12 then divisor, tag = 1e12, "T"
				elseif abs >= 1e9 then divisor, tag = 1e9, "B"
				elseif abs >= 1e6 then divisor, tag = 1e6, "M"
				elseif abs >= 1e3 then divisor, tag = 1e3, "K" end
				if divisor == 1 then return nil end
				local places = math.max(0, math.min(3, tonumber(decimals) or 1))
				local text = string.format("%." .. places .. "f", n / divisor)
				text = text:gsub("(%..-)0+$", "%1"):gsub("%.$", "")
				return text .. tag
			end

			local function formatValue(value)
				if type(opts.formatter) == "function" then
					local ok, result = pcall(opts.formatter, value, Display)
					if ok and result ~= nil then return tostring(result) end
				end
				local n = tonumber(value)
				if n == nil then
					return tostring(value == nil and opts.placeholder or value)
				end
				local decimals = math.max(0, math.floor(tonumber(opts.decimals) or 0))
				local text = opts.compact and compactNumber(n, decimals) or nil
				if not text then text = string.format("%." .. decimals .. "f", n) end
				if opts.commas and not opts.compact then text = addCommas(text) end
				return tostring(opts.prefix or "") .. text .. tostring(opts.suffix or "")
			end

			local function render()
				valueLabel.Text = formatValue(Display.Value)
			end

			function Display:Set(value)
				local numeric = tonumber(value)
				Display.Value = numeric ~= nil and numeric or value
				render()
				return Display
			end
			function Display:Get() return Display.Value end
			function Display:Add(amount)
				Display.Value = (tonumber(Display.Value) or 0) + (tonumber(amount) or 0)
				render()
				return Display
			end
			function Display:Subtract(amount)
				Display.Value = (tonumber(Display.Value) or 0) - (tonumber(amount) or 0)
				render()
				return Display
			end
			function Display:SetPrefix(prefix) opts.prefix = tostring(prefix or ""); render(); return Display end
			function Display:SetSuffix(suffix) opts.suffix = tostring(suffix or ""); render(); return Display end
			function Display:SetDecimals(decimals) opts.decimals = math.max(0, math.floor(tonumber(decimals) or 0)); render(); return Display end
			function Display:SetFormatter(formatter) opts.formatter = formatter; render(); return Display end
			function Display:SetName(name) title.Text = (opts.icon ~= "" and tostring(opts.icon) .. "  " or "") .. tostring(name or ""); return Display end
			function Display:SetDescription(text)
				if desc then desc.Text = tostring(text or "") end
				return Display
			end
			function Display:SetValueColor(color)
				if typeof(color) == "Color3" then valueLabel.TextColor3 = color end
				return Display
			end

			addTooltip(Display.frame, opts.tooltip)
			render()
			if type(opts.valueObject) == "table" and type(opts.valueObject.Bind) == "function" then
				Display._valueDisconnect = opts.valueObject:Bind(function(value)
					Display:Set(value)
				end, true)
				GUI:RegisterOwnedCleanup("values", function()
					if type(Display._valueDisconnect) == "function" then Display._valueDisconnect() end
				end, "NumberDisplay value binding")
			end
			return Display
		end

		Tab.ValueDisplay = Tab.NumberDisplay
		Tab.PriceDisplay = Tab.NumberDisplay
		Tab.TotalDisplay = Tab.NumberDisplay
		Tab.Total = Tab.NumberDisplay

		-- ── ADVANCED LAYOUT HELPERS ─────────────────────────────────────────────
		local function makeProxyParent(parent)
			local Proxy = { _scroll = parent }
			local names = {
				"Section", "Separator", "Label", "Paragraph", "Badge", "ButtonGrid", "Image",
				"ProgressBar", "Button", "Toggle", "Slider", "Dropdown", "SearchDropdown",
				"SearchableDropdown", "FilterDropdown", "TextInput", "ColorPicker", "Keybind",
				"Warning", "Info", "Success", "Divider", "Chip", "ControlHint", "Hyperlink",
				"StatusCard", "LogConsole", "NumberDisplay", "ValueDisplay", "PriceDisplay", "TotalDisplay", "Total"
			}
			local function callTabMethod(methodName, ...)
				local fn = Tab[methodName]
				if type(fn) ~= "function" then return nil end
				local old = Tab._scroll
				Tab._scroll = parent
				local ok, result = pcall(fn, Tab, ...)
				Tab._scroll = old
				if not ok then error(result, 2) end
				return result
			end
			for _, methodName in ipairs(names) do
				Proxy[methodName] = function(_, ...)
					return callTabMethod(methodName, ...)
				end
			end
			return Proxy
		end

		local function attachAutoHeight(frame, body, layout, topPad, bottomPad, minHeight, isOpenFn)
			local function updateHeight()
				task.defer(function()
					if not frame.Parent then return end
					local open = true
					if type(isOpenFn) == "function" then open = isOpenFn() == true end
					local contentH = open and (layout.AbsoluteContentSize.Y + (bottomPad or 10)) or 0
					if body then
						body.Visible = open
						body.Size = UDim2.new(1, -20, 0, math.max(0, layout.AbsoluteContentSize.Y + 2))
					end
					frame.Size = UDim2.new(1, 0, 0, math.max(minHeight or 40, (topPad or 0) + contentH))
				end)
			end
			layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateHeight)
			updateHeight()
			return updateHeight
		end

		function Tab:Groupbox(opts)
			opts = validate({name="Groupbox", description="", icon="", tooltip=""}, opts)
			local Group = { _open = true }
			local f = base("Groupbox", 74)
			f.ClipsDescendants = false
			pad(f, 0, 0, 0, 0)
			addTooltip(f, opts.tooltip)

			local accent = Instance.new("Frame", f)
			accent.Name = "GroupboxAccent"
			accent.BackgroundColor3 = Library.Theme.Accent; regAccent(accent)
			accent.BorderSizePixel = 0
			accent.Size = UDim2.new(0, 3, 0, 26)
			accent.Position = UDim2.new(0, 10, 0, 12)
			corner(accent, 2)

			local x = opts.icon ~= "" and 42 or 22
			if opts.icon ~= "" then
				local ic = lbl(f, tostring(opts.icon), 15, Library.Theme.Accent, FONT_UI_BOLD, Enum.TextXAlignment.Center)
				ic.Position = UDim2.new(0, 18, 0, 12)
				ic.Size = UDim2.new(0, 20, 0, 20)
				regAccent(ic, "TextColor3")
			end

			local title = lbl(f, tostring(opts.name), 14, Library.Theme.TextPrimary, FONT_UI_BOLD)
			title.Name = "ControlTitle"
			title.Position = UDim2.new(0, x, 0, opts.description ~= "" and 9 or 14)
			title.Size = UDim2.new(1, -(x + 14), 0, 18)
			title.TextTruncate = Enum.TextTruncate.AtEnd
			if opts.description ~= "" then
				local desc = lbl(f, tostring(opts.description), 11, Library.Theme.TextSecondary, FONT_UI)
				desc.Name = "ControlDescription"
				desc.Position = UDim2.new(0, x, 0, 29)
				desc.Size = UDim2.new(1, -(x + 14), 0, 16)
				desc.TextTruncate = Enum.TextTruncate.AtEnd
			end

			local body = Instance.new("Frame", f)
			body.Name = "GroupboxBody"
			body.BackgroundTransparency = 1
			body.BorderSizePixel = 0
			body.Position = UDim2.new(0, 10, 0, opts.description ~= "" and 54 or 46)
			body.Size = UDim2.new(1, -20, 0, 10)
			local layout = Instance.new("UIListLayout", body)
			layout.Padding = UDim.new(0, 8)
			layout.SortOrder = Enum.SortOrder.LayoutOrder
			local refresh = attachAutoHeight(f, body, layout, opts.description ~= "" and 56 or 48, 12, opts.description ~= "" and 68 or 60, function() return true end)
			local Proxy = makeProxyParent(body)
			for k, v in pairs(Proxy) do Group[k] = v end
			Group.frame = f
			function Group:GetFrame() return f end
			function Group:Refresh() refresh(); return Group end
			return _universalControl(Group, opts)
		end

		function Tab:CollapsibleSection(opts)
			opts = validate({name="Advanced Settings", description="", icon="", open=true, tooltip=""}, opts)
			local Section = { _open = opts.open ~= false }
			local f = base("CollapsibleSection", 44)
			f.ClipsDescendants = true
			pad(f, 0, 0, 0, 0)
			addTooltip(f, opts.tooltip)

			local header = Instance.new("TextButton", f)
			header.Name = "CollapsibleHeader"
			header.BackgroundTransparency = 1
			header.BorderSizePixel = 0
			header.AutoButtonColor = false
			header.Text = ""
			header.Size = UDim2.new(1, 0, 0, opts.description ~= "" and 52 or 42)

			local accent = Instance.new("Frame", header)
			accent.Name = "CollapsibleAccent"
			accent.BackgroundColor3 = Library.Theme.Accent; regAccent(accent)
			accent.BorderSizePixel = 0
			accent.Size = UDim2.new(0, 3, 0, opts.description ~= "" and 32 or 24)
			accent.Position = UDim2.new(0, 10, 0, opts.description ~= "" and 10 or 9)
			corner(accent, 2)

			local arrow = lbl(header, Section._open and "−" or "+", 16, Library.Theme.Accent, FONT_MONO_BOLD, Enum.TextXAlignment.Center)
			arrow.Name = "CollapsibleArrow"
			arrow.AnchorPoint = Vector2.new(1, 0.5)
			arrow.Position = UDim2.new(1, -12, 0.5, 0)
			arrow.Size = UDim2.new(0, 22, 0, 22)
			regAccent(arrow, "TextColor3")

			local x = opts.icon ~= "" and 44 or 22
			if opts.icon ~= "" then
				local ic = lbl(header, tostring(opts.icon), 15, Library.Theme.TextSecondary, FONT_UI_BOLD, Enum.TextXAlignment.Center)
				ic.Position = UDim2.new(0, 19, 0, opts.description ~= "" and 13 or 10)
				ic.Size = UDim2.new(0, 20, 0, 20)
			end
			local title = lbl(header, tostring(opts.name), 14, Library.Theme.TextPrimary, FONT_UI_BOLD)
			title.Name = "ControlTitle"
			title.Position = UDim2.new(0, x, 0, opts.description ~= "" and 8 or 12)
			title.Size = UDim2.new(1, -(x + 42), 0, 20)
			title.TextTruncate = Enum.TextTruncate.AtEnd
			if opts.description ~= "" then
				local desc = lbl(header, tostring(opts.description), 11, Library.Theme.TextSecondary, FONT_UI)
				desc.Name = "ControlDescription"
				desc.Position = UDim2.new(0, x, 0, 29)
				desc.Size = UDim2.new(1, -(x + 42), 0, 16)
				desc.TextTruncate = Enum.TextTruncate.AtEnd
			end

			local bodyY = opts.description ~= "" and 54 or 44
			local body = Instance.new("Frame", f)
			body.Name = "CollapsibleBody"
			body.BackgroundTransparency = 1
			body.BorderSizePixel = 0
			body.Position = UDim2.new(0, 10, 0, bodyY)
			body.Size = UDim2.new(1, -20, 0, 10)
			local layout = Instance.new("UIListLayout", body)
			layout.Padding = UDim.new(0, 8)
			layout.SortOrder = Enum.SortOrder.LayoutOrder
			local refresh = attachAutoHeight(f, body, layout, bodyY, 10, bodyY, function() return Section._open end)

			function Section:SetOpen(state)
				Section._open = state == true
				arrow.Text = Section._open and "−" or "+"
				refresh()
				return Section._open
			end
			function Section:Toggle() return Section:SetOpen(not Section._open) end
			function Section:IsOpen() return Section._open == true end
			header.InputBegan:Connect(function(i)
				if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then Section:Toggle() end
			end)
			header.MouseEnter:Connect(function() tw(f, {BackgroundColor3 = Library.Theme.SurfaceHover}, TI_FAST) end)
			header.MouseLeave:Connect(function() tw(f, {BackgroundColor3 = Library.Theme.Surface}, TI_FAST) end)

			local Proxy = makeProxyParent(body)
			for k, v in pairs(Proxy) do Section[k] = v end
			Section.frame = f
			function Section:GetFrame() return f end
			function Section:Refresh() refresh(); return Section end
			function Section:Get() return Section:IsOpen() end
			function Section:Set(v) return Section:SetOpen(v) end
			Section:SetOpen(Section._open)
			return _universalControl(Section, opts)
		end

		function Tab:Columns(opts)
			opts = validate({columns=2, gap=8, tooltip=""}, opts)
			local count = math.clamp(tonumber(opts.columns) or 2, 1, 4)
			local gap = math.max(0, tonumber(opts.gap) or 8)
			local Columns = { _columns = {} }
			local f = Instance.new("Frame", Tab._scroll)
			f.Name = "Columns"
			f.BackgroundTransparency = 1
			f.BorderSizePixel = 0
			f.Size = UDim2.new(1, 0, 0, 40)
			addTooltip(f, opts.tooltip)
			local layouts = {}
			local function update()
				task.defer(function()
					if not f.Parent then return end
					local maxH = 0
					for _, layout in ipairs(layouts) do maxH = math.max(maxH, layout.AbsoluteContentSize.Y) end
					f.Size = UDim2.new(1, 0, 0, math.max(40, maxH))
				end)
			end
			for i = 1, count do
				local col = Instance.new("Frame", f)
				col.Name = "Column" .. i
				col.BackgroundTransparency = 1
				col.BorderSizePixel = 0
				col.Position = UDim2.new((i - 1) / count, (i - 1) * gap, 0, 0)
				col.Size = UDim2.new(1 / count, -gap + (gap / count), 1, 0)
				local layout = Instance.new("UIListLayout", col)
				layout.Padding = UDim.new(0, 8)
				layout.SortOrder = Enum.SortOrder.LayoutOrder
				layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(update)
				table.insert(layouts, layout)
				Columns._columns[i] = makeProxyParent(col)
			end
			function Columns:Column(i) return Columns._columns[math.clamp(tonumber(i) or 1, 1, count)] end
			Columns.frame = f
			function Columns:GetFrame() return f end
			function Columns:Refresh() update(); return Columns end
			function Columns:Get() return Columns._columns end
			update()
			return _universalControl(Columns, opts)
		end

		function Tab:StatusCard(opts)
			opts = validate({title="Status", status="Idle", value="", kind="info", tooltip=""}, opts)
			local colors = {
				success = Color3.fromRGB(70, 220, 130), warning = Color3.fromRGB(255, 190, 70),
				error = Color3.fromRGB(255, 80, 90), info = Library.Theme.Accent, running = Library.Theme.Accent,
				idle = Library.Theme.TextSecondary
			}
			local Card = { Status = tostring(opts.status or "Idle"), Kind = tostring(opts.kind or "info") }
			Card.frame = base("StatusCard", 64)
			pad(Card.frame, 0, 12, 0, 14)
			addTooltip(Card.frame, opts.tooltip)
			local dot = Instance.new("Frame", Card.frame)
			dot.Name = "StatusDot"
			dot:SetAttribute("VenturaStatus", Card.Kind); dot.BackgroundColor3 = colors[Card.Kind] or Library.Theme.Accent
			dot.BorderSizePixel = 0
			dot.AnchorPoint = Vector2.new(0, 0.5)
			dot.Position = UDim2.new(0, 0, 0.5, 0)
			dot.Size = UDim2.new(0, 10, 0, 10)
			corner(dot, 10)
			local title = lbl(Card.frame, tostring(opts.title), 13, Library.Theme.TextPrimary, FONT_UI_BOLD)
			title.Name = "ControlTitle"
			title.Position = UDim2.new(0, 20, 0, 10)
			title.Size = UDim2.new(1, -30, 0, 18)
			local status = lbl(Card.frame, Card.Status, 12, Library.Theme.TextSecondary, FONT_UI)
			status.Name = "ControlDescription"
			status.Position = UDim2.new(0, 20, 0, 30)
			status.Size = UDim2.new(1, -30, 0, 18)
			local value = nil
			if tostring(opts.value or "") ~= "" then
				value = lbl(Card.frame, tostring(opts.value), 12, Library.Theme.Accent, FONT_MONO_BOLD, Enum.TextXAlignment.Right)
				value.Name = "StatusValue"
				value.AnchorPoint = Vector2.new(1, 0.5)
				value.Position = UDim2.new(1, 0, 0.5, 0)
				value.Size = UDim2.new(0, 110, 0, 18)
				regAccent(value, "TextColor3")
				title.Size = UDim2.new(1, -145, 0, 18)
				status.Size = UDim2.new(1, -145, 0, 18)
			end
			function Card:SetStatus(text, kind)
				Card.Status = tostring(text or "")
				if kind then Card.Kind = tostring(kind) end
				status.Text = Card.Status
				dot:SetAttribute("VenturaStatus", Card.Kind); dot.BackgroundColor3 = colors[Card.Kind] or Library.Theme.Accent
				return Card
			end
			function Card:SetTitle(text) title.Text = tostring(text or ""); return Card end
			function Card:SetValue(text) if value then value.Text = tostring(text or "") end; return Card end
			function Card:GetStatus() return Card.Status, Card.Kind end
			function Card:GetFrame() return Card.frame end
			function Card:Get() return Card.Status, Card.Kind end
			function Card:Set(v) return Card:SetStatus(v) end
			return _universalControl(Card, opts)
		end

		function Tab:LogConsole(opts)
			opts = validate({name="Console", height=160, maxLines=100, timestamp=true, tooltip=""}, opts)
			local Console = { Lines = {}, MaxLines = math.max(10, tonumber(opts.maxLines) or 100) }
			Console.frame = base("LogConsole", (tonumber(opts.height) or 160) + 34)
			pad(Console.frame, 0, 10, 8, 10)
			addTooltip(Console.frame, opts.tooltip)
			local title = lbl(Console.frame, tostring(opts.name), 13, Library.Theme.TextPrimary, FONT_UI_BOLD)
			title.Name = "ControlTitle"
			title.Size = UDim2.new(1, 0, 0, 24)
			title.Position = UDim2.new(0, 0, 0, 6)
			local scroll = Instance.new("ScrollingFrame", Console.frame)
			scroll.Name = "LogScroll"
			scroll.BackgroundColor3 = Library.Theme.Background
			scroll.BorderSizePixel = 0
			scroll.Position = UDim2.new(0, 0, 0, 32)
			scroll.Size = UDim2.new(1, 0, 1, -38)
			scroll.ScrollBarThickness = 2
			scroll.ScrollBarImageColor3 = Library.Theme.BorderHover
			scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
			corner(scroll, 7); stroke(scroll, Library.Theme.Border)
			local layout = Instance.new("UIListLayout", scroll)
			layout.Padding = UDim.new(0, 2)
			layout.SortOrder = Enum.SortOrder.LayoutOrder
			pad(scroll, 6, 6, 6, 6)
			layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
				scroll.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 12)
				scroll.CanvasPosition = Vector2.new(0, math.max(0, layout.AbsoluteContentSize.Y))
			end)
			function Console:Add(text, kind)
				kind = tostring(kind or "info")
				local lineText = tostring(text or "")
				if opts.timestamp then lineText = os.date("%H:%M:%S") .. "  " .. lineText end
				local line = Instance.new("TextLabel", scroll)
				line.Name = "LogLine"
				line.BackgroundTransparency = 1
				line.BorderSizePixel = 0
				line.Size = UDim2.new(1, -4, 0, 18)
				line.TextXAlignment = Enum.TextXAlignment.Left
				line.TextYAlignment = Enum.TextYAlignment.Center
				line.FontFace = FONT_MONO
				line.TextSize = 11
				line.TextTruncate = Enum.TextTruncate.AtEnd
				line.TextColor3 = kind == "success" and Color3.fromRGB(80, 220, 140)
					or kind == "warning" and Color3.fromRGB(255, 195, 85)
					or kind == "error" and Color3.fromRGB(255, 95, 110)
					or Library.Theme.TextSecondary
				line.Text = lineText
				table.insert(Console.Lines, line)
				while #Console.Lines > Console.MaxLines do
					local old = table.remove(Console.Lines, 1)
					pcall(function() old:Destroy() end)
				end
				return line
			end
			function Console:Log(text, kind) return Console:Add(text, kind) end
			function Console:Append(text, kind) return Console:Add(text, kind) end
			function Console:Clear()
				for _, line in ipairs(Console.Lines) do pcall(function() line:Destroy() end) end
				Console.Lines = {}
			end
			function Console:GetFrame() return Console.frame end
			function Console:Get() return Console.Lines end
			function Console:Set(v) Console:Clear(); Console:Add(v); return Console end
			return _universalControl(Console, opts)
		end

