		T:ColorPicker({ name = "Builder Background", default = builder.Background, config = false, noConfig = true, save = false, persist = false, callback = function(c) builder.Background = c end })
		T:ColorPicker({ name = "Builder Surface", default = builder.Surface, config = false, noConfig = true, save = false, persist = false, callback = function(c) builder.Surface = c end })
		T:ColorPicker({ name = "Builder Text", default = builder.TextPrimary, config = false, noConfig = true, save = false, persist = false, callback = function(c) builder.TextPrimary = c end })
		T:ColorPicker({ name = "Builder Accent", default = builder.Accent, config = false, noConfig = true, save = false, persist = false, callback = function(c) builder.Accent = c end })

		T:ButtonGrid({
			name = "Builder Actions",
			columns = 3,
			buttons = {
				{ name = "Preview", icon = Library.Icons.eye, callback = function()
					GUI:ApplyThemePack({
						name = builderName,
						category = "Custom",
						colors = {
							Background = builder.Background,
							Surface = builder.Surface,
							SurfaceHover = builder.Surface:Lerp(builder.Accent, 0.16),
							Nav = builder.Background:Lerp(Color3.fromRGB(0,0,0), 0.22),
							Topbar = builder.Background:Lerp(Color3.fromRGB(0,0,0), 0.28),
							Border = builder.Surface:Lerp(builder.Accent, 0.22),
							BorderHover = builder.Accent,
							TextPrimary = builder.TextPrimary,
							TextSecondary = builder.TextPrimary:Lerp(builder.Background, 0.38),
							TextDisabled = builder.TextPrimary:Lerp(builder.Background, 0.62),
							UserBox = builder.Surface:Lerp(builder.Background, 0.18),
							Accent = builder.Accent,
						},
						effects = { animation = GUI._themeMixAnimationStyle or GUI:GetThemeAnimationStyle(), glass = 0.12, style = "custom" },
					})
					GUI.notify("Theme Builder", "Previewing " .. builderName, 2, "success")
				end },
				{ name = "Runtime Save", icon = Library.Icons.save, callback = function()
					GUI:RegisterThemePack({ name = builderName, category = "Custom", colors = { Background=builder.Background, Surface=builder.Surface, SurfaceHover=builder.Surface:Lerp(builder.Accent,0.16), Nav=builder.Background:Lerp(Color3.fromRGB(0,0,0),0.22), Topbar=builder.Background:Lerp(Color3.fromRGB(0,0,0),0.28), Border=builder.Surface:Lerp(builder.Accent,0.22), BorderHover=builder.Accent, TextPrimary=builder.TextPrimary, TextSecondary=builder.TextPrimary:Lerp(builder.Background,0.38), TextDisabled=builder.TextPrimary:Lerp(builder.Background,0.62), UserBox=builder.Surface:Lerp(builder.Background,0.18), Accent=builder.Accent }, effects={ animation = GUI._themeMixAnimationStyle or GUI:GetThemeAnimationStyle(), style="custom" } }, false)
					if themeDrop then themeDrop:SetItems(GUI:GetThemes()) end
					if categoryDrop then categoryDrop:SetItems(GUI:GetThemeCategories()) end
					GUI.notify("Theme Builder", "Runtime theme added: " .. builderName, 3, "success")
				end },
				{ name = "Copy Theme", icon = Library.Icons.copy, callback = function()
					local code = string.format('Library:RegisterThemePack({name=%q, category="Custom", colors={Background=Color3.fromRGB(%d,%d,%d), Surface=Color3.fromRGB(%d,%d,%d), TextPrimary=Color3.fromRGB(%d,%d,%d), Accent=Color3.fromRGB(%d,%d,%d)}, effects={animation=%q}})', builderName, math.floor(builder.Background.R*255+0.5), math.floor(builder.Background.G*255+0.5), math.floor(builder.Background.B*255+0.5), math.floor(builder.Surface.R*255+0.5), math.floor(builder.Surface.G*255+0.5), math.floor(builder.Surface.B*255+0.5), math.floor(builder.TextPrimary.R*255+0.5), math.floor(builder.TextPrimary.G*255+0.5), math.floor(builder.TextPrimary.B*255+0.5), math.floor(builder.Accent.R*255+0.5), math.floor(builder.Accent.G*255+0.5), math.floor(builder.Accent.B*255+0.5), GUI._themeMixAnimationStyle or GUI:GetThemeAnimationStyle())
					pcall(function() setclipboard(code) end)
					GUI.notify("Theme Builder", "Theme source copied", 2, "success")
				end },
			},
		})

