				GUI:SetTheme(val)
			end,
		})
		GUI._themeDropdown = themeDrop
		GUI._cfgSyncCallbacks.theme = function(val)
			pcall(function() themeDrop:Set(val, true) end)
		end

		T:ButtonGrid({
			name = "Quick Theme Effects",
