		local profileNameValue = GUI:GetConfigProfile()

		local function syncAutoLoadProfile(profile, quiet)
			profile = _profileSanitize(profile or profileNameValue or GUI:GetConfigProfile())
			if not GUI:GetAutoLoad() then return true end
			local ok, msg = GUI:SetAutoLoadProfile(profile)
			if not ok and not quiet then
				GUI.notify("Config", msg or "Save this profile first, then enable Auto Load", 3, "warning")
			end
			return ok, msg
		end

		S:Toggle({
			name        = "Auto Load",
			description = "Automatically load the last selected/saved profile next time",
			default     = GUI:GetAutoLoad(),
			tooltip     = "Stores the active profile and loads it on next execution",
			callback    = function(state)
				local profile = _profileSanitize(profileNameValue or GUI:GetConfigProfile())
				GUI:SetConfigProfile(profile, false)
				GUI:SetAutoLoad(state)
				local ok, msg = true, nil
				if state then ok, msg = GUI:SetAutoLoadProfile(profile) end
				if state and not ok then GUI:ClearAutoLoad() end
				GUI.notify("Config", state and (ok and ("Auto Load enabled: " .. profile) or (msg or "Save this profile first, then enable Auto Load")) or "Auto Load disabled", 3, state and (ok and "success" or "warning") or "warning")
			end,
		})

		local profileDrop
		local profileInput
		local function refreshProfileDropdown(selected)
			if profileDrop and type(profileDrop.SetItems) == "function" then
				profileDrop:SetItems(GUI:RefreshConfigProfiles())
				profileDrop:Set(selected or GUI:GetConfigProfile(), true)
			end
			if profileInput and type(profileInput.Set) == "function" then
				profileInput:Set(selected or GUI:GetConfigProfile(), true)
			end
		end

		profileDrop = S:SearchDropdown({
			name              = "Profile",
			description       = "Search and choose one config profile",
			items             = GUI:RefreshConfigProfiles(),
			default           = GUI:GetConfigProfile(),
			multi             = false,
			maxVisible        = 5,
			searchPlaceholder = "Search profiles...",
			tooltip           = "Selecting only changes the target profile. Press Load or Save to touch disk.",
			callback          = function(profile)
				profileNameValue = _profileSanitize(profile or "Default")
				GUI:SetConfigProfile(profileNameValue, false)
				if profileInput then profileInput:Set(profileNameValue, true) end
				refreshProfileDropdown(profileNameValue)
				local autoSynced = syncAutoLoadProfile(profileNameValue, true)
				GUI.notify("Profile", GUI:GetAutoLoad() and (autoSynced and ("Selected + Auto Load: " .. profileNameValue) or ("Selected: " .. profileNameValue .. " — save first to auto load")) or ("Selected: " .. profileNameValue .. " — press Load or Save"), 2, GUI:GetAutoLoad() and (autoSynced and "success" or "warning") or "info")
			end,
		})

		profileInput = S:TextInput({
			name        = "Save As",
			placeholder = "Default / Farm / PvP / Alt",
			default     = GUI:GetConfigProfile(),
			tooltip     = "Type a new name, then press Save",
			callback    = function(text)
				profileNameValue = _profileSanitize(text)
			end,
		})

		S:ButtonGrid({
			name = "Profile Actions",
			columns = 4,
			buttons = {
				{
					name = "Save",
					icon = Library.Icons.save,
					callback = function()
						local profile = _profileSanitize(profileNameValue or GUI:GetConfigProfile())
						GUI:SetConfigProfile(profile, false)
						local ok = GUI:SaveProfile(profile)
						refreshProfileDropdown(profile)
						if ok then syncAutoLoadProfile(profile, true) end
						GUI.notify("Config", ok and ("Saved: " .. profile .. (GUI:GetAutoLoad() and "  •  Auto Load updated" or "")) or "Save failed / file API unsupported", 3, ok and "success" or "error")
					end,
				},
				{
					name = "Load",
					icon = Library.Icons.download,
					callback = function()
						local profile = _profileSanitize(profileNameValue or GUI:GetConfigProfile())
						local ok = GUI:LoadProfile(profile)
						if ok then
							refreshProfileDropdown(profile)
							syncAutoLoadProfile(profile, true)
						end
						GUI.notify("Config", ok and ("Loaded: " .. profile .. (GUI:GetAutoLoad() and "  •  Auto Load updated" or "")) or ("No save for: " .. profile), 3, ok and "success" or "warning")
					end,
				},
				{
					name = "Reset",
					icon = Library.Icons.refresh,
					callback = function()
						local profile = _profileSanitize(profileNameValue or GUI:GetConfigProfile())
						GUI:SetConfigProfile(profile, false)
						GUI:ResetConfig(profile, true)
						refreshProfileDropdown(profile)
						GUI.notify("Config", "Reset live settings for " .. profile .. ". Press Save to keep it.", 4, "warning")
					end,
				},
				{
					name = "Delete",
					icon = Library.Icons.trash,
					callback = function()
						local profile = _profileSanitize(profileNameValue or GUI:GetConfigProfile())
						if profile == "Default" then
							GUI.notify("Config", "Default profile cannot be deleted.", 3, "warning")
							return
						end
						local ok, msg = GUI:DeleteProfile(profile)
						profileNameValue = "Default"
						GUI:SetConfigProfile("Default", false)
						pcall(function() GUI:LoadProfile("Default") end)
						refreshProfileDropdown("Default")
						GUI.notify("Config", ok and ("Deleted: " .. profile) or (msg or "Delete failed"), 3, ok and "success" or "warning")
					end,
				},
			},
		})


		S:ButtonGrid({
			name = "Advanced Config",
			columns = 2,
			buttons = {
				{ name = "Duplicate", icon = Library.Icons.copy, callback = function()
					local profile = _profileSanitize(profileNameValue or GUI:GetConfigProfile())
					local copyName = profile .. " Copy"
					local ok, msg = GUI:DuplicateProfile(profile, copyName)
					refreshProfileDropdown(ok and copyName or profile)
					GUI.notify("Config", ok and ("Duplicated to " .. copyName) or tostring(msg), 3, ok and "success" or "warning")
				end },
				{ name = "Status", icon = Library.Icons.info, callback = function()
					local s = GUI:GetConfigStatus()
					GUI.notify("Config Status", "Profile: " .. tostring(s.profile) .. " | Saved: " .. tostring(s.exists) .. " | Controls: " .. tostring(s.controls), 5, "info")
				end },
			},
		})

		S:Section({ name = "Info" })
		S:Label({ text = "VenturaUI v" .. Library.Version .. "  •  transparent themes + animations" })
		S:Label({ text = "Logged in as: " .. LP.Name .. "  (UserId: " .. LP.UserId .. ")" })
		S:Label({ text = "Toggle / Bubble: " .. keys.toggle.Name })
		S:Divider()
		S:Button({
			name        = "Copy UserId",
			description = "Copy your Roblox UserId to clipboard",
			callback    = function()
				pcall(function() setclipboard(tostring(LP.UserId)) end)
				GUI.notify("Copied!", "UserId: " .. LP.UserId, 2, "success")
			end,
		})

		-- Sync the Settings controls with the config after all callbacks exist.
		if GUI._startupLoadedConfig then GUI:ApplyConfig(GUI._startupLoadedConfig) end
		_safeLoadSetLabel("Themes and Settings ready.")
		_safeLoadState.uiReady = true
	end) -- task.defer (Settings)
	end)() -- config/theme/settings module


	-- ══════════════════════════════════════════════════════════════════════
	-- Semicolon separates this IIFE from the preceding module call.
	;(function()
	-- v5.78 Function Support Pack — window utilities
	-- Status registry, safe task system, and cleanup helpers. Config logic is
	-- intentionally untouched.
	-- ══════════════════════════════════════════════════════════════════════
	GUI._statuses = GUI._statuses or {}
	GUI._statusCards = GUI._statusCards or {}
	GUI._tasks = GUI._tasks or {}

	local function _applyStatusToCards(key)
		key = tostring(key or "")
		local data = GUI._statuses[key]
		if not data then return end
		for i = #(GUI._statusCards[key] or {}), 1, -1 do
			local card = GUI._statusCards[key][i]
			if not card or (card.frame and not card.frame.Parent) then
				table.remove(GUI._statusCards[key], i)
			else
				pcall(function()
					if type(card.SetValue) == "function" then card:SetValue(data.Value) end
					if type(card.SetStatus) == "function" then card:SetStatus(data.Status, data.Kind) end
				end)
			end
		end
	end

	function GUI:RegisterStatusCard(key, card)
		key = tostring(key or "")
		if key == "" or type(card) ~= "table" then return nil end
		GUI._statusCards[key] = GUI._statusCards[key] or {}
		table.insert(GUI._statusCards[key], card)
		_applyStatusToCards(key)
		return function()
			local list = GUI._statusCards[key] or {}
			for i = #list, 1, -1 do if list[i] == card then table.remove(list, i) end end
		end
	end

	function GUI:AddStatus(key, value, kind, statusText)
		key = tostring(key or "Status")
		local status = GUI._statuses[key]
		if not status then
			status = {Key = key, Value = "", Kind = "info", Status = key}
			GUI._statuses[key] = status
		end
		function status:Set(newValue, newKind, newStatusText)
			self.Value = tostring(newValue == nil and "" or newValue)
			if newKind ~= nil then self.Kind = tostring(newKind) end
			if newStatusText ~= nil then self.Status = tostring(newStatusText) end
			_applyStatusToCards(self.Key)
			return self
		end
		function status:SetValue(newValue) return self:Set(newValue) end
		function status:SetKind(newKind) self.Kind = tostring(newKind or "info"); _applyStatusToCards(self.Key); return self end
		function status:SetText(newStatusText) self.Status = tostring(newStatusText or self.Key); _applyStatusToCards(self.Key); return self end
		function status:Get() return self.Value end
		function status:Remove() if GUI.RemoveStatus then GUI:RemoveStatus(self.Key) end end
		status:Set(value == nil and status.Value or value, kind or status.Kind, statusText or status.Status)
		return status
	end

	function GUI:SetStatus(key, value, kind, statusText)
		local status = GUI._statuses[tostring(key or "")]
		if not status then status = GUI:AddStatus(key, value, kind, statusText) else status:Set(value, kind, statusText) end
		return status
	end

	function GUI:GetStatus(key)
		return GUI._statuses[tostring(key or "")]
	end

	function GUI:GetStatuses()
		local out = {}
		for key, data in pairs(GUI._statuses or {}) do
			out[key] = {Key = data.Key, Value = data.Value, Kind = data.Kind, Status = data.Status}
		end
		return out
	end

	function GUI:RemoveStatus(key)
		key = tostring(key or "")
		GUI._statuses[key] = nil
		for _, card in ipairs(GUI._statusCards[key] or {}) do
			pcall(function()
				if type(card.SetValue) == "function" then card:SetValue("") end
				if type(card.SetStatus) == "function" then card:SetStatus("Removed", "idle") end
			end)
		end
		return true
	end

	function GUI:ClearStatuses()
		for key in pairs(GUI._statuses or {}) do GUI:RemoveStatus(key) end
		return true
	end

	function GUI:CreateStatusCard(tab, opts)
		opts = opts or {}
		if not tab or type(tab.StatusCard) ~= "function" then return nil end
		local key = opts.key or opts.id or opts.statusId or opts.statusKey or opts.title or opts.name
		local card = tab:StatusCard(opts)
		if key ~= nil then GUI:RegisterStatusCard(key, card); GUI:SetStatus(key, opts.value or "", opts.kind or "info", opts.status or opts.title or key) end
		return card
	end
	GUI.StatusCard = GUI.CreateStatusCard

	function GUI:_StopTaskObject(taskInfo)
		if not taskInfo then return false end
		taskInfo.Running = false
		taskInfo.Stopped = true
		if type(taskInfo.Cleanup) == "function" and not taskInfo._cleanupRan then
			taskInfo._cleanupRan = true
			pcall(taskInfo.Cleanup, taskInfo)
		end
		return true
	end

	function GUI:Task(name, callback, options)
		if type(name) == "function" then callback, name, options = name, nil, callback end
		if type(callback) ~= "function" then return nil end
		options = type(options) == "table" and options or {}
		name = tostring(name or ("Task_" .. tostring(os.clock()):gsub("%.", "_")))
		if options.replace ~= false then GUI:StopTask(name) end
		local taskInfo = {
			Name = name,
			Running = true,
			Stopped = false,
			Started = os.clock(),
			Cleanup = nil,
		}
		function taskInfo:Stop() return GUI:StopTask(self.Name) end
		function taskInfo:IsRunning() return self.Running == true and self.Stopped ~= true end
		GUI._tasks[name] = taskInfo
		local function stopRequested()
			return _destroyed == true or GUI._activityStopped == true or taskInfo.Stopped == true or taskInfo.Running ~= true
		end
		taskInfo.Thread = task.spawn(function()
			local ok, result = pcall(callback, stopRequested, taskInfo)
			if ok and type(result) == "function" then taskInfo.Cleanup = result end
			if not ok then warn("[VenturaUI] Task '" .. tostring(name) .. "' failed: " .. tostring(result)) end
			taskInfo.Running = false
		end)
		return taskInfo
	end

	function GUI:Loop(name, seconds, callback, runNow)
		seconds = math.max(0.03, tonumber(seconds) or 1)
		return GUI:Task(name, function(stop, info)
			if runNow == true and not stop() then pcall(callback, info) end
			while not stop() do
				task.wait(seconds)
				if not stop() then pcall(callback, info) end
			end
		end)
	end
	function GUI:Every(seconds, callback, runNow)
		return GUI:Loop("Every_" .. tostring(os.clock()):gsub("%.", "_"), seconds, callback, runNow)
	end
	function GUI:Interval(nameOrSeconds, secondsOrCallback, callbackOrRunNow, runNow)
		if type(nameOrSeconds) == "number" then
			return GUI:Every(nameOrSeconds, secondsOrCallback, callbackOrRunNow)
		end
		return GUI:Loop(nameOrSeconds, secondsOrCallback, callbackOrRunNow, runNow)
	end

	function GUI:StopTask(name)
		local taskInfo = GUI._tasks[tostring(name or "")]
		if not taskInfo then return false end
		GUI:_StopTaskObject(taskInfo)
		GUI._tasks[tostring(name or "")] = nil
		return true
	end

	function GUI:StopAllTasks()
		for name, taskInfo in pairs(GUI._tasks or {}) do
			GUI:_StopTaskObject(taskInfo)
			GUI._tasks[name] = nil
		end
		return true
	end

	function GUI:GetTasks()
		local out = {}
		for name, taskInfo in pairs(GUI._tasks or {}) do
			table.insert(out, {Name = name, Running = taskInfo.Running == true, Started = taskInfo.Started})
		end
		table.sort(out, function(a, b) return tostring(a.Name) < tostring(b.Name) end)
		return out
	end

	function GUI:OnClose(callback)
		return GUI:OnDestroy(callback)
	end
	GUI.AddCleanup = GUI.RegisterCleanup
	GUI.OnCleanup = GUI.RegisterCleanup
	GUI.Track = GUI.TrackInstance

	function GUI:CleanupTracked()
		GUI:StopAllTasks()
		GUI:RestoreTrackedProperties()
		return true
	end
	function GUI:Cleanup()
		return GUI:CleanupTracked()
	end

	function GUI:NewMaid()
		local maid = {Items = {}}
		function maid:Give(item)
			if item ~= nil then table.insert(self.Items, item) end
			return item
		end
		function maid:GiveTask(item) return self:Give(item) end
		function maid:Cleanup()
			for i = #self.Items, 1, -1 do
				local item = self.Items[i]
				self.Items[i] = nil
				pcall(function()
					if type(item) == "function" then item()
					elseif type(item) == "table" and type(item.Stop) == "function" then item:Stop()
					elseif type(item) == "table" and type(item.Destroy) == "function" then item:Destroy()
					elseif typeof(item) == "RBXScriptConnection" then item:Disconnect()
					elseif typeof(item) == "Instance" then item:Destroy()
					end
				end)
			end
			return true
		end
		maid.Destroy = maid.Cleanup
		return maid
	end
	GUI.CreateMaid = GUI.NewMaid
	GUI.Janitor = GUI.NewMaid
	end)() -- status/task utility module
	end)() -- visual/control engine module

	return GUI
end -- Library:new

