			callback = function(v)
				if GUI:GetWatermarkAutoSize() then
					GUI:SetWatermarkAutoSize(false, true)
					pcall(function() if wmAutoSizeToggle then wmAutoSizeToggle:Set(false, true) end end)
				end
				GUI:SetWatermarkSize(v, nil)
			end,
