	local _theme = Library.Themes and Library.Themes[_themeName]
	if type(_theme) == "table" then
		_theme.RealStars = true
		_theme.StarTwinkle = true
		if _themeName == "BlackHole" then _theme.ShootingStars = true end
	end
end

