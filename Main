	function GUI:OnDestroy(callback)
		if type(callback) ~= "function" then return nil end
		table.insert(GUI._destroyCallbacks, callback)
		return function()
			for i, fn in ipairs(GUI._destroyCallbacks) do
				if fn == callback then table.remove(GUI._destroyCallbacks, i); break end
			end
		end
	end
	function GUI:OnReconnect(callback)
		if type(callback) ~= "function" then return nil end
		table.insert(GUI._reconnectCallbacks, callback)
		return function()
			for i, fn in ipairs(GUI._reconnectCallbacks) do
				if fn == callback then table.remove(GUI._reconnectCallbacks, i); break end
			end
		end
	end

	function GUI:Reconnect(reason)
		return _runReconnect(reason or "manual")
	end

	function GUI:SetReconnectOnRespawn(state)
		GUI._reconnectEnabled = state ~= false
		return GUI._reconnectEnabled
	end

	function GUI:GetReconnectOnRespawn()
		return GUI._reconnectEnabled ~= false
	end

	function GUI:SetReconnectDelay(seconds)
		GUI._reconnectDelay = math.clamp(tonumber(seconds) or GUI._reconnectDelay or 0.85, 0, 10)
		return GUI._reconnectDelay
	end

	function GUI:GetReconnectDelay()
		return GUI._reconnectDelay or 0.85
	end

	function GUI:BindToCharacter(callback, runNow)
		local disconnect = GUI:OnReconnect(callback)
		if runNow ~= false and type(callback) == "function" then
			task.defer(function()
				if _destroyed or GUI._activityStopped then return end
				local character = LP.Character
				local humanoid = character and character:FindFirstChildOfClass("Humanoid")
				pcall(callback, character, humanoid, "initial")
			end)
		end
		return disconnect
	end

	function GUI:ScheduleReconnect(reason, delayOverride)
		_scheduleReconnect(reason or "manual", delayOverride)
	end

	function GUI:RegisterCleanup(callback, label)
		if type(callback) ~= "function" then return nil end
		local item = {callback = callback, label = tostring(label or "cleanup"), ran = false}
		table.insert(GUI._cleanupCallbacks, item)
		return function()
			for i, v in ipairs(GUI._cleanupCallbacks) do
				if v == item then table.remove(GUI._cleanupCallbacks, i); break end
			end
		end
	end

	function GUI:TrackProperty(object, property, restoreValue)
		if object == nil or property == nil then return nil end
		local value = restoreValue
		if value == nil then
			local ok, current = pcall(function() return object[property] end)
			if ok then value = current end
		end
		local item = {object = object, property = property, value = value}
		table.insert(GUI._trackedProperties, item)
		return function()
			for i, v in ipairs(GUI._trackedProperties) do
				if v == item then table.remove(GUI._trackedProperties, i); break end
			end
		end
	end

	function GUI:TrackHumanoidProperty(property, restoreValue)
		if property == nil then return nil end
		local function currentHumanoid()
			local character = LP and LP.Character
			return character and character:FindFirstChildOfClass("Humanoid")
		end
		local value = restoreValue
		if value == nil then
			local h = currentHumanoid()
			if h then
				local ok, current = pcall(function() return h[property] end)
				if ok then value = current end
			end
		end
		local item = {property = property, value = value}
		table.insert(GUI._trackedHumanoidProperties, item)
		local cleanup = GUI:RegisterCleanup(function()
			local h = currentHumanoid()
			if h and item.value ~= nil then
				pcall(function() h[property] = item.value end)
			end
		end, "Humanoid." .. tostring(property))
		return function()
			for i, v in ipairs(GUI._trackedHumanoidProperties) do
				if v == item then table.remove(GUI._trackedHumanoidProperties, i); break end
			end
			if cleanup then cleanup() end
		end
	end

	function GUI:TrackInstance(instance, mode)
		if instance == nil then return nil end
		local item = {instance = instance, mode = mode or "destroy"}
		table.insert(GUI._trackedInstances, item)
		return function()
			for i, v in ipairs(GUI._trackedInstances) do
				if v == item then table.remove(GUI._trackedInstances, i); break end
			end
		end
	end

	function GUI:TrackEffect(instance)
		return GUI:TrackInstance(instance, "destroy")
	end

	function GUI:RestoreTrackedProperties()
		_runTrackedPropertyRestores()
		_runTrackedInstanceCleanups()
		_runRegisteredCleanups()
	end

	function GUI:IsDestroyed() return _destroyed == true end
	function GUI:ShouldRun() return not _destroyed and GUI._activityStopped ~= true end
	function GUI:TrackConnection(conn)
		if conn and type(conn.Disconnect) == "function" then track(conn) end
		return conn
	end
	function GUI:StopActivity() _stopAllActivity() end
	function GUI:StopAll() _stopAllActivity() end
	function GUI:IsClosing() return GUI._closing == true or _destroyed == true end
	function GUI:HardClose()
		if _destroyed then return end
		if _runtimeRoot.activeWindow == GUI then
			_runtimeRoot.activeWindow = nil
			_runtimeRoot.activeScreenGui = nil
			_runtimeRoot.activeCharacter = nil
		end
		GUI._closing = true
		GUI._open = false
		_stopAllActivity()
		for _, c in ipairs(_connections) do
			pcall(function()
				if c and type(c.Disconnect) == "function" then c:Disconnect() end
			end)
		end
		_connections = {}
		if _mainTween then pcall(function() _mainTween:Cancel() end); _mainTween = nil end
		if V.minimizeBubble then pcall(function() V.minimizeBubble:Destroy() end); V.minimizeBubble = nil end
		if _ttFrame then pcall(function() _ttFrame.Visible = false end) end
		pcall(function() SG:Destroy() end)
		_destroyed = true
		_runtimeUntrackShutdown(GUI._runtimeShutdown)
	end
	function GUI:Close() GUI:Destroy() end
