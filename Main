		function Tab:Alert(opts)
			opts = validate({title="Notice", text="", icon=Library.Icons.info, kind="info", tooltip=""}, opts)
			local body = tostring(opts.text or "")
			local title = tostring(opts.title or "")
			local widthGuess = math.max(260, (Content.AbsoluteSize.X > 0 and Content.AbsoluteSize.X or 540) - 74)
			local bodyH = body ~= "" and math.max(18, math.ceil(textHeight(body, widthGuess, 12, Enum.Font.SourceSans)) + 4) or 0
			local totalH = math.max(58, 38 + bodyH)
			local Alert = {Title = title, Text = body}
			Alert.frame = base("Alert", totalH)
			pad(Alert.frame, 10, 14, 10, 14)
			addTooltip(Alert.frame, opts.tooltip)
			local col = opts.color or _kindAccent(opts.kind)
			local line = Instance.new("Frame", Alert.frame)
			line.Name = "AlertAccent"
			line.BackgroundColor3 = col
			line.BorderSizePixel = 0
			line.Size = UDim2.new(0, 3, 1, -18)
			line.Position = UDim2.new(0, 0, 0, 9)
			corner(line, 3)
			if not opts.color and tostring(opts.kind):lower() == "accent" then regAccent(line) end
			local ic = lbl(Alert.frame, tostring(opts.icon or ""), 16, col, FONT_UI_BOLD, Enum.TextXAlignment.Center)
			ic.Name = "AlertIcon"
			ic.Size = UDim2.new(0, 24, 0, 24)
			ic.Position = UDim2.new(0, 10, 0, 8)
			local titleLbl = lbl(Alert.frame, title, 13, Library.Theme.TextPrimary, FONT_UI_BOLD)
			titleLbl.Name = "AlertTitle"
			titleLbl.Position = UDim2.new(0, 42, 0, 6)
			titleLbl.Size = UDim2.new(1, -48, 0, 20)
			local bodyLbl = lbl(Alert.frame, body, 12, Library.Theme.TextSecondary, FONT_UI)
			bodyLbl.Name = "AlertText"
			bodyLbl.TextWrapped = true
			bodyLbl.TextTruncate = Enum.TextTruncate.None
			bodyLbl.TextYAlignment = Enum.TextYAlignment.Top
			bodyLbl.Position = UDim2.new(0, 42, 0, 28)
			bodyLbl.Size = UDim2.new(1, -48, 0, math.max(18, bodyH))
			function Alert:Set(text)
				Alert.Text = tostring(text or "")
				bodyLbl.Text = Alert.Text
				return Alert
			end
			function Alert:SetTitle(v)
				Alert.Title = tostring(v or "")
				titleLbl.Text = Alert.Title
				return Alert
			end
			function Alert:Get() return Alert.Text end
			return _universalControl(Alert, opts)
		end
		Tab.Notice = Tab.Alert
		Tab.Banner = Tab.Alert

		function Tab:ToggleButton(opts)
			opts = validate({name="Toggle Button", description="", default=false, icon="", tooltip="", callback=function()end}, opts)
			local hasDesc = tostring(opts.description or "") ~= ""
			local TB = {Value = opts.default == true}
			TB.frame = base("ToggleButton", hasDesc and 64 or 54)
			pad(TB.frame, 0, 12, 0, 12)
			addTooltip(TB.frame, opts.tooltip)
			local button = Instance.new("TextButton", TB.frame)
			button.Name = "ToggleButtonSurface"
			button.AutoButtonColor = false
			button.BackgroundColor3 = TB.Value and Library.Theme.Accent or Library.Theme.Surface
			button.BorderSizePixel = 0
			button.Position = UDim2.new(0, 6, 0, 6)
			button.Size = UDim2.new(1, -12, 1, -12)
			button.Text = ""
			button.ZIndex = 3
			corner(button, 10); stroke(button, TB.Value and Library.Theme.Accent or Library.Theme.Border, 1)
			local x = tostring(opts.icon or "") ~= "" and 46 or 16
			if tostring(opts.icon or "") ~= "" then
				local ic = lbl(button, tostring(opts.icon), 16, TB.Value and Color3.fromRGB(255,255,255) or Library.Theme.Accent, FONT_UI_BOLD, Enum.TextXAlignment.Center)
				ic.Name = "ToggleButtonIcon"
				ic.Size = UDim2.new(0, 30, 1, 0)
				ic.Position = UDim2.new(0, 8, 0, 0)
			end
			local title = lbl(button, tostring(opts.name), 13, TB.Value and Color3.fromRGB(255,255,255) or Library.Theme.TextPrimary, FONT_UI_BOLD)
			title.Name = "ToggleButtonTitle"
			title.Position = UDim2.new(0, x, 0, hasDesc and 8 or 0)
			title.Size = hasDesc and UDim2.new(1, -x - 12, 0, 18) or UDim2.new(1, -x - 12, 1, 0)
			local desc
			if hasDesc then
				desc = lbl(button, tostring(opts.description), 11, TB.Value and Color3.fromRGB(245,245,255) or Library.Theme.TextSecondary, FONT_UI)
				desc.Name = "ToggleButtonDescription"
				desc.Position = UDim2.new(0, x, 0, 29)
				desc.Size = UDim2.new(1, -x - 12, 0, 16)
			end
			local function render()
				local st = button:FindFirstChildOfClass("UIStroke")
				pcall(function()
					button:SetAttribute("VenturaAccent", TB.Value == true)
					button:SetAttribute("VenturaAccentProp", "BackgroundColor3")
					button:SetAttribute("VenturaAccentStroke", TB.Value == true)
				end)
				button.BackgroundColor3 = TB.Value and Library.Theme.Accent or Library.Theme.Surface
				if st then st.Color = TB.Value and Library.Theme.Accent or Library.Theme.Border end
				title.TextColor3 = TB.Value and Color3.fromRGB(255,255,255) or Library.Theme.TextPrimary
				if desc then desc.TextColor3 = TB.Value and Color3.fromRGB(245,245,255) or Library.Theme.TextSecondary end
			end
			function TB:Set(v, silent)
				TB.Value = v == true
				render()
				if not silent then GUI:_invokeCallback(tostring(opts.name or opts.title or "control"), opts.callback, TB.Value) end
				return TB
			end
			function TB:Get() return TB.Value end
			button.MouseButton1Click:Connect(function() if TB.Disabled then return end; TB:Set(not TB.Value) end)
			render()
			return _universalControl(TB, opts)
		end
		Tab.ToggleCard = Tab.ToggleButton

		function Tab:ActionRow(opts)
			opts = validate({buttons={}, height=36, gap=6, tooltip=""}, opts)
			local buttons = type(opts.buttons) == "table" and opts.buttons or {}
			local count = math.max(#buttons, 1)
			local Row = {Buttons = {}}
			Row.frame = Instance.new("Frame", Tab._scroll)
			Row.frame.Name = "ActionRow"
			Row.frame.BackgroundTransparency = 1
			Row.frame.BorderSizePixel = 0
			Row.frame.Size = UDim2.new(1, 0, 0, tonumber(opts.height) or 36)
			addTooltip(Row.frame, opts.tooltip)
			for i, spec in ipairs(buttons) do
				local b = Instance.new("TextButton", Row.frame)
				b.Name = "ActionRowButton"
				b.AutoButtonColor = false
				b.BackgroundColor3 = spec.accent and Library.Theme.Accent or Library.Theme.Surface
				b.BorderSizePixel = 0
				b.Text = (tostring(spec.icon or "") ~= "" and tostring(spec.icon) .. " " or "") .. tostring(spec.name or spec.text or "Action")
				b.TextColor3 = spec.accent and Color3.fromRGB(255,255,255) or Library.Theme.TextPrimary
				b.TextSize = 12
				b.FontFace = FONT_UI_BOLD
				b.Size = UDim2.new(1/count, -((tonumber(opts.gap) or 6) * (count - 1) / count), 1, 0)
				b.Position = UDim2.new((i - 1) / count, (i - 1) * (tonumber(opts.gap) or 6), 0, 0)
				b.ZIndex = 3
				corner(b, 8); stroke(b, spec.accent and Library.Theme.Accent or Library.Theme.Border, 1)
				if spec.accent then regAccent(b, "BackgroundColor3"); local st = b:FindFirstChildOfClass("UIStroke"); if st then regAccent(st, "Color") end end
				b.MouseEnter:Connect(function() tw(b, {BackgroundColor3 = spec.accent and Library.Theme.Accent:Lerp(Color3.fromRGB(255,255,255), 0.10) or Library.Theme.SurfaceHover}) end)
				b.MouseLeave:Connect(function() tw(b, {BackgroundColor3 = spec.accent and Library.Theme.Accent or Library.Theme.Surface}) end)
				b.MouseButton1Click:Connect(function()
					if Row.Disabled or spec.disabled then return end
					if type(spec.callback) == "function" then pcall(spec.callback) end
				end)
				table.insert(Row.Buttons, b)
			end
			function Row:SetDisabled(state)
				Row.Disabled = state == true
				for _, b in ipairs(Row.Buttons) do b.TextTransparency = Row.Disabled and 0.45 or 0 end
				return Row
			end
			function Row:GetFrame() return Row.frame end
			return _universalControl(Row, opts)
		end
		Tab.ButtonRow = Tab.ActionRow
		Tab.Actions = Tab.ActionRow

		function Tab:CodeBlock(opts)
			opts = validate({code="-- code", title="", copy=true, tooltip=""}, opts)
			local code = tostring(opts.code or "")
			local lines = 1
			for _ in code:gmatch("\n") do lines = lines + 1 end
			local height = math.clamp((opts.title ~= "" and 34 or 14) + lines * 17 + 18, 62, tonumber(opts.maxHeight) or 220)
			local Code = {Value = code}
			Code.frame = base("CodeBlock", height)
			pad(Code.frame, 10, 12, 10, 12)
			addTooltip(Code.frame, opts.tooltip)
			local y = 0
			if tostring(opts.title or "") ~= "" then
				local title = lbl(Code.frame, tostring(opts.title), 12, Library.Theme.TextPrimary, FONT_UI_BOLD)
				title.Name = "CodeBlockTitle"
				title.Size = UDim2.new(1, opts.copy and -70 or 0, 0, 18)
				y = 24
			end
			if opts.copy then
				local copy = Instance.new("TextButton", Code.frame)
				copy.Name = "CodeCopyButton"
				copy.AutoButtonColor = false
				copy.BackgroundColor3 = Library.Theme.Accent
				copy.BorderSizePixel = 0
				copy.AnchorPoint = Vector2.new(1,0)
				copy.Position = UDim2.new(1, 0, 0, 0)
				copy.Size = UDim2.new(0, 58, 0, 22)
				copy.Text = "Copy"
				copy.TextSize = 11
				copy.FontFace = FONT_UI_BOLD
				copy.TextColor3 = Color3.fromRGB(255,255,255)
				copy.ZIndex = 4
				corner(copy, 7); regAccent(copy, "BackgroundColor3")
				copy.MouseButton1Click:Connect(function()
					if type(setclipboard) == "function" then pcall(function() setclipboard(Code.Value) end) end
					pcall(function() GUI:Notify("Copied", "Code block copied.", 2, "success") end)
				end)
			end
			local box = Instance.new("ScrollingFrame", Code.frame)
			box.Name = "CodeScroll"
			box.BackgroundColor3 = Library.Theme.Background
			box.BorderSizePixel = 0
			box.Position = UDim2.new(0, 0, 0, y)
			box.Size = UDim2.new(1, 0, 1, -y)
			box.ScrollBarThickness = 3
			box.CanvasSize = UDim2.new(0, 0, 0, math.max(20, lines * 17 + 10))
			box.ZIndex = 3
			corner(box, 8); stroke(box, Library.Theme.Border, 1)
			local txt = lbl(box, Code.Value, 11, Library.Theme.TextSecondary, FONT_MONO, Enum.TextXAlignment.Left)
			txt.Name = "CodeText"
			txt.TextYAlignment = Enum.TextYAlignment.Top
			txt.TextWrapped = false
			txt.TextTruncate = Enum.TextTruncate.None
			txt.Position = UDim2.new(0, 10, 0, 6)
			txt.Size = UDim2.new(1, -20, 0, math.max(20, lines * 17))
			function Code:Set(v)
				Code.Value = tostring(v or "")
				txt.Text = Code.Value
				return Code
			end
			function Code:Get() return Code.Value end
			return _universalControl(Code, opts)
		end

		function Tab:SearchBox(opts)
			opts = validate({name="Search", placeholder="Search...", default="", tooltip="", callback=function()end, submitCallback=nil}, opts)
			local SB = {Value = tostring(opts.default or "")}
			SB.frame = base("SearchBox", 54)
			pad(SB.frame, 0, 12, 0, 12)
			addTooltip(SB.frame, opts.tooltip)
			local box = Instance.new("TextBox", SB.frame)
			box.Name = "SearchBoxInput"
			box.BackgroundColor3 = Library.Theme.Background
			box.BorderSizePixel = 0
			box.ClearTextOnFocus = false
			box.PlaceholderText = tostring(opts.placeholder or "Search...")
			box.PlaceholderColor3 = Library.Theme.TextDisabled
			box.Text = SB.Value
			box.TextColor3 = Library.Theme.TextPrimary
			box.TextSize = 12
			box.FontFace = FONT_UI
			box.TextXAlignment = Enum.TextXAlignment.Left
			box.Position = UDim2.new(0, 8, 0.5, -16)
			box.Size = UDim2.new(1, -16, 0, 32)
			box.ZIndex = 3
			corner(box, 9); stroke(box, Library.Theme.Border, 1)
			pad(box, 0, 10, 0, 10)
			box:GetPropertyChangedSignal("Text"):Connect(function()
				SB.Value = box.Text
				GUI:_invokeCallback(tostring(opts.name or opts.title or "control"), opts.callback, SB.Value)
			end)
			box.FocusLost:Connect(function(enterPressed)
				if enterPressed and type(opts.submitCallback) == "function" then pcall(opts.submitCallback, SB.Value) end
			end)
			function SB:Set(v, silent)
				SB.Value = tostring(v or "")
				box.Text = SB.Value
				if not silent then GUI:_invokeCallback(tostring(opts.name or opts.title or "control"), opts.callback, SB.Value) end
				return SB
			end
			function SB:Get() return SB.Value end
			function SB:Focus() box:CaptureFocus(); return SB end
			function SB:Clear() return SB:Set("") end
			return _universalControl(SB, opts)
		end

		function Tab:MultiDropdown(opts)
			opts = opts or {}
			opts.multi = true
			return Tab:Dropdown(opts)
		end
		Tab.MultiSelect = Tab.MultiDropdown
		Tab.MultiSelectDropdown = Tab.MultiDropdown

		-- v5.69 usability aliases. These use the existing safe CollapsibleSection/Groupbox internals.
		function Tab:ControlGroup(opts) return Tab:CollapsibleSection(opts) end
		function Tab:CollapsibleGroup(opts) return Tab:CollapsibleSection(opts) end
		function Tab:Group(opts) return Tab:CollapsibleSection(opts) end
		function Tab:CardGroup(opts) return Tab:Groupbox(opts) end
		Tab.GroupBox = Tab.Groupbox
		Tab.Folder = Tab.CollapsibleSection


		-- ══════════════════════════════════════════════════════════════════════
		-- v5.78 Function Support Pack — safer control APIs
		-- Adds richer dropdown/button/toggle/status-card methods without touching
		-- config save/load behavior or replacing the original controls.
		-- ══════════════════════════════════════════════════════════════════════
		do
			local _oldDropdown = Tab.Dropdown
			function Tab:Dropdown(opts)
				opts = opts or {}
				local dd = _oldDropdown(self, opts)
				if type(dd) == "table" then
					local function copyOptions()
						local out = {}
						local items = (type(dd.GetItems) == "function" and dd:GetItems()) or opts.items or {}
						for _, item in ipairs(items) do table.insert(out, item) end
						return out
					end
					function dd:GetOptions()
						return copyOptions()
					end
					function dd:Refresh(list, keepSelection)
						if list ~= nil and type(self.SetItems) == "function" then
							local previous = type(self.Get) == "function" and self:Get() or nil
							self:SetItems(type(list) == "table" and list or {})
							if keepSelection ~= false and previous ~= nil and type(self.Set) == "function" then
								pcall(function() self:Set(previous, true) end)
							end
						elseif type(self.SetItems) == "function" then
							self:SetItems(copyOptions())
						end
						return self
					end
					function dd:AddOption(option, selectIt)
						local items, exists = copyOptions(), false
						for _, item in ipairs(items) do if item == option then exists = true break end end
						if not exists then table.insert(items, option) end
						self:Refresh(items, true)
						if selectIt == true and type(self.Set) == "function" then self:Set(option) end
						return self
					end
					function dd:RemoveOption(option)
						local items = copyOptions()
						for i = #items, 1, -1 do if items[i] == option then table.remove(items, i) end end
						self:Refresh(items, true)
						local current = type(self.Get) == "function" and self:Get() or nil
						if current == option and type(self.Set) == "function" then self:Set(nil) end
						return self
					end
					function dd:Clear(clearSelection)
						if type(self.SetItems) == "function" then self:SetItems({}) end
						if clearSelection ~= false and type(self.Set) == "function" then self:Set(opts.multi and {} or nil, true) end
						return self
					end
					function dd:SetPlaceholder(text)
						opts.placeholder = tostring(text or "Select...")
						if type(self.Set) == "function" then pcall(function() self:Set(self:Get(), true) end) end
						return self
					end
					function dd:GetPlaceholder()
						return tostring(opts.placeholder or "Select...")
					end
					function dd:SetDisabled(state)
						self.Disabled = state == true
						if self.frame then
							self.frame.Active = not self.Disabled
							pcall(function() tw(self.frame, {BackgroundTransparency = self.Disabled and 0.35 or 0}, TI_FAST) end)
						end
						return self
					end
					function dd:Close()
						self.Open = false
						if self.frame then
							local panel = self.frame:FindFirstChild("DropdownList", true)
							if panel then panel.Visible = false end
							local closedH = tostring(opts.description or "") ~= "" and 64 or 54
							self.frame.Size = UDim2.new(1, 0, 0, closedH)
						end
						return self
					end
				end
				return dd
			end

			local _oldSearchDropdown = Tab.SearchDropdown
			if type(_oldSearchDropdown) == "function" then
				function Tab:SearchDropdown(opts)
					opts = opts or {}
					local dd = _oldSearchDropdown(self, opts)
					if type(dd) == "table" then
						local function copyOptions()
							local out = {}
							local items = (type(dd.GetItems) == "function" and dd:GetItems()) or opts.items or {}
							for _, item in ipairs(items) do table.insert(out, item) end
							return out
						end
						function dd:GetOptions() return copyOptions() end
						function dd:Refresh(list, keepSelection)
							if list ~= nil and type(self.SetItems) == "function" then
								local previous = type(self.Get) == "function" and self:Get() or nil
								self:SetItems(type(list) == "table" and list or {})
								if keepSelection ~= false and previous ~= nil and type(self.Set) == "function" then pcall(function() self:Set(previous, true) end) end
							elseif type(self.SetItems) == "function" then
								self:SetItems(copyOptions())
							end
							return self
						end
						function dd:AddOption(option, selectIt)
							local items, exists = copyOptions(), false
							for _, item in ipairs(items) do if item == option then exists = true break end end
							if not exists then table.insert(items, option) end
							self:Refresh(items, true)
							if selectIt == true and type(self.Set) == "function" then self:Set(option) end
							return self
						end
						function dd:RemoveOption(option)
							local items = copyOptions()
							for i = #items, 1, -1 do if items[i] == option then table.remove(items, i) end end
							self:Refresh(items, true)
							return self
						end
						function dd:Clear(clearSelection)
							if type(self.SetItems) == "function" then self:SetItems({}) end
							if clearSelection ~= false and type(self.Set) == "function" then self:Set(opts.multi and {} or nil, true) end
							return self
						end
						function dd:SetPlaceholder(text)
							opts.placeholder = tostring(text or "Select...")
							if type(self.Set) == "function" then pcall(function() self:Set(self:Get(), true) end) end
							return self
						end
						function dd:SetDisabled(state)
							self.Disabled = state == true
							if self.frame then self.frame.Active = not self.Disabled end
							return self
						end
					end
					return dd
				end
			end

			local _oldButton = Tab.Button
			function Tab:Button(opts)
				opts = opts or {}
				local btn = _oldButton(self, opts)
				if type(btn) == "table" then
					local oldSetDisabled = btn.SetDisabled
					if type(oldSetDisabled) == "function" then
						function btn:SetDisabled(state)
							oldSetDisabled(self, state)
							return self
						end
					end
					function btn:SetIcon(icon)
						opts.icon = tostring(icon or "")
						local label = self.frame and self.frame:FindFirstChild("ButtonIconText", true)
						if label and label:IsA("TextLabel") then label.Text = opts.icon end
						return self
					end
					function btn:SetLoading(state, loadingText)
						self._loading = state == true
						if self._loading then
							self._preLoadingName = self._preLoadingName or (type(self.GetName) == "function" and self:GetName()) or tostring(opts.name or "Button")
							if type(self.SetText) == "function" then self:SetText(tostring(loadingText or "Loading...")) end
							if type(self.SetDisabled) == "function" then self:SetDisabled(true) end
						else
							if self._preLoadingName and type(self.SetText) == "function" then self:SetText(self._preLoadingName) end
							self._preLoadingName = nil
							if type(self.SetDisabled) == "function" then self:SetDisabled(false) end
						end
						return self
					end
					function btn:IsLoading() return self._loading == true end
					function btn:SetDescriptionText(text)
						if type(self.SetDescription) == "function" then return self:SetDescription(text) end
						return self
					end
				end
				return btn
			end

			local _oldToggle = Tab.Toggle
			function Tab:Toggle(opts)
				opts = opts or {}
				local toggle = _oldToggle(self, opts)
				if type(toggle) == "table" then
					function toggle:Toggle(silent)
						local nextValue = not (type(self.Get) == "function" and self:Get() == true)
						return self:Set(nextValue, silent)
					end
					function toggle:IsOn() return type(self.Get) == "function" and self:Get() == true end
					function toggle:IsToggled() return self:IsOn() end
					function toggle:GetState() return self:IsOn() end
					function toggle:SetText(text)
						if type(self.SetName) == "function" then return self:SetName(text) end
						return self
					end
					function toggle:SetDisabled(state)
						self.Disabled = state == true
						if self.frame then
							self.frame.Active = not self.Disabled
							pcall(function() tw(self.frame, {BackgroundTransparency = self.Disabled and 0.35 or 0}, TI_FAST) end)
						end
						return self
					end
				end
				return toggle
			end

			local _oldStatusCard = Tab.StatusCard
			if type(_oldStatusCard) == "function" then
				function Tab:StatusCard(opts)
					opts = opts or {}
					local card = _oldStatusCard(self, opts)
					if type(card) == "table" then
						local key = opts.key or opts.id or opts.statusId or opts.statusKey
						if key ~= nil and type(GUI.RegisterStatusCard) == "function" then
							GUI:RegisterStatusCard(key, card)
							if opts.value ~= nil then GUI:SetStatus(key, opts.value, opts.kind, opts.status) end
						end
						function card:SetKey(newKey)
							if type(GUI.RegisterStatusCard) == "function" then GUI:RegisterStatusCard(newKey, self) end
							return self
						end
					end
					return card
				end
				Tab.Status = Tab.StatusCard
				Tab.StatusValue = Tab.StatusCard
				Tab.StatusRow = Tab.StatusCard
			end
		end


		function Tab:BuildLazy(builder)
			if type(builder) ~= "function" then return Tab end
			if not Tab._lazy or Tab.Active or Tab._lazyBuilt then
				GUI:_invokeCallback("lazy-tab:" .. tostring(Tab._name), builder, Tab)
			else
				table.insert(Tab._lazyBuilders, builder)
			end
			return Tab
		end

		function Tab:_BuildLazy()
			if Tab._lazyBuilt then return Tab end
			Tab._lazyBuilt = true
			local builders = Tab._lazyBuilders
			Tab._lazyBuilders = {}
			for _, builder in ipairs(builders) do
				GUI:_invokeCallback("lazy-tab:" .. tostring(Tab._name), builder, Tab)
				if _safeLoadState.enabled then _safeLoadYield("Building " .. tostring(Tab._name), false) end
			end
			return Tab
		end

		function Tab:IsLazyBuilt()
			return Tab._lazyBuilt == true
		end

		if isFirst then Tab:_BuildLazy() end
		return Tab
	end -- GUI:CreateTab


	function GUI:GetNormalizedPosition()
		local camera = workspace.CurrentCamera
		local viewport = camera and camera.ViewportSize or Vector2.new(1280, 720)
		local absolute = MainWrap and MainWrap.AbsolutePosition or Vector2.new(viewport.X * 0.5, viewport.Y * 0.5)
		return Vector2.new(
			math.clamp(absolute.X / math.max(viewport.X, 1), -2, 3),
			math.clamp(absolute.Y / math.max(viewport.Y, 1), -2, 3)
		)
	end

	function GUI:SetNormalizedPosition(x, y)
		local camera = workspace.CurrentCamera
		local viewport = camera and camera.ViewportSize or Vector2.new(1280, 720)
		x, y = tonumber(x) or 0.5, tonumber(y) or 0.5
		local position = UDim2.new(0, math.floor(viewport.X * x + 0.5), 0, math.floor(viewport.Y * y + 0.5))
		MainWrap.Position = position
		_runtimeRoot.windowPosition = position
		return position
	end



	function GUI:GetReexecutePolicy()
		return {
			reuseExisting = options.reuseExisting ~= false,
			mode = tostring(options.reuseExistingMode or "respawn"):lower(),
			replaceExistingOnExecute = options.replaceExistingOnExecute ~= false,
			forceRebuild = options.forceRebuild == true,
			respawnReuseWindow = tonumber(options.respawnReuseWindow) or 6,
			lastBuilderAction = tostring(_runtimeRoot.lastBuilderAction or "none"),
			respawnReuseCredits = tonumber(_runtimeRoot.respawnReuseCredits) or 0,
			respawnGuardUntil = tonumber(_runtimeRoot.respawnGuardUntil) or 0,
		}
	end

	function GUI:GetLastBuilderAction()
		return tostring(_runtimeRoot.lastBuilderAction or "none")
	end


	-- Register-safe module boundary: config, theme, and settings engine.
	;(function()
	-- ══════════════════════════════════════════════════════════════════════
	-- Config save / load
	-- ══════════════════════════════════════════════════════════════════════
	-- v5.83: put all config/profile files inside a new root folder named VenturaUi-V2.
	-- This creates a completely separate config root instead of VenturaUI/V2.
	V._cfgRootFolder = "VenturaUi-V2"
	V._cfgVersionFolder = ""
	V._cfgFolder = V._cfgRootFolder
	V._cfgBaseName = options.name:gsub("[^%w%-%_]", "_")
	V._cfgProfileFolder = V._cfgFolder .. "/" .. V._cfgBaseName
	V._cfgProfileIndexFile = V._cfgProfileFolder .. "/profiles.index"
	V._cfgAutoLoadFile = V._cfgProfileFolder .. "/autoload.profile"
	V._cfgAutoLoadEnabledFile = V._cfgProfileFolder .. "/autoload.enabled"
	V._cfgProfileDeletedFile = V._cfgProfileFolder .. "/profiles.deleted"

	local function _profileSanitize(name)
		name = _trim(name or "")
		if name == "" then name = "Default" end
		return name
	end

	local function _profileFileName(name)
		local safe = _profileSanitize(name):gsub("[^%w%-%_%.]", "_")
		if safe == "" then safe = "Default" end
		return safe .. ".json"
	end

	V._cfgProfile = _profileSanitize(options.profile or options.configProfile or "Default")
	V._explicitProfileProvided = _explicitProfileOverride == true
	V._cfgFile = V._cfgProfileFolder .. "/" .. _profileFileName(V._cfgProfile)
	V._autoLoadEnabled = (options.autoLoad ~= false and options.autoLoadConfig ~= false and options.configAutoLoad ~= false)

	local function _setConfigProfileInternal(name)
		V._cfgProfile = _profileSanitize(name)
		V._cfgFile = V._cfgProfileFolder .. "/" .. _profileFileName(V._cfgProfile)
		return V._cfgProfile
	end

	local function _ensureConfigFolders()
		if not hasFileAPI() then return false end
		ensureFolder(V._cfgRootFolder)
		if V._cfgFolder ~= V._cfgRootFolder then
			ensureFolder(V._cfgFolder)
		end
		ensureFolder(V._cfgProfileFolder)
		return true
	end

	local function _readPlainFile(path)
		if not hasFileAPI() then return nil end
		local okExists, exists = pcall(isfile, path)
		if not okExists or not exists then return nil end
		local ok, raw = pcall(readfile, path)
		if not ok or raw == nil then return nil end
		return tostring(raw)
	end

	local function _writePlainFile(path, value)
		if not hasFileAPI() then return false end
		_ensureConfigFolders()
		local ok, err = pcall(function() writefile(path, tostring(value or "")) end)
		if not ok then warn("[VenturaUI] Config meta save failed: " .. tostring(err)) end
		return ok
	end


	local function _readDeletedProfiles()
		local deleted = {}
		local raw = _readPlainFile(V._cfgProfileDeletedFile)
		if raw and raw ~= "" then
			for line in (raw .. "\n"):gmatch("([^\n]*)\n") do
				local name = _profileSanitize(_cfgUnesc(_trim(line)))
				if name ~= "" and name:lower() ~= "default" then
					deleted[name:lower()] = name
				end
			end
		end
		return deleted
	end

	local function _writeDeletedProfiles(deleted)
		if not hasFileAPI() then return false end
		local lines = {}
		local seen = {}
		for _, name in pairs(deleted or {}) do
			name = _profileSanitize(name)
			local key = name:lower()
			if name ~= "" and key ~= "default" and not seen[key] then
				seen[key] = true
				table.insert(lines, _cfgEsc(name))
			end
		end
		table.sort(lines, function(a, b) return a:lower() < b:lower() end)
		return _writePlainFile(V._cfgProfileDeletedFile, table.concat(lines, "\n"))
	end

	local function _isProfileDeleted(name)
		name = _profileSanitize(name)
		if name:lower() == "default" then return false end
		return _readDeletedProfiles()[name:lower()] ~= nil
	end

	local function _markProfileDeleted(name)
		name = _profileSanitize(name)
		if name:lower() == "default" then return false end
		local deleted = _readDeletedProfiles()
		deleted[name:lower()] = name
		return _writeDeletedProfiles(deleted)
	end

	local function _unmarkProfileDeleted(name)
		name = _profileSanitize(name)
		if name:lower() == "default" then return true end
		local deleted = _readDeletedProfiles()
		deleted[name:lower()] = nil
		return _writeDeletedProfiles(deleted)
	end

	local function _readAutoLoadEnabled()
		local raw = _readPlainFile(V._cfgAutoLoadEnabledFile)
		if raw == nil or raw == "" then return V._autoLoadEnabled end
		raw = _trim(raw):lower()
		return raw == "true" or raw == "1" or raw == "yes" or raw == "on"
	end

	local function _writeAutoLoadEnabled(enabled)
		V._autoLoadEnabled = enabled == true
		return _writePlainFile(V._cfgAutoLoadEnabledFile, V._autoLoadEnabled and "true" or "false")
	end

	local function _readAutoLoadProfile()
		if not _readAutoLoadEnabled() then return nil end
		local raw = _readPlainFile(V._cfgAutoLoadFile)
		if raw == nil or raw == "" then return nil end
		return _profileSanitize(_cfgUnesc(_trim(raw)))
	end

	local function _writeAutoLoadProfile(profile)
		if not V._autoLoadEnabled then return false end
		return _writePlainFile(V._cfgAutoLoadFile, _cfgEsc(_profileSanitize(profile or V._cfgProfile)))
	end

	local function _uniqueSortedProfiles(list)
		local deleted = _readDeletedProfiles()
		local seen, out = {}, {}
		local function add(name)
			name = _profileSanitize(name)
			local key = name:lower()
			if key ~= "default" and deleted[key] then return end
			if not seen[key] then seen[key] = true; table.insert(out, name) end
		end
		add("Default")
		add(V._cfgProfile)
		for _, name in ipairs(list or {}) do add(name) end
		table.sort(out, function(a,b) return a:lower() < b:lower() end)
		return out
	end

	local function _readProfileIndex()
		local profiles = {"Default", V._cfgProfile}
		if hasFileAPI() then
			local okExists, exists = pcall(isfile, V._cfgProfileIndexFile)
			if okExists and exists then
				local ok, raw = pcall(readfile, V._cfgProfileIndexFile)
				if ok and raw then
					for line in (raw .. "\n"):gmatch("([^\n]*)\n") do
						line = _cfgUnesc(_trim(line))
						if line ~= "" then table.insert(profiles, line) end
					end
				end
			end
			-- Some executors support listfiles; use it when available but never require it.
			if type(listfiles) == "function" then
				pcall(function()
					for _, file in ipairs(listfiles(V._cfgProfileFolder)) do
						local normalized = tostring(file):gsub("\\", "/")
						local base = normalized:match("([^/]+)%.json$")
						if base and base ~= "" then table.insert(profiles, base) end
					end
				end)
			end
		end
		return _uniqueSortedProfiles(profiles)
	end

	local function _writeProfileIndex(list)
		if not hasFileAPI() then return false end
		_ensureConfigFolders()
		local profiles = _uniqueSortedProfiles(list or {})
		local lines = {}
		for _, name in ipairs(profiles) do table.insert(lines, _cfgEsc(name)) end
		local ok, err = pcall(function() writefile(V._cfgProfileIndexFile, table.concat(lines, "\n")) end)
		if not ok then warn("[VenturaUI] Profile index save failed: " .. tostring(err)) end
		return ok
	end

	local function _addProfileToIndex(name)
		name = _profileSanitize(name)
		_unmarkProfileDeleted(name)
		local profiles = _readProfileIndex()
		table.insert(profiles, name)
		_writeProfileIndex(profiles)
		return _uniqueSortedProfiles(profiles)
	end

	-- Auto-load the last selected/saved profile on startup unless the script explicitly picked one.
	V._autoLoadEnabled = _readAutoLoadEnabled()
	if V._autoLoadEnabled and not V._explicitProfileProvided then
		local autoProfile = _readAutoLoadProfile()
		if autoProfile then
			_setConfigProfileInternal(autoProfile)
		end
	end


	

	local function _activeThemeData()
		return (Library.Themes and Library.Themes[GUI._savedTheme or tostring(options.theme or "Dark")]) or nil
	end

	local function _themeTransparency(key, fallback)
		local theme = _activeThemeData()
		local pack = type(theme) == "table" and theme.Transparency or nil
		local value
		if type(pack) == "table" then
			value = pack[key]
			if value == nil and key == "Surface" then value = pack.Card end
			if value == nil and key == "Background" then value = pack.Input end
			if value == nil then value = pack.Default end
		end
		if value == nil then value = fallback end
		return math.clamp(tonumber(value) or tonumber(fallback) or 0, 0, 0.95)
	end

	local function _themeTransparencyForRole(role, name)
		role = tostring(role or "")
		name = tostring(name or "")
		if name == "Main" or role == "Main" then return _themeTransparency("Main", 0) end
		if role == "Nav" then return _themeTransparency("Nav", 0) end
		if role == "Topbar" then return _themeTransparency("Topbar", 0) end
		if role == "UserBox" then return _themeTransparency("UserBox", 0) end
		if role == "Background" then return _themeTransparency("Background", 0) end
		if role == "Surface" then return _themeTransparency("Surface", 0) end
		return nil
	end

	local function _isAccentSurfaceName(name)
		name = tostring(name or "")
		local lower = name:lower()
		return name:find("Accent", 1, true)
			or name:find("Divider", 1, true)
			or name:find("Separator", 1, true)
			or lower:find("underline", 1, true) ~= nil
			or lower:find("highlight", 1, true) ~= nil
			or lower:find("selected", 1, true) ~= nil
			or lower:find("active", 1, true) ~= nil
			or lower:find("line", 1, true) ~= nil
			or name == "SliderFill"
			or name == "SliderThumbGlow"
			or name == "SliderThumbCore"
			or name == "TopAccentSheen"
			or name == "OuterAccentRing"
			or name == "WatermarkAccent"
			or name == "MiniAccent"
			or name == "StatusDot"
	end

	local function _applyBackgroundTransparency(obj, role, name)
		if not obj or not obj:IsA("GuiObject") then return end
		if obj:GetAttribute("VenturaNoTransparency") == true then return end
		name = tostring(name or obj.Name or "")
		if _isAccentSurfaceName(name) then return end
		if name == "TogglePill" and obj:GetAttribute("VenturaOn") == true then return end
		local target = _themeTransparencyForRole(role, name)
		if target ~= nil and obj.BackgroundTransparency < 0.96 then
			obj.BackgroundTransparency = target
		end
	end

	local function _themeColor(role, fallback)
		role = tostring(role or "")
		if role == "Accent" then return Library.Theme.Accent or fallback end
		return Library.Theme[role] or fallback or Library.Theme.TextPrimary or Color3.fromRGB(235, 235, 235)
	end

	local function _applyRole(obj, role, prop)
		if not obj or not obj.Parent then return false end
		local color = _themeColor(role, nil)
		if typeof(color) ~= "Color3" then return false end
		prop = prop or (obj:IsA("UIStroke") and "Color") or ((obj:IsA("TextLabel") or obj:IsA("TextBox") or obj:IsA("TextButton")) and "TextColor3") or ((obj:IsA("ImageLabel") or obj:IsA("ImageButton")) and "ImageColor3") or "BackgroundColor3"
		pcall(function() obj[prop] = color end)
		if prop == "BackgroundColor3" and obj:IsA("GuiObject") then
			_applyBackgroundTransparency(obj, role, obj.Name)
		end
		return true
	end

	function GUI:_FireThemeListeners(themeName)
		for i = #GUI._themeListeners, 1, -1 do
			local cb = GUI._themeListeners[i]
			if type(cb) == "function" then
				pcall(cb, themeName or GUI:GetTheme(), Library.Theme)
			else
				table.remove(GUI._themeListeners, i)
			end
		end
	end

	function GUI:_RefreshThemeVisuals()
		if not SG or not SG.Parent then return false end
		local accent = Library.Theme.Accent or Color3.fromRGB(115, 185, 255)
		local surface = Library.Theme.Surface or Color3.fromRGB(28, 28, 34)
		local background = Library.Theme.Background or Color3.fromRGB(18, 18, 22)
		local nav = Library.Theme.Nav or background
		local topbar = Library.Theme.Topbar or background
		local border = Library.Theme.Border or Color3.fromRGB(50, 50, 60)
		local textPrimary = Library.Theme.TextPrimary or Color3.fromRGB(235, 235, 245)
		local textSecondary = Library.Theme.TextSecondary or Color3.fromRGB(145, 145, 165)
		local textDisabled = Library.Theme.TextDisabled or Color3.fromRGB(85, 85, 100)

		-- v5.48 full theme-sync sweep. This table covers built-in controls plus
		-- the expanded v5.45-v5.47 components so theme/color changes don't leave
		-- old surfaces behind.
		local roleByName = {
			Main = "Background", Content = "Background", Loader = "Background", LoaderPanel = "Surface",
			Nav = "Nav", Sidebar = "Nav", Topbar = "Topbar", SearchBar = "Surface", UserBox = "UserBox",
			FloatingMiniHUD = "Surface", Watermark = "Topbar", ThemeDesignOverlay = "Background",

			Button = "Surface", ButtonGrid = "Surface", ButtonGridButton = "Surface", ButtonIconBox = "Background", ButtonArrowBox = "Background",
			Toggle = "Surface", Slider = "Surface", Dropdown = "Surface", SearchDropdown = "Surface",
			Paragraph = "Surface", ProgressBar = "Surface", ColorPicker = "Surface", Keybind = "Surface", TextInput = "Surface",
			Groupbox = "Surface", CollapsibleSection = "Surface", StatusCard = "Surface", LogConsole = "Surface",
			MiniStat = "Surface", CopyButton = "Surface", Stepper = "Surface", Segmented = "Surface", KeyValue = "Surface",
			Alert = "Surface", Notice = "Surface", Banner = "Surface", ToggleButton = "Surface", ToggleCard = "Surface",
			ActionRow = "Surface", ButtonRow = "Surface", Actions = "Surface", CodeBlock = "Surface", SearchBox = "Surface",
			Property = "Surface", PropertyRow = "Surface", Stat = "Surface", StatCard = "Surface", MultiDropdown = "Surface",
			MultiSelect = "Surface", MultiSelectDropdown = "Surface", Spacer = "Surface",

			InputBox = "Background", KeybindBox = "Background", DropdownSearchBox = "Background", DropdownValue = "Background", SearchValue = "Background",
			DropdownList = "Background", SearchDropdownList = "Background", SliderTrack = "Background", SliderValuePill = "Background",
			SliderThumbCore = "Background", TogglePill = "Background", DDHeader = "Background", ResizeHandle = "Background",
			ThemePreview = "Background", AccentPreviewBox = "Background", LogScroll = "Background", StepperBox = "Background",
			SegmentedHolder = "Background", KeyValuePill = "Background", CodeScroll = "Background", SearchBoxInput = "Background",
			Option = "Surface", DropdownOption = "Surface", SearchOption = "Surface", SegmentOption = "Surface", Row = "Surface",
		}
		local textRoleByName = {
			Title = "TextPrimary", Subtitle = "TextSecondary", SearchText = "TextSecondary", UserName = "TextPrimary", UserSub = "TextSecondary",
			ControlTitle = "TextPrimary", ButtonTitle = "TextPrimary", ButtonGridText = "TextPrimary", ButtonIconText = "TextPrimary", ParagraphTitle = "TextPrimary", SliderValueText = "TextPrimary", TextBox = "TextPrimary",
			ControlDescription = "TextSecondary", ButtonDescription = "TextSecondary", ParagraphBody = "TextSecondary", MiniTitle = "TextSecondary",
			StateText = "TextSecondary", KeybindLabel = "TextSecondary", DropdownValueText = "TextPrimary", Placeholder = "TextDisabled",
			TooltipText = "TextPrimary", VersionLabel = "TextSecondary", SectionTitle = "TextPrimary", SectionSubtitle = "TextSecondary",
			NavText = "TextSecondary", NavIcon = "TextSecondary", TabText = "TextSecondary", TabIcon = "TextSecondary",
			DropdownValue = "TextPrimary", SearchValue = "TextPrimary", DropdownSearchBox = "TextPrimary", InputBox = "TextPrimary",
			MiniFPS = "TextPrimary", MiniPing = "TextPrimary", WatermarkText = "TextPrimary", LabelText = "TextPrimary",
			StepperMinus = "TextSecondary", StepperPlus = "Accent", StepperValue = "TextPrimary", SegmentOption = "TextPrimary", SegmentText = "TextPrimary",
			MiniStatIcon = "Accent", KeyValueIcon = "Accent", KeyValueLabel = "TextSecondary", KeyValueValue = "TextPrimary",
			AlertTitle = "TextPrimary", AlertText = "TextSecondary", AlertIcon = "Accent", NoticeTitle = "TextPrimary", NoticeText = "TextSecondary",
			BannerTitle = "TextPrimary", BannerText = "TextSecondary", ToggleButtonTitle = "TextPrimary", ToggleButtonDescription = "TextSecondary",
			CodeBlockTitle = "TextPrimary", CodeText = "TextSecondary", SearchBoxInput = "TextPrimary",
			PropertyLabel = "TextSecondary", PropertyValue = "TextPrimary", StatTitle = "TextSecondary", StatValue = "TextPrimary",
		}

		local function _lowerName(obj, name)
			return tostring(name or (obj and obj.Name) or ""):lower()
		end
		local function _hasAny(lower, list)
			for _, part in ipairs(list) do
				if lower:find(part, 1, true) then return true end
			end
			return false
		end
		local function _isInternalVisual(name)
			return name == "SpaceStarBackground" or name == "Star" or name == "ThemeDesignOverlay"
		end
		local function _inferGuiRole(obj, name)
			if not obj then return nil end
			local explicit = obj:GetAttribute("VenturaThemeRole")
			if explicit then return tostring(explicit), obj:GetAttribute("VenturaThemeProp"), true end
			if roleByName[name] then return roleByName[name], nil, false end
			local lower = _lowerName(obj, name)
			if _isInternalVisual(name) then return nil end
			if _hasAny(lower, {"nav", "sidebar", "sidepanel"}) then return "Nav" end
			if _hasAny(lower, {"topbar", "titlebar", "headerbar"}) then return "Topbar" end
			if _hasAny(lower, {"main", "content", "background", "backdrop", "canvas"}) then return "Background" end
			if _hasAny(lower, {"input", "textbox", "search", "value", "track", "scroll", "list", "holder", "container", "pill", "box", "preview"}) then return "Background" end
			if _hasAny(lower, {"button", "toggle", "slider", "dropdown", "paragraph", "card", "stat", "section", "group", "panel", "row", "option", "item", "alert", "notice", "banner", "code", "property", "multi", "stepper", "segmented", "console"}) then return "Surface" end
			return nil
		end
		local function _inferTextRole(obj, name)
			name = tostring(name or obj.Name or "")
			local lower = name:lower()
			local explicitTextRole = obj:GetAttribute("VenturaTextRole")
			if explicitTextRole then return tostring(explicitTextRole) end
			if textRoleByName[name] then return textRoleByName[name] end
			if obj:GetAttribute("VenturaAccent") == true then
				local prop = obj:GetAttribute("VenturaAccentProp")
				if not prop or prop == "TextColor3" then return "Accent" end
			end
			if _hasAny(lower, {"accent", "highlight", "selected"}) then return "Accent" end
			if _hasAny(lower, {"desc", "subtitle", "sub", "body", "hint", "tag", "caption", "secondary"}) then return "TextSecondary" end
			if _hasAny(lower, {"placeholder", "disabled", "attempt", "muted"}) then return "TextDisabled" end
			if _hasAny(lower, {"nav", "tab", "arrow", "caret"}) then return "TextSecondary" end
			if _hasAny(lower, {"status", "logline", "fps", "ping"}) then return nil end
			return "TextPrimary"
		end
		local function _styleTextObject(obj, name)
			if not obj or obj:GetAttribute("VenturaNoTheme") == true then return end
			if obj:IsA("TextButton") and tostring(obj.Text or "") ~= "" then
				local accentProp = obj:GetAttribute("VenturaAccentProp")
				if obj:GetAttribute("VenturaAccent") == true and (accentProp == nil or accentProp == "BackgroundColor3") then
					obj.TextColor3 = Color3.fromRGB(255,255,255)
					return
				end
			end
			local role = _inferTextRole(obj, name)
			if role then obj.TextColor3 = _themeColor(role, textPrimary) end
			if obj:IsA("TextBox") then
				obj.PlaceholderColor3 = textDisabled
			end
		end
		local function _strokeShouldAccent(obj, name)
			local parent = obj and obj.Parent
			local lower = _lowerName(obj, name)
			local parentLower = parent and tostring(parent.Name or ""):lower() or ""
			return obj:GetAttribute("VenturaAccent") == true
				or (parent and parent:GetAttribute("VenturaAccentStroke") == true)
				or _isAccentSurfaceName(name)
				or _hasAny(lower, {"accent", "divider", "separator", "underline", "highlight", "selected", "active"})
				or _hasAny(parentLower, {"selected", "active", "accent", "sliderfill", "togglepill"})
				or (parent and parent.Name == "TogglePill" and parent:GetAttribute("VenturaOn") == true)
		end
		local function _styleImage(obj, name)
			if obj:GetAttribute("VenturaAccent") == true then
				obj.ImageColor3 = accent
				return
			end
			local lower = _lowerName(obj, name)
			if _hasAny(lower, {"icon", "arrow", "caret", "chevron"}) then
				obj.ImageColor3 = textSecondary
			end
		end

		for _, obj in ipairs(SG:GetDescendants()) do
			pcall(function()
				if obj:GetAttribute("VenturaNoTheme") == true then return end
				local n = obj.Name
				if obj:IsA("UIStroke") then
					obj.Color = _strokeShouldAccent(obj, n) and accent or border
				elseif obj:IsA("Frame") or obj:IsA("TextButton") or obj:IsA("ScrollingFrame") then
					if _isInternalVisual(n) then return end
					if obj:IsA("TextButton") and obj.Text == "" and obj.BackgroundTransparency >= 0.965 then
						-- Pure hitboxes should not inherit stale colors or become visible during theme sync.
						obj.BackgroundTransparency = 1
					elseif n == "ToggleButtonSurface" and obj:GetAttribute("VenturaOn") == true then
						obj.BackgroundColor3 = accent
					elseif _isAccentSurfaceName(n) or (obj:GetAttribute("VenturaAccent") == true and (obj:GetAttribute("VenturaAccentProp") or "BackgroundColor3") == "BackgroundColor3") then
						obj.BackgroundColor3 = accent
						if n:find("Divider") or n:find("Separator") or _lowerName(obj, n):find("line", 1, true) then
							obj.BackgroundTransparency = math.max(tonumber(obj.BackgroundTransparency) or 0, 0.35)
						end
					elseif n == "TogglePill" then
						obj.BackgroundColor3 = obj:GetAttribute("VenturaOn") == true and accent or background
						_applyBackgroundTransparency(obj, "Background", n)
					else
						local role, prop = _inferGuiRole(obj, n)
						if role then
							if prop then
								_applyRole(obj, role, prop)
							elseif obj.BackgroundTransparency < 0.965 then
								obj.BackgroundColor3 = _themeColor(role, surface)
								_applyBackgroundTransparency(obj, role, n)
							end
						elseif obj:IsA("TextButton") and obj.BackgroundTransparency < 0.95 and n ~= "MinimizeRestoreCircle" then
							obj.BackgroundColor3 = surface
							_applyBackgroundTransparency(obj, "Surface", n)
						end
					end
					if n == "StatusDot" then
						local status = tostring(obj:GetAttribute("VenturaStatus") or ""):lower()
						if status == "running" or status == "success" then obj.BackgroundColor3 = Color3.fromRGB(80, 220, 130)
						elseif status == "warning" then obj.BackgroundColor3 = Color3.fromRGB(235, 190, 70)
						elseif status == "error" then obj.BackgroundColor3 = Color3.fromRGB(235, 85, 85)
						elseif status == "idle" or status == "off" then obj.BackgroundColor3 = textDisabled
						else obj.BackgroundColor3 = accent end
					end
					if obj:IsA("TextButton") then _styleTextObject(obj, n); _applyFontScaleToObject(obj) end
				elseif obj:IsA("TextLabel") or obj:IsA("TextBox") then
					_styleTextObject(obj, n)
					_applyFontScaleToObject(obj)
				elseif obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
					_styleImage(obj, n)
				end
			end)
		end

		for i = #GUI._themeObjects, 1, -1 do
			local item = GUI._themeObjects[i]
			if item and item.obj and item.obj.Parent then
				_applyRole(item.obj, item.role, item.prop)
			else
				table.remove(GUI._themeObjects, i)
			end
		end

		applyAccentToRegistered(accent, false)
		for _, tab in ipairs(GUI._tabs or {}) do
			if tab and type(tab._ApplyNavStyle) == "function" then
				pcall(function() tab:_ApplyNavStyle(true) end)
			end
		end
		_styleMiniHUD()
		_styleMinimizeBubble()
		local themeData = Library.Themes and Library.Themes[GUI:GetTheme()]
		if themeData then pcall(function() _applyThemeDesign(themeData, GUI:GetTheme()) end) end
		return true
	end


	local function _relativeLuminance(c)
		if typeof(c) ~= "Color3" then return 0 end
		local function channel(v)
			if v <= 0.03928 then return v / 12.92 end
			return ((v + 0.055) / 1.055) ^ 2.4
		end
		return 0.2126 * channel(c.R) + 0.7152 * channel(c.G) + 0.0722 * channel(c.B)
	end

	local function _applySmartContrast(themeData)
		if GUI._smartContrastEnabled == false and not (type(themeData) == "table" and themeData.SmartContrast == true) then return false end
		local bg = Library.Theme.Background or Color3.fromRGB(18,18,22)
		local surface = Library.Theme.Surface or bg
		local lum = _relativeLuminance(bg:Lerp(surface, 0.35))
		if lum > 0.55 then
			Library.Theme.TextPrimary = Color3.fromRGB(24, 26, 32)
			Library.Theme.TextSecondary = Color3.fromRGB(66, 72, 86)
			Library.Theme.TextDisabled = Color3.fromRGB(110, 116, 130)
		else
			Library.Theme.TextPrimary = Color3.fromRGB(242, 246, 255)
			Library.Theme.TextSecondary = Color3.fromRGB(152, 166, 195)
			Library.Theme.TextDisabled = Color3.fromRGB(82, 92, 118)
		end
		return true
	end

	local function _playThemeTransition()
		if GUI._themeTransitionEnabled == false or not Main or not Main.Parent then return end
		local ok = pcall(function()
			local overlay = Instance.new("Frame")
			overlay.Name = "ThemeTransitionFlash"
			overlay.BackgroundColor3 = (Library.Theme.Accent or Color3.fromRGB(115,185,255)):Lerp(Library.Theme.Background or Color3.fromRGB(8,8,12), 0.22)
			overlay.BackgroundTransparency = 0.72
			overlay.BorderSizePixel = 0
			overlay.Size = UDim2.new(1, 0, 1, 0)
			overlay.Position = UDim2.new(0, 0, 0, 0)
			overlay.ZIndex = 999
			overlay.Active = false
			overlay.Parent = Main
			local grad = Instance.new("UIGradient", overlay)
			grad.Rotation = 25
			grad.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Library.Theme.Accent or Color3.fromRGB(115,185,255)),
				ColorSequenceKeypoint.new(0.5, Library.Theme.SurfaceHover or Library.Theme.Surface or Color3.fromRGB(30,30,40)),
				ColorSequenceKeypoint.new(1, Library.Theme.Background or Color3.fromRGB(8,8,12)),
			})
			tw(overlay, {BackgroundTransparency = 1}, TweenInfo.new(math.clamp(tonumber(GUI._themeTransitionDuration) or 0.28, 0.05, 1.5), Enum.EasingStyle.Quad, Enum.EasingDirection.Out), function()
				pcall(function() overlay:Destroy() end)
			end)
		end)
		return ok
	end

	function GUI:_applyTheme(val)
		local t = Library.Themes[val]; if not t then return false end
		local previousAccent = Library.Theme.Accent
		GUI._savedTheme = val
		for k,v in pairs(t) do
			if k ~= "UserBox" and k ~= "Accent" and typeof(v) == "Color3" then Library.Theme[k] = v end
		end
		_applySmartContrast(t)
		local mixedAnimation = GUI._themeMixAnimationStyle or t.AnimationStyle or tostring(val):lower()
		_setSpaceBackground(t.Stars ~= false or t.Animated == true or tostring(val) == "Space", mixedAnimation)
		_applyThemeDesign(t, val)
		local nextAccent = _themeAccentFor(val, t)
		if typeof(nextAccent) == "Color3" and (GUI._themeAccentMode == true or GUI._manualAccent ~= true) then
			GUI._manualAccent = false
			Library.Theme.Accent = nextAccent
			GUI._savedAccent = nextAccent
			applyAccentToRegistered(nextAccent, true)
		elseif typeof(previousAccent) == "Color3" then
			Library.Theme.Accent = previousAccent
			applyAccentToRegistered(previousAccent, false)
		end
		-- v5.48: one full refresh handles all old/new controls; config logic is untouched.
		GUI:_RefreshThemeVisuals()
		_playThemeTransition()
		tw(Main,    { BackgroundColor3 = Library.Theme.Background, BackgroundTransparency = _themeTransparency("Main", 0) }, TI_SLOW)
		tw(Nav,     { BackgroundColor3 = Library.Theme.Nav, BackgroundTransparency = _themeTransparency("Nav", 0) }, TI_SLOW)
		tw(Topbar,  { BackgroundColor3 = Library.Theme.Topbar, BackgroundTransparency = _themeTransparency("Topbar", 0) }, TI_SLOW)
		tw(topLine, { BackgroundColor3 = Library.Theme.Accent }, TI_SLOW)
		tw(accentLine, { BackgroundColor3 = Library.Theme.Accent }, TI_SLOW)
		tw(navBorder, { BackgroundColor3 = Library.Theme.Accent }, TI_SLOW)
		tw(UserBox, { BackgroundColor3 = t.UserBox or Library.Theme.Surface, BackgroundTransparency = _themeTransparency("UserBox", 0) }, TI_SLOW)
		tw(userSep, { BackgroundColor3 = Library.Theme.Accent }, TI_SLOW)
		tw(searchBar, { BackgroundColor3 = Library.Theme.Surface, BackgroundTransparency = _themeTransparency("Surface", 0) }, TI_SLOW)
		tw(_mainStroke, { Color = Library.Theme.Border }, TI_SLOW)
		_styleMiniHUD()
		_styleMinimizeBubble()
		for _, p in ipairs(navPatches) do tw(p, { BackgroundColor3 = Library.Theme.Nav }, TI_SLOW) end
		GUI:_FireThemeListeners(val)
		return true
	end

	function GUI:SetTheme(name, silent)
		if GUI:_applyTheme(name) then
			if GUI._cfgSyncCallbacks and GUI._cfgSyncCallbacks.theme then pcall(GUI._cfgSyncCallbacks.theme, name) end
			if not silent then pcall(function() GUI:MarkConfigDirty() end) end
			return true
		end
		return false
	end
	function GUI:GetTheme() return GUI._savedTheme or "Dark" end
	function GUI:GetThemeAccent(name)
		local themeName = name or GUI:GetTheme()
		local theme = Library.Themes and Library.Themes[themeName]
		return theme and _themeAccentFor(themeName, theme) or nil
	end
	function GUI:GetThemes()
		local names = {}
		for name in pairs(Library.Themes) do table.insert(names, name) end
		table.sort(names)
		return names
	end
	function GUI:GetThemeCategories()
		local out, seen = {"All"}, {All = true}
		for _, data in pairs(Library.Themes or {}) do
			if type(data) == "table" then
				local category = tostring(data.Category or data.DesignStyle or data.AnimationStyle or "Other")
				category = category:sub(1,1):upper() .. category:sub(2)
				if category ~= "" and not seen[category] then seen[category] = true; table.insert(out, category) end
			end
		end
		table.sort(out, function(a,b) if a == "All" then return true elseif b == "All" then return false end return a:lower() < b:lower() end)
		return out
	end

	function GUI:GetThemesByCategory(category)
		category = tostring(category or "All")
		if category == "" or category:lower() == "all" then return GUI:GetThemes() end
		local out = {}
		for name, data in pairs(Library.Themes or {}) do
			local c = type(data) == "table" and tostring(data.Category or data.DesignStyle or data.AnimationStyle or "Other") or "Other"
			if c:lower() == category:lower() then table.insert(out, name) end
		end
		table.sort(out)
		return out
	end

	function GUI:SetSmartContrast(enabled)
		GUI._smartContrastEnabled = enabled ~= false
		local theme = Library.Themes and Library.Themes[GUI:GetTheme()]
		_applySmartContrast(theme)
		GUI:_RefreshThemeVisuals()
		return GUI._smartContrastEnabled
	end
	function GUI:GetSmartContrast()
		return GUI._smartContrastEnabled ~= false
	end

	function GUI:SetThemeTransition(enabled, duration)
		GUI._themeTransitionEnabled = enabled ~= false
		if duration ~= nil then GUI._themeTransitionDuration = math.clamp(tonumber(duration) or GUI._themeTransitionDuration or 0.28, 0.05, 1.5) end
		return GUI._themeTransitionEnabled, GUI._themeTransitionDuration
	end
	function GUI:GetThemeTransition()
		return GUI._themeTransitionEnabled ~= false, GUI._themeTransitionDuration or 0.28
	end

	function GUI:SetThemeMix(opts, silent)
		opts = type(opts) == "table" and opts or {}
		if opts.category then GUI._themeCategoryFilter = tostring(opts.category) end
		if opts.theme and Library.Themes[tostring(opts.theme)] then GUI:SetTheme(tostring(opts.theme), true) end
		if opts.animation then GUI._themeMixAnimationStyle = tostring(opts.animation):lower(); GUI:SetThemeAnimationStyle(GUI._themeMixAnimationStyle, true) end
		if opts.accent then
			if typeof(opts.accent) == "Color3" then GUI:SetAccent(opts.accent, true) else GUI:SetAccentPreset(tostring(opts.accent), true) end
		end
		if opts.glass ~= nil then GUI:SetGlassIntensity(tonumber(opts.glass) or 0) end
		if opts.glow ~= nil then GUI:SetThemeOverlayVisible(opts.glow ~= false) end
		GUI:_RefreshThemeVisuals()
		if not silent then pcall(function() GUI:MarkConfigDirty() end) end
		return true
	end
	function GUI:GetThemeMix()
		return {
			category = GUI._themeCategoryFilter or "All",
			theme = GUI:GetTheme(),
			animation = GUI._themeMixAnimationStyle or GUI:GetThemeAnimationStyle(),
			accent = GUI:GetAccentPresetFromColor(Library.Theme.Accent) or "Custom",
			glow = GUI:GetThemeOverlayVisible(),
			glass = GUI:GetThemeTransparency(),
		}
	end

	function GUI:RegisterThemePack(pack, applyNow)
		if type(pack) ~= "table" then return false end
		local name = tostring(pack.name or pack.Name or ""):match("^%s*(.-)%s*$")
		if name == "" then return false end
		local colors = type(pack.colors) == "table" and pack.colors or pack
		local effects = type(pack.effects) == "table" and pack.effects or {}
		local theme = {}
		for k, v in pairs(colors) do theme[k] = v end
		theme.Category = pack.category or pack.Category or pack.style or pack.Style or theme.Category or "Custom"
		theme.DesignStyle = effects.design or effects.style or theme.DesignStyle or theme.Category
		theme.AnimationStyle = effects.animation or theme.AnimationStyle or "nova"
		theme.Stars = effects.particles ~= false
		theme.Animated = effects.animation ~= false
		theme.SmartContrast = pack.smartContrast ~= false
		if effects.glass ~= nil then
			local g = math.clamp(tonumber(effects.glass) or 0.18, 0, 0.85)
			theme.Transparency = {Main=math.clamp(g - 0.12,0,0.85), Background=g, Surface=math.clamp(g + 0.04,0,0.90), Nav=g, Topbar=g, UserBox=g, Overlay=0.90}
		end
		Library.Themes[name] = theme
		if GUI._themeDropdown and type(GUI._themeDropdown.SetItems) == "function" then pcall(function() GUI._themeDropdown:SetItems(GUI:GetThemes()) end) end
		if applyNow then return GUI:SetTheme(name) end
		return true
	end
	function GUI:ApplyThemePack(pack)
		return GUI:RegisterThemePack(pack, true)
	end

