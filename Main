	local function _roundStarCorner(obj, w, h)
		if not obj then return end
		local c = obj:FindFirstChildOfClass("UICorner")
		if not c then c = Instance.new("UICorner", obj) end
		if math.abs((tonumber(w) or 1) - (tonumber(h) or 1)) <= 1 then
			c.CornerRadius = UDim.new(1, 0)
		else
			c.CornerRadius = UDim.new(0, math.max(1, math.floor(math.min(tonumber(w) or 1, tonumber(h) or 1) / 2)))
		end
	end

	local function _makeSpaceLayer(forceRebuild)
		if forceRebuild then _destroySpaceLayer() end
		if V._spaceLayer and V._spaceLayer.Parent then return V._spaceLayer end
		V._spaceLayer = Instance.new("Frame", Main)
		V._spaceLayer.Name = "SpaceStarBackground"
		V._spaceLayer.BackgroundTransparency = 1
		V._spaceLayer.BorderSizePixel = 0
		V._spaceLayer.Size = UDim2.new(1, 0, 1, 0)
		V._spaceLayer.Position = UDim2.new(0, 0, 0, 0)
		V._spaceLayer.ClipsDescendants = true
		V._spaceLayer.Active = false
		V._spaceLayer.ZIndex = 0
		V._spaceStars = {}

		local starCount = math.clamp(math.floor(tonumber((_safeLoadState.enabled and options.safeLoadStarCount) or options.animationStarCount or options.starCount) or (_safeLoadState.enabled and 34 or 70)), 0, 90)
		for i = 1, starCount do
			local dot = Instance.new("Frame", V._spaceLayer)
			dot.Name = "Star"
			dot.BorderSizePixel = 0
			dot.BackgroundColor3 = i % 7 == 0 and Color3.fromRGB(135, 190, 255) or Color3.fromRGB(240, 248, 255)
			dot.BackgroundTransparency = (i % 5 == 0) and 0.15 or 0.35
			dot.ZIndex = 0
			local size = (i % 11 == 0) and 3 or ((i % 3 == 0) and 2 or 1)
			dot.Size = UDim2.new(0, size, 0, size)
			_roundStarCorner(dot, size, size)
			local data = {
				obj = dot,
				x = math.random(),
				y = math.random(),
				speed = 0.018 + math.random() * 0.055,
				drift = (math.random() - 0.5) * 0.018,
				pulse = math.random() * math.pi * 2,
				baseTransparency = dot.BackgroundTransparency,
				baseSize = size,
			}
			table.insert(V._spaceStars, data)
		end
		return V._spaceLayer
	end

	local function _stepSpaceStars(dt)
		if not V._spaceEnabled or not V._spaceLayer or not V._spaceLayer.Parent then return end
		if GUI._animationsEnabled == false or GUI._open == false then return end
		local fpsCap = tonumber(GUI._animationFPSCap) or tonumber(options.animationFPSCap) or (_safeLoadState.enabled and 24 or 30)
		if fpsCap > 0 then
			V._spaceAnimAccum = (V._spaceAnimAccum or 0) + (tonumber(dt) or 0)
			local target = 1 / math.clamp(fpsCap, 10, 60)
			if V._spaceAnimAccum < target then return end
			dt = math.min(V._spaceAnimAccum, 0.08)
			V._spaceAnimAccum = 0
		end
		local speedMul = math.clamp(tonumber(GUI._animationSpeed) or 1, 0.15, 3.5)
		local intensityMul = math.clamp(tonumber(GUI._animationIntensity) or 1, 0.15, 2.75)
		dt = dt * speedMul
		GUI._spaceClock = (GUI._spaceClock or 0) + dt
		local w = math.max(V._spaceLayer.AbsoluteSize.X, 1)
		local h = math.max(V._spaceLayer.AbsoluteSize.Y, 1)
		local accent = Library.Theme.Accent or Color3.fromRGB(115,185,255)
		local text = Library.Theme.TextPrimary or Color3.fromRGB(240,248,255)
		local style = tostring(GUI._spaceStyle or "stars"):lower()
		for i, star in ipairs(V._spaceStars) do
			local o = star.obj
			if o and o.Parent then
				local xDrift = star.drift
				local ySpeed = star.speed
				if style == "matrix" or style == "toxic" then
					ySpeed = ySpeed * 1.65
					xDrift = xDrift * 0.25
				elseif style == "embers" or style == "inferno" then
					ySpeed = -ySpeed * 1.10
					xDrift = xDrift * 1.80
				elseif style == "aurora" then
					xDrift = xDrift + math.sin(GUI._spaceClock * 0.8 + i) * 0.035
					ySpeed = ySpeed * 0.42
				elseif style == "ocean" then
					xDrift = xDrift + math.sin(GUI._spaceClock * 1.25 + star.y * 5) * 0.025
					ySpeed = ySpeed * 0.65
				elseif style == "galaxy" or style == "void" then
					xDrift = xDrift + math.sin(GUI._spaceClock * 0.7 + i * 0.41) * 0.018
					ySpeed = ySpeed * 0.58
				elseif style == "sakura" then
					xDrift = xDrift + math.sin(GUI._spaceClock * 1.4 + i) * 0.045
					ySpeed = ySpeed * 0.55
				elseif style == "luxury" then
					ySpeed = ySpeed * 0.35
					xDrift = xDrift * 0.45
				elseif style == "neon" or style == "hologram" then
					xDrift = xDrift + math.sin(GUI._spaceClock * 1.8 + i * 0.5) * 0.055
					ySpeed = ySpeed * 0.34
				elseif style == "snow" or style == "frost" then
					xDrift = xDrift + math.sin(GUI._spaceClock * 0.75 + i) * 0.012
					ySpeed = ySpeed * 0.24
				elseif style == "storm" or style == "rain" then
					ySpeed = ySpeed * 2.65
					xDrift = xDrift * 0.18 + 0.018
				elseif style == "vortex" then
					local angle = GUI._spaceClock * 0.55 + i * 0.37
					xDrift = xDrift + math.cos(angle) * 0.045
					ySpeed = ySpeed * 0.42 + math.sin(angle) * 0.015
				elseif style == "mist" or style == "smoke" then
					xDrift = xDrift + math.sin(GUI._spaceClock * 0.32 + i * 0.21) * 0.020
					ySpeed = ySpeed * 0.10
				elseif style == "bubbles" then
					ySpeed = -ySpeed * 0.42
					xDrift = xDrift + math.sin(GUI._spaceClock * 1.1 + i) * 0.030
				elseif style == "comets" or style == "comet" then
					ySpeed = ySpeed * 1.75
					xDrift = xDrift + 0.095
				elseif style == "fireflies" or style == "firefly" then
					xDrift = xDrift + math.sin(GUI._spaceClock * 1.7 + i) * 0.040
					ySpeed = math.sin(GUI._spaceClock * 1.1 + i * 0.13) * 0.018
				elseif style == "scanlines" then
					xDrift = 0.20 + (i % 4) * 0.012
					ySpeed = 0
				elseif style == "prism" then
					xDrift = xDrift + math.sin(GUI._spaceClock * 1.45 + i * 0.31) * 0.060
					ySpeed = ySpeed * 0.28
				elseif style == "liquid" then
					xDrift = xDrift + math.sin(GUI._spaceClock * 0.95 + star.y * 7) * 0.055
					ySpeed = ySpeed * 0.25
				elseif style == "meteor" then
					ySpeed = ySpeed * 2.25
					xDrift = xDrift + 0.135
				elseif style == "orbit" then
					local a = GUI._spaceClock * 0.75 + i * 0.25
					xDrift = xDrift + math.cos(a) * 0.052
					ySpeed = ySpeed * 0.20 + math.sin(a) * 0.026
				elseif style == "pulsegrid" then
					xDrift = 0.018 * math.sin(GUI._spaceClock * 2 + i)
					ySpeed = 0.006 * math.cos(GUI._spaceClock * 1.4 + i)
				elseif style == "quantum" then
					xDrift = xDrift + math.sin(GUI._spaceClock * 2.2 + i * 0.33) * 0.075
					ySpeed = ySpeed * 0.18 + math.cos(GUI._spaceClock * 1.7 + i) * 0.022
				elseif style == "nebulaflow" then
					xDrift = xDrift + math.sin(GUI._spaceClock * 0.42 + star.y * 8) * 0.050
					ySpeed = ySpeed * 0.16
				elseif style == "wave" then
					xDrift = xDrift + math.sin(GUI._spaceClock * 1.85 + star.y * 10) * 0.075
					ySpeed = ySpeed * 0.22
				elseif style == "stardust" then
					xDrift = xDrift + math.sin(GUI._spaceClock * 0.70 + i) * 0.018
					ySpeed = ySpeed * 0.18
				elseif style == "eclipse" then
					local a = GUI._spaceClock * 0.35 + i * 0.19
					xDrift = xDrift + math.cos(a) * 0.030
					ySpeed = ySpeed * 0.12 + math.sin(a) * 0.018
				elseif style == "firestorm" then
					ySpeed = -ySpeed * 2.10
					xDrift = xDrift + math.sin(GUI._spaceClock * 2.4 + i) * 0.065
				elseif style == "laser" then
					xDrift = 0.32 + (i % 6) * 0.018
					ySpeed = 0.006 * math.sin(GUI._spaceClock + i)
				elseif style == "waterfall" then
					ySpeed = ySpeed * 2.95
					xDrift = xDrift * 0.08
				elseif style == "confetti" then
					xDrift = xDrift + math.sin(GUI._spaceClock * 1.6 + i) * 0.070
					ySpeed = ySpeed * (0.45 + (i % 5) * 0.12)
				elseif style == "hyperspeed" then
					xDrift = 0.46 + (i % 7) * 0.028
					ySpeed = ySpeed * 0.10 + math.sin(GUI._spaceClock * 2 + i) * 0.008
				elseif style == "blackhole" or style == "gravwell" then
					local a = GUI._spaceClock * (style == "blackhole" and 0.95 or 0.62) + i * 0.31
					xDrift = xDrift + math.cos(a) * (style == "blackhole" and 0.075 or 0.052)
					ySpeed = ySpeed * 0.12 + math.sin(a) * (style == "blackhole" and 0.040 or 0.030)
				elseif style == "lightning" then
					xDrift = xDrift + math.sin(GUI._spaceClock * 7.5 + i) * 0.120
					ySpeed = ySpeed * 1.45
				elseif style == "datastream" or style == "circuit" then
					xDrift = (style == "circuit") and (0.018 * math.sin(GUI._spaceClock * 2.4 + i)) or 0
					ySpeed = ySpeed * (style == "datastream" and 2.15 or 0.72)
				elseif style == "shards" then
					xDrift = xDrift + 0.085 + math.sin(GUI._spaceClock * 1.3 + i) * 0.020
					ySpeed = ySpeed * 0.95
				elseif style == "solarwind" then
					xDrift = xDrift + 0.145 + math.sin(GUI._spaceClock * 0.9 + star.y * 8) * 0.065
					ySpeed = ySpeed * 0.35
				elseif style == "dreamcloud" or style == "shadowmist" then
					xDrift = xDrift + math.sin(GUI._spaceClock * 0.25 + i * 0.18) * 0.026
					ySpeed = ySpeed * 0.08
				elseif style == "heartbeat" then
					local beat = math.abs(math.sin(GUI._spaceClock * 2.7))
					xDrift = xDrift + math.sin(GUI._spaceClock * 1.5 + i) * 0.020
					ySpeed = ySpeed * (0.15 + beat * 0.30)
				elseif style == "ripple" then
					xDrift = xDrift + math.sin(GUI._spaceClock * 1.25 + star.y * 12) * 0.090
					ySpeed = ySpeed * 0.20
				elseif style == "rainbow" then
					xDrift = xDrift + math.sin(GUI._spaceClock * 1.4 + i * 0.22) * 0.060
					ySpeed = ySpeed * 0.28
				elseif style == "forge" or style == "lavalamp" then
					ySpeed = -ySpeed * (style == "forge" and 1.65 or 0.36)
					xDrift = xDrift + math.sin(GUI._spaceClock * (style == "forge" and 2.0 or 0.55) + i) * (style == "forge" and 0.055 or 0.075)
				elseif style == "icecomet" then
					ySpeed = ySpeed * 1.85
					xDrift = xDrift + 0.115
				elseif style == "neonpulse" then
					local pulse = math.abs(math.sin(GUI._spaceClock * 2.6 + i * 0.07))
					xDrift = xDrift + math.sin(GUI._spaceClock * 2.1 + i) * (0.045 + pulse * 0.045)
					ySpeed = ySpeed * 0.18 + pulse * 0.014
				elseif style == "galaxyring" or style == "royalflow" then
					local a = GUI._spaceClock * (style == "royalflow" and 0.55 or 0.72) + i * 0.28
					xDrift = xDrift + math.cos(a) * (style == "royalflow" and 0.050 or 0.068)
					ySpeed = ySpeed * 0.13 + math.sin(a) * (style == "royalflow" and 0.022 or 0.033)
				elseif style == "electricgrid" then
					xDrift = 0.024 * math.sin(GUI._spaceClock * 5.5 + i)
					ySpeed = 0.010 * math.cos(GUI._spaceClock * 3.5 + i * 0.3)
				elseif style == "matrixbloom" then
					xDrift = math.sin(GUI._spaceClock * 1.1 + i) * 0.018
					ySpeed = ySpeed * (1.55 + math.abs(math.sin(GUI._spaceClock + i)) * 0.45)
				elseif style == "bloodcircuit" then
					xDrift = (i % 2 == 0) and 0.030 or -0.020
					ySpeed = ySpeed * 0.62 + math.sin(GUI._spaceClock * 2.8 + i) * 0.018
				elseif style == "aurorafrost" then
					xDrift = xDrift + math.sin(GUI._spaceClock * 0.85 + star.y * 8) * 0.070
					ySpeed = ySpeed * 0.12
				elseif style == "eclipsepulse" then
					local a = GUI._spaceClock * 0.45 + i * 0.21
					xDrift = xDrift + math.cos(a) * 0.040
					ySpeed = ySpeed * 0.10 + math.sin(a) * 0.018
				elseif style == "toxicpulse" then
					xDrift = xDrift + math.sin(GUI._spaceClock * 3.0 + i) * 0.060
					ySpeed = ySpeed * 1.25
				elseif style == "chromewave" then
					xDrift = xDrift + math.sin(GUI._spaceClock * 1.25 + star.y * 9) * 0.055
					ySpeed = ySpeed * 0.16
				elseif style == "hazerain" then
					xDrift = xDrift + math.sin(GUI._spaceClock * 0.55 + i) * 0.022
					ySpeed = ySpeed * 1.05
				elseif style == "diamonds" then
					xDrift = xDrift + 0.040 + math.sin(GUI._spaceClock * 1.0 + i) * 0.020
					ySpeed = ySpeed * 0.55
				elseif style == "tidalpulse" then
					xDrift = xDrift + math.sin(GUI._spaceClock * 1.7 + star.y * 14) * 0.100
					ySpeed = ySpeed * 0.18 + math.cos(GUI._spaceClock * 1.2 + i) * 0.016
				elseif style == "portal" then
					local a = GUI._spaceClock * 1.15 + i * 0.37
					xDrift = xDrift + math.cos(a) * 0.115
					ySpeed = ySpeed * 0.10 + math.sin(a) * 0.060
				elseif style == "constellation" then
					xDrift = xDrift + math.sin(GUI._spaceClock * 0.35 + i) * 0.012
					ySpeed = ySpeed * 0.05
				elseif style == "magnetic" then
					local wave = math.sin(GUI._spaceClock * 2.3 + star.y * 10)
					xDrift = xDrift + wave * 0.120
					ySpeed = ySpeed * 0.35 + math.cos(GUI._spaceClock * 1.7 + i) * 0.025
				elseif style == "plasmafield" then
					xDrift = xDrift + math.sin(GUI._spaceClock * 1.4 + star.y * 11) * 0.075
					ySpeed = ySpeed * 0.20 + math.cos(GUI._spaceClock + i) * 0.020
				elseif style == "snowburst" then
					xDrift = xDrift + math.sin(GUI._spaceClock * 0.8 + i) * 0.035
					ySpeed = ySpeed * 0.72
				elseif style == "neonrain" then
					xDrift = xDrift + 0.018 * math.sin(i)
					ySpeed = ySpeed * 2.05
				elseif style == "sunburst" then
					xDrift = xDrift + math.cos(GUI._spaceClock * 1.1 + i) * 0.075
					ySpeed = ySpeed * 1.15 + math.sin(GUI._spaceClock * 2 + i) * 0.035
				elseif style == "liquidgrid" then
					xDrift = xDrift + math.sin(GUI._spaceClock * 1.1 + star.y * 12) * 0.080
					ySpeed = ySpeed * 0.18 + math.cos(GUI._spaceClock * 1.2 + i) * 0.018
				elseif style == "starfall" then
					xDrift = xDrift + 0.090
					ySpeed = ySpeed * 2.35
				elseif style == "nebularipple" then
					xDrift = xDrift + math.sin(GUI._spaceClock * 1.1 + star.y * 15) * 0.095
					ySpeed = ySpeed * 0.18 + math.cos(GUI._spaceClock * 1.4 + i) * 0.018
				elseif style == "starspiral" then
					local a = GUI._spaceClock * 1.05 + i * 0.32
					xDrift = xDrift + math.cos(a) * 0.095
					ySpeed = ySpeed * 0.11 + math.sin(a) * 0.055
				elseif style == "matrixflare" then
					xDrift = math.sin(GUI._spaceClock * 2.8 + i) * 0.035
					ySpeed = ySpeed * (1.75 + math.abs(math.sin(GUI._spaceClock * 2 + i)) * 0.90)
				elseif style == "glassrain" then
					xDrift = xDrift * 0.20 + math.sin(GUI._spaceClock * 0.7 + i) * 0.018
					ySpeed = ySpeed * 2.45
				elseif style == "cosmicdust" then
					xDrift = xDrift + math.sin(GUI._spaceClock * 0.55 + i * 0.2) * 0.032
					ySpeed = ySpeed * 0.16
				elseif style == "electricpulse" then
					local pulse = math.abs(math.sin(GUI._spaceClock * 3.5 + i * 0.07))
					xDrift = xDrift + math.sin(GUI._spaceClock * 5.2 + i) * (0.050 + pulse * 0.080)
					ySpeed = ySpeed * 0.45 + pulse * 0.026
				elseif style == "aurorawave" then
					xDrift = xDrift + math.sin(GUI._spaceClock * 0.75 + star.y * 10) * 0.090
					ySpeed = ySpeed * 0.10 + math.cos(GUI._spaceClock * 0.9 + i) * 0.012
				elseif style == "pixelstorm" then
					xDrift = ((i % 2 == 0) and 0.036 or -0.024) + math.sin(GUI._spaceClock * 4 + i) * 0.018
					ySpeed = ySpeed * 1.35
				elseif style == "crystalorbit" then
					local a = GUI._spaceClock * 0.86 + i * 0.27
					xDrift = xDrift + math.cos(a) * 0.070
					ySpeed = ySpeed * 0.16 + math.sin(a) * 0.034
				elseif style == "darkmatter" then
					local a = GUI._spaceClock * 0.52 + i * 0.23
					xDrift = xDrift + math.cos(a) * 0.055
					ySpeed = ySpeed * 0.08 + math.sin(a) * 0.025
				elseif style == "goldenembers" then
					ySpeed = -ySpeed * 1.65
					xDrift = xDrift + math.sin(GUI._spaceClock * 1.8 + i) * 0.060
				elseif style == "neoncomets" then
					ySpeed = ySpeed * 1.95
					xDrift = xDrift + 0.125 + math.sin(GUI._spaceClock * 1.5 + i) * 0.025
				end

				xDrift = xDrift * intensityMul
				ySpeed = ySpeed * intensityMul
				star.y = star.y + ySpeed * dt
				star.x = star.x + xDrift * dt
				if star.y > 1.04 then
					star.y = -0.04
					star.x = math.random()
				elseif star.y < -0.05 then
					star.y = 1.04
					star.x = math.random()
				end
				if star.x > 1.04 then star.x = -0.04 elseif star.x < -0.04 then star.x = 1.04 end
				star.pulse = star.pulse + dt * (style == "toxic" and 4.1 or 2.2) * math.clamp(intensityMul, 0.4, 2.2)
				local baseSize = tonumber(star.baseSize) or 1
				local sw, sh = baseSize, baseSize
				if style == "comets" or style == "comet" then
					sw, sh = 7 + (i % 4) * 2, ((i % 2 == 0) and 1 or 2)
				elseif style == "scanlines" then
					sw, sh = math.max(18, math.floor(w * (0.045 + (i % 5) * 0.012))), 1
				elseif style == "mist" or style == "smoke" then
					sw, sh = 2 + (i % 5), 2 + (i % 5)
				elseif style == "bubbles" then
					sw, sh = 2 + (i % 4), 2 + (i % 4)
				elseif style == "meteor" then
					sw, sh = 10 + (i % 5) * 2, ((i % 3 == 0) and 2 or 1)
				elseif style == "laser" then
					sw, sh = math.max(22, math.floor(w * (0.06 + (i % 6) * 0.010))), 1
				elseif style == "waterfall" then
					sw, sh = ((i % 4 == 0) and 2 or 1), 7 + (i % 5) * 2
				elseif style == "pulsegrid" then
					sw, sh = 2 + (i % 2), 2 + (i % 2)
				elseif style == "quantum" then
					sw, sh = 1 + (i % 4), 1 + (i % 4)
				elseif style == "nebulaflow" or style == "wave" then
					sw, sh = 2 + (i % 5), 2 + (i % 5)
				elseif style == "stardust" or style == "eclipse" then
					sw, sh = ((i % 7 == 0) and 3 or ((i % 3 == 0) and 2 or 1)), ((i % 7 == 0) and 3 or ((i % 3 == 0) and 2 or 1))
				elseif style == "firestorm" then
					sw, sh = 2 + (i % 4), 2 + (i % 4)
				elseif style == "confetti" then
					sw, sh = 2 + (i % 5), ((i % 2 == 0) and 2 or 3)
				elseif style == "hyperspeed" then
					sw, sh = math.max(24, math.floor(w * (0.07 + (i % 7) * 0.010))), 1
				elseif style == "blackhole" or style == "gravwell" then
					sw, sh = ((i % 5 == 0) and 4 or 2), ((i % 5 == 0) and 4 or 2)
				elseif style == "lightning" then
					sw, sh = math.max(14, math.floor(w * (0.035 + (i % 4) * 0.010))), ((i % 3 == 0) and 2 or 1)
				elseif style == "datastream" then
					sw, sh = ((i % 4 == 0) and 2 or 1), 5 + (i % 5) * 2
				elseif style == "circuit" then
					sw, sh = ((i % 3 == 0) and 8 or 2), ((i % 3 == 0) and 1 or 2)
				elseif style == "shards" then
					sw, sh = 4 + (i % 5), ((i % 2 == 0) and 2 or 3)
				elseif style == "solarwind" then
					sw, sh = 7 + (i % 5) * 2, 1
				elseif style == "dreamcloud" or style == "shadowmist" or style == "lavalamp" then
					sw, sh = 3 + (i % 6), 3 + (i % 6)
				elseif style == "heartbeat" or style == "ripple" or style == "rainbow" then
					sw, sh = 2 + (i % 4), 2 + (i % 4)
				elseif style == "forge" then
					sw, sh = 2 + (i % 4), 2 + (i % 4)
				elseif style == "icecomet" then
					sw, sh = 9 + (i % 5) * 2, ((i % 3 == 0) and 2 or 1)
				elseif style == "neonpulse" or style == "toxicpulse" then
					sw, sh = 2 + (i % 5), 2 + (i % 5)
				elseif style == "galaxyring" or style == "eclipsepulse" or style == "royalflow" then
					sw, sh = ((i % 6 == 0) and 4 or 2), ((i % 6 == 0) and 4 or 2)
				elseif style == "electricgrid" or style == "bloodcircuit" then
					sw, sh = ((i % 3 == 0) and 10 or 2), ((i % 3 == 0) and 1 or 2)
				elseif style == "matrixbloom" then
					sw, sh = ((i % 4 == 0) and 2 or 1), 5 + (i % 6)
				elseif style == "aurorafrost" or style == "chromewave" or style == "hazerain" then
					sw, sh = 3 + (i % 6), 3 + (i % 6)
				elseif style == "diamonds" then
					sw, sh = 3 + (i % 4), ((i % 2 == 0) and 3 or 2)
				elseif style == "tidalpulse" then
					sw, sh = 2 + (i % 4), 2 + (i % 4)
				elseif style == "portal" then
					sw, sh = ((i % 5 == 0) and 5 or 2), ((i % 5 == 0) and 5 or 2)
				elseif style == "constellation" then
					sw, sh = ((i % 7 == 0) and 3 or 1), ((i % 7 == 0) and 3 or 1)
