	function GUI:RegisterThemeObject(obj, role, prop)
		if not obj then return obj end
		role = tostring(role or "Surface")
		pcall(function()
			obj:SetAttribute("VenturaThemeRole", role)
			if prop then obj:SetAttribute("VenturaThemeProp", tostring(prop)) end
		end)
		table.insert(GUI._themeObjects, {obj=obj, role=role, prop=prop})
		_applyRole(obj, role, prop)
		return obj
	end

	function GUI:RegisterTextObject(obj, role)
		if not obj then return obj end
		role = tostring(role or "TextPrimary")
		pcall(function()
			obj:SetAttribute("VenturaTextRole", role)
			obj:SetAttribute("VenturaThemeRole", role)
			obj:SetAttribute("VenturaThemeProp", "TextColor3")
		end)
		table.insert(GUI._themeObjects, {obj=obj, role=role, prop="TextColor3"})
		_applyRole(obj, role, "TextColor3")
		return obj
	end

	function GUI:RegisterAccentObject(obj, prop)
		return regAccent(obj, prop)
	end

	function GUI:RegisterAccentText(obj)
		return regAccent(obj, "TextColor3")
	end

	function GUI:SetThemeObjectRole(obj, role, prop)
		if not obj then return false end
		for _, item in ipairs(GUI._themeObjects) do
			if item.obj == obj then
				item.role = tostring(role or item.role or "Surface")
				item.prop = prop or item.prop
				_applyRole(obj, item.role, item.prop)
				return true
			end
		end
		GUI:RegisterThemeObject(obj, role, prop)
		return true
	end

	function GUI:ApplyThemeTo(obj, role, prop)
		return _applyRole(obj, role or (obj and obj:GetAttribute("VenturaThemeRole")) or "Surface", prop)
	end

