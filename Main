local function destroyExistingVenturaGUI()
	_runtimeDisconnectAll()
	local containers = {}
	pcall(function()
		if type(gethui) == "function" then
			local hui = gethui()
			if hui then table.insert(containers, hui) end
		end
	end)
	pcall(function() table.insert(containers, CoreGui) end)
	pcall(function()
		local pg = LP:FindFirstChild("PlayerGui")
		if pg then table.insert(containers, pg) end
	end)
	for _, container in ipairs(containers) do
		for _, child in ipairs(container:GetChildren()) do
			if child:IsA("ScreenGui") and child.Name == "VenturaUI" then
				pcall(function() child:Destroy() end)
			end
		end
	end
end

function Library:UnloadAll()
	destroyExistingVenturaGUI()
	return true
end

function Library:GetRuntimeCounts()
	local aliveConnections, aliveInstances = 0, 0
	for _, conn in ipairs(_runtimeRoot.connections or {}) do
		if conn then aliveConnections = aliveConnections + 1 end
	end
	for _, inst in ipairs(_runtimeRoot.instances or {}) do
		if inst and inst.Parent then aliveInstances = aliveInstances + 1 end
	end
	return {
		connections = aliveConnections,
		instances = aliveInstances,
		shutdowns = #(_runtimeRoot.shutdowns or {}),
	}
end

-- Returns {kind="text"|"image", value=string}
local function resolveIcon(icon)
	if not icon or icon == "" then return {kind="none", value=""} end
	if type(icon) == "string" then
		if icon:match("^rbxasset") then return {kind="image", value=icon} end
		if icon:match("^%d+$") then return {kind="image", value="rbxassetid://"..icon} end
		-- anything else is a text/unicode icon
		return {kind="text", value=icon}
	end
	return {kind="none", value=""}
end

