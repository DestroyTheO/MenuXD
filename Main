		Tab.StatCard = Tab.MiniStat

		function Tab:CopyButton(opts)
			opts = validate({name="Copy", description="", text="", buttonText="Copy", icon=Library.Icons.copy, tooltip="", callback=nil}, opts)
			local hasDesc = tostring(opts.description or "") ~= ""
			local Copy = {Value = tostring(opts.text or "")}
			Copy.frame = base("CopyButton", hasDesc and 64 or 54)
			pad(Copy.frame, 0, 10, 0, 12)
			addTooltip(Copy.frame, opts.tooltip)
			labelPair(Copy.frame, opts.name, opts.description, 120, hasDesc and 10 or 16)
			local btn = Instance.new("TextButton", Copy.frame)
			btn.Name = "CopyActionButton"
			btn.AutoButtonColor = false
			btn.BackgroundColor3 = Library.Theme.Accent
			btn.BorderSizePixel = 0
			btn.Text = tostring(opts.icon or "") .. " " .. tostring(opts.buttonText or "Copy")
			btn.TextColor3 = Color3.fromRGB(255,255,255)
			btn.TextSize = 12
			btn.FontFace = FONT_UI_BOLD
			btn.AnchorPoint = Vector2.new(1, 0.5)
			btn.Position = UDim2.new(1, -8, 0.5, 0)
			btn.Size = UDim2.new(0, 96, 0, 30)
			btn.ZIndex = 3
			corner(btn, 8)
			regAccent(btn, "BackgroundColor3")
			btn.MouseEnter:Connect(function() tw(btn, {BackgroundColor3 = Library.Theme.Accent:Lerp(Color3.fromRGB(255,255,255), 0.16)}) end)
			btn.MouseLeave:Connect(function() tw(btn, {BackgroundColor3 = Library.Theme.Accent}) end)
			btn.MouseButton1Click:Connect(function()
				if type(setclipboard) == "function" then pcall(function() setclipboard(Copy.Value) end) end
				if type(opts.callback) == "function" then GUI:_invokeCallback(tostring(opts.name or opts.title or "control"), opts.callback, Copy.Value) end
				pcall(function() GUI:Notify("Copied", "Text copied to clipboard.", 2, "success") end)
			end)
			function Copy:Set(v) Copy.Value = tostring(v or ""); return Copy end
			function Copy:Get() return Copy.Value end
			function Copy:SetButtonText(v) btn.Text = tostring(opts.icon or "") .. " " .. tostring(v or "Copy"); return Copy end
			return _universalControl(Copy, opts)
		end

		function Tab:Stepper(opts)
			opts = validate({name="Stepper", description="", min=0, max=100, step=1, default=0, suffix="", tooltip="", callback=function()end}, opts)
			local hasDesc = tostring(opts.description or "") ~= ""
			local Stepper = {Value = tonumber(opts.default) or 0}
			local minV, maxV, stepV = tonumber(opts.min) or 0, tonumber(opts.max) or 100, math.max(tonumber(opts.step) or 1, 0.0001)
			Stepper.frame = base("Stepper", hasDesc and 66 or 56)
			pad(Stepper.frame, 0, 10, 0, 12)
			addTooltip(Stepper.frame, opts.tooltip)
			labelPair(Stepper.frame, opts.name, opts.description, 150, hasDesc and 10 or 16)
			local box = Instance.new("Frame", Stepper.frame)
			box.Name = "StepperBox"
			box.BackgroundColor3 = Library.Theme.Background
			box.BorderSizePixel = 0
			box.AnchorPoint = Vector2.new(1, 0.5)
			box.Position = UDim2.new(1, -8, 0.5, 0)
			box.Size = UDim2.new(0, 132, 0, 32)
			box.ZIndex = 3
			corner(box, 9); stroke(box, Library.Theme.BorderHover, 1)
			local minus = Instance.new("TextButton", box)
			minus.Name = "StepperMinus"; minus.AutoButtonColor=false; minus.BackgroundTransparency=1; minus.Text="−"; minus.TextSize=20; minus.FontFace=FONT_UI_BOLD; minus.TextColor3=Library.Theme.TextSecondary; minus.Size=UDim2.new(0,34,1,0); minus.ZIndex=4
			local plus = Instance.new("TextButton", box)
			plus.Name = "StepperPlus"; plus.AutoButtonColor=false; plus.BackgroundTransparency=1; plus.Text="+"; plus.TextSize=18; plus.FontFace=FONT_UI_BOLD; plus.TextColor3=Library.Theme.Accent; plus.AnchorPoint=Vector2.new(1,0); plus.Position=UDim2.new(1,0,0,0); plus.Size=UDim2.new(0,34,1,0); plus.ZIndex=4; regAccent(plus,"TextColor3")
			local value = lbl(box, "", 12, Library.Theme.TextPrimary, FONT_MONO_BOLD, Enum.TextXAlignment.Center)
			value.Name="StepperValue"; value.Position=UDim2.new(0,34,0,0); value.Size=UDim2.new(1,-68,1,0); value.ZIndex=4
			local function round(v) return math.floor((v / stepV) + 0.5) * stepV end
			local function render() value.Text = tostring(Stepper.Value) .. tostring(opts.suffix or "") end
			function Stepper:Set(v, silent)
				Stepper.Value = math.clamp(round(tonumber(v) or Stepper.Value or minV), minV, maxV)
				render()
				if not silent then GUI:_invokeCallback(tostring(opts.name or opts.title or "control"), opts.callback, Stepper.Value) end
				return Stepper
			end
			function Stepper:Get() return Stepper.Value end
			minus.MouseButton1Click:Connect(function() if Stepper.Disabled then return end; Stepper:Set(Stepper.Value - stepV) end)
			plus.MouseButton1Click:Connect(function() if Stepper.Disabled then return end; Stepper:Set(Stepper.Value + stepV) end)
			Stepper:Set(Stepper.Value, true)
			return _universalControl(Stepper, opts)
		end
		Tab.NumberStepper = Tab.Stepper

		function Tab:Segmented(opts)
			opts = validate({name="Segmented", description="", items={}, default=nil, tooltip="", callback=function()end}, opts)
			local hasDesc = tostring(opts.description or "") ~= ""
			local Seg = {Selected = opts.default or (type(opts.items)=="table" and opts.items[1])}
			Seg.frame = base("Segmented", hasDesc and 82 or 72)
			pad(Seg.frame, 0, 12, 10, 12)
			addTooltip(Seg.frame, opts.tooltip)
			labelPair(Seg.frame, opts.name, opts.description, 0, hasDesc and 8 or 10)
			local holder = Instance.new("Frame", Seg.frame)
			holder.Name = "SegmentedHolder"
			holder.BackgroundColor3 = Library.Theme.Background
			holder.BorderSizePixel = 0
			holder.Position = UDim2.new(0, 8, 1, -38)
			holder.Size = UDim2.new(1, -16, 0, 30)
			holder.ZIndex = 3
			corner(holder, 9); stroke(holder, Library.Theme.Border, 1)
			local list = Instance.new("UIListLayout", holder)
			list.FillDirection = Enum.FillDirection.Horizontal
			list.SortOrder = Enum.SortOrder.LayoutOrder
			list.Padding = UDim.new(0, 5)
			local buttons = {}
			local function redraw()
				for _, b in ipairs(buttons) do pcall(function() b:Destroy() end) end
				buttons = {}
				local items = type(opts.items) == "table" and opts.items or {}
				local count = math.max(#items, 1)
				for index, item in ipairs(items) do
					local selected = item == Seg.Selected
					local b = Instance.new("TextButton", holder)
					b.Name = "SegmentOption"
					b.AutoButtonColor = false
					b.BackgroundColor3 = selected and Library.Theme.Accent or Library.Theme.Surface
					b.TextColor3 = selected and Color3.fromRGB(255,255,255) or Library.Theme.TextSecondary
					b.Text = tostring(item)
					b.TextSize = 11
					b.FontFace = FONT_UI_BOLD
					b.BorderSizePixel = 0
					b.Size = UDim2.new(1/count, -math.max(0, (count-1)*5/count), 1, -8)
					b.Position = UDim2.new(0,0,0,4)
					b.ZIndex = 4
					b.LayoutOrder = index
					corner(b, 7)
					if selected then regAccent(b, "BackgroundColor3") end
					b.MouseButton1Click:Connect(function()
						if Seg.Disabled then return end
						Seg:Set(item)
					end)
					table.insert(buttons, b)
				end
			end
			function Seg:Set(v, silent)
				Seg.Selected = v
				redraw()
				if not silent then GUI:_invokeCallback(tostring(opts.name or opts.title or "control"), opts.callback, v) end
				return Seg
			end
			function Seg:Get() return Seg.Selected end
			function Seg:SetItems(items)
				opts.items = type(items) == "table" and items or {}
				local valid = false
				for _, item in ipairs(opts.items) do if item == Seg.Selected then valid = true break end end
				if not valid then Seg.Selected = opts.items[1] end
				redraw()
				return Seg
			end
			redraw()
			return _universalControl(Seg, opts)
		end
		Tab.SegmentedControl = Tab.Segmented
		Tab.Tabs = Tab.Segmented


		-- ── v5.46: more public component/function support ─────────────────────────
		local function _kindAccent(kind)
			kind = tostring(kind or "info"):lower()
			if kind == "success" then return Color3.fromRGB(85, 225, 140) end
			if kind == "warning" or kind == "warn" then return Color3.fromRGB(255, 195, 80) end
			if kind == "error" or kind == "danger" then return Color3.fromRGB(255, 80, 105) end
			if kind == "premium" or kind == "accent" then return Library.Theme.Accent end
			return Color3.fromRGB(95, 175, 255)
		end

