	function GUI:GetAnimationStyles()
		local out, seen = {}, {}
		local defaults = {"nova","galaxy","aurora","void","embers","toxic","ocean","sakura","luxury","matrix","neon","snow","storm","vortex","mist","bubbles","comets","fireflies","scanlines","prism","liquid","smoke","rain","meteor","orbit","pulsegrid","quantum","nebulaflow","wave","stardust","eclipse","firestorm","laser","waterfall","confetti","hyperspeed","blackhole","lightning","datastream","shards","solarwind","circuit","dreamcloud","heartbeat","gravwell","ripple","rainbow","forge","icecomet","lavalamp","shadowmist","neonpulse","galaxyring","electricgrid","matrixbloom","bloodcircuit","aurorafrost","eclipsepulse","toxicpulse","chromewave","hazerain","diamonds","tidalpulse","starfall","royalflow","portal","constellation","magnetic","plasmafield","snowburst","neonrain","sunburst","liquidgrid","nebularipple","starspiral","matrixflare","glassrain","cosmicdust","electricpulse","aurorawave","pixelstorm","crystalorbit","darkmatter","goldenembers","neoncomets"}
		for _, style in ipairs(defaults) do
			if not seen[style] then seen[style] = true; table.insert(out, style) end
		end
		for _, data in pairs(Library.Themes or {}) do
			if type(data) == "table" then
				local style = tostring(data.AnimationStyle or "")
				if style ~= "" and not seen[style] then seen[style] = true; table.insert(out, style) end
			end
		end
		table.sort(out)
		return out
	end

