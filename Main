		if V.miniFrame then return V.miniFrame end
		V.miniFrame = Instance.new("Frame", SG)
		V.miniFrame.Name = "FloatingMiniHUD"
		V.miniFrame.BackgroundColor3 = Library.Theme.Surface
		V.miniFrame.BorderSizePixel = 0
