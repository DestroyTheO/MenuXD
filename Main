local vp
do
	local cam = workspace.CurrentCamera or workspace:FindFirstChildWhichIsA("Camera")
	vp = (cam and cam.ViewportSize) or Vector2.new(1280, 720)
end
local winW = MOBILE and math.min(vp.X-20,640) or math.min(820, vp.X - 40)
local winH = math.min(580, vp.Y - 40)
local _defaultWinW, _defaultWinH = winW, winH
	local WIN_MIN_W = 340
	local WIN_MIN_H = 220
	local WIN_MAX_W = math.max(WIN_MIN_W, vp.X - 24)
	local WIN_MAX_H = math.max(WIN_MIN_H, vp.Y - 24)
	local function getViewportLimit()
		local cam = workspace.CurrentCamera
		local size = cam and cam.ViewportSize or Vector2.new(1280, 720)
		return math.max(WIN_MIN_W, size.X - 24), math.max(WIN_MIN_H, size.Y - 24)
	end

