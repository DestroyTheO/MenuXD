	function GUI:RebuildTheme() return GUI:ForceThemeRefresh() end

	function GUI:OnThemeChanged(callback)
		if type(callback) ~= "function" then return nil end
		table.insert(GUI._themeListeners, callback)
		local alive = true
		return {
			Disconnect = function()
				if not alive then return end
				alive = false
				for i = #GUI._themeListeners, 1, -1 do
					if GUI._themeListeners[i] == callback then table.remove(GUI._themeListeners, i) end
				end
			end,
		}
	end

	function GUI:GetThemePalette()
		local out = {}
		for k, v in pairs(Library.Theme) do out[k] = v end
		return out
	end

