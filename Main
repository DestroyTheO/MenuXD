		return _themeColor(role, Library.Theme.TextPrimary)
	end

	function GUI:GetDesignStyles()
		local out, seen = {}, {}
		for _, data in pairs(Library.Themes or {}) do
			if type(data) == "table" then
				local style = tostring(data.DesignStyle or data.AnimationStyle or "space")
				if style ~= "" and not seen[style] then
					seen[style] = true
					table.insert(out, style)
				end
			end
		end
		table.sort(out)
		return out
	end

	function GUI:GetThemesByStyle(style)
		style = tostring(style or ""):lower()
		local out = {}
		for name, data in pairs(Library.Themes or {}) do
			if type(data) == "table" then
				local ds = tostring(data.DesignStyle or data.AnimationStyle or ""):lower()
				if style == "" or ds == style then table.insert(out, name) end
			end
		end
		table.sort(out)
		return out
	end

