				{ name = "Neon Rain", icon = "🌧️", callback = function() GUI:SetThemeAnimationStyle("neonrain", true); GUI.notify("Theme FX", "Neon rain applied", 2, "success") end },
				{ name = "Constellation", icon = "✦", callback = function() GUI:SetThemeAnimationStyle("constellation", true); GUI.notify("Theme FX", "Constellation applied", 2, "success") end },
				{ name = "Liquid Grid", icon = "▦", callback = function() GUI:SetThemeAnimationStyle("liquidgrid", true); GUI.notify("Theme FX", "Liquid grid applied", 2, "success") end },
				{ name = "Nebula", icon = "〰", callback = function() GUI:SetThemeAnimationStyle("nebularipple", true); GUI.notify("Theme FX", "Nebula ripple applied", 2, "success") end },
				{ name = "Spiral", icon = "🌀", callback = function() GUI:SetThemeAnimationStyle("starspiral", true); GUI.notify("Theme FX", "Star spiral applied", 2, "success") end },
				{ name = "Pulse", icon = "⚡", callback = function() GUI:SetThemeAnimationStyle("electricpulse", true); GUI.notify("Theme FX", "Electric pulse applied", 2, "success") end },
				{ name = "Glass Rain", icon = "💧", callback = function() GUI:SetThemeAnimationStyle("glassrain", true); GUI.notify("Theme FX", "Glass rain applied", 2, "success") end },
			},
		})

		T:Section({ name = "Mix & Match" })
		local animationDrop = T:SearchDropdown({
			name              = "Animation Style",
			description       = "Mix any animation with any theme",
			items             = GUI:GetAnimationStyles(),
			default           = GUI:GetThemeAnimationStyle(),
			searchPlaceholder = "Search animations...",
			maxVisible        = 7,
			multi             = false,
			callback = function(style)
				GUI._themeMixAnimationStyle = tostring(style or "nova"):lower()
				GUI:SetThemeAnimationStyle(GUI._themeMixAnimationStyle, true)
			end,
		})


		T:ButtonGrid({
			name = "Animation Presets",
			columns = 4,
			buttons = {
				{ name = "Calm", icon = "🌙", callback = function() GUI:SetThemeAnimationPreset("calm"); GUI.notify("Animation", "Calm preset applied", 2, "info") end },
				{ name = "Balanced", icon = "✨", callback = function() GUI:SetThemeAnimationPreset("balanced"); GUI.notify("Animation", "Balanced preset applied", 2, "info") end },
				{ name = "Cinematic", icon = "🎬", callback = function() GUI:SetThemeAnimationPreset("cinematic"); GUI.notify("Animation", "Cinematic preset applied", 2, "info") end },
				{ name = "Hyper", icon = "⚡", callback = function() GUI:SetThemeAnimationPreset("hyper"); GUI.notify("Animation", "Hyper preset applied", 2, "warning") end },
			},
		})

		T:Slider({
			name = "Animation Speed",
			description = "Controls how fast theme background effects move",
			min = 15, max = 350, default = math.floor((GUI:GetAnimationSpeed() or 1) * 100 + 0.5), suffix = "%", showRange = true,
			config = false, noConfig = true, save = false, persist = false,
			valueFormatter = function(v) return tostring(v) .. "%" end,
			callback = function(v) GUI:SetAnimationSpeed((tonumber(v) or 100) / 100) end,
		})

		T:Slider({
			name = "Animation Intensity",
			description = "Controls how dramatic the theme movement feels",
			min = 15, max = 275, default = math.floor((GUI:GetAnimationIntensity() or 1) * 100 + 0.5), suffix = "%", showRange = true,
			config = false, noConfig = true, save = false, persist = false,
			valueFormatter = function(v) return tostring(v) .. "%" end,
			callback = function(v) GUI:SetAnimationIntensity((tonumber(v) or 100) / 100) end,
		})

		local accentNames = GUI:GetAccentPresets()
		local currentAccentPreset = GUI:GetAccentPresetFromColor(Library.Theme.Accent) or accentNames[1] or "Blue"
		local accentDrop = T:SearchDropdown({
			name              = "Accent Preset",
