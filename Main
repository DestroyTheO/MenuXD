		T:Section({ name = "Accent Color" })
		local function applyAccent(c)
			GUI:SetAccent(c)
		end

		-- Accent RGB sliders stay removed for performance. Accent editing uses preset, picker, and HEX/RGB input.
		local hexInput
		local _syncingAccentInput = false
		local function syncAccentInputsFromColor(c)
			if _syncingAccentInput or typeof(c) ~= "Color3" then return end
			_syncingAccentInput = true
			if hexInput then hexInput:Set("#" .. GUI:_c3ToHex(c), true) end
			_syncingAccentInput = false
		end

		local accentCP = T:ColorPicker({
			name     = "Custom Accent",
			tooltip  = "HSV color picker with live preview.",
			default  = Library.Theme.Accent,
			callback = function(c)
				if _syncingAccentInput then return end
				applyAccent(c)
				syncAccentInputsFromColor(c)
			end,
		})
		GUI._accentDropdown = accentDrop
		GUI._cfgSyncCallbacks.accent = function(c)
			syncAccentInputsFromColor(c)
			pcall(function() accentCP:Set(c, true) end)
			local preset = GUI:GetAccentPresetFromColor(c)
			if preset and accentDrop and type(accentDrop.Set) == "function" then
				pcall(function() accentDrop:Set(preset, true) end)
			end
		end

		local function parseRGB(s)
			local r,g,b = tostring(s):match("(%d+)[,%s]+(%d+)[,%s]+(%d+)")
			if r then return Color3.fromRGB(math.clamp(tonumber(r) or 0,0,255), math.clamp(tonumber(g) or 0,0,255), math.clamp(tonumber(b) or 0,0,255)) end
		end
		local function parseHex(s)
			local h = tostring(s or ""):gsub("#",""):gsub("0x","")
			if #h == 6 and h:match("^[%da-fA-F]+$") then return _hexToC3(h) end
		end
		hexInput = T:TextInput({
			name        = "HEX / RGB Value",
			placeholder = "#6496FF or 100,150,255",
			default     = "#" .. GUI:_c3ToHex(Library.Theme.Accent),
			tooltip     = "Type a hex or RGB color then press Enter",
			callback    = function(s)
				local c = parseHex(s) or parseRGB(s)
				if c then accentCP:Set(c, true); syncAccentInputsFromColor(c); applyAccent(c) end
			end,
		})

		T:Section({ name = "Custom Theme Builder" })
