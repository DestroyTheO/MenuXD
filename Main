		V.minimizeBubbleAccent.Size = UDim2.new(0, 28, 0, 4)
		V.minimizeBubbleAccent.BackgroundColor3 = Library.Theme.Accent
		V.minimizeBubbleAccent.BackgroundTransparency = 0.18
		V.minimizeBubbleAccent.BorderSizePixel = 0
		V.minimizeBubbleAccent.ZIndex = 853
		corner(V.minimizeBubbleAccent, 100)
		regAccent(V.minimizeBubbleAccent)

		V.minimizeBubbleInner = Instance.new("Frame", V.minimizeBubble)
		V.minimizeBubbleInner.Name = "InnerCircle"
		V.minimizeBubbleInner.AnchorPoint = Vector2.new(0.5, 0.5)
		V.minimizeBubbleInner.Position = UDim2.fromScale(0.5, 0.5)
		V.minimizeBubbleInner.Size = UDim2.new(0, 42, 0, 42)
		V.minimizeBubbleInner.BackgroundColor3 = Color3.fromRGB(18,18,22)
		V.minimizeBubbleInner.BackgroundTransparency = 0.08
		V.minimizeBubbleInner.BorderSizePixel = 0
		V.minimizeBubbleInner.ZIndex = 852
		corner(V.minimizeBubbleInner, 100)
		local innerStroke = stroke(V.minimizeBubbleInner, Color3.fromRGB(55,55,65), 1)
		innerStroke.Transparency = 0.15

		-- Animated orbit rings. They recolor to every active theme.
		for _, spec in ipairs({
			{34, 34, -18, 0.76},
			{24, 24,  22, 0.84},
		}) do
			local orbit = Instance.new("Frame", V.minimizeBubbleInner)
			orbit.Name = "BubbleSpaceOrbit"
			orbit.AnchorPoint = Vector2.new(0.5, 0.5)
			orbit.Position = UDim2.fromScale(0.5, 0.5)
			orbit.Size = UDim2.new(0, spec[1], 0, spec[2])
			orbit.BackgroundTransparency = 1
			orbit.BorderSizePixel = 0
			orbit.Rotation = spec[3]
			orbit.Visible = true
			orbit.ZIndex = 853
			corner(orbit, 100)
			local orbitStroke = stroke(orbit, Color3.fromRGB(130, 205, 255), 1)
			orbitStroke.Transparency = spec[4]
		end

		-- Tiny animated star specks. They recolor to every active theme.
		for _, spec in ipairs({
			{0.30, 0.28, 2}, {0.68, 0.33, 1}, {0.40, 0.73, 1}, {0.74, 0.66, 2}, {0.22, 0.58, 1}
		}) do
