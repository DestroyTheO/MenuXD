		              Size     = UDim2.new(1, -(navW+28), 1, -64) }, TI_SLOW)
			for _, b in ipairs(_sbLines) do tw(b, {BackgroundColor3 = Library.Theme.TextSecondary}) end
		else
			-- Slide nav out
			tw(Nav,     { Size     = UDim2.new(0, 0, 1, -34) }, TI_SLOW)
			tw(Content, { Position = UDim2.new(0, 10, 0, 46),
			              Size     = UDim2.new(1, -20, 1, -56) }, TI_SLOW)
			for _, b in ipairs(_sbLines) do tw(b, {BackgroundColor3 = Library.Theme.Accent}) end
		end
	end)

	local NOTIF_W      = 260
	local NOTIF_H      = 56
	local NOTIF_PAD    = 8
	local NOTIF_RIGHT  = 14
	local NOTIF_BOTTOM = 14
	local _notifStack  = {}
	GUI._notificationStack = _notifStack

	local function _notifNormalizeArgs(title, text, duration, ntype)
		-- v5.73: old notification visuals restored, but keep table-style calls from
		-- newer demos/scripts from breaking. Actions/progress-position features are
		-- intentionally ignored so the toast looks like the older Ventura style.
		if type(title) == "table" then
			local opts = title
			return tostring(opts.title or opts.name or "VenturaUI"),
				tostring(opts.message or opts.text or opts.description or ""),
				tonumber(opts.duration or opts.time or 3) or 3,
				tostring(opts.type or opts.ntype or opts.kind or "info")
		end
		return tostring(title or "VenturaUI"), tostring(text or ""), tonumber(duration or 3) or 3, tostring(ntype or "info")
	end

	local function _notifReflow()
		local yOff = NOTIF_BOTTOM
		for i = 1, #_notifStack do
			local card = _notifStack[i]
			if card and card.Parent then
				local targetY = -(yOff)
				tw(card, { Position = UDim2.new(1, -(NOTIF_W + NOTIF_RIGHT), 1, targetY) }, TI_FAST)
				yOff = yOff + NOTIF_H + NOTIF_PAD
			end
		end
	end

	local function _removeCard(card)
		for i, c in ipairs(_notifStack) do
			if c == card then table.remove(_notifStack, i); break end
		end
		_notifReflow()
	end

	local function _notifAccent(ntype)
		ntype = tostring(ntype or ""):lower()
		return ntype == "success" and Color3.fromRGB(60,200,100)
			or (ntype == "warning" or ntype == "warn") and Color3.fromRGB(230,180,0)
			or (ntype == "error" or ntype == "danger") and Color3.fromRGB(220,60,60)
			or ntype == "loading" and Color3.fromRGB(120,180,255)
			or ntype == "debug" and Color3.fromRGB(185,145,255)
			or ntype == "info" and Color3.fromRGB(80,160,255)
			or Library.Theme.Accent
	end

	local function _notifIcon(ntype)
		ntype = tostring(ntype or ""):lower()
		return (ntype == "success" and "✅ ")
			or ((ntype == "warning" or ntype == "warn") and "⚠️ ")
			or ((ntype == "error" or ntype == "danger") and "❌ ")
			or (ntype == "loading" and "⏳ ")
			or (ntype == "debug" and "🐛 ")
			or (ntype == "info" and "ℹ️ ")
			or ""
	end

	-- ══════════════════════════════════════════════════════════════════════
	-- NOTIFICATION SYSTEM — Classic Ventura style restored
	-- ══════════════════════════════════════════════════════════════════════
	function GUI.notify(title, text, duration, ntype)
		title, text, duration, ntype = _notifNormalizeArgs(title, text, duration, ntype)
		local accentCol = _notifAccent(ntype)

		local card = Instance.new("Frame", SG)
		card.Name             = "_Notif"
		card.Size             = UDim2.new(0, NOTIF_W, 0, NOTIF_H)
		card.BackgroundColor3 = Library.Theme.Surface
		card.BorderSizePixel  = 0
		card.Position         = UDim2.new(1, NOTIF_RIGHT + NOTIF_W + 40, 1, -(NOTIF_BOTTOM))
		card.AnchorPoint      = Vector2.new(0, 1)
		card.ZIndex           = 600
		corner(card, 6)
		stroke(card, Library.Theme.Border)

		local accent = Instance.new("Frame", card)
		accent.Size             = UDim2.new(0, 3, 1, 0)
		accent.BackgroundColor3 = accentCol
		accent.BorderSizePixel  = 0
		accent.ZIndex           = 601
		corner(accent, 2)

		local progBg = Instance.new("Frame", card)
		progBg.Size             = UDim2.new(1, 0, 0, 2)
		progBg.Position         = UDim2.new(0, 0, 1, -2)
		progBg.BackgroundColor3 = Library.Theme.Border
		progBg.BorderSizePixel  = 0
		progBg.ZIndex           = 601

		local progFill = Instance.new("Frame", progBg)
		progFill.Size             = UDim2.new(1, 0, 1, 0)
		progFill.BackgroundColor3 = accentCol
		progFill.BorderSizePixel  = 0
		progFill.ZIndex           = 602

		local tTitle = lbl(card, _notifIcon(ntype)..title, 12, Library.Theme.TextPrimary,
			Font.new("rbxasset://fonts/families/Ubuntu.json", Enum.FontWeight.Bold))
		tTitle.Size     = UDim2.new(1, -18, 0, 16)
		tTitle.Position = UDim2.new(0, 12, 0, 8)
		tTitle.ZIndex   = 601

		local tText = lbl(card, text, 11, Library.Theme.TextSecondary)
		tText.Size           = UDim2.new(1, -18, 0, 24)
		tText.Position       = UDim2.new(0, 12, 0, 26)
		tText.ZIndex         = 601
		tText.TextWrapped    = true
		tText.TextYAlignment = Enum.TextYAlignment.Top

		table.insert(_notifStack, 1, card)
		_notifReflow()

		local targetPos = UDim2.new(1, -(NOTIF_W + NOTIF_RIGHT), 1, -(NOTIF_BOTTOM))
		card.Position = UDim2.new(1, NOTIF_W + NOTIF_RIGHT + 40, 1, -(NOTIF_BOTTOM))
		tw(card, { Position = targetPos }, TI_FAST)
		tw(progFill, { Size = UDim2.new(0, 0, 1, 0) }, TweenInfo.new(duration, Enum.EasingStyle.Linear))

		local removed = false
		local function dismissCard()
			if removed or not card or not card.Parent then return end
			removed = true
			_removeCard(card)
			tw(card, {
				Position = UDim2.new(1, NOTIF_W + NOTIF_RIGHT + 40, 1, card.Position.Y.Offset),
				BackgroundTransparency = 1
			}, TI_FAST, function()
				pcall(function() card:Destroy() end)
			end)
		end

		card.InputBegan:Connect(function(inp)
			if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
				dismissCard()
			end
		end)

		task.delay(duration, dismissCard)
		return { Dismiss = dismissCard, Close = dismissCard, Instance = card }
	end

	function GUI:Notify(title, text, duration, ntype)
		return GUI.notify(title, text, duration, ntype)
	end
	function GUI:Notification(options)
		return GUI.notify(options)
	end
	function GUI:Toast(title, text, duration, ntype)
		return GUI.notify(title, text, duration, ntype)
	end
	function GUI:Success(title, text, duration)
		return GUI.notify(title, text, duration or 3, "success")
	end
	function GUI:Warn(title, text, duration)
		return GUI.notify(title, text, duration or 3, "warning")
	end
	function GUI:Warning(title, text, duration)
		return GUI.notify(title, text, duration or 3, "warning")
	end
	function GUI:Error(title, text, duration)
		return GUI.notify(title, text, duration or 3, "error")
	end
	function GUI:Info(title, text, duration)
		return GUI.notify(title, text, duration or 3, "info")
	end
	function GUI:ClearNotifications()
		for i = #_notifStack, 1, -1 do
			local card = _notifStack[i]
			if card and card.Parent then pcall(function() card:Destroy() end) end
			_notifStack[i] = nil
		end
	end
	function GUI:SetNotificationPosition(_position)
		-- Classic notifications are fixed bottom-right. Kept as a safe no-op for
		-- scripts written against v5.70+.
		return false
	end
	function GUI:GetNotificationPosition()
		return "bottom-right"
	end
	function GUI:SetNotificationMax(_maxCount)
		return false
	end
	function GUI:GetNotifications()
		return _notifStack
	end

	-- ══════════════════════════════════════════════════════════════════════
	-- WINDOW CONTROLS — Minimize, Destroy, Title, SelectTab
	-- ══════════════════════════════════════════════════════════════════════
	local _mainTween = nil  -- tracks active tween on Main so we can cancel it

	-- Small draggable restore circle shown while the main window is minimized.
	V.minimizeBubbleIcon, V.minimizeBubbleStroke, V.minimizeBubbleAccent = nil, nil, nil
	V.minimizeBubbleShadow, V.minimizeBubbleInner, V.minimizeBubbleGlow, V.minimizeBubbleDot, V.minimizeBubbleRing, V.minimizeBubbleGradient = nil, nil, nil, nil, nil, nil
	V.bubbleDragging, V.bubbleDragStart, V.bubbleStartPos, V.bubbleMoved = false, nil, nil, false
	V.doMinimize = nil
	local function _bubbleIconText()
		-- 5.12: modern bubble is icon-free; keep function for old scripts without rendering emoji/text.
		return ""
	end

	local function _styleMinimizeBubble()
		if not V.minimizeBubble then return end
		local accent = Library.Theme.Accent
		local themeName = tostring(GUI._savedTheme or GUI._activeTheme or "Dark")
		local themeKey = themeName:lower()
		local bg = Library.Theme.Background or Color3.fromRGB(8, 8, 12)
		local surface = Library.Theme.Surface or Color3.fromRGB(18, 18, 22)
		local hover = Library.Theme.SurfaceHover or surface
		local border = Library.Theme.BorderHover or Library.Theme.Border or accent
		local starColor = Library.Theme.TextPrimary or Color3.fromRGB(245,245,255)

		-- 5.20: every theme gets the animated orbit/star bubble. The colors are
		-- pulled from the current theme so it no longer looks like the default dark one.
		local shell = bg:Lerp(accent, themeKey == "space" and 0.18 or 0.11)
		local inner = surface:Lerp(accent, themeKey == "space" and 0.16 or 0.09)
		local top = hover:Lerp(accent, 0.28)
		local bottom = bg:Lerp(Color3.fromRGB(0,0,0), 0.28)

		V.minimizeBubble.BackgroundColor3 = shell
		if V.minimizeBubbleStroke then V.minimizeBubbleStroke.Color = border:Lerp(accent, 0.45) end
		if V.minimizeBubbleAccent then
			V.minimizeBubbleAccent.BackgroundColor3 = accent
			V.minimizeBubbleAccent.Visible = false
		end
		if V.minimizeBubbleGlow then
			V.minimizeBubbleGlow.BackgroundColor3 = accent
			V.minimizeBubbleGlow.BackgroundTransparency = themeKey == "space" and 0.60 or 0.68
		end
		if V.minimizeBubbleRing then
			V.minimizeBubbleRing.BackgroundColor3 = accent
			V.minimizeBubbleRing.BackgroundTransparency = themeKey == "space" and 0.80 or 0.84
		end
		if V.minimizeBubbleDot then V.minimizeBubbleDot.BackgroundColor3 = accent end
		if V.minimizeBubbleInner then
			V.minimizeBubbleInner.BackgroundColor3 = inner
		end
		if V.minimizeBubbleGradient then
			V.minimizeBubbleGradient.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, top),
				ColorSequenceKeypoint.new(0.52, shell),
				ColorSequenceKeypoint.new(1, bottom),
			})
		end
		for _, child in ipairs(V.minimizeBubble:GetDescendants()) do
			if child.Name == "BubbleStar" then
				child.Visible = true
				child.BackgroundColor3 = starColor:Lerp(accent, 0.18)
			elseif child.Name == "ModernMarkAccentTop" or child.Name == "ModernMarkMiddle" or child.Name == "ModernMarkAccentBottom" then
				child.Visible = false
			elseif child.Name == "BubbleSpaceOrbit" then
				child.Visible = true
				local st = child:FindFirstChildOfClass("UIStroke")
				if st then
					st.Color = accent:Lerp(starColor, 0.35)
					st.Transparency = themeKey == "space" and 0.70 or 0.78
				end
			end
		end
	end

	local function _createMinimizeBubble()
		if V.minimizeBubble then return V.minimizeBubble end
		V.minimizeBubble = Instance.new("TextButton", SG)
		V.minimizeBubble.Name = "MinimizeRestoreCircle"
