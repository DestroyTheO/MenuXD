local function getScreenGuiParent()
	local hui
	pcall(function()
		if type(gethui) == "function" then hui = gethui() end
	end)
	if hui then return hui end
	local pg
	pcall(function()
		pg = LP and (LP:FindFirstChildOfClass("PlayerGui") or LP:WaitForChild("PlayerGui", 5))
	end)
	if RunService:IsStudio() and pg then return pg end
	local okCore = pcall(function()
		local probe = Instance.new("Folder")
		probe.Name = "_VenturaParentProbe"
		probe.Parent = CoreGui
		probe:Destroy()
	end)
	if okCore then return CoreGui end
	return pg or CoreGui
end

local function parentScreenGuiSafely(sg)
	if not sg then return false end
	local parent = getScreenGuiParent()
	local ok = pcall(function() sg.Parent = parent end)
	if ok and sg.Parent then return true end
	local pg
	pcall(function()
		pg = LP and (LP:FindFirstChildOfClass("PlayerGui") or LP:WaitForChild("PlayerGui", 5))
	end)
	if pg then
		ok = pcall(function() sg.Parent = pg end)
		if ok and sg.Parent then return true end
	end
	ok = pcall(function() sg.Parent = CoreGui end)
	return ok and sg.Parent ~= nil
end

function Library:new(options)
	local _rawOptions = type(options) == "table" and options or {}
	-- v5.79: configProfile is treated as the default profile/namespace, not a hard override.
	-- Only an explicit `profile = "Name"` should block saved Auto Load from choosing the profile.
	local _explicitProfileOverride = _rawOptions.profile ~= nil and tostring(_rawOptions.profile or "") ~= ""
	options=validate({
		name            = "Ventura UI",
		subtitle        = nil,
		toggleKey       = Enum.KeyCode.Insert,
		-- 5.34: separate minimize UI/key removed. Legacy scripts may still pass
		-- minimizeKey, but the toggle key owns the bubble flow now.
		minimizeKey     = nil,
		loadingTime     = 1.5,
		safeLoad        = false, -- v5.77: load heavier tabs/modules in small chunks instead of one big freeze
		slowLoad        = false, -- alias: true enables safeLoad
		safeLoadDelay   = 0.025, -- delay between small chunks while safe loading
		safeLoadBatch   = 3, -- number of UI control builds before yielding
		safeLoadShowSteps = true, -- update loader subtitle while chunks are being built
		safeLoadStarCount = 34, -- lower animated background dot count during safe load
		animationStarCount = nil, -- optional override for theme/background dots
		animationFPSCap = nil, -- optional cap for theme animation updates
		accent          = nil,
		theme           = nil,
		configProfile   = "Default",
		profile         = nil,
		autoLoad        = false, -- 5.35: no config auto-load unless the script/user explicitly enables it
		autoLoadConfig  = false,
		configAutoLoad  = false,
		autoSave        = false, -- opt-in only; nothing writes automatically unless enabled
		autoSaveInterval= 10,
		autoConfigFlags = true, -- controls can save by stable name when no explicit flag is provided
		onClose         = nil,
		watermark       = nil,
		watermarkStats  = true,    -- show FPS + ping in the top-right watermark bar
		watermarkRuntime = true,  -- show how long this script/UI has been running in the top-right bar
		watermarkRuntimeLabel = "RAN", -- label used before the formatted runtime text
		watermarkResizable = false, -- v5.46: top-right bar resize handle removed by default
		watermarkAutoSize  = nil,  -- nil = auto unless a manual width is provided; true/false forces behavior
		watermarkWidth     = nil,  -- manual top-right bar width; aliases: topRightBarWidth/statusBarWidth
		watermarkHeight    = 30,   -- manual top-right bar height; aliases: topRightBarHeight/statusBarHeight
		watermarkMinWidth  = 130,
		watermarkMaxWidth  = 720,
		watermarkMinHeight = 24,
		watermarkMaxHeight = 64,
		topRightBarWidth   = nil,
		topRightBarHeight  = nil,
		statusBarWidth     = nil,
		statusBarHeight    = nil,
		destroyOnRespawn= false,
		forceRebuild     = false, -- always replace the current window for this builder pass
		reuseExisting    = true,  -- allows respawn-only duplicate absorption
		reuseExistingMode = "respawn", -- "respawn" (default), "always", or "never"
		replaceExistingOnExecute = true, -- normal re-execution destroys and replaces the old UI
		respawnReuseWindow = 6, -- seconds in which one immediate respawn builder pass may be absorbed
		reconnectOnRespawn = false, -- opt-in only; prevents heavy callbacks replaying after every respawn
		reconnectDelay   = 0.85,
		keyEnabled      = false,
		key             = nil,
		keyLink         = nil,
		onKeySuccess    = nil,
		onKeyFail       = nil,
		aiEnabled       = false,   -- set true for a free built-in AI assistant (no key needed)
		floatingMiniUI  = false,   -- legacy separate top-right HUD; off by default
		miniUI          = nil,     -- alias: true only if you intentionally want the old top-right HUD
		miniTitle       = "VENTURA",
		responsiveScale = true,    -- resize the window when the viewport changes without moving it
		lockWindowPosition = true, -- preserve the dragged position across respawn/camera/config changes
		resizeSnap      = false,   -- opt-in only; ignored while lockWindowPosition is enabled
		resizeSnapMode  = "center", -- legacy option retained for compatibility
		looseDragBounds = false,   -- legacy option; drag borders are removed in 5.8
		dragBounds      = false,   -- false = no screen-edge clamping at all
		offscreenGrip   = 0,       -- legacy option kept for compatibility
		dragOutMultiplier = 1.0,  -- normal 1:1 dragging by default
		minimizeBubbleIcon = nil, -- legacy compatibility; modern bubble no longer renders icon text
		toggleCreatesBubble = true, -- toggle key collapses/restores through the draggable bubble
		goodbyeNotification = false, -- off by default so closing stops activity immediately
		fontScale       = 100,   -- v5.59: visual-only text/font size percentage
		fontSize        = nil,   -- alias for fontScale; use 80-140 for percent
		themeAccent      = true,  -- v5.41: changing themes also changes accent color by default
		followThemeAccent= true,  -- aliases kept for older scripts
		useThemeAccent   = true,
		performanceMode  = "auto", -- auto, balanced, low, or off
		performanceLowFPS = 42,
		performanceRecoverFPS = 54,
		slowCallbackMs   = 50,
		callbackReentryGuard = true,
		lazyTabs         = false, -- opt-in: use Tab:BuildLazy(function(Tab) ... end)
		configSchemaVersion = 2,
		normalizedPosition = true,
	}, options)

	if options.theme and Library.Themes and Library.Themes[options.theme] then
		local bootTheme = Library.Themes[options.theme]
		for k,v in pairs(bootTheme) do
			if k ~= "UserBox" and k ~= "Accent" then Library.Theme[k] = v end
		end
		if options.accent == nil then
			Library.Theme.Accent = _themeAccentFor(options.theme, bootTheme)
		end
	end
	if options.accent then Library.Theme.Accent=options.accent end

	-- Re-execution policy:
	--   • Normal execution replaces the old UI.
	--   • The immediate auto-execute pass after CharacterAdded may be absorbed once.
	--   • forceRebuild=true always replaces.
	--   • reuseExistingMode="always" restores the old permanent-singleton behavior.
	local _activeWindow = _runtimeRoot.activeWindow
	local _activeScreenGui = _runtimeRoot.activeScreenGui
	local _activeAlive = false
	pcall(function()
		_activeAlive = _activeWindow ~= nil
			and _activeScreenGui ~= nil
			and _activeScreenGui.Parent ~= nil
			and _activeScreenGui:IsA("ScreenGui")
	end)

	local _reuseMode = tostring(options.reuseExistingMode or "respawn"):lower()
	if _reuseMode ~= "respawn" and _reuseMode ~= "always" and _reuseMode ~= "never" then
		_reuseMode = "respawn"
	end

	local _forceRebuild = options.forceRebuild == true
	local _reuseAllowed = options.reuseExisting ~= false and _reuseMode ~= "never"
	local _insideRespawnWindow = os.clock() <= (tonumber(_runtimeRoot.respawnGuardUntil) or 0)
	local _sameRespawnCharacter = _runtimeRoot.respawnCharacter ~= nil
		and _runtimeRoot.respawnCharacter == LP.Character
	local _hasRespawnCredit = (tonumber(_runtimeRoot.respawnReuseCredits) or 0) > 0
	local _isRespawnBuilderPass = _activeAlive
		and _reuseAllowed
		and _reuseMode == "respawn"
		and _insideRespawnWindow
		and _sameRespawnCharacter
		and _hasRespawnCredit
	local _alwaysReuse = _activeAlive
		and _reuseAllowed
		and _reuseMode == "always"

	if not _forceRebuild and (_isRespawnBuilderPass or _alwaysReuse) then
		if _isRespawnBuilderPass then
			_runtimeRoot.respawnReuseCredits = math.max(
				0,
				(tonumber(_runtimeRoot.respawnReuseCredits) or 1) - 1
			)
			_runtimeRoot.lastBuilderAction = "reused-after-respawn"
		else
			_runtimeRoot.lastBuilderAction = "reused-always"
		end
		_runtimeRoot.activeCharacter = LP.Character
		return _makeRespawnBuilderSink(_activeWindow)
	end

	-- Default behavior for a normal second execution: stop the old callbacks,
	-- destroy the old ScreenGui, and build the newest version.
	if _activeAlive then
		_runtimeRoot.lastBuilderAction = "replaced-existing"
	else
		_runtimeRoot.lastBuilderAction = "created-new"
	end
	destroyExistingVenturaGUI()

	local keys            = {toggle=_safeEnumKey(options.toggleKey, Enum.KeyCode.Insert)}
	local keybindListening= false
	local currentScale    = 100
	local _destroyed      = false
	local _connections    = {}

	local function getOffscreenGrip(defaultGrip)
		-- 5.8 removes drag borders entirely. This is kept so older scripts using
		-- SetOffscreenGrip/GetOffscreenGrip do not error.
		local g = tonumber(options.offscreenGrip) or defaultGrip or 0
		return math.max(0, math.floor(g + 0.5))
	end

	local function getDragOutMultiplier()
		return math.clamp(tonumber(options.dragOutMultiplier) or 1, 0.1, 5)
	end

	local function _dragBordersEnabled()
		return options.dragBounds == true
	end

	local function _offsetPosition(pos, fallbackX, fallbackY)
		local cam = workspace.CurrentCamera
		local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
		if not pos then return UDim2.new(0, fallbackX or 14, 0, fallbackY or 14) end
		local x = pos.X.Offset
		local y = pos.Y.Offset
		if pos.X.Scale ~= 0 then x = math.floor(vp.X * pos.X.Scale + pos.X.Offset + 0.5) end
		if pos.Y.Scale ~= 0 then y = math.floor(vp.Y * pos.Y.Scale + pos.Y.Offset + 0.5) end
		return UDim2.new(0, x, 0, y)
	end

	local GUI = {CurrentTab=nil, _tabs={}, _open=true, _accentObjects={}, _themeObjects={}, _themeListeners={}, _keybindWidgets={}, _activeKeybind=nil, _configControls={}, _controls={}, _toggleControls={}, _reconnectControls={}, _reconnectCallbacks={}, _loadedConfigData=nil, _configApplying=false, _destroyCallbacks={}, _cleanupCallbacks={}, _trackedProperties={}, _trackedHumanoidProperties={}, _trackedInstances={}, _ownerBuckets={}, _callbackStats={}, _callbackActive={}, _callbackHistory={}, _configMigrations={}, _values={}, _activityStopped=false, _closing=false, _reconnectEnabled=(options.reconnectOnRespawn == true), _reconnectDelay=tonumber(options.reconnectDelay) or 0.85, _respawnToken=0}

	-- v5.77 Safe / Slow Load ----------------------------------------------------
	-- Heavy theme/settings pages can be built in small chunks. This keeps the UI
	-- responsive during startup and prevents one giant frame hitch on slower PCs.
	local _safeLoadState = {
		enabled = (options.safeLoad == true or options.slowLoad == true),
		delay = math.clamp(tonumber(options.safeLoadDelay) or 0.025, 0, 0.25),
		batch = math.max(1, math.floor(tonumber(options.safeLoadBatch) or 3)),
		step = 0,
		lastYield = os.clock(),
		lastLabel = "",
		subtitle = nil,
		uiReady = false, -- v5.81: loader waits for deferred Themes/Settings before opening the window
	}
	GUI._safeLoadState = _safeLoadState

	local function _safeLoadSetLabel(label)
		label = tostring(label or "Loading...")
		_safeLoadState.lastLabel = label
		if options.safeLoadShowSteps ~= false and _safeLoadState.subtitle then
			pcall(function() _safeLoadState.subtitle.Text = label end)
		end
	end

	local function _safeLoadYield(label, force)
		if not _safeLoadState.enabled or _destroyed then return end
		_safeLoadState.step = (_safeLoadState.step or 0) + 1
		if label then _safeLoadSetLabel(label) end
		local dueBatch = ((_safeLoadState.step % _safeLoadState.batch) == 0)
		local dueTime = (os.clock() - (_safeLoadState.lastYield or 0)) >= 0.020
		if force or dueBatch or dueTime then
			_safeLoadState.lastYield = os.clock()
			task.wait(_safeLoadState.delay)
		end
	end

	local function _safeLoadWrapTab(tab, label)
		if not _safeLoadState.enabled or type(tab) ~= "table" or tab._safeLoadWrapped then return tab end
		tab._safeLoadWrapped = true
		local methods = {
			"Section", "Info", "Label", "Divider", "Separator", "Button", "ButtonGrid",
			"Toggle", "Slider", "Dropdown", "SearchDropdown", "ColorPicker", "TextInput",
			"Keybind", "StatusCard", "Stat", "StatCard", "MiniStat", "NumberDisplay", "ValueDisplay", "PriceDisplay", "TotalDisplay", "Total", "ButtonRow",
			"ActionRow", "Actions", "ToggleButton", "ToggleCard", "CodeBlock", "SearchBox",
			"MultiDropdown", "MultiSelect", "MultiSelectDropdown", "Spacer",
		}
		for _, methodName in ipairs(methods) do
			local raw = tab[methodName]
			if type(raw) == "function" then
				tab[methodName] = function(self, ...)
					_safeLoadYield((label or "Tab") .. ": " .. methodName)
					local ok, result = pcall(raw, self, ...)
					if not ok then
						warn("[VenturaUI] SafeLoad skipped " .. tostring(label or "Tab") .. "." .. tostring(methodName) .. ": " .. tostring(result))
						return nil
					end
					_safeLoadYield((label or "Tab") .. ": " .. methodName .. " ready")
					return result
				end
			end
		end
		return tab
	end

	function GUI:GetSafeLoadStatus()
		return {
			enabled = _safeLoadState.enabled == true,
			step = _safeLoadState.step or 0,
			delay = _safeLoadState.delay,
			batch = _safeLoadState.batch,
			lastLabel = _safeLoadState.lastLabel,
		}
	end

	function GUI:SetSafeLoadDelay(delaySeconds)
		_safeLoadState.delay = math.clamp(tonumber(delaySeconds) or _safeLoadState.delay or 0.025, 0, 0.25)
		return _safeLoadState.delay
	end

	function GUI:SetSafeLoadEnabled(state)
		_safeLoadState.enabled = state == true
		return _safeLoadState.enabled
	end

	function GUI:SafeYield(label)
		return _safeLoadYield(label or "Safe loading...", true)
	end
	GUI._smartContrastEnabled = true
	GUI._themeTransitionEnabled = true
	GUI._themeTransitionDuration = 0.28
	GUI._themeMixAnimationStyle = nil
	GUI._themeMixGlow = true
	GUI._themeCategoryFilter = "All"
	-- v5.41 accent state: themes own the accent by default so every theme feels distinct.
	-- Pass themeAccent=false / followThemeAccent=false / useThemeAccent=false to lock a custom accent.
	GUI._themeAccentMode = not (options.themeAccent == false or options.followThemeAccent == false or options.useThemeAccent == false)
	GUI._manualAccent = (options.accent ~= nil and GUI._themeAccentMode ~= true)
	GUI._savedAccent = Library.Theme.Accent
	GUI._accentPresetName = nil
	-- v5.59 font scaling is visual-only by default. It does not add or change config keys.
	GUI._fontScale = math.clamp(tonumber(options.fontScale or options.fontSize or 100) or 100, 80, 140)
	local V = {}

	-- Top-right watermark / mini bar stats state
	V.wmFrame, V.wmLbl, V.wmBaseText = nil, nil, nil
	V.wmStatsVisible = true
	V.wmRuntimeVisible = options.watermarkRuntime ~= false
	V.wmRuntimeLabel = tostring(options.watermarkRuntimeLabel or "RAN")
	V.runStartedAt = os.clock()
	-- 5.18: stats bar defaults to top-right so it stays clear of Roblox top-left UI.
	V.WM_DEFAULT_X, V.WM_DEFAULT_Y = -14, 14
	V.wmMinWidth = math.max(80, tonumber(options.watermarkMinWidth) or 130)
	V.wmMaxWidth = math.max(V.wmMinWidth, tonumber(options.watermarkMaxWidth) or 720)
	V.wmMinHeight = math.max(20, tonumber(options.watermarkMinHeight) or 24)
	V.wmMaxHeight = math.max(V.wmMinHeight, tonumber(options.watermarkMaxHeight) or 64)
	local _requestedWatermarkWidth = tonumber(options.watermarkWidth or options.topRightBarWidth or options.statusBarWidth)
	local _requestedWatermarkHeight = tonumber(options.watermarkHeight or options.topRightBarHeight or options.statusBarHeight)
	if options.watermarkAutoSize == nil then
		V.wmAutoSize = _requestedWatermarkWidth == nil
	else
		V.wmAutoSize = options.watermarkAutoSize ~= false
	end
	V.wmResizable = false -- v5.46: resize handle removed; keep size APIs only for compatibility
	V.wmWidth = math.clamp(_requestedWatermarkWidth or math.clamp(textWidth(tostring(options.watermark or options.name or "VenturaUI"), 13, Enum.Font.RobotoMono) + 38, V.wmMinWidth, V.wmMaxWidth), V.wmMinWidth, V.wmMaxWidth)
	V.wmHeight = math.clamp(_requestedWatermarkHeight or 30, V.wmMinHeight, V.wmMaxHeight)
	V.wmResizeHandle, V.wmAccent = nil, nil
	V._wmResizing = false

	-- Predeclared here so viewport-resize snapping can also recover the minimized restore bubble.
	V.minimizeBubble = nil
	-- Config ID / flag helpers -------------------------------------------------
	-- Use opts.flag / opts.configId / opts.configID / opts.saveId / opts.id on controls.
	-- Example: Tab:Toggle({ name="Auto Farm", flag="autoFarm" })
	local function _trim(s)
		return tostring(s or ""):gsub("^%s+", ""):gsub("%s+$", "")
	end
	local function _controlConfigId(opts)
		local id = opts and (opts.configId or opts.configID or opts.flag or opts.saveId or opts.config or opts.id)
		id = _trim(id or "")
		return id ~= "" and id or nil
	end
	local function _cfgKey(id)
		local safe = _trim(id):gsub("[^%w_%-%.]", function(ch)
			return string.format("_%02X", string.byte(ch))
		end)
		return "control." .. safe
	end
	local function _cfgEsc(sv)
		sv = tostring(sv or "")
		sv = sv:gsub("%%", "%%25"):gsub("\n", "%%0A"):gsub("\r", "%%0D"):gsub("|", "%%7C"):gsub("=", "%%3D")
		return sv
	end
	local function _cfgUnesc(sv)
		sv = tostring(sv or "")
		sv = sv:gsub("%%3D", "="):gsub("%%7C", "|"):gsub("%%0D", "\r"):gsub("%%0A", "\n"):gsub("%%25", "%%")
		return sv
	end
	local function _cfgColorToHex(c)
		return string.format("%02X%02X%02X", math.floor(c.R*255+0.5), math.floor(c.G*255+0.5), math.floor(c.B*255+0.5))
	end
	local function _cfgHexToColor(hex)
		hex = tostring(hex or ""):gsub("#", "")
		if #hex ~= 6 or not hex:match("^[%da-fA-F]+$") then return nil end
		return Color3.fromRGB(tonumber(hex:sub(1,2),16) or 0, tonumber(hex:sub(3,4),16) or 0, tonumber(hex:sub(5,6),16) or 0)
	end
	local function _cfgEncodeValue(v)
		if typeof(v) == "Color3" then return "__c3:" .. _cfgColorToHex(v) end
		if typeof(v) == "EnumItem" then return "__key:" .. tostring(v.Name) end
		if type(v) == "table" then
			local parts = {}
			for _, x in ipairs(v) do table.insert(parts, _cfgEsc(x)) end
			return "__tbl:" .. table.concat(parts, "|")
		end
		if type(v) == "string" then return "__str:" .. _cfgEsc(v) end
		if type(v) == "boolean" then return v and "__bool:true" or "__bool:false" end
		if type(v) == "number" then return "__num:" .. tostring(v) end
		return "__str:" .. _cfgEsc(tostring(v or ""))
	end
	local function _cfgDecodeValue(v)
		if type(v) ~= "string" then return v end
		if v:sub(1,6) == "__str:" then return _cfgUnesc(v:sub(7)) end
		if v:sub(1,6) == "__num:" then return tonumber(v:sub(7)) or 0 end
		if v:sub(1,7) == "__bool:" then return v:sub(8) == "true" end
		if v:sub(1,6) == "__key:" then return v:sub(7) end
		if v:sub(1,6) == "__c3:" then return _cfgHexToColor(v:sub(7)) end
		if v:sub(1,6) == "__tbl:" then
			local out = {}
			local body = v:sub(7)
			if body ~= "" then
				for part in (body .. "|"):gmatch("(.-)|") do table.insert(out, _cfgUnesc(part)) end
			end
			return out
		end
		return v
	end
	local function _applyConfigValueToControl(control, raw, fireCallback)
		if raw == nil or not control or type(control.Set) ~= "function" then return end
		local decoded = _cfgDecodeValue(raw)
		GUI._configApplying = true
		local ok, err = pcall(function()
			-- fireCallback=true keeps script variables synced when auto-loading saved controls.
			control:Set(decoded, not fireCallback)
		end)
		GUI._configApplying = false
		if not ok then warn("[VenturaUI] Failed applying config control: " .. tostring(err)) end
	end
	local function _autoConfigId(opts, kind)
		if options.autoConfigFlags == false then return nil end
		if not opts or opts.config == false or opts.noConfig == true or opts.save == false or opts.persist == false then return nil end
		local rawName = _trim(opts.name or opts.title or opts.text or "")
		if rawName == "" then return nil end
		local safe = (tostring(kind or "control") .. "." .. rawName):lower():gsub("[^%w_%-%.]+", "_"):gsub("_+", "_")
		if safe == "" then return nil end
		GUI._autoConfigIdCounts = GUI._autoConfigIdCounts or {}
		local n = (GUI._autoConfigIdCounts[safe] or 0) + 1
		GUI._autoConfigIdCounts[safe] = n
		return n > 1 and (safe .. "." .. tostring(n)) or safe
	end

	local function _registerConfigControl(control, opts, kind)
		local explicitId = _controlConfigId(opts)
		local id = explicitId or _autoConfigId(opts, kind)
		if not id then return control end
		control._configId = id
		control._configExplicitId = explicitId ~= nil
		control._configKind = kind or "generic"
		control._loadCallback = not (opts and opts.loadCallback == false)
		if opts and opts.default ~= nil then
			control._configDefaultValue = opts.default
		elseif control and type(control.Get) == "function" then
			local okDefault, defaultValue = pcall(function() return control:Get() end)
			if okDefault then control._configDefaultValue = defaultValue end
		end
		GUI._configControls[id] = control
		GUI._controls[id] = control
		control._controlId = id
		function control:GetId() return self._controlId end
		local data = GUI._loadedConfigData
		if data then
			local raw = data[_cfgKey(id)]
			if raw ~= nil then
				control._configAppliedRaw = raw
				task.defer(function()
					if not _destroyed then _applyConfigValueToControl(control, raw, control._loadCallback) end
				end)
			end
		end
		return control
	end

	-- Respawn reconnect helpers --------------------------------------------------
	-- Controls that affect Character/Humanoid state can re-fire after death so
	-- active features do not silently stop working on the new character.
	local function _registerReconnectControl(control, opts, kind)
		if not control then return control end
		opts = opts or {}
		-- Character callback replay is intentionally opt-in. Automatically replaying
		-- every toggle/slider callback can duplicate RenderStepped loops, effects,
		-- and character connections after each reset.
		local shouldReconnect = (opts.reconnect == true) or (opts.reconnectOnRespawn == true)
		if GUI._reconnectEnabled == true
			and (kind == "toggle" or kind == "slider")
			and opts.reconnect ~= false
			and opts.reconnectOnRespawn ~= false
		then
			shouldReconnect = true
		end
		control._reconnectKind = kind or "generic"
		control._reconnectOnRespawn = shouldReconnect == true
		control._callback = control._callback or opts.callback
		if control._reconnectOnRespawn then
			table.insert(GUI._reconnectControls, control)
		end
		return control
	end

	local function _safeControlValue(control)
		if control and type(control.Get) == "function" then
			local ok, value = pcall(function() return control:Get() end)
			if ok then return value end
		end
		return control and control.Value
	end

	local function _runReconnect(reason)
		if _destroyed or GUI._activityStopped or GUI._reconnectEnabled == false then return false end
		local character = LP.Character
		if not character then return false end
		local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 5)

		-- Let scripts rebuild character-bound effects/connections first.
		for _, callback in ipairs(GUI._reconnectCallbacks or {}) do
			if type(callback) == "function" then
				GUI:_invokeCallback("character-reconnect", callback, character, humanoid, reason or "manual")
			end
		end

		-- Re-apply active control callbacks. This fixes sliders like WalkSpeed and
		-- toggles like noclip/auras that need to bind to the new character.
		for i = #GUI._reconnectControls, 1, -1 do
			local control = GUI._reconnectControls[i]
			if not control or (control.frame and not control.frame.Parent) then
				table.remove(GUI._reconnectControls, i)
			elseif control._reconnectOnRespawn ~= false then
				local value = _safeControlValue(control)
				local kind = tostring(control._reconnectKind or "generic")
				local callback = control._callback
				if type(callback) == "function" then
					if kind == "toggle" then
						if value == true then pcall(callback, true, "respawn", character, humanoid) end
					elseif kind == "slider" then
						pcall(callback, value, "respawn", character, humanoid)
					elseif control._forceReconnectCallback == true then
						pcall(callback, value, "respawn", character, humanoid)
					end
				end
			end
		end
		return true
	end

	local function _scheduleReconnect(reason, delayOverride)
		if _destroyed or GUI._activityStopped or GUI._reconnectEnabled == false then return end
		GUI._respawnToken = (GUI._respawnToken or 0) + 1
		local token = GUI._respawnToken
		task.delay(tonumber(delayOverride) or GUI._reconnectDelay or 0.85, function()
			if token ~= GUI._respawnToken then return end
			_runReconnect(reason or "respawn")
		end)
	end

	local function track(c)
		if c then
			table.insert(_connections, c)
			_runtimeTrackConnection(c)
			GUI._ownerBuckets.window = GUI._ownerBuckets.window or {connections={}, instances={}, cleanups={}}
			table.insert(GUI._ownerBuckets.window.connections, c)
		end
		return c
	end

	-- ══════════════════════════════════════════════════════════════════════
	-- v5.96 STABILITY CORE
	-- Central ownership, shared input routing, callback diagnostics,
	-- reactive values, performance controls, and config migrations.
	-- ══════════════════════════════════════════════════════════════════════
	;(function()
		local function ownerName(owner)
			if type(owner) == "table" and owner.Name then return tostring(owner.Name) end
			local name = tostring(owner or "window")
			return name ~= "" and name or "window"
		end

		local function bucket(owner)
			local name = ownerName(owner)
			local value = GUI._ownerBuckets[name]
			if not value then
				value = {Name=name, connections={}, instances={}, cleanups={}, released=false}
				GUI._ownerBuckets[name] = value
			end
			return value
		end

		function GUI:CreateOwner(name)
			local value = bucket(name)
			value.released = false
			return value
		end

		function GUI:TrackOwnedConnection(owner, connection)
			if not connection then return connection end
			table.insert(bucket(owner).connections, connection)
			table.insert(_connections, connection)
			_runtimeTrackConnection(connection)
			return connection
		end

		function GUI:TrackOwnedInstance(owner, instance)
			if not instance then return instance end
			table.insert(bucket(owner).instances, instance)
			table.insert(GUI._trackedInstances, instance)
			_runtimeTrackInstance(instance)
			return instance
		end

		function GUI:RegisterOwnedCleanup(owner, callback, label)
			if type(callback) ~= "function" then return nil end
			local record = {callback=callback, label=tostring(label or "cleanup")}
			table.insert(bucket(owner).cleanups, record)
			return callback
		end

		function GUI:ReleaseOwner(owner, reason)
			local value = bucket(owner)
			if value.released then return true end
			value.released = true
			for i = #value.cleanups, 1, -1 do
				local record = value.cleanups[i]
				if record and type(record.callback) == "function" then
					pcall(record.callback, reason or "release")
				end
				value.cleanups[i] = nil
			end
			for i = #value.connections, 1, -1 do
				local connection = value.connections[i]
				pcall(function()
					if connection and type(connection.Disconnect) == "function" then connection:Disconnect() end
				end)
				value.connections[i] = nil
			end
			for i = #value.instances, 1, -1 do
				local instance = value.instances[i]
				pcall(function()
					if instance and instance.Parent then instance:Destroy() end
				end)
				value.instances[i] = nil
			end
			return true
		end

		function GUI:GetOwnerStats()
			local result = {}
			for name, value in pairs(GUI._ownerBuckets) do
				local connections, instances = 0, 0
				for _, connection in ipairs(value.connections or {}) do
					if connection and connection.Connected ~= false then connections = connections + 1 end
				end
				for _, instance in ipairs(value.instances or {}) do
					if instance and instance.Parent then instances = instances + 1 end
				end
				result[name] = {
					connections=connections,
					instances=instances,
					cleanups=#(value.cleanups or {}),
					released=value.released == true,
				}
			end
			return result
		end

		-- Callback protection preserves pcall-compatible return values.
		function GUI:_invokeCallback(label, callback, ...)
			if type(callback) ~= "function" then return false, "callback is not a function" end
			local guard = options.callbackReentryGuard ~= false
			if guard and GUI._callbackActive[callback] then
				GUI._callbackStats.reentryBlocked = (GUI._callbackStats.reentryBlocked or 0) + 1
				return false, "callback re-entry blocked"
			end

			GUI._callbackActive[callback] = true
			local started = os.clock()
			local packed = table.pack(pcall(callback, ...))
			local elapsedMs = (os.clock() - started) * 1000
			GUI._callbackActive[callback] = nil

			local name = tostring(label or "callback")
			local stat = GUI._callbackStats[name] or {calls=0, errors=0, totalMs=0, maxMs=0}
			stat.calls = stat.calls + 1
			stat.totalMs = stat.totalMs + elapsedMs
			stat.maxMs = math.max(stat.maxMs, elapsedMs)
			stat.lastMs = elapsedMs
			if not packed[1] then
				stat.errors = stat.errors + 1
				stat.lastError = tostring(packed[2])
			end
			GUI._callbackStats[name] = stat

			table.insert(GUI._callbackHistory, 1, {
				label=name,
				ok=packed[1] == true,
				ms=elapsedMs,
				error=packed[1] and nil or tostring(packed[2]),
				at=os.clock(),
			})
			while #GUI._callbackHistory > 100 do table.remove(GUI._callbackHistory) end

			if elapsedMs >= math.max(1, tonumber(options.slowCallbackMs) or 50) then
				warn(string.format("[VenturaUI] Slow callback: %s took %.1fms", name, elapsedMs))
			end
			return table.unpack(packed, 1, packed.n)
		end

		function GUI:ProtectCallback(label, callback)
			return function(...)
				return GUI:_invokeCallback(label, callback, ...)
			end
		end

		function GUI:GetCallbackDiagnostics()
			local copy = {}
			for name, stat in pairs(GUI._callbackStats) do
				copy[name] = {
					calls=stat.calls,
					errors=stat.errors,
					totalMs=stat.totalMs,
					maxMs=stat.maxMs,
					lastMs=stat.lastMs,
					lastError=stat.lastError,
				}
			end
			copy.reentryBlocked = GUI._callbackStats.reentryBlocked or 0
			copy.history = table.clone(GUI._callbackHistory)
			return copy
		end

		-- One InputChanged and one InputEnded connection for every global drag route.
		local dispatcher = {changed={}, ended={}}
		GUI._inputDispatcher = dispatcher

		function GUI:_registerInputHandler(kind, id, callback, owner)
			kind = tostring(kind or "changed"):lower()
			if not dispatcher[kind] or type(callback) ~= "function" then return nil end
			id = tostring(id or (kind .. "_" .. tostring(os.clock())))
			dispatcher[kind][id] = {
				callback=callback,
				owner=ownerName(owner or "input"),
			}
			return function()
				dispatcher[kind][id] = nil
			end
		end

		function GUI:RemoveInputHandler(kind, id)
			kind = tostring(kind or "changed"):lower()
			if dispatcher[kind] then dispatcher[kind][tostring(id)] = nil end
		end

		local function dispatch(kind, input, gameProcessed)
			for id, record in pairs(dispatcher[kind]) do
				if record and type(record.callback) == "function" then
					local ok = GUI:_invokeCallback("input:" .. tostring(id), record.callback, input, gameProcessed)
					if ok == false and record.owner and GUI._ownerBuckets[record.owner] and GUI._ownerBuckets[record.owner].released then
						dispatcher[kind][id] = nil
					end
				end
			end
		end

		GUI:TrackOwnedConnection("input", UIS.InputChanged:Connect(function(input, gameProcessed)
			dispatch("changed", input, gameProcessed)
		end))
		GUI:TrackOwnedConnection("input", UIS.InputEnded:Connect(function(input, gameProcessed)
			dispatch("ended", input, gameProcessed)
		end))

		-- Control registry.
		function GUI:GetControl(id)
			return GUI._controls[tostring(id or "")]
		end

		function GUI:GetControls()
			local result = {}
			for id, control in pairs(GUI._controls) do result[id] = control end
			return result
		end

		function GUI:GetControlIds()
			local ids = {}
			for id in pairs(GUI._controls) do table.insert(ids, id) end
			table.sort(ids)
			return ids
		end

		-- Reactive values.
		function GUI:CreateValue(initialValue, name)
			local value = {
				Value=initialValue,
				Name=tostring(name or ("Value" .. tostring(#GUI._values + 1))),
				_listeners={},
				_destroyed=false,
			}
			table.insert(GUI._values, value)

			function value:Get() return self.Value end
			function value:Set(newValue)
				if self._destroyed or self.Value == newValue then return self end
				self.Value = newValue
				for id, callback in pairs(self._listeners) do
					if type(callback) == "function" then
						GUI:_invokeCallback("value:" .. self.Name .. ":" .. tostring(id), callback, newValue, self)
					end
				end
				return self
			end
			function value:Update(updater)
				if type(updater) == "function" then self:Set(updater(self.Value)) end
				return self
			end
			function value:Bind(callback, fireNow)
				if type(callback) ~= "function" then return function() end end
				local id = tostring(os.clock()) .. ":" .. tostring(math.random())
				self._listeners[id] = callback
				if fireNow ~= false then GUI:_invokeCallback("value-bind:" .. self.Name, callback, self.Value, self) end
				return function() self._listeners[id] = nil end
			end
			function value:BindControl(control, transform)
				if type(control) ~= "table" or type(control.Set) ~= "function" then return function() end end
				return self:Bind(function(current)
					control:Set(type(transform) == "function" and transform(current) or current)
				end, true)
			end
			function value:Destroy()
				self._destroyed = true
				table.clear(self._listeners)
			end
			return value
		end

		-- Config migrations.
		GUI._configSchemaVersion = math.max(1, math.floor(tonumber(options.configSchemaVersion) or 2))

		function GUI:RegisterConfigMigration(fromVersion, toVersion, callback)
			fromVersion, toVersion = tonumber(fromVersion), tonumber(toVersion)
			if not fromVersion or not toVersion or toVersion <= fromVersion or type(callback) ~= "function" then return false end
			GUI._configMigrations[fromVersion] = {to=toVersion, callback=callback}
			return true
		end

		function GUI:MigrateConfig(data)
			if type(data) ~= "table" then return data, false end
			local current = tonumber(data.__schema) or 1
			local changed = false
			local guard = 0
			while current < GUI._configSchemaVersion and guard < 32 do
				guard = guard + 1
				local migration = GUI._configMigrations[current]
				if migration then
					local ok, result = GUI:_invokeCallback("config-migration:" .. tostring(current), migration.callback, data)
					if ok and type(result) == "table" then data = result end
					current = migration.to
				else
					current = current + 1
				end
				changed = true
			end
			data.__schema = GUI._configSchemaVersion
			-- Built-in migration: old center snapping must stay disabled while position lock is active.
			if data.resizeSnap == true and options.lockWindowPosition ~= false then
				data.resizeSnap = false
				changed = true
			end
			return data, changed
		end

		function GUI:GetConfigSchemaVersion()
			return GUI._configSchemaVersion
		end

		-- Performance state. Auto mode only samples one lightweight Heartbeat.
		GUI._performanceMode = tostring(options.performanceMode or "auto"):lower()
		GUI._performanceState = {low=false, fps=60, changedAt=os.clock()}

		local function applyPerformanceLow(low)
			low = low == true
			if GUI._performanceState.low == low then return end
			GUI._performanceState.low = low
			GUI._performanceState.changedAt = os.clock()
			if low then
				GUI._animationFPSCap = 15
				GUI._animationSpeed = 0.35
				GUI._animationIntensity = 0.30
				if type(GUI.SetThemeOverlayVisible) == "function" then pcall(function() GUI:SetThemeOverlayVisible(false) end) end
			else
				GUI._animationFPSCap = tonumber(options.animationFPSCap) or 30
				GUI._animationSpeed = 1
				GUI._animationIntensity = 1
				if type(GUI.SetThemeOverlayVisible) == "function" then pcall(function() GUI:SetThemeOverlayVisible(true) end) end
			end
		end

		function GUI:SetPerformanceMode(mode)
			mode = tostring(mode or "auto"):lower()
			if mode ~= "auto" and mode ~= "balanced" and mode ~= "low" and mode ~= "off" then mode = "auto" end
			GUI._performanceMode = mode
			if mode == "low" then applyPerformanceLow(true)
			elseif mode == "balanced" or mode == "off" then applyPerformanceLow(false) end
			return mode
		end

		function GUI:GetPerformanceMode() return GUI._performanceMode end
		function GUI:GetPerformanceState()
			return {
				mode=GUI._performanceMode,
				low=GUI._performanceState.low,
				fps=GUI._performanceState.fps,
				changedAt=GUI._performanceState.changedAt,
			}
		end

		local elapsed, frames = 0, 0
		GUI:TrackOwnedConnection("performance", RunService.Heartbeat:Connect(function(dt)
			if GUI._performanceMode ~= "auto" or _destroyed then return end
			elapsed = elapsed + math.max(0, tonumber(dt) or 0)
			frames = frames + 1
			if elapsed < 1 then return end
			local fps = frames / math.max(elapsed, 0.001)
			GUI._performanceState.fps = math.floor(fps + 0.5)
			elapsed, frames = 0, 0
			if not GUI._performanceState.low and fps < (tonumber(options.performanceLowFPS) or 42) then
				applyPerformanceLow(true)
			elseif GUI._performanceState.low and fps > (tonumber(options.performanceRecoverFPS) or 54) then
				applyPerformanceLow(false)
			end
		end))

		function GUI:GetDiagnostics()
			local runtime = Library:GetRuntimeCounts()
			local inputHandlers = 0
			for _, group in pairs(dispatcher) do for _ in pairs(group) do inputHandlers = inputHandlers + 1 end end
			return {
				version=Library.Version,
				destroyed=_destroyed,
				tabs=#GUI._tabs,
				controls=#GUI:GetControlIds(),
				values=#GUI._values,
				connections=runtime.connections,
				instances=runtime.instances,
				shutdowns=runtime.shutdowns,
				inputHandlers=inputHandlers,
				owners=GUI:GetOwnerStats(),
				callbacks=GUI:GetCallbackDiagnostics(),
				performance=GUI:GetPerformanceState(),
				reexecution=GUI:GetReexecutePolicy(),
				position=MainWrap and MainWrap.Position or nil,
			}
		end
	end)()
	local function regAccent(obj, prop)
		if obj then
			local resolvedProp = prop
			if not resolvedProp then
				if obj:IsA("UIStroke") then
					resolvedProp = "Color"
				elseif obj:IsA("TextLabel") or obj:IsA("TextBox") or obj:IsA("TextButton") then
					resolvedProp = "TextColor3"
				elseif obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
					resolvedProp = "ImageColor3"
				else
					resolvedProp = "BackgroundColor3"
				end
			end
			pcall(function()
				obj:SetAttribute("VenturaAccent", true)
				obj:SetAttribute("VenturaAccentProp", resolvedProp)
			end)
			table.insert(GUI._accentObjects, {obj=obj, prop=resolvedProp})
		end
		return obj
	end
	local function _sameColor3(a, b, tolerance)
		if typeof(a) ~= "Color3" or typeof(b) ~= "Color3" then return false end
		tolerance = tonumber(tolerance) or (1 / 255)
		return math.abs(a.R - b.R) <= tolerance and math.abs(a.G - b.G) <= tolerance and math.abs(a.B - b.B) <= tolerance
	end

	local function _accentPresetFromColor(color)
		if typeof(color) ~= "Color3" then return nil end
		local best
		for name, preset in pairs(Library.Accents or {}) do
			if _sameColor3(color, preset) then
				if not best or tostring(name) < tostring(best) then best = name end
			end
		end
		return best
	end

	local function _syncAccentControls(color)
		if typeof(color) ~= "Color3" then return end
		GUI._savedAccent = color
		GUI._accentPresetName = _accentPresetFromColor(color)
		if GUI._accentDropdown and GUI._accentPresetName and type(GUI._accentDropdown.Set) == "function" then
			pcall(function() GUI._accentDropdown:Set(GUI._accentPresetName, true) end)
		end
		if GUI._cfgSyncCallbacks and GUI._cfgSyncCallbacks.accent then
			pcall(GUI._cfgSyncCallbacks.accent, color)
		end
	end

	local function applyAccentToRegistered(color, syncControls)
		if typeof(color) ~= "Color3" then return false end
		Library.Theme.Accent = color
		GUI._savedAccent = color

		for i = #GUI._accentObjects, 1, -1 do
			local item = GUI._accentObjects[i]
			if item and item.obj and item.obj.Parent then
				pcall(function() item.obj[item.prop or "BackgroundColor3"] = color end)
			else
				table.remove(GUI._accentObjects, i)
			end
		end

		-- Safety net: catch accent objects created before registration or rebuilt by dropdown refreshes.
		pcall(function()
			if GUI._sg then
				for _, obj in ipairs(GUI._sg:GetDescendants()) do
					if obj:GetAttribute("VenturaAccent") == true then
						if obj:IsA("UIStroke") then
							obj.Color = color
						elseif obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
							local prop = obj:GetAttribute("VenturaAccentProp") or ((obj:IsA("TextLabel") or obj:IsA("TextBox") or obj:IsA("TextButton")) and "TextColor3" or "BackgroundColor3")
							pcall(function() obj[prop] = color end)
						elseif obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
							obj.ImageColor3 = color
						elseif obj:IsA("Frame") or obj:IsA("ScrollingFrame") then
							obj.BackgroundColor3 = color
						end
					end

					if obj.Name == "TogglePill" and obj:GetAttribute("VenturaOn") == true then
						obj.BackgroundColor3 = color
						local st = obj:FindFirstChildOfClass("UIStroke")
						if st then st.Color = color end
					end
				end
			end
		end)

		for _, tab in ipairs(GUI._tabs or {}) do
			if tab and type(tab._ApplyNavStyle) == "function" then
				pcall(function() tab:_ApplyNavStyle(true) end)
			end
		end

		-- v5.48: accent changes also need to resync theme-driven visuals
		-- like selected tabs, divider strokes, glass surfaces, overlays, and
		-- newer component helper rows. Avoid recursion when the theme refresher
		-- calls this with syncControls=false.
		if syncControls ~= false and GUI._RefreshThemeVisuals then
			pcall(function() GUI:_RefreshThemeVisuals() end)
		end

		if syncControls ~= false then _syncAccentControls(color) end
		return true
	end

	local SG = _runtimeTrackInstance(Instance.new("ScreenGui"))
	SG.Name="VenturaUI"; SG.ZIndexBehavior=Enum.ZIndexBehavior.Sibling
	SG.IgnoreGuiInset=true; SG.ResetOnSpawn=false
	SG.DisplayOrder=999
	parentScreenGuiSafely(SG)
	GUI._sg=SG; setupTooltip(SG)
	_runtimeRoot.activeWindow = GUI
	_runtimeRoot.activeScreenGui = SG
	_runtimeRoot.activeCharacter = LP.Character
	_runtimeRoot.respawnCharacter = nil
	_runtimeRoot.respawnGuardUntil = 0
	_runtimeRoot.respawnReuseCredits = 0
	if _ttConn then track(_ttConn) end

	-- Register-safe module boundary: visual engine, controls, config, and utilities.
	;(function()
	-- v5.59 Font scale engine ----------------------------------------------------
	-- Keeps original TextSize as an attribute so the slider can move up/down cleanly
	-- without compounding sizes every time it is dragged.
	local function _isTextObject(obj)
		return obj and (obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox"))
	end

	local function _rememberGuiBase(obj)
		if not obj or not obj:IsA("GuiObject") then return end
		pcall(function()
			if obj:GetAttribute("VenturaBasePosXScale") == nil then
				obj:SetAttribute("VenturaBasePosXScale", obj.Position.X.Scale)
				obj:SetAttribute("VenturaBasePosXOffset", obj.Position.X.Offset)
				obj:SetAttribute("VenturaBasePosYScale", obj.Position.Y.Scale)
				obj:SetAttribute("VenturaBasePosYOffset", obj.Position.Y.Offset)
				obj:SetAttribute("VenturaBaseSizeXScale", obj.Size.X.Scale)
				obj:SetAttribute("VenturaBaseSizeXOffset", obj.Size.X.Offset)
				obj:SetAttribute("VenturaBaseSizeYScale", obj.Size.Y.Scale)
				obj:SetAttribute("VenturaBaseSizeYOffset", obj.Size.Y.Offset)
			end
		end)
	end

	local function _baseNumber(obj, attr, fallback)
		local v
		pcall(function() v = obj:GetAttribute(attr) end)
		return tonumber(v) ~= nil and tonumber(v) or fallback
	end

	local function _lineHeight(obj, minHeight, extra)
		_rememberGuiBase(obj)
		local baseH = _baseNumber(obj, "VenturaBaseSizeYOffset", minHeight or 16)
		local textH = math.floor((tonumber(obj.TextSize) or 12) + (extra or 6) + 0.5)
		return math.max(minHeight or 16, baseH, textH)
	end

	local function _findText(parent, names)
		if not parent then return nil end
		for _, n in ipairs(names) do
			local found = parent:FindFirstChild(n)
			if found and _isTextObject(found) then return found end
		end
		return nil
	end

	local function _setTextRect(obj, y, h)
		if not obj or not obj:IsA("GuiObject") then return end
		_rememberGuiBase(obj)
		obj.Size = UDim2.new(obj.Size.X.Scale, obj.Size.X.Offset, 0, h)
		obj.Position = UDim2.new(obj.Position.X.Scale, obj.Position.X.Offset, 0, y)
		if obj:IsA("TextBox") and obj.MultiLine == true then
			obj.TextYAlignment = Enum.TextYAlignment.Top
		else
			obj.TextYAlignment = Enum.TextYAlignment.Center
		end
	end

	local function _growFrameToText(parent, neededBottom, padBottom)
		if not parent or not parent:IsA("GuiObject") or parent:GetAttribute("VenturaNoAutoTextGrow") == true then return end
		local pname = tostring(parent.Name or "")
		local growNames = {
			Section=true, Button=true, Toggle=true, Slider=true, Dropdown=true, SearchDropdown=true, Keybind=true,
			TextInput=true, CopyButton=true, Stepper=true, Segmented=true, StatusCard=true, ToggleButton=true,
			ToggleCard=true, Alert=true, Notice=true, Banner=true, CodeBlock=true, SearchBox=true, Property=true,
			PropertyRow=true, Stat=true, StatCard=true, MiniStat=true, KeyValue=true, NumberDisplay=true,
		}
		if not growNames[pname] then return end
		_rememberGuiBase(parent)
		local baseH = _baseNumber(parent, "VenturaBaseSizeYOffset", parent.Size.Y.Offset)
		local nextH = math.max(baseH, math.floor((neededBottom or 0) + (padBottom or 6) + 0.5))
		if parent.Size.Y.Scale == 0 and nextH > 0 and parent.Size.Y.Offset ~= nextH then
			parent.Size = UDim2.new(parent.Size.X.Scale, parent.Size.X.Offset, 0, nextH)
			local divider = parent:FindFirstChild("SectionAccentDivider")
			if divider and divider:IsA("GuiObject") then
				divider.Position = UDim2.new(divider.Position.X.Scale, divider.Position.X.Offset, 0, nextH - 1)
			end
		end
	end

	local function _reflowPair(parent, titleNames, descNames, centerSingle)
		if not parent then return false end
		local title = _findText(parent, titleNames)
		local desc = _findText(parent, descNames)
		if not title and not desc then return false end
		if title then _rememberGuiBase(title) end
		if desc then _rememberGuiBase(desc) end

		local titleH = title and _lineHeight(title, 18, 6) or 0
		local descH = desc and _lineHeight(desc, 16, 5) or 0
		local gap = desc and 2 or 0
		local total = titleH + gap + descH
		local frameH = parent.Size.Y.Scale == 0 and parent.Size.Y.Offset or parent.AbsoluteSize.Y
		local titleY
		if desc then
			-- Keep top-style controls like sliders from being pushed into their tracks.
			titleY = title and _baseNumber(title, "VenturaBasePosYOffset", title.Position.Y.Offset) or 0
		else
			local baseY = title and _baseNumber(title, "VenturaBasePosYOffset", title.Position.Y.Offset) or 0
			titleY = centerSingle and math.max(0, math.floor((frameH - titleH) / 2 + 0.5)) or baseY
		end
		if title then _setTextRect(title, titleY, titleH) end
		if desc then _setTextRect(desc, titleY + titleH + gap, descH) end
		_growFrameToText(parent, titleY + total, 7)
		return true
	end

	local function _fixTextLayoutObject(obj)
		if not _isTextObject(obj) or obj:GetAttribute("VenturaNoTextLayoutFix") == true then return end
		local name = tostring(obj.Name or "")
		local lower = name:lower()
		pcall(function()
			_rememberGuiBase(obj)

			-- v5.67: pair-aware reflow. This fixes the common font-size bug where
			-- descriptions kept their old Y offsets and started colliding with titles.
			local parent = obj.Parent
			if lower == "controltitle" or lower == "controldescription" then
				_reflowPair(parent, {"ControlTitle"}, {"ControlDescription"}, false)
			elseif lower == "buttontitle" or lower == "buttondescription" then
				_reflowPair(parent, {"ButtonTitle"}, {"ButtonDescription"}, true)
			elseif lower == "togglebuttontitle" or lower == "togglebuttondescription" then
				_reflowPair(parent, {"ToggleButtonTitle"}, {"ToggleButtonDescription"}, true)
			elseif lower == "sectiontitle" or lower == "sectionsubtitle" then
				_reflowPair(parent, {"SectionTitle"}, {"SectionSubtitle"}, false)
			elseif lower == "alerttitle" or lower == "alerttext" then
				_reflowPair(parent, {"AlertTitle"}, {"AlertText"}, false)
			elseif lower == "bannertitle" or lower == "bannertext" then
				_reflowPair(parent, {"BannerTitle"}, {"BannerText"}, false)
			elseif lower == "noticetitle" or lower == "noticetext" then
				_reflowPair(parent, {"NoticeTitle"}, {"NoticeText"}, false)
			else
				local nextH = _lineHeight(obj, obj:IsA("TextBox") and 18 or 14, 5)
				if obj.Size.Y.Scale == 0 and obj.Size.Y.Offset > 0 and obj.Size.Y.Offset < nextH then
					obj.Size = UDim2.new(obj.Size.X.Scale, obj.Size.X.Offset, 0, nextH)
				end
			end

			-- Most Ventura controls are single-line. Keep them vertically centered after scaling,
			-- but leave multiline body/code/log text top-aligned.
			local keepTop = obj.TextWrapped == true and (lower:find("paragraph", 1, true) or lower:find("body", 1, true) or lower:find("code", 1, true) or lower:find("log", 1, true))
			if obj:IsA("TextBox") and obj.MultiLine == true then keepTop = true end
			obj.TextYAlignment = keepTop and Enum.TextYAlignment.Top or Enum.TextYAlignment.Center

			if not obj.TextWrapped then
				obj.TextTruncate = Enum.TextTruncate.AtEnd
			end

			-- Version badge and status/value pills need width recalculation after scaling.
			if lower == "versionlabel" then
				local padX = 12
				local ok, bounds = pcall(function()
					return TextService:GetTextSize(tostring(obj.Text or ""), tonumber(obj.TextSize) or 10, Enum.Font.RobotoMono, Vector2.new(400, 40))
				end)
				if ok and bounds then obj.Size = UDim2.new(0, math.max(34, math.floor(bounds.X + padX + 0.5)), 0, math.max(16, math.floor((tonumber(obj.TextSize) or 10) + 6))) end
			end
		end)
	end

	local function _applyFontScaleToObject(obj)
		if not obj or obj:GetAttribute("VenturaNoFontScale") == true then return end
		if not _isTextObject(obj) then return end
		local base = tonumber(obj:GetAttribute("VenturaBaseTextSize"))
		if not base or base <= 0 then
			base = tonumber(obj.TextSize) or 13
			pcall(function() obj:SetAttribute("VenturaBaseTextSize", base) end)
		end
		local scale = math.clamp(tonumber(GUI._fontScale) or 100, 80, 140) / 100
		local nextSize = math.clamp(math.floor(base * scale + 0.5), 8, 32)
		if obj.TextSize ~= nextSize then obj.TextSize = nextSize end
		_fixTextLayoutObject(obj)
	end

	local function _applyFontScaleAll()
		if not SG or not SG.Parent then return false end
		pcall(function()
			for _, obj in ipairs(SG:GetDescendants()) do
				_applyFontScaleToObject(obj)
			end
			-- second pass lets descriptions read the final scaled title height
			for _, obj in ipairs(SG:GetDescendants()) do
				_fixTextLayoutObject(obj)
			end
		end)
		return true
	end

	-- Lightweight respawn handling. The UI survives because ResetOnSpawn=false.
	-- Do not wait for character parts or replay callbacks unless the script
	-- explicitly enables reconnectOnRespawn.
	track(LP.CharacterAdded:Connect(function(character)
		_runtimeRoot.activeCharacter = character
		_runtimeRoot.respawnCharacter = character
		_runtimeRoot.respawnGuardUntil = os.clock() + math.clamp(
			tonumber(options.respawnReuseWindow) or 6,
			1,
			20
		)
		-- One credit absorbs one immediate auto-execute builder pass. It does not
		-- block later manual executions from replacing the current UI.
		_runtimeRoot.respawnReuseCredits = 1
		_runtimeRoot.lastBuilderAction = "character-respawned"
		GUI._respawnToken = (GUI._respawnToken or 0) + 1

		-- Stop an in-progress mouse/touch operation so a destroyed input object
		-- cannot keep the window moving or resizing after the reset.
		V.dragging = false
		V.dragInput = nil
		V.resizeDragging = false
		V.resizeInput = nil

		local saved = (MainWrap and MainWrap.Parent and MainWrap.Position) or _runtimeRoot.windowPosition
		if saved and typeof(saved) == "UDim2" then
			_runtimeRoot.windowPosition = saved
		end

		task.defer(function()
			if _destroyed or not MainWrap or not MainWrap.Parent then return end
			local position = _runtimeRoot.windowPosition
			if position and typeof(position) == "UDim2" then
				MainWrap.Position = position
			end
		end)

		if GUI._reconnectEnabled == true then
			_scheduleReconnect("CharacterAdded")
		end
	end))

	-- ══════════════════════════════════════════════════════════════════════
	-- FLOATING MINI HUD — FPS + Ping
	-- ══════════════════════════════════════════════════════════════════════
	V.miniFrame, V.miniTitleLbl, V.miniFpsLbl, V.miniPingLbl, V.miniAccent, V.miniStroke = nil, nil, nil, nil, nil, nil
	V.floatingMiniAllowed = (options.floatingMiniUI == true or options.miniUI == true)
	V.miniVisible = V.floatingMiniAllowed and true or false
	V.miniDrag, V.miniDragStart, V.miniStartPos = false, nil, nil
	V.miniStats = { fps = 0, ping = 0 }

	local function _miniClampPosition(pos)
		-- 5.8: no drag borders. Convert scale positions to absolute offsets, then leave them alone.
		return _offsetPosition(pos, 14, 14)
	end

	local function _readPing()
		local ping
		local function pullStat(item)
			if not item then return nil end
			local value
			pcall(function()
				if item.GetValue then value = item:GetValue() end
			end)
			if value == nil then
				pcall(function()
					if item.GetValueString then value = item:GetValueString() end
				end)
			end
			if type(value) == "string" then
				value = value:match("[%d%.]+")
			end
			return tonumber(value)
		end

		pcall(function()
			local network = Stats:FindFirstChild("Network")
			local server = network and network:FindFirstChild("ServerStatsItem")
			ping = pullStat(server and (server:FindFirstChild("Data Ping") or server:FindFirstChild("Ping")))
		end)
		if not ping then
			pcall(function()
				local perf = Stats:FindFirstChild("PerformanceStats")
				ping = pullStat(perf and (perf:FindFirstChild("Ping") or perf:FindFirstChild("Network Ping")))
			end)
		end
		if not ping then
			pcall(function()
				local network = Stats:FindFirstChild("Network")
				for _, obj in ipairs(network and network:GetDescendants() or {}) do
					if not ping and obj.Name:lower():find("ping", 1, true) then
						ping = pullStat(obj)
					end
				end
			end)
		end

		ping = tonumber(ping) or 0
		-- Some stat objects report seconds; most report milliseconds.
		if ping > 0 and ping < 1 then ping = ping * 1000 end
		return math.clamp(math.floor(ping + 0.5), 0, 9999)
	end

	local function _miniColorForFPS(fps)
		fps = tonumber(fps) or 0
		if fps >= 55 then return Color3.fromRGB(80, 220, 130) end
		if fps >= 35 then return Color3.fromRGB(235, 190, 70) end
		return Color3.fromRGB(235, 85, 85)
	end
	local function _miniColorForPing(ping)
		ping = tonumber(ping) or 0
		if ping <= 90 then return Color3.fromRGB(80, 220, 130) end
		if ping <= 160 then return Color3.fromRGB(235, 190, 70) end
		return Color3.fromRGB(235, 85, 85)
	end

	local function _formatRuntime(seconds)
		seconds = math.max(0, math.floor(tonumber(seconds) or 0))
		local h = math.floor(seconds / 3600)
		local m = math.floor((seconds % 3600) / 60)
		local s = seconds % 60
		if h > 0 then
			return string.format("%02d:%02d:%02d", h, m, s)
		end
		return string.format("%02d:%02d", m, s)
	end

	local function _getRuntimeSeconds()
		return math.max(0, os.clock() - (V.runStartedAt or os.clock()))
	end

	local function _watermarkBaseTextSize()
		return V.wmHeight >= 38 and 14 or 13
	end

	local function _watermarkScaledTextSize()
		local scale = math.clamp(tonumber(GUI._fontScale) or 100, 80, 140) / 100
		return math.clamp(math.floor(_watermarkBaseTextSize() * scale + 0.5), 8, 32)
	end

	local function _applyWatermarkFontScale()
		if not V.wmLbl then return end
		local base = _watermarkBaseTextSize()
		pcall(function() V.wmLbl:SetAttribute("VenturaBaseTextSize", base) end)
		_applyFontScaleToObject(V.wmLbl)
	end

	local function _watermarkContentWidth(text)
		return math.clamp(math.floor(textWidth(text or "", _watermarkScaledTextSize(), Enum.Font.RobotoMono) + 38 + 0.5), V.wmMinWidth, V.wmMaxWidth)
	end

	local function _applyWatermarkSize(width, height, silent)
		if width ~= nil then V.wmWidth = math.clamp(math.floor((tonumber(width) or V.wmWidth) + 0.5), V.wmMinWidth, V.wmMaxWidth) end
		if height ~= nil then V.wmHeight = math.clamp(math.floor((tonumber(height) or V.wmHeight) + 0.5), V.wmMinHeight, V.wmMaxHeight) end
		if V.wmFrame then
			V.wmFrame.Size = UDim2.new(0, V.wmWidth, 0, V.wmHeight)
		end
		if V.wmLbl then
			pcall(function() V.wmLbl.Name = "WatermarkText" end)
			_applyWatermarkFontScale()
			V.wmLbl.Size = UDim2.new(1, -24, 1, 0)
			V.wmLbl.Position = UDim2.new(0, 16, 0, 0)
			V.wmLbl.TextYAlignment = Enum.TextYAlignment.Center
		end
		if V.wmAccent then
			V.wmAccent.Size = UDim2.new(0, 3, 1, -8)
			V.wmAccent.Position = UDim2.new(0, 6, 0, 4)
		end
		if V.wmResizeHandle then
			V.wmResizeHandle.Position = UDim2.new(0, 2, 1, -13)
		end
		if not silent and GUI.MarkConfigDirty then pcall(function() GUI:MarkConfigDirty() end) end
		if GUI._cfgSyncCallbacks and GUI._cfgSyncCallbacks.watermarkSize then
			pcall(GUI._cfgSyncCallbacks.watermarkSize, V.wmWidth, V.wmHeight, V.wmAutoSize)
		end
		return V.wmWidth, V.wmHeight
	end

	local function _syncWatermarkStats()
		if not V.wmFrame or not V.wmLbl then return end
		local base = tostring(V.wmBaseText or options.watermark or options.name or "VenturaUI")
		local parts = {}
		if V.wmStatsVisible then
			table.insert(parts, string.format("FPS %d", tonumber(V.miniStats.fps) or 0))
			table.insert(parts, string.format("PING %dms", tonumber(V.miniStats.ping) or 0))
		end
		if V.wmRuntimeVisible then
			local label = tostring(V.wmRuntimeLabel or "RAN")
			table.insert(parts, string.format("%s %s", label, _formatRuntime(_getRuntimeSeconds())))
		end
		local text = base
		if #parts > 0 then
			text = base .. "  •  " .. table.concat(parts, "  •  ")
		end
		V.wmLbl.Text = text
		if V.wmAutoSize then
			V.wmWidth = _watermarkContentWidth(text)
		end
		_applyWatermarkSize(V.wmWidth, V.wmHeight, true)
	end

	local function _setMiniText()
		if V.miniFpsLbl then
			V.miniFpsLbl.Text = "FPS " .. tostring(V.miniStats.fps)
			V.miniFpsLbl.TextColor3 = _miniColorForFPS(V.miniStats.fps)
		end
		if V.miniPingLbl then
			V.miniPingLbl.Text = "PING " .. tostring(V.miniStats.ping) .. "ms"
			V.miniPingLbl.TextColor3 = _miniColorForPing(V.miniStats.ping)
		end
		_syncWatermarkStats()
	end

	-- Only run the stats loop when a stats surface is actually requested.
	V._fpsFrames, V._fpsElapsed, V._pingElapsed = 0, 0, 0
	local _statsLoopEnabled = options.watermarkStats ~= false or V.floatingMiniAllowed == true
	if _statsLoopEnabled then
		track(RunService.RenderStepped:Connect(function(dt)
			if _destroyed then return end
			V._fpsFrames = V._fpsFrames + 1
			V._fpsElapsed = V._fpsElapsed + dt
			V._pingElapsed = V._pingElapsed + dt
			if V._fpsElapsed >= 0.5 then
				V.miniStats.fps = math.clamp(math.floor(V._fpsFrames / math.max(V._fpsElapsed, 1/240) + 0.5), 0, 999)
				V._fpsFrames, V._fpsElapsed = 0, 0
				if V._pingElapsed >= 1 then
					V._pingElapsed = 0
					V.miniStats.ping = _readPing()
				end
				_setMiniText()
			end
		end))
	end

	local function _styleMiniHUD()
		if not V.miniFrame then return end
		V.miniFrame.BackgroundColor3 = Library.Theme.Surface
		if V.miniStroke then V.miniStroke.Color = Library.Theme.Border end
		if V.miniTitleLbl then V.miniTitleLbl.TextColor3 = Library.Theme.TextSecondary end
		if V.miniAccent then V.miniAccent.BackgroundColor3 = Library.Theme.Accent end
	end

