		return _writeAutoLoadEnabled(enabled == true)
	end

	function GUI:GetAutoLoadProfile()
		return _readAutoLoadProfile() or V._cfgProfile
	end

	function GUI:SetAutoLoadProfile(profileName)
		local profile = _profileSanitize(profileName or V._cfgProfile)
		_addProfileToIndex(profile)
		return _writeAutoLoadProfile(profile)
	end

	function GUI:SetConfigProfile(profileName, loadAfter)
		local profile = _setConfigProfileInternal(profileName)
		_addProfileToIndex(profile)
		_writeAutoLoadProfile(profile)
		if loadAfter == true then
			local data = GUI:LoadConfig(profile)
			if data then GUI:ApplyConfig(data); return true, data end
			return false, nil
		end
		return true, nil
	end

	function GUI:SaveProfile(profileName)
		if profileName then _setConfigProfileInternal(profileName) end
		_addProfileToIndex(V._cfgProfile)
		_writeAutoLoadProfile(V._cfgProfile)
		return GUI:SaveConfig(true)
	end

	function GUI:LoadProfile(profileName)
		local data = GUI:LoadConfig(profileName)
		if data then
			_addProfileToIndex(V._cfgProfile)
			_writeAutoLoadProfile(V._cfgProfile)
			GUI:ApplyConfig(data)
			return true, data
		end
		return false, nil
	end

	function GUI:_writeProfileIndexExact(list)
		if not hasFileAPI() then return false end
		_ensureConfigFolders()
		local seen, lines = {}, {}
		local deleted = _readDeletedProfiles()
		local function add(name)
			name = _profileSanitize(name)
			local key = name:lower()
			if key ~= "default" and deleted[key] then return end
			if not seen[key] then
				seen[key] = true
				table.insert(lines, _cfgEsc(name))
			end
		end
		add("Default")
		for _, name in ipairs(list or {}) do add(name) end
		table.sort(lines, function(a,b) return a:lower() < b:lower() end)
		local ok, err = pcall(function() writefile(V._cfgProfileIndexFile, table.concat(lines, "\n")) end)
		if not ok then warn("[VenturaUI] Profile index save failed: " .. tostring(err)) end
		return ok
	end

	-- Deletes only the selected profile. It never deletes the profile folder or other config files.
	-- If an executor does not support delfile(), the profile is hidden with a tombstone so listfiles()
	-- cannot make it reappear or block later profile loads.
	function GUI:DeleteProfile(profileName)
		local profile = _profileSanitize(profileName or V._cfgProfile)
		if profile:lower() == "default" then
			return false, "Default profile cannot be deleted"
		end

		_markProfileDeleted(profile)

		local targetFile = V._cfgProfileFolder .. "/" .. _profileFileName(profile)
		local deletedFile = false
		if hasFileAPI() then
			pcall(function()
				if type(delfile) == "function" and isfile(targetFile) then
					delfile(targetFile)
					deletedFile = true
				end
			end)
		end

		local keep = {}
		for _, name in ipairs(_readProfileIndex()) do
			if name:lower() ~= profile:lower() then
				table.insert(keep, name)
			end
		end
		GUI:_writeProfileIndexExact(keep)

		if (_readAutoLoadProfile() or ""):lower() == profile:lower() then
			_writePlainFile(V._cfgAutoLoadFile, _cfgEsc("Default"))
		end
		if V._cfgProfile:lower() == profile:lower() then
			_setConfigProfileInternal("Default")
			_writeAutoLoadProfile("Default")
		end

		return true, deletedFile and "deleted profile file" or "hidden deleted profile"
	end

	GUI._cfgSyncCallbacks = {}

	function GUI:GetConfigIdValue(id)
		local c = GUI._configControls and GUI._configControls[tostring(id or "")]
		if c and type(c.Get) == "function" then local ok, v = pcall(function() return c:Get() end); if ok then return v end end
		return nil
	end
	function GUI:SetConfigIdValue(id, value, fireCallback)
		local c = GUI._configControls and GUI._configControls[tostring(id or "")]
		if c then _applyConfigValueToControl(c, _cfgEncodeValue(value), fireCallback ~= false); pcall(function() GUI:MarkConfigDirty() end); return true end
		return false
	end
	function GUI:GetConfigIds()
		local ids = {}; for id in pairs(GUI._configControls or {}) do table.insert(ids, id) end; table.sort(ids); return ids
	end

	function GUI:ApplyConfig(data)
		if not data then return end
		if data.theme and Library.Themes[data.theme] then
			GUI:_applyTheme(data.theme)
			if GUI._cfgSyncCallbacks.theme then pcall(GUI._cfgSyncCallbacks.theme, data.theme) end
		end
		if data.accent then
			local c = GUI:_hexToC3(data.accent)
			if typeof(c) == "Color3" then GUI:SetAccent(c, true) end
		end
		-- Load base window size AND scale, then apply the scaled size to the real UI immediately.
		-- Old behavior loaded winW/winH first and skipped applying scale whenever winW/winH existed.
		WIN_MAX_W, WIN_MAX_H = getViewportLimit()
		if data.winW then
			winW = math.clamp(tonumber(data.winW) or winW, WIN_MIN_W, WIN_MAX_W)
		end
		if data.winH then
			winH = math.clamp(tonumber(data.winH) or winH, WIN_MIN_H, WIN_MAX_H)
		end
		if data.scale then
			currentScale = math.clamp(tonumber(data.scale) or 100, 50, 200)
		end
		local sw, sh = applyWindowScale(false, V.minimized and 34 or nil)
		MainWrap.Size = UDim2.new(0, sw, 0, V.minimized and 34 or sh)
		task.defer(function() if not _destroyed then applyWindowScale(false, V.minimized and 34 or nil); _applyResponsiveScale(false) end end)
		if GUI._cfgSyncCallbacks.scale then pcall(GUI._cfgSyncCallbacks.scale, currentScale) end
		-- 5.19+: responsive scaling is on by default but can be toggled off in Settings.
		_responsiveScaleEnabled = data.responsiveScale ~= false
		if GUI._cfgSyncCallbacks.responsiveScale then pcall(GUI._cfgSyncCallbacks.responsiveScale, _responsiveScaleEnabled) end
		_resizeSnapEnabled = (not _lockWindowPosition) and data.resizeSnap == true
		_resizeSnapMode = tostring(data.resizeSnapMode or _resizeSnapMode or "center"):lower()
		if GUI._cfgSyncCallbacks.resizeSnap then pcall(GUI._cfgSyncCallbacks.resizeSnap, _resizeSnapEnabled) end
		if data.dragBounds ~= nil then
			options.dragBounds = data.dragBounds == true
		end
		if data.toggleKey then
			local ok, k = pcall(function() return Enum.KeyCode[data.toggleKey] end)
			if ok and k and k ~= Enum.KeyCode.Unknown then keys.toggle = k end
		end
		-- 5.34: old configs may contain minKey, but the separate minimize key was removed.
		-- Bubble restore/collapse now follows toggleKey only.
		if data.miniVisible ~= nil then
			V.miniVisible = V.floatingMiniAllowed and data.miniVisible == true or false
			if V.miniFrame then V.miniFrame.Visible = V.miniVisible end
			if GUI._cfgSyncCallbacks.miniVisible then pcall(GUI._cfgSyncCallbacks.miniVisible, V.miniVisible) end
		end
		if V.floatingMiniAllowed and V.miniFrame and data.miniX and data.miniY then
			V.miniFrame.Position = UDim2.new(0, tonumber(data.miniX) or 14, 0, tonumber(data.miniY) or 14)
		end
		-- 5.19+: FPS / ping and runtime stats can be toggled from Settings.
		V.wmStatsVisible = data.watermarkStatsVisible ~= false
		if data.watermarkRuntimeVisible ~= nil then V.wmRuntimeVisible = data.watermarkRuntimeVisible == true end
		if data.watermarkRuntimeLabel ~= nil then V.wmRuntimeLabel = _cfgUnesc(data.watermarkRuntimeLabel) end
		if data.watermarkAutoSize ~= nil then V.wmAutoSize = data.watermarkAutoSize == true end
		_applyWatermarkSize(tonumber(data.watermarkWidth) or V.wmWidth, tonumber(data.watermarkHeight) or V.wmHeight, true)
		_syncWatermarkStats()
		if GUI._cfgSyncCallbacks.watermarkStats then pcall(GUI._cfgSyncCallbacks.watermarkStats, V.wmStatsVisible) end
		if GUI._cfgSyncCallbacks.watermarkRuntime then pcall(GUI._cfgSyncCallbacks.watermarkRuntime, V.wmRuntimeVisible) end
		if GUI._cfgSyncCallbacks.watermarkSize then pcall(GUI._cfgSyncCallbacks.watermarkSize, V.wmWidth, V.wmHeight, V.wmAutoSize) end
		if V.wmFrame then
			local savedX = tonumber(data.watermarkX) or V.WM_DEFAULT_X
			local savedY = tonumber(data.watermarkY) or V.WM_DEFAULT_Y
			local savedScaleX = tonumber(data.watermarkScaleX)
			local savedScaleY = tonumber(data.watermarkScaleY) or 0
			-- Old configs did not save scale and usually forced the bar back to the left.
			-- Upgrade those to the new top-right default. New configs keep their dragged position.
			if savedScaleX == nil then
				V.wmFrame.AnchorPoint = Vector2.new(1, 0)
				V.wmFrame.Position = UDim2.new(1, V.WM_DEFAULT_X, 0, V.WM_DEFAULT_Y)
			else
				V.wmFrame.Position = UDim2.new(savedScaleX, savedX, savedScaleY, savedY)
			end
		end
		if data.minimizeBubbleX and data.minimizeBubbleY then
			local b = _createMinimizeBubble()
			b.Position = UDim2.new(0, tonumber(data.minimizeBubbleX) or 18, 0, tonumber(data.minimizeBubbleY) or 78)
			b.Visible = V.minimized and GUI._open ~= false
		end
		GUI._loadedConfigData = data
		for id, control in pairs(GUI._configControls or {}) do
			local raw = data[_cfgKey(id)]
			if raw ~= nil and control._configAppliedRaw ~= raw then
				control._configAppliedRaw = raw
				_applyConfigValueToControl(control, raw, control._loadCallback ~= false)
			end
		end
		-- After old saved positions are restored, recover visibility once more so tiny/small
		-- Roblox window sizes never leave the UI lost off-screen.
		if _resizeSnapEnabled then
			task.defer(function() if not _destroyed then _applyResponsiveScale(true) end end)
		end
	end


	-- ══════════════════════════════════════════════════════════════════════
	-- Ventura 5.35 Smart Config Engine overlay
	-- Replaces the older always-autoload-ish profile behavior with explicit,
	-- profile-safe save/load flow plus smarter API helpers.
	-- ══════════════════════════════════════════════════════════════════════
	function GUI:_installSmartConfig535()
		local _baseApplyConfig_535 = GUI.ApplyConfig

	local function _profileExists(profile)
		profile = _profileSanitize(profile or V._cfgProfile)
		if not hasFileAPI() then return false end
		local file = V._cfgProfileFolder .. "/" .. _profileFileName(profile)
		local ok, exists = pcall(isfile, file)
		if ok and exists then return true, file end
		if profile:lower() == "default" then
			local legacyFile = V._cfgFolder .. "/" .. V._cfgBaseName .. ".json"
			local okLegacy, legacyExists = pcall(isfile, legacyFile)
			if okLegacy and legacyExists then return true, legacyFile end
		end
		return false, file
	end

	function GUI:_encodeConfig(t)
		local lines = {"__ventura_config=2"}
		local keysOut = {}
		for k in pairs(t or {}) do
			if tostring(k) ~= "__ventura_config" then table.insert(keysOut, tostring(k)) end
		end
		table.sort(keysOut, function(a, b) return a:lower() < b:lower() end)
		for _, k in ipairs(keysOut) do
			local v = t[k]
			if v ~= nil then
				table.insert(lines, _cfgEsc(k) .. "=" .. _cfgEsc(tostring(v)))
			end
		end
		return table.concat(lines, "\n")
	end

	function GUI:_decodeConfig(s)
		local t = {}
		if type(s) ~= "string" then return t end
		for line in (s .. "\n"):gmatch("([^\n]*)\n") do
			local k, v = line:match("^([^=]+)=(.*)$")
			if k and v then
				k = _cfgUnesc(_trim(k))
				v = _cfgUnesc(v)
				if k ~= "" then
					if v == "true" then t[k] = true
					elseif v == "false" then t[k] = false
					elseif v:sub(1,2) == "__" then t[k] = v
					elseif tonumber(v) ~= nil then t[k] = tonumber(v)
					else t[k] = v end
				end
			end
		end
		return t
	end

	function GUI:_configPayloadTable()
		local payload = {
			__version = Library.Version,
			__schema = GUI:GetConfigSchemaVersion(),
			__savedAt = tostring(os.time()),
			profile   = V._cfgProfile,
			accent    = GUI:_c3ToHex(Library.Theme.Accent),
			theme     = GUI._savedTheme or options.theme or "Dark",
			scale     = currentScale,
			winW      = math.floor(winW),
			winH      = math.floor(winH),
			renderW   = math.floor((MainWrap and MainWrap.AbsoluteSize.X > 0) and MainWrap.AbsoluteSize.X or select(1, getScaledWindowSize())),
			renderH   = math.floor((MainWrap and MainWrap.AbsoluteSize.Y > 0) and MainWrap.AbsoluteSize.Y or select(2, getScaledWindowSize())),
			toggleKey = keys.toggle.Name,
			miniVisible = V.floatingMiniAllowed and V.miniVisible == true or false,
			miniX = (V.floatingMiniAllowed and V.miniFrame) and V.miniFrame.Position.X.Offset or 0,
			miniY = (V.floatingMiniAllowed and V.miniFrame) and V.miniFrame.Position.Y.Offset or 0,
			watermarkStatsVisible = V.wmStatsVisible == true,
			watermarkRuntimeVisible = V.wmRuntimeVisible == true,
			watermarkRuntimeLabel = V.wmRuntimeLabel or "RAN",
			watermarkX = V.wmFrame and V.wmFrame.Position.X.Offset or V.WM_DEFAULT_X,
			watermarkY = V.wmFrame and V.wmFrame.Position.Y.Offset or V.WM_DEFAULT_Y,
			watermarkScaleX = V.wmFrame and V.wmFrame.Position.X.Scale or 1,
			watermarkScaleY = V.wmFrame and V.wmFrame.Position.Y.Scale or 0,
			watermarkWidth = V.wmWidth,
			watermarkHeight = V.wmHeight,
			watermarkAutoSize = V.wmAutoSize == true,
			minimizeBubbleX = V.minimizeBubble and V.minimizeBubble.Position.X.Offset or 18,
			minimizeBubbleY = V.minimizeBubble and V.minimizeBubble.Position.Y.Offset or 78,
			responsiveScale = _responsiveScaleEnabled == true,
			resizeSnap = (not _lockWindowPosition) and _resizeSnapEnabled == true,
			resizeSnapMode = _resizeSnapMode,
			dragBounds = options.dragBounds == true,
		}
		for id, control in pairs(GUI._configControls or {}) do
			if control and type(control.Get) == "function" then
				local ok, value = pcall(function() return control:Get() end)
				if ok then payload[_cfgKey(id)] = _cfgEncodeValue(value) end
			end
		end
		return payload
	end

	function GUI:_configPayload()
		return GUI:_encodeConfig(GUI:_configPayloadTable())
	end

	function GUI:GetConfigSnapshot(decodedControls)
		local payload = GUI:_configPayloadTable()
		if decodedControls == true then
			payload.controls = {}
			for id, control in pairs(GUI._configControls or {}) do
				if control and type(control.Get) == "function" then
					local ok, value = pcall(function() return control:Get() end)
					if ok then payload.controls[id] = value end
				end
			end
		end
		return payload
	end

	function GUI:ApplyConfigSnapshot(snapshot, fireCallbacks)
		if type(snapshot) ~= "table" then return false end
		if type(snapshot.controls) == "table" then
			for id, value in pairs(snapshot.controls) do
				GUI:SetConfigIdValue(id, value, fireCallbacks ~= false)
			end
		end
		return GUI:ApplyConfig(snapshot, fireCallbacks)
	end

	function GUI:ApplyConfig(data, fireCallbacks)
		if type(data) ~= "table" then return false end
		data = select(1, GUI:MigrateConfig(data))
		if options.normalizedPosition ~= false and tonumber(data.windowNormX) and tonumber(data.windowNormY) then
			GUI:SetNormalizedPosition(data.windowNormX, data.windowNormY)
		elseif tonumber(data.windowX) and tonumber(data.windowY) then
			local restored = UDim2.new(tonumber(data.windowScaleX) or 0, tonumber(data.windowX) or 0, tonumber(data.windowScaleY) or 0, tonumber(data.windowY) or 0)
			MainWrap.Position = restored
			_runtimeRoot.windowPosition = restored
		end
		if data.watermarkRuntimeLabel ~= nil then data.watermarkRuntimeLabel = tostring(data.watermarkRuntimeLabel) end
		local previous = {}
		if fireCallbacks == false then
			for id, control in pairs(GUI._configControls or {}) do
				previous[id] = control._loadCallback
				control._loadCallback = false
			end
		end
		local ok, err = pcall(function() _baseApplyConfig_535(GUI, data) end)
		if fireCallbacks == false then
			for id, value in pairs(previous) do
				if GUI._configControls[id] then GUI._configControls[id]._loadCallback = value end
			end
		end
		if not ok then
			warn("[VenturaUI] ApplyConfig failed: " .. tostring(err))
			return false, err
		end
		GUI._configDirty = false
		return true
	end

	function GUI:GetConfigProfiles()
		return _readProfileIndex()
	end
	function GUI:RefreshConfigProfiles()
		return _readProfileIndex()
	end
	function GUI:ProfileExists(profileName)
		local exists = _profileExists(profileName)
		return exists == true
	end
	function GUI:GetConfigProfile()
		return V._cfgProfile
	end
	function GUI:GetConfigPath(profileName)
		if profileName then return V._cfgProfileFolder .. "/" .. _profileFileName(profileName) end
		return V._cfgFile
	end
	function GUI:GetConfigFolder()
		return V._cfgProfileFolder
	end
	function GUI:GetConfigRootFolder()
		return V._cfgRootFolder
	end
	function GUI:GetConfigVersionFolder()
		return V._cfgFolder
	end
	function GUI:GetConfigStatus()
		local exists, path = _profileExists(V._cfgProfile)
		return {
			profile = V._cfgProfile,
			path = path or V._cfgFile,
			exists = exists == true,
			dirty = GUI._configDirty == true,
			autoLoad = _readAutoLoadEnabled() == true,
			autoLoadProfile = _readAutoLoadProfile(),
			autoSave = GUI._autoSaveEnabled == true,
			fileAPI = hasFileAPI(),
			controls = (function()
				local n = 0
				for _ in pairs(GUI._configControls or {}) do n = n + 1 end
				return n
			end)(),
		}
	end

	function GUI:SetAutoLoad(enabled)
		local ok = _writeAutoLoadEnabled(enabled == true)
		if enabled == true then
			local exists = _profileExists(V._cfgProfile)
			if exists then _writeAutoLoadProfile(V._cfgProfile) end
		end
		return ok
	end
	function GUI:GetAutoLoad()
		return _readAutoLoadEnabled() == true
	end
	function GUI:GetAutoLoadProfile()
		return _readAutoLoadProfile()
	end
	function GUI:SetAutoLoadProfile(profileName)
		local profile = _profileSanitize(profileName or V._cfgProfile)
		local exists = _profileExists(profile)
		if not exists then return false, "profile has not been saved yet" end
		_writeAutoLoadEnabled(true)
		_addProfileToIndex(profile)
		return _writeAutoLoadProfile(profile)
	end
	function GUI:ClearAutoLoad()
		_writePlainFile(V._cfgAutoLoadFile, "")
		return _writeAutoLoadEnabled(false)
	end

	function GUI:SetConfigProfile(profileName, loadAfter, createIfMissing)
		local profile = _setConfigProfileInternal(profileName)
		if createIfMissing == true then _addProfileToIndex(profile) end
		if loadAfter == true then return GUI:LoadProfile(profile) end
		return true, nil
	end

	function GUI:LoadConfig(profileName)
		if profileName then _setConfigProfileInternal(profileName) end
		if _isProfileDeleted(V._cfgProfile) then return nil end
		if not hasFileAPI() then return nil end
		local exists, targetFile = _profileExists(V._cfgProfile)
		if not exists then return nil end
		local ok, raw = pcall(readfile, targetFile)
		if not ok or not raw or raw == "" then return nil end
		local ok2, data = pcall(function() return GUI:_decodeConfig(raw) end)
		if not ok2 or type(data) ~= "table" or not next(data) then return nil end
		return data
	end

	function GUI:SaveConfig(force, profileName)
		if GUI._configApplying then return true end
		if type(force) == "string" and profileName == nil then profileName = force; force = true end
		if profileName then _setConfigProfileInternal(profileName) end
		if not hasFileAPI() then
			warn("[VenturaUI] SaveConfig skipped: executor does not support writefile/readfile/isfile/isfolder/makefolder.")
			return false
		end
		if GUI._saveQueued and not force then return true end
		GUI._saveQueued = true
		local function writeNow()
			GUI._saveQueued = false
			if _destroyed then return false end
			local ok, err = pcall(function()
				_ensureConfigFolders()
				_unmarkProfileDeleted(V._cfgProfile)
				_addProfileToIndex(V._cfgProfile)
				writefile(V._cfgFile, GUI:_configPayload())
				if _readAutoLoadEnabled() then _writeAutoLoadProfile(V._cfgProfile) end
			end)
			if ok then GUI._configDirty = false else warn("[VenturaUI] SaveConfig failed: " .. tostring(err)) end
			return ok
		end
		if force then return writeNow() end
		task.delay(0.15, writeNow)
		return true
	end

	function GUI:SaveProfile(profileName)
		if profileName then _setConfigProfileInternal(profileName) end
		return GUI:SaveConfig(true)
	end
	GUI.SaveCurrentProfile = GUI.SaveProfile

	function GUI:LoadProfile(profileName)
		local oldProfile = V._cfgProfile
		local oldFile = V._cfgFile
		local profile = _profileSanitize(profileName or V._cfgProfile)
		_setConfigProfileInternal(profile)
		local data = GUI:LoadConfig()
		if not data then
			V._cfgProfile = oldProfile
			V._cfgFile = oldFile
			return false, nil
		end
		_addProfileToIndex(profile)
		if _readAutoLoadEnabled() then _writeAutoLoadProfile(profile) end
		GUI._loadedConfigData = data
		GUI:ApplyConfig(data)
		return true, data
	end
	GUI.LoadCurrentProfile = GUI.LoadProfile

	function GUI:CreateProfile(profileName, fromCurrent)
		local oldProfile = V._cfgProfile
		local oldFile = V._cfgFile
		local profile = _setConfigProfileInternal(profileName)
		if fromCurrent == false then GUI:ResetConfig(profile, true) end
		local ok = GUI:SaveConfig(true)
		if not ok then
			V._cfgProfile = oldProfile
			V._cfgFile = oldFile
		end
		return ok, profile
	end
	GUI.NewProfile = GUI.CreateProfile

	function GUI:DuplicateProfile(fromProfile, toProfile)
		fromProfile = _profileSanitize(fromProfile or V._cfgProfile)
		toProfile = _profileSanitize(toProfile or (fromProfile .. " Copy"))
		local oldProfile, oldFile = V._cfgProfile, V._cfgFile
		_setConfigProfileInternal(fromProfile)
		local data = GUI:LoadConfig()
		V._cfgProfile, V._cfgFile = oldProfile, oldFile
		if not data then return false, "source profile not found" end
		data.profile = toProfile
		if not hasFileAPI() then return false, "file API unsupported" end
		local target = V._cfgProfileFolder .. "/" .. _profileFileName(toProfile)
		local ok, err = pcall(function()
			_ensureConfigFolders()
			writefile(target, GUI:_encodeConfig(data))
			_addProfileToIndex(toProfile)
		end)
		return ok, ok and toProfile or tostring(err)
	end

	function GUI:RenameProfile(oldName, newName)
		oldName = _profileSanitize(oldName or V._cfgProfile)
		newName = _profileSanitize(newName)
		if oldName:lower() == "default" then return false, "Default profile cannot be renamed" end
		local ok, msg = GUI:DuplicateProfile(oldName, newName)
		if not ok then return false, msg end
		GUI:DeleteProfile(oldName)
		if V._cfgProfile:lower() == oldName:lower() then _setConfigProfileInternal(newName) end
		return true, newName
	end

	function GUI:DeleteProfile(profileName)
		local profile = _profileSanitize(profileName or V._cfgProfile)
		if profile:lower() == "default" then return false, "Default profile cannot be deleted" end
		_markProfileDeleted(profile)
		local targetFile = V._cfgProfileFolder .. "/" .. _profileFileName(profile)
		local deletedFile = false
		if hasFileAPI() then
			pcall(function()
				if type(delfile) == "function" and isfile(targetFile) then delfile(targetFile); deletedFile = true end
			end)
		end
		local keep = {}
		for _, name in ipairs(_readProfileIndex()) do
			if name:lower() ~= profile:lower() then table.insert(keep, name) end
		end
		GUI:_writeProfileIndexExact(keep)
		if (_readAutoLoadProfile() or ""):lower() == profile:lower() then GUI:ClearAutoLoad() end
		if V._cfgProfile:lower() == profile:lower() then _setConfigProfileInternal("Default") end
		return true, deletedFile and "deleted profile file" or "hidden deleted profile"
	end
	GUI.ClearProfile = GUI.DeleteProfile

	function GUI:ResetConfig(profileName, applyNow)
		if profileName then _setConfigProfileInternal(profileName) end
		local data = {
			profile = V._cfgProfile,
			accent = GUI:_c3ToHex(options.accent or Color3.fromRGB(100,150,255)),
			theme = options.theme or "Dark",
			scale = 100,
			winW = math.floor(_defaultWinW or 820),
			winH = math.floor(_defaultWinH or 580),
			toggleKey = (options.toggleKey or Enum.KeyCode.Insert).Name,
			watermarkStatsVisible = options.watermarkStats ~= false,
			watermarkRuntimeVisible = options.watermarkRuntime ~= false,
			watermarkRuntimeLabel = options.watermarkRuntimeLabel or "RAN",
			watermarkWidth = math.clamp(tonumber(options.watermarkWidth or options.topRightBarWidth or options.statusBarWidth) or textWidth(tostring(options.watermark or options.name or "VenturaUI"), 13, Enum.Font.RobotoMono) + 38, V.wmMinWidth, V.wmMaxWidth),
			watermarkHeight = math.clamp(tonumber(options.watermarkHeight or options.topRightBarHeight or options.statusBarHeight) or 30, V.wmMinHeight, V.wmMaxHeight),
			watermarkAutoSize = options.watermarkAutoSize ~= false,
			watermarkX = V.WM_DEFAULT_X,
			watermarkY = V.WM_DEFAULT_Y,
			watermarkScaleX = 1,
			watermarkScaleY = 0,
			responsiveScale = true,
			resizeSnap = false,
			resizeSnapMode = "center",
			dragBounds = false,
		}
		for id, control in pairs(GUI._configControls or {}) do
			local defaultValue = control and control._configDefaultValue
			if defaultValue ~= nil then data[_cfgKey(id)] = _cfgEncodeValue(defaultValue) end
		end
		if applyNow ~= false then GUI:ApplyConfig(data, true) end
		GUI._loadedConfigData = data
		GUI:MarkConfigDirty()
		return data
	end

	function GUI:RegisterConfigItem(id, getter, setter, defaultValue, opts)
		id = _trim(id or "")
		if id == "" or type(getter) ~= "function" then return nil end
		opts = opts or {}
		local item = {
			_configId = id,
			_configKind = opts.kind or "custom",
			_configDefaultValue = defaultValue,
			_loadCallback = opts.loadCallback ~= false,
			Get = function() local ok, value = pcall(getter); if ok then return value end end,
			Set = function(_, value, silent) if type(setter) == "function" then return setter(value, silent) end end,
		}
		GUI._configControls[id] = item
		return item
	end
	function GUI:UnregisterConfigId(id)
		id = tostring(id or "")
		GUI._configControls[id] = nil
		return true
	end
	function GUI:SetConfigDefault(id, value)
		local c = GUI._configControls and GUI._configControls[tostring(id or "")]
		if not c then return false end
		c._configDefaultValue = value
		return true
	end
	function GUI:GetConfigIdInfo(id)
		local c = GUI._configControls and GUI._configControls[tostring(id or "")]
		if not c then return nil end
		return { id = tostring(id), kind = c._configKind, explicit = c._configExplicitId == true, default = c._configDefaultValue }
	end

	GUI._autoSaveEnabled = options.autoSave == true
	GUI._autoSaveInterval = math.max(2, tonumber(options.autoSaveInterval) or 10)
	GUI._autoSaveToken = 0
	function GUI:SetAutoSave(enabled, interval)
		GUI._autoSaveEnabled = enabled == true
		if interval then GUI._autoSaveInterval = math.max(2, tonumber(interval) or GUI._autoSaveInterval) end
		GUI._autoSaveToken = (GUI._autoSaveToken or 0) + 1
		local token = GUI._autoSaveToken
		if GUI._autoSaveEnabled then
			task.spawn(function()
				while not _destroyed and GUI._autoSaveEnabled and token == GUI._autoSaveToken do
					task.wait(GUI._autoSaveInterval)
					if GUI._configDirty then GUI:SaveConfig(true) end
				end
			end)
		end
		return GUI._autoSaveEnabled
	end
	function GUI:GetAutoSave()
		return GUI._autoSaveEnabled == true, GUI._autoSaveInterval
	end
	if GUI._autoSaveEnabled then GUI:SetAutoSave(true, GUI._autoSaveInterval) end

	GUI._startupLoadedConfig = GUI:LoadConfig()
	GUI._loadedConfigData = GUI._startupLoadedConfig
	if GUI._startupLoadedConfig then
		GUI:ApplyConfig(GUI._startupLoadedConfig)
	elseif options.theme and Library.Themes[options.theme] then
		GUI:SetTheme(options.theme, true)
	end

	end
	GUI:_installSmartConfig535()
	GUI._installSmartConfig535 = nil

	-- ══════════════════════════════════════════════════════════════════════
	-- AI Assistant tab (FIXED: now properly inside Library:new)
	-- ══════════════════════════════════════════════════════════════════════
	-- ══════════════════════════════════════════════════════════════════════
	-- AI ASSISTANT TAB (optional — aiEnabled=true)
	-- ══════════════════════════════════════════════════════════════════════
	if options.aiEnabled then
		task.defer(function()
			local HS    = game:GetService("HttpService")
			local _busy = false
			local _cooldownUntil = 0  -- tick() time when cooldown expires
			local _history = {}
			local _msgN    = 0

			local AI = GUI:CreateTab({ name = "AI", icon = "🤖" })

			AI:Paragraph({
				title = "AI Assistant",
				text  = "Ask anything about Roblox scripting, exploiting, or VenturaUI. "
					.. "Free — no key or signup needed.",
			})

			AI:Separator()

			local tabList = AI._scroll

			-- ── Input row at TOP (below tip, always visible) ──────────────────
			local inputRow = Instance.new("Frame", tabList)
			inputRow.Name               = "AIInputRow"
			inputRow.BackgroundTransparency = 1
			inputRow.BorderSizePixel    = 0
			inputRow.Size               = UDim2.new(1, 0, 0, 40)
			inputRow.LayoutOrder        = 8999

			local inputBg = Instance.new("Frame", inputRow)
			inputBg.BackgroundColor3 = Color3.fromRGB(17,17,17)
			inputBg.BorderSizePixel  = 0
			inputBg.Size             = UDim2.new(1, -46, 1, -6)
			inputBg.Position         = UDim2.new(0, 0, 0, 3)
			corner(inputBg, 6); stroke(inputBg, Library.Theme.Border)

			local aiBox = Instance.new("TextBox", inputBg)
			aiBox.BackgroundTransparency = 1
			aiBox.BorderSizePixel        = 0
			aiBox.Size                   = UDim2.new(1, -10, 1, 0)
			aiBox.Position               = UDim2.new(0, 8, 0, 0)
			aiBox.TextSize               = 12
			aiBox.FontFace               = Font.new("rbxasset://fonts/families/Ubuntu.json")
			aiBox.TextColor3             = Library.Theme.TextPrimary
			aiBox.PlaceholderText        = "Ask anything..."
			aiBox.PlaceholderColor3      = Library.Theme.TextDisabled
			aiBox.Text                   = ""
			aiBox.ClearTextOnFocus       = false
			aiBox.TextXAlignment         = Enum.TextXAlignment.Left
			aiBox.TextTruncate           = Enum.TextTruncate.AtEnd

			aiBox.Focused:Connect(function()
				tw(inputBg:FindFirstChildOfClass("UIStroke"), {Color=Library.Theme.Accent})
			end)
			aiBox.FocusLost:Connect(function()
				tw(inputBg:FindFirstChildOfClass("UIStroke"), {Color=Library.Theme.Border})
			end)

			local sendBtn = Instance.new("TextButton", inputRow)
			sendBtn.BackgroundColor3  = Library.Theme.Accent
			sendBtn.BorderSizePixel   = 0
			sendBtn.AnchorPoint       = Vector2.new(1, 0.5)
			sendBtn.Position          = UDim2.new(1, 0, 0.5, 0)
			sendBtn.Size              = UDim2.new(0, 38, 1, -6)
			sendBtn.Text              = "↑"
			sendBtn.TextSize          = 16
			sendBtn.TextColor3        = Color3.fromRGB(255, 255, 255)
			sendBtn.FontFace          = Font.new("rbxasset://fonts/families/Ubuntu.json", Enum.FontWeight.Bold)
			sendBtn.AutoButtonColor   = false
			corner(sendBtn, 6)
			sendBtn.MouseEnter:Connect(function() tw(sendBtn,{BackgroundColor3=Library.Theme.BorderHover}) end)
			sendBtn.MouseLeave:Connect(function() tw(sendBtn,{BackgroundColor3=Library.Theme.Accent}) end)

			-- ── Chat scroll BELOW input ────────────────────────────────────────
			local wrapper = Instance.new("Frame")
			wrapper.Name                   = "AIChatWrapper"
			wrapper.BackgroundTransparency = 1
			wrapper.Size                   = UDim2.new(1, -8, 0, 200)
			wrapper.BorderSizePixel        = 0
			wrapper.LayoutOrder            = 9000
			wrapper.Parent                 = tabList

			local chatScroll = Instance.new("ScrollingFrame")
			chatScroll.Name                 = "AIChat"
			chatScroll.BackgroundColor3     = Library.Theme.Nav
			chatScroll.BorderSizePixel      = 0
			chatScroll.Size                 = UDim2.new(1, 0, 1, 0)
			chatScroll.Position             = UDim2.new(0, 0, 0, 0)
			chatScroll.CanvasSize           = UDim2.new(0, 0, 0, 0)
			chatScroll.AutomaticCanvasSize  = Enum.AutomaticSize.Y
			chatScroll.ScrollBarThickness   = 2
			chatScroll.ScrollBarImageColor3 = Color3.fromRGB(60, 60, 60)
			chatScroll.ClipsDescendants     = true
			chatScroll.Parent               = wrapper
			Instance.new("UICorner", chatScroll).CornerRadius = UDim.new(0, 6)

			local chatList = Instance.new("UIListLayout", chatScroll)
			chatList.Padding       = UDim.new(0, 5)
			chatList.SortOrder     = Enum.SortOrder.LayoutOrder
			chatList.FillDirection = Enum.FillDirection.Vertical

			local chatPad = Instance.new("UIPadding", chatScroll)
			chatPad.PaddingTop    = UDim.new(0, 6)
			chatPad.PaddingBottom = UDim.new(0, 6)
			chatPad.PaddingLeft   = UDim.new(0, 7)
			chatPad.PaddingRight  = UDim.new(0, 7)

			local function _bubble(role, text)
				_msgN = _msgN + 1
				local isUser = (role == "user")
				local row = Instance.new("Frame", chatScroll)
				row.BackgroundTransparency = 1
				row.BorderSizePixel        = 0
				row.Size                   = UDim2.new(1, 0, 0, 0)
				row.AutomaticSize          = Enum.AutomaticSize.Y
				row.LayoutOrder            = _msgN
				local bub = Instance.new("TextLabel", row)
				bub.BackgroundColor3  = isUser and Library.Theme.Accent or Library.Theme.Surface
				bub.BorderSizePixel   = 0
				bub.TextWrapped       = true
				bub.RichText          = false
				bub.TextSize          = 11
				bub.TextXAlignment    = Enum.TextXAlignment.Left
				bub.TextYAlignment    = Enum.TextYAlignment.Top
				bub.FontFace          = Font.new("rbxasset://fonts/families/Ubuntu.json")
				bub.TextColor3        = isUser and Color3.fromRGB(255,255,255) or Library.Theme.TextPrimary
				bub.Text              = (isUser and "You: " or "AI: ") .. tostring(text)
				bub.AutomaticSize     = Enum.AutomaticSize.Y
				bub.Size              = UDim2.new(0.84, 0, 0, 0)
				bub.AnchorPoint       = Vector2.new(isUser and 1 or 0, 0)
				bub.Position          = UDim2.new(isUser and 1 or 0, isUser and -4 or 4, 0, 0)
				local bPad = Instance.new("UIPadding", bub)
				bPad.PaddingTop    = UDim.new(0, 5)
				bPad.PaddingBottom = UDim.new(0, 5)
				bPad.PaddingLeft   = UDim.new(0, 7)
				bPad.PaddingRight  = UDim.new(0, 7)
				Instance.new("UICorner", bub).CornerRadius = UDim.new(0, 6)
				task.defer(function()
					pcall(function()
						chatScroll.CanvasPosition = Vector2.new(0, chatScroll.AbsoluteCanvasSize.Y)
					end)
				end)
				return bub
			end

			local function _send(userText)
				userText = tostring(userText or ""):match("^%s*(.-)%s*$")
				if userText == "" then return end
				if _busy then
					GUI.notify("AI", "Still waiting for a reply...", 2)
					return
				end
				local remaining = math.ceil(_cooldownUntil - tick())
				if remaining > 0 then
					GUI.notify("AI", "Please wait " .. remaining .. "s before next message.", 2)
					return
				end
				_busy = true
				table.insert(_history, { role = "user", content = userText })
				_bubble("user", userText)
				local thinkBub = _bubble("assistant", "...")
				task.spawn(function()
					-- Build message history
					local contextMsgs = {}
					for _, m in ipairs(_history) do
						table.insert(contextMsgs, m.role .. ": " .. m.content)
					end
					local context = table.concat(contextMsgs, "\n")

					local systemPrompt = "You are a helpful Roblox scripting assistant inside VenturaUI. "
						.. "Answer questions about Roblox Lua, game development, UI scripting, and VenturaUI. "
						.. "Be concise and use plain text only, no markdown."

					local fullPrompt = systemPrompt .. "\n\nConversation so far:\n" .. context

					-- Executor-compatible HTTP
					local function httpReq(opts)
						if syn and syn.request then return syn.request(opts)
						elseif request then return request(opts)
						elseif http and http.request then return http.request(opts)
						elseif http_request then return http_request(opts)
						else return nil end
					end

					-- URL encode
					local function enc(s)
						return s:gsub("[^%w%-%.%_%~]", function(c)
							return string.format("%%%02X", string.byte(c))
						end)
					end

					-- Get body if response is success
					local function getBody(ok, res)
						if not ok or not res then return nil end
						local body = res.Body or res.body or ""
						local status = res.StatusCode or res.status_code or 0
						if (res.Success or res.success or status == 200) and body ~= "" then
							return body
						end
						return nil
					end

					-- Safety: always unblock after 30s even if all requests hang
					task.delay(30, function()
						if _busy then
							_busy = false
							pcall(function() thinkBub.Text = "AI: Request timed out. Please try again." end)
						end
					end)

					local reply = ""

					-- Provider 1: Pollinations POST (JSON, most reliable)
					if reply == "" then
						local ok1, res1 = pcall(httpReq, {
							Url    = "https://text.pollinations.ai/openai",
							Method = "POST",
							Headers = { ["Content-Type"] = "application/json" },
							Body = HS:JSONEncode({
								model    = "openai",
								private  = true,
								messages = {
									{ role = "system", content = systemPrompt },
									{ role = "user",   content = context },
								},
							}),
						})
						local b1 = getBody(ok1, res1)
						if b1 then
							local ok2, data = pcall(HS.JSONDecode, HS, b1)
							if ok2 and data and data.choices and data.choices[1] then
								reply = ((data.choices[1].message or {}).content or ""):match("^%s*(.-)%s*$")
							end
						end
					end

					-- Provider 2: Pollinations GET mistral (shorter prompt to avoid URL length issues)
					if reply == "" then
						local shortPrompt = systemPrompt .. "\nUser: " .. userText
						local ok3, res3 = pcall(httpReq, {
							Url    = "https://text.pollinations.ai/" .. enc(shortPrompt) .. "?model=mistral&private=true",
							Method = "GET",
						})
						local b3 = getBody(ok3, res3)
						if b3 and b3 ~= "" then reply = b3:match("^%s*(.-)%s*$") end
					end

					-- Provider 3: Pollinations GET default model, short prompt
					if reply == "" then
						local shortPrompt = "Roblox scripting assistant. User asks: " .. userText
						local ok4, res4 = pcall(httpReq, {
							Url    = "https://text.pollinations.ai/" .. enc(shortPrompt) .. "?private=true",
							Method = "GET",
						})
						local b4 = getBody(ok4, res4)
						if b4 and b4 ~= "" then reply = b4:match("^%s*(.-)%s*$") end
					end

					-- Provider 4: retry Provider 1 once more before giving up
					if reply == "" then
						task.wait(1.5)
						local ok5, res5 = pcall(httpReq, {
							Url    = "https://text.pollinations.ai/openai",
							Method = "POST",
							Headers = { ["Content-Type"] = "application/json" },
							Body = HS:JSONEncode({
								model    = "openai",
								private  = true,
								messages = {
									{ role = "system", content = systemPrompt },
									{ role = "user",   content = userText },
								},
							}),
						})
						local b5 = getBody(ok5, res5)
						if b5 then
							local ok6, data = pcall(HS.JSONDecode, HS, b5)
							if ok6 and data and data.choices and data.choices[1] then
								reply = ((data.choices[1].message or {}).content or ""):match("^%s*(.-)%s*$")
							end
						end
					end

					-- If still nothing, don't start cooldown — let them retry immediately
					if reply == "" then
						pcall(function() thinkBub.Text = "AI: No response — tap send again to retry." end)
						_busy = false
						return
					end

					pcall(function() thinkBub.Text = "AI: " .. reply end)
					table.insert(_history, { role = "assistant", content = reply })
					while #_history > 20 do table.remove(_history, 1) end

					-- Only start cooldown on successful reply
					local COOLDOWN = 12
					_cooldownUntil = tick() + COOLDOWN
					local cdBub = _bubble("assistant", "⏳ Next message in " .. COOLDOWN .. "s...")
					task.spawn(function()
						for t = COOLDOWN, 1, -1 do
							pcall(function() cdBub.Text = "⏳ Next message in " .. t .. "s..." end)
							task.wait(1)
						end
						pcall(function() cdBub.Text = "✓ Ready!" end)
					end)

					task.defer(function()
						pcall(function()
							chatScroll.CanvasPosition = Vector2.new(0, chatScroll.AbsoluteCanvasSize.Y)
						end)
					end)
					_busy = false
				end)
			end

			local function doSend()
				local msg = aiBox.Text
				if msg == "" or msg:match("^%s*$") then return end
				aiBox.Text = ""
				_send(msg)
			end

			sendBtn.MouseButton1Click:Connect(doSend)
			aiBox.FocusLost:Connect(function(enterPressed)
				if enterPressed then doSend() end
			end)

			AI:Button({
				name        = "Clear Chat",
				description = "Wipe all messages and conversation history",
				callback    = function()
					_history = {}; _msgN = 0
					for _, c in ipairs(chatScroll:GetChildren()) do
						if c:IsA("Frame") then c:Destroy() end
					end
					GUI.notify("AI", "Chat cleared.", 2)
				end,
			})
		end) -- task.defer (AI)
	end -- if options.aiEnabled

