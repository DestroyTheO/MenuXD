		V.wmLbl.TextSize = 13; V.wmLbl.ZIndex = 51
		V.wmLbl.FontFace = Font.new("rbxasset://fonts/families/RobotoMono.json", Enum.FontWeight.SemiBold)
		V.wmLbl.TextColor3 = Library.Theme.TextPrimary
		pcall(function() V.wmLbl:SetAttribute("VenturaBaseTextSize", _watermarkBaseTextSize()) end)
		_applyWatermarkFontScale()
		V.wmLbl.Text = V.wmBaseText
		V.wmLbl.TextXAlignment = Enum.TextXAlignment.Left
		V.wmLbl.TextYAlignment = Enum.TextYAlignment.Center

		-- v5.66: no resize handle, but Settings exposes safe size controls again.

		_syncWatermarkStats()
		local wmDrag, wmDragStart, wmDragPos = false, nil, nil
		V.wmFrame.InputBegan:Connect(function(i)
			if (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) and not V._wmResizing then
				wmDrag=true; wmDragStart=i.Position; wmDragPos=V.wmFrame.Position
			end
		end)
		GUI:_registerInputHandler("changed", "watermark-drag", function(i)
			if (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) and V._wmResizing then
				local d = i.Position - V._wmResizeStart
				_applyWatermarkSize((V._wmStartW or V.wmWidth) - d.X, (V._wmStartH or V.wmHeight) + d.Y, true)
				return
			end
			if wmDrag and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
				local d = (i.Position - wmDragStart) * getDragOutMultiplier()
				V.wmFrame.Position = UDim2.new(wmDragPos.X.Scale, wmDragPos.X.Offset + d.X, wmDragPos.Y.Scale, wmDragPos.Y.Offset + d.Y)
			end
		end, "watermark")
		GUI:_registerInputHandler("ended", "watermark-drag-end", function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
				if V._wmResizing then V._wmResizing = false; pcall(function() GUI:MarkConfigDirty() end) end
				if wmDrag then pcall(function() GUI:MarkConfigDirty() end) end
				wmDrag=false
			end
		end, "watermark")
		GUI._watermark = V.wmFrame
	end

