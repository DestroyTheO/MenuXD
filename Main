-- v5.42: apply the moving space/star layer to every theme, including older themes.
-- Themes without an explicit style get a deterministic style based on their name.
do
	local styleByTheme = {
		Dark="void", Midnight="nova", Obsidian="void", Crimson="embers", Royal="galaxy",
		Teal="aurora", Forest="matrix", Solar="luxury", Cyber="nova", Nebula="galaxy",
		Matrix="matrix", Ice="ocean", BloodMoon="embers", Slate="void", Candy="sakura",
		Space="nova", Galaxy="galaxy", Aurora="aurora", Void="void", Nova="nova",
		Inferno="embers", Radioactive="toxic", Ocean="ocean", Sakura="sakura", Luxury="luxury",
		Phantom="void", Synthwave="galaxy", Eclipse="luxury", Amethyst="galaxy", Glacier="ocean",
		EmeraldNight="matrix", RoseGold="sakura", Vapor="aurora", Noir="void", Volcano="embers",
		Hologram="neon", Carbon="void", Cyberpunk="neon", Frostbite="snow", Dracula="embers", Storm="storm",
		MintGlass="aurora", RubyShadow="embers", GoldenHour="luxury", DeepCode="matrix", Moonlight="snow", Vortex="vortex",
	}
	for name, data in pairs(Library.Themes or {}) do
		if type(data) == "table" then
			data.Stars = true
			data.Animated = true
			data.AnimationStyle = data.AnimationStyle or styleByTheme[name] or tostring(name):lower()
			if typeof(data.Accent) ~= "Color3" and Library.ThemeAccents and typeof(Library.ThemeAccents[name]) == "Color3" then
				data.Accent = Library.ThemeAccents[name]
			end
		end
	end
end

local function _themeAccentFor(name, theme)
	if type(theme) == "table" and typeof(theme.Accent) == "Color3" then
		return theme.Accent
	end
	local mapped = Library.ThemeAccents and Library.ThemeAccents[tostring(name or "")]
	if typeof(mapped) == "Color3" then
		return mapped
	end
	return Library.Accents.Blue or Library.Theme.Accent
end

local _NOOP_TWEEN = {
	Play = function() end,
	Cancel = function() end,
	Pause = function() end,
	Completed = { Once = function() end, Connect = function() return { Disconnect = function() end } end },
}


