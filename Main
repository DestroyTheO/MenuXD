	function GUI:GetKeybinds()
		return {
			toggle = keys.toggle,
			bubble = keys.toggle,
			-- Legacy alias: no separate minimize key exists anymore.
			minimize = keys.toggle,
		}
	end
	function GUI:SetKeybind(action, key)
		action = tostring(action or ""):lower()
		key = _safeEnumKey(key, nil)
		if not key then
			return false
		end
		if action == "toggle" or action == "toggleui" or action == "ui" or action == "bubble" or action == "minimize" or action == "min" then
			-- 5.34: bubble/minimize aliases intentionally update the same toggle key.
			keys.toggle = key
		else
			return false
		end
		pcall(function() GUI:MarkConfigDirty() end)
		return true
	end
	function GUI:CancelKeybindCapture()
		if GUI._activeKeybind and GUI._activeKeybind._stopListening then
			GUI._activeKeybind:_stopListening(true)
			return true
		end
		return false
	end
	function GUI:SetSubtitle(text) pcall(function() lSub.Text=tostring(text or "") end) end
	function GUI:SelectTab(name)
		for _,tab in ipairs(GUI._tabs) do
			if tab._name==name and not tab._disabled then tab:Activate(); return true end
		end
		return false
	end
	function GUI:SetControlSearch(query, tabName)
		local target = GUI.CurrentTab
		if tabName ~= nil then
			for _, tab in ipairs(GUI._tabs or {}) do
				if tab._name == tabName then target = tab; break end
			end
		end
		if target and type(target.SetSearchQuery) == "function" then target:SetSearchQuery(query); return true end
		return false
	end
	function GUI:ClearControlSearch()
		for _, tab in ipairs(GUI._tabs or {}) do
			if type(tab.ClearSearch) == "function" then pcall(function() tab:ClearSearch() end) end
		end
		return true
	end
	function GUI:SetControlSearchVisible(state)
		for _, tab in ipairs(GUI._tabs or {}) do
			if type(tab.SetControlSearchVisible) == "function" then pcall(function() tab:SetControlSearchVisible(state) end) end
		end
		return state ~= false
	end
	track(exitBtn.MouseButton1Click:Connect(function()
		if _destroyed then return end
		if options.onClose then pcall(options.onClose) end
		-- 5.9: no delayed goodbye task by default; close should stop activity immediately.
		if options.goodbyeNotification == true then
			pcall(function() GUI.notify("Ventura UI", "Closing...", 0.8, "info") end)
		end
		GUI:Destroy()
	end))

	-- ── Shared global key listener (UI hotkeys + all keybind widgets) ───────
	track(UIS.InputBegan:Connect(function(input,gpe)
		if _destroyed then return end

		local activeKB = GUI._activeKeybind
		if activeKB and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
			-- Clicking anywhere after the initial bind-click cancels capture, so the label
			-- cannot get stuck on "Press key...". A tiny guard prevents the same click
			-- that opened capture from instantly cancelling it.
			if os.clock() >= tonumber(GUI._keybindMouseGuardUntil or 0) then
				activeKB:_stopListening(true)
			end
			return
		end

		if input.UserInputType~=Enum.UserInputType.Keyboard then return end

		if activeKB then
			if input.KeyCode == Enum.KeyCode.Escape then
				activeKB:_stopListening(true)
				return
			end
			local parsedKey = _safeEnumKey(input.KeyCode, nil)
			if not parsedKey then return end
			activeKB.Value = parsedKey
			activeKB:_refreshLabel()
			activeKB:_stopListening(false)
			_safeCall("keybind callback", activeKB._callback, parsedKey)
			pcall(function() GUI:MarkConfigDirty() end)
			return
		end

		if gpe or keybindListening then return end
		if input.KeyCode==keys.toggle then
			-- 5.34: one key owns the full toggle+bubble flow.
			-- Press once: main window hides and creates the draggable bubble.
			-- Press again or click the bubble: main window restores.
			if options.toggleCreatesBubble ~= false then
				GUI._open = true
				V.doMinimize(not V.minimized)
			else
				GUI._open=not GUI._open
				_syncOpenVisibility()
			end
		end
	end))

	-- ── Window drag ─────────────────────────────────────────────────────────
	-- Normalize scale-based positions to absolute pixel offsets before dragging.
	-- This prevents the first drag from jumping toward the top-left.
	V.dragging = false
	V.dragStart = nil
	V.startPos = nil
	V.dragInput = nil

	track(Topbar.InputBegan:Connect(function(input)
		local inputType = input.UserInputType
		if inputType ~= Enum.UserInputType.MouseButton1 and inputType ~= Enum.UserInputType.Touch then
			return
		end

		local relX = input.Position.X - Main.AbsolutePosition.X
		if relX <= 40 or relX >= Main.AbsoluteSize.X - 92 then return end

		local current = _offsetPosition(
			MainWrap.Position,
			MainWrap.AbsolutePosition.X + MainWrap.AbsoluteSize.X * MainWrap.AnchorPoint.X,
			MainWrap.AbsolutePosition.Y + MainWrap.AbsoluteSize.Y * MainWrap.AnchorPoint.Y
		)

		-- Convert once at drag start. All later calculations stay in one coordinate system.
		MainWrap.Position = current
		_runtimeRoot.windowPosition = current

		V.dragging = true
		V.dragInput = inputType == Enum.UserInputType.Touch and input or nil
		V.dragStart = Vector2.new(input.Position.X, input.Position.Y)
		V.startPos = current
	end))

	GUI:_registerInputHandler("changed", "window-drag", function(input)
		if not V.dragging or not V.dragStart or not V.startPos then return end
		local inputType = input.UserInputType
		if inputType ~= Enum.UserInputType.MouseMovement and inputType ~= Enum.UserInputType.Touch then return end
		if inputType == Enum.UserInputType.Touch and V.dragInput and input ~= V.dragInput then return end
		local delta = (Vector2.new(input.Position.X, input.Position.Y) - V.dragStart) * getDragOutMultiplier()
		local newX = V.startPos.X.Offset + delta.X
		local newY = V.startPos.Y.Offset + delta.Y
		if _dragBordersEnabled() then
			local camera = workspace.CurrentCamera
			local viewport = camera and camera.ViewportSize or Vector2.new(1280, 720)
			local scaledW, fullH = getScaledWindowSize()
			local scaledH = V.minimized and 34 or fullH
			newX = math.clamp(newX, scaledW / 2, viewport.X - scaledW / 2)
			newY = math.clamp(newY, scaledH / 2, viewport.Y - scaledH / 2)
		end
		local position = UDim2.new(0, math.floor(newX + 0.5), 0, math.floor(newY + 0.5))
		MainWrap.Position = position
		_runtimeRoot.windowPosition = position
	end, "window")
	GUI:_registerInputHandler("ended", "window-drag-end", function(input)
		local inputType = input.UserInputType
		local endsMouse = inputType == Enum.UserInputType.MouseButton1
		local endsTouch = inputType == Enum.UserInputType.Touch and (V.dragInput == nil or input == V.dragInput)
		if endsMouse or endsTouch then
			V.dragging=false; V.dragInput=nil; V.dragStart=nil; V.startPos=nil
			if MainWrap and MainWrap.Parent then _runtimeRoot.windowPosition = MainWrap.Position end
		end
	end, "window")

	-- ── Window resize (bottom-right corner hotspot) ────────────────────────
	local resizeHandle = Instance.new("TextButton", Main)
	resizeHandle.Name = "ResizeHandle"
	resizeHandle.Size = UDim2.new(0, 22, 0, 22)
	resizeHandle.AnchorPoint = Vector2.new(1, 1)
	resizeHandle.Position = UDim2.new(1, -2, 1, -2)
	resizeHandle.BackgroundTransparency = 1
	resizeHandle.BorderSizePixel = 0
	resizeHandle.Text = "⌟"
	resizeHandle.TextSize = 17
	resizeHandle.TextColor3 = Library.Theme.TextDisabled
	resizeHandle.FontFace = Font.new("rbxasset://fonts/families/RobotoMono.json", Enum.FontWeight.Bold)
	resizeHandle.ZIndex = 10
	resizeHandle.Active = true
	resizeHandle.Selectable = false
	resizeHandle.AutoButtonColor = false
	addTooltip(resizeHandle, "Drag to resize")

	V.resizeDragging = false
	V.resizeDragStart, V.resizeStartSize = nil, nil
	V.resizeInput = nil
	track(resizeHandle.InputBegan:Connect(function(i)
		if V.minimized then return end  -- no resize while minimized
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			V.resizeDragging = true
			V.resizeInput = i.UserInputType == Enum.UserInputType.Touch and i or nil
			V.resizeDragStart = Vector2.new(i.Position.X, i.Position.Y)
			V.resizeStartSize = Vector2.new(winW, winH)  -- use logical size, not AbsoluteSize
		end
	end))

	GUI:_registerInputHandler("changed", "window-resize", function(i)
		if not V.resizeDragging then return end
		if i.UserInputType ~= Enum.UserInputType.MouseMovement and i.UserInputType ~= Enum.UserInputType.Touch then return end
		if i.UserInputType == Enum.UserInputType.Touch and V.resizeInput and i ~= V.resizeInput then return end
		local delta = Vector2.new(i.Position.X, i.Position.Y) - V.resizeDragStart
		WIN_MAX_W, WIN_MAX_H = getViewportLimit()
		local newW = math.clamp(V.resizeStartSize.X + delta.X, WIN_MIN_W, WIN_MAX_W)
		local newH = math.clamp(V.resizeStartSize.Y + delta.Y, WIN_MIN_H, WIN_MAX_H)
		winW, winH, currentScale = newW, newH, 100
		MainWrap.Size = UDim2.new(0, newW, 0, newH)
	end, "window")
	GUI:_registerInputHandler("ended", "window-resize-end", function(i)
		local inputType = i.UserInputType
		local endsMouse = inputType == Enum.UserInputType.MouseButton1
		local endsTouch = inputType == Enum.UserInputType.Touch and (V.resizeInput == nil or i == V.resizeInput)
		if (endsMouse or endsTouch) and V.resizeDragging then
			V.resizeDragging=false; V.resizeInput=nil; GUI:MarkConfigDirty()
		end
	end, "window")

	-- ══════════════════════════════════════════════════════════════════════
	-- MAIN TAB SYSTEM — GUI:CreateTab
	-- Create a tab and all its component methods
	-- ══════════════════════════════════════════════════════════════════════
	function GUI:CreateTab(opts)
		opts=validate({name="Tab", icon="🏠", badge=nil, badgeColor=nil},opts)
		local Tab={Active=false, _name=opts.name, _disabled=false, _lazyBuilders={}, _lazyBuilt=false, _lazy=(opts.lazy == true or options.lazyTabs == true)}
		local isFirst=(#GUI._tabs==0)
		table.insert(GUI._tabs,Tab)
		if isFirst then GUI.CurrentTab=Tab; Tab.Active=true end

		Tab._scroll=Instance.new("ScrollingFrame",Content)
		Tab._scroll.Name=opts.name.."_Content"
		Tab._scroll.BackgroundTransparency=1; Tab._scroll.BorderSizePixel=0
		Tab._scroll.Size=UDim2.new(1,0,1,0); Tab._scroll.ClipsDescendants=true
		Tab._scroll.ScrollBarThickness=2; Tab._scroll.ScrollBarImageColor3=Color3.fromRGB(62,62,62)
		Tab._scroll.CanvasSize=UDim2.new(0,0,0,0)
		Tab._scroll.Position=isFirst and UDim2.new(0,0,0,0) or UDim2.new(0,99999,0,0)
		Tab._scroll.Visible=true
		pad(Tab._scroll,4,4,6,2)
		local sL=Instance.new("UIListLayout",Tab._scroll)
		sL.Padding=UDim.new(0,9); sL.SortOrder=Enum.SortOrder.LayoutOrder
		sL:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
			Tab._scroll.CanvasSize=UDim2.new(0,0,0,sL.AbsoluteContentSize.Y+14)
		end)

		-- v5.69 usability: per-tab control search, rich tooltips, and collapsible control groups. Pins/favorites removed.
		Tab._usabilityControls = {}
		Tab._searchQuery = ""
		Tab._controlSearchVisible = true

		local SearchFrame = Instance.new("Frame", Tab._scroll)
		SearchFrame.Name = "ControlSearchBar"
		SearchFrame.BackgroundColor3 = Library.Theme.Surface
		SearchFrame.BorderSizePixel = 0
		SearchFrame.Size = UDim2.new(1, 0, 0, 36)
		SearchFrame.LayoutOrder = -1000000
		SearchFrame:SetAttribute("VenturaThemeRole", "Surface")
		SearchFrame:SetAttribute("VenturaSearchBar", true)
		SearchFrame:SetAttribute("VenturaNoPin", true)
		corner(SearchFrame, 9)
		local searchStroke = stroke(SearchFrame, Library.Theme.Border, 1)
		pcall(function()
			searchStroke:SetAttribute("VenturaThemeRole", "Border")
			searchStroke:SetAttribute("VenturaThemeProp", "Color")
		end)
		local searchIcon = lbl(SearchFrame, Library.Icons.search or "🔍", 13, Library.Theme.TextSecondary, FONT_UI_BOLD, Enum.TextXAlignment.Center)
		searchIcon.Name = "ControlSearchIcon"
		searchIcon.Size = UDim2.new(0, 30, 1, 0)
		searchIcon.Position = UDim2.new(0, 6, 0, 0)
		pcall(function() searchIcon:SetAttribute("VenturaTextRole", "TextSecondary") end)
		local searchBox = Instance.new("TextBox", SearchFrame)
		searchBox.Name = "ControlSearchInput"
		searchBox.BackgroundTransparency = 1
		searchBox.BorderSizePixel = 0
		searchBox.ClearTextOnFocus = false
		searchBox.PlaceholderText = "Search controls in " .. tostring(opts.name or "tab") .. "..."
		searchBox.PlaceholderColor3 = Library.Theme.TextDisabled
		searchBox.Text = ""
		searchBox.TextColor3 = Library.Theme.TextPrimary
		searchBox.TextSize = 12
		searchBox.FontFace = FONT_UI
		searchBox.TextXAlignment = Enum.TextXAlignment.Left
		searchBox.Size = UDim2.new(1, -70, 1, 0)
		searchBox.Position = UDim2.new(0, 36, 0, 0)
		pcall(function() searchBox:SetAttribute("VenturaTextRole", "TextPrimary") end)
		local clearSearch = Instance.new("TextButton", SearchFrame)
		clearSearch.Name = "ControlSearchClear"
		clearSearch.BackgroundTransparency = 1
		clearSearch.BorderSizePixel = 0
		clearSearch.Text = "×"
		clearSearch.TextSize = 16
		clearSearch.FontFace = FONT_UI_BOLD
		clearSearch.TextColor3 = Library.Theme.TextDisabled
		clearSearch.AnchorPoint = Vector2.new(1, 0.5)
		clearSearch.Position = UDim2.new(1, -8, 0.5, 0)
		clearSearch.Size = UDim2.new(0, 24, 0, 24)
		clearSearch.AutoButtonColor = false
		pcall(function() clearSearch:SetAttribute("VenturaTextRole", "TextDisabled") end)
		addTooltip(SearchFrame, {name="Control Search", description="Filter controls in this tab without changing their saved config values.", tip="Press the X button to clear the search."})

		local function _normalizeSearchText(value)
			return tostring(value or ""):lower()
		end

		function Tab:_ApplyControlSearch()
			local query = _normalizeSearchText(Tab._searchQuery)
			local hasQuery = query ~= ""
			for i = #Tab._usabilityControls, 1, -1 do
				local control = Tab._usabilityControls[i]
				local frame = control and control.frame
				if not frame or not frame.Parent then
					table.remove(Tab._usabilityControls, i)
				else
					local haystack = _normalizeSearchText(frame:GetAttribute("VenturaSearchText") or control._searchText or "")
					local visible = (not hasQuery) or haystack:find(query, 1, true) ~= nil
					if control._manualVisible == false then visible = false end
					frame.Visible = visible
				end
			end
			return true
		end

		function Tab:SetSearchQuery(query)
			Tab._searchQuery = tostring(query or "")
			if searchBox and searchBox.Text ~= Tab._searchQuery then searchBox.Text = Tab._searchQuery end
			Tab:_ApplyControlSearch()
			return Tab
		end
		function Tab:GetSearchQuery() return Tab._searchQuery end
		function Tab:ClearSearch() return Tab:SetSearchQuery("") end
		function Tab:SetControlSearchVisible(state)
			Tab._controlSearchVisible = state ~= false
			SearchFrame.Visible = Tab._controlSearchVisible
			return Tab
		end
		function Tab:GetControlSearchVisible() return Tab._controlSearchVisible ~= false end
		track(searchBox:GetPropertyChangedSignal("Text"):Connect(function()
			Tab._searchQuery = searchBox.Text or ""
			Tab:_ApplyControlSearch()
		end))
		track(clearSearch.MouseButton1Click:Connect(function()
			Tab:ClearSearch()
		end))

		Tab._searchFrame = SearchFrame
		Tab._searchBox = searchBox

		Tab._navBtn=Instance.new("Frame",BtnHolder)
		Tab._navBtn.Name=opts.name.."_Btn"; Tab._navBtn.BorderSizePixel=0
		Tab._navBtn:SetAttribute("VenturaTabButton", true)
		Tab._navBtn.BackgroundColor3=isFirst and Library.Theme.Accent:Lerp(Library.Theme.Nav, 0.72) or Library.Theme.Nav
		Tab._navBtn.BackgroundTransparency=isFirst and 0.18 or 1
		Tab._navBtn.Size=UDim2.new(1,0,0,34)
		Tab._navBtn.LayoutOrder=_nextNavOrder()
		corner(Tab._navBtn,4)

		-- Register with an explicit section, fixed-bottom system section, or active user section.
		-- Themes/Settings pass the fixed-bottom section, so they always stay at the
		-- bottom of the nav while normal user tabs keep using normal sections.
		local sec = opts.navSection
		if opts.bottomSection == true or opts.systemTab == true then
			sec = sec or GUI._bottomNavSection
		end
		sec = sec or GUI._activeNavSection
		if sec and sec._registerTab then
			sec._registerTab(Tab._navBtn)
		end

		local indicator=Instance.new("Frame",Tab._navBtn)
		indicator.BackgroundColor3=Library.Theme.Accent; regAccent(indicator); indicator.BorderSizePixel=0
		indicator.AnchorPoint=Vector2.new(0,0.5)
		indicator.Size=UDim2.new(0,isFirst and 2 or 0,0.65,0)
		indicator.Position=UDim2.new(0,0,0.5,0); indicator.ZIndex=1; corner(indicator,2)
		Tab._indicator=indicator

		-- Smart icon: TextLabel for unicode glyphs, ImageLabel for asset IDs
		local iconInfo = resolveIcon(opts.icon)
		local navIcon
		if iconInfo.kind == "text" then
			navIcon = Instance.new("TextLabel", Tab._navBtn)
			navIcon.BackgroundTransparency = 1
			navIcon.BorderSizePixel = 0
			navIcon.AnchorPoint = Vector2.new(0, 0.5)
			navIcon.Size = UDim2.new(0, 20, 0, 20)
			navIcon.Position = UDim2.new(0, 6, 0.5, 0)
			navIcon.ZIndex = 2
			navIcon.Text = iconInfo.value
			navIcon.TextSize = 15
			navIcon.FontFace = Font.new("rbxasset://fonts/families/Ubuntu.json")
			navIcon.Name = "NavIcon"
			navIcon:SetAttribute("VenturaNavIcon", true)
			navIcon.TextColor3 = isFirst and Library.Theme.Accent or Library.Theme.TextSecondary
			navIcon.TextXAlignment = Enum.TextXAlignment.Center
			navIcon.TextYAlignment = Enum.TextYAlignment.Center
		else
			navIcon = Instance.new("ImageLabel", Tab._navBtn)
			navIcon.BackgroundTransparency = 1
			navIcon.BorderSizePixel = 0
			navIcon.AnchorPoint = Vector2.new(0, 0.5)
			navIcon.Image = iconInfo.kind == "image" and iconInfo.value or ""
			navIcon.Name = "NavIcon"
			navIcon:SetAttribute("VenturaNavIcon", true)
			navIcon.ImageColor3 = isFirst and Library.Theme.Accent or Library.Theme.TextSecondary
			navIcon.Size = UDim2.new(0, 18, 0, 18)
			navIcon.Position = UDim2.new(0, 6, 0.5, 0)
			navIcon.ZIndex = 2
		end
		Tab._navIcon = navIcon
		Tab._navIconKind = iconInfo.kind

		local navText=Instance.new("TextLabel",Tab._navBtn)
		navText.Name="NavText"; navText:SetAttribute("VenturaNavText", true)
		navText.BackgroundTransparency=1; navText.BorderSizePixel=0
		navText.TextSize=14; navText.FontFace=Font.new("rbxasset://fonts/families/Ubuntu.json")
		navText.TextColor3=isFirst and Library.Theme.Accent or Library.Theme.TextSecondary
		navText.Text=opts.name; navText.TextTruncate=Enum.TextTruncate.AtEnd
		navText.TextXAlignment=Enum.TextXAlignment.Left
		navText.Size=UDim2.new(1,-40,1,0); navText.Position=UDim2.new(0,34,0,0); navText.ZIndex=2
		Tab._navText=navText

		if opts.badge then
			local badgeFrame=Instance.new("Frame",Tab._navBtn)
			badgeFrame.BackgroundColor3=opts.badgeColor or Color3.fromRGB(255,80,80)
			badgeFrame.BorderSizePixel=0; badgeFrame.AnchorPoint=Vector2.new(1,0.5)
			badgeFrame.Size=UDim2.new(0,math.max(#opts.badge*6+8,24),0,13)
			badgeFrame.Position=UDim2.new(1,-2,0.5,0); badgeFrame.ZIndex=3; corner(badgeFrame,3)
			local badgeLbl=Instance.new("TextLabel",badgeFrame)
			badgeLbl.BackgroundTransparency=1; badgeLbl.Size=UDim2.new(1,0,1,0)
			badgeLbl.TextSize=9; badgeLbl.TextXAlignment=Enum.TextXAlignment.Center
			badgeLbl.FontFace=Font.new("rbxasset://fonts/families/Ubuntu.json",Enum.FontWeight.Bold)
			badgeLbl.TextColor3=Color3.fromRGB(255,255,255); badgeLbl.Text=opts.badge; badgeLbl.ZIndex=4
		end

		local navClickBtn=Instance.new("TextButton",Tab._navBtn)
		navClickBtn.BackgroundTransparency=1; navClickBtn.BorderSizePixel=0
		navClickBtn.Size=UDim2.new(1,0,1,0); navClickBtn.Text=""; navClickBtn.ZIndex=3
		navClickBtn.AutoButtonColor=false

		local function _tabSelectedBackground()
			local accent = Library.Theme.Accent
			local navColor = Library.Theme.Nav or Library.Theme.Background
			return accent:Lerp(navColor, 0.72)
		end

		function Tab:_ApplyNavStyle(instant)
			local active = Tab.Active and not Tab._disabled
			local txtColor = Tab._disabled and Library.Theme.TextDisabled or (active and Library.Theme.Accent or Library.Theme.TextSecondary)
			local bgColor = active and _tabSelectedBackground() or Library.Theme.Nav
			local bgTrans = active and 0.18 or 1
			local indicatorSize = UDim2.new(0, active and 3 or 0, 0.65, 0)
			if instant then
				Tab._navBtn.BackgroundColor3 = bgColor
				Tab._navBtn.BackgroundTransparency = bgTrans
				navText.TextColor3 = txtColor
				if Tab._navIconKind == "text" then navIcon.TextColor3 = txtColor else navIcon.ImageColor3 = txtColor end
				Tab._indicator.Size = indicatorSize
			else
				tw(Tab._navBtn,{BackgroundColor3=bgColor, BackgroundTransparency=bgTrans})
				tw(navText,{TextColor3=txtColor})
				if Tab._navIconKind == "text" then tw(navIcon,{TextColor3=txtColor}) else tw(navIcon,{ImageColor3=txtColor}) end
				tw(Tab._indicator,{Size=indicatorSize})
			end
		end
		Tab:_ApplyNavStyle(true)

		navClickBtn.MouseEnter:Connect(function()
			if not Tab.Active and not Tab._disabled then
				tw(Tab._navBtn,{BackgroundTransparency=0.85})
				tw(navText,{TextColor3=Library.Theme.TextPrimary})
				if Tab._navIconKind=="text" then tw(navIcon,{TextColor3=Library.Theme.TextPrimary}) else tw(navIcon,{ImageColor3=Library.Theme.TextPrimary}) end
			end
		end)
		navClickBtn.MouseLeave:Connect(function()
			if not Tab.Active and not Tab._disabled then
				tw(Tab._navBtn,{BackgroundTransparency=1})
				tw(navText,{TextColor3=Library.Theme.TextSecondary})
				if Tab._navIconKind=="text" then tw(navIcon,{TextColor3=Library.Theme.TextSecondary}) else tw(navIcon,{ImageColor3=Library.Theme.TextSecondary}) end
			end
		end)
		navClickBtn.MouseButton1Click:Connect(function()
			if not Tab._disabled then Tab:Activate() end
		end)

		function Tab:Activate()
			if Tab.Active or Tab._disabled then return end
			if type(Tab._BuildLazy) == "function" then Tab:_BuildLazy() end
			if GUI.CurrentTab then GUI.CurrentTab:Deactivate() end
			Tab.Active=true; Tab._scroll.Position=UDim2.new(0,0,0,0); GUI.CurrentTab=Tab
			Tab:_ApplyNavStyle(false)
		end
		function Tab:Deactivate()
			if not Tab.Active then return end
			Tab.Active=false; Tab._scroll.Position=UDim2.new(0,99999,0,0)
			Tab:_ApplyNavStyle(false)
		end
		function Tab:Disable()
			Tab._disabled=true; navClickBtn.Active=false
			tw(navText,{TextColor3=Library.Theme.TextDisabled})
			if Tab._navIconKind == "text" then
				tw(navIcon,{TextColor3=Library.Theme.TextDisabled})
			else
				tw(navIcon,{ImageColor3=Library.Theme.TextDisabled})
			end
			tw(Tab._navBtn,{BackgroundTransparency=1})
		end
		function Tab:Enable()
			Tab._disabled=false; navClickBtn.Active=true
			Tab:_ApplyNavStyle(false)
		end

		local function base(name,h)
			local f=Instance.new("Frame",Tab._scroll)
			f.Name=name
			f.BorderSizePixel=0
			f.BackgroundColor3=Library.Theme.Surface
			f.Size=UDim2.new(1,0,0,h or 32)
			f.Active=true
			f.ClipsDescendants=true
			pcall(function()
				f:SetAttribute("VenturaThemeRole", "Surface")
				f:SetAttribute("VenturaThemeProp", "BackgroundColor3")
			end)
			corner(f,9)
			local baseStroke = stroke(f,Library.Theme.Border,1)
			pcall(function()
				baseStroke:SetAttribute("VenturaThemeRole", "Border")
				baseStroke:SetAttribute("VenturaThemeProp", "Color")
			end)
			return f
		end

		local function softLine(parent, y, left, right)
			local line=Instance.new("Frame",parent)
			line.Name="SectionAccentDivider"
			line.BackgroundColor3=Library.Theme.Accent
			line.BackgroundTransparency=0.45
			line.BorderSizePixel=0
			regAccent(line)
			line.Position=UDim2.new(0,left or 0,0,y or 0)
			line.Size=UDim2.new(1,-((left or 0)+(right or 0)),0,1)
			return line
		end

		local CONTROL_TEXT_INSET = 8

		local function _searchTextFromOptions(control, opts)
			opts = opts or {}
			local parts = {}
			local function add(value)
				if value == nil then return end
				if type(value) == "table" then
					for _, v in pairs(value) do add(v) end
				else
					table.insert(parts, tostring(value))
				end
			end
			add(opts.name); add(opts.title); add(opts.text); add(opts.description); add(opts.desc); add(opts.subtitle)
			add(opts.placeholder); add(opts.flag); add(opts.configId); add(opts.configID); add(opts.id)
			add(opts.items); add(opts.buttons)
			if control then add(control._configId); add(control._configKind) end
			return table.concat(parts, " "):lower()
		end

		local function _registerUsabilityControl(control, opts)
			control = control or {}
			opts = opts or {}
			local frame = control.frame
			if not frame then return control end
			control._searchText = _searchTextFromOptions(control, opts)
			control._manualVisible = true
			pcall(function()
				frame:SetAttribute("VenturaSearchText", control._searchText)
				if frame:GetAttribute("VenturaOriginalLayoutOrder") == nil then frame:SetAttribute("VenturaOriginalLayoutOrder", frame.LayoutOrder or 0) end
			end)
			table.insert(Tab._usabilityControls, control)

			-- v5.69: pins/favorites were removed. These no-op compatibility aliases
			-- keep older scripts from erroring, but they no longer create UI or move controls.
			function control:SetPinned(_state) return self end
			function control:Pin() return self end
			function control:Unpin() return self end
			function control:TogglePin() return self end
			function control:IsPinned() return false end
			control.SetFavorite = control.SetPinned
			control.Favorite = control.Pin
			control.Unfavorite = control.Unpin

			if Tab._searchQuery and Tab._searchQuery ~= "" then pcall(function() Tab:_ApplyControlSearch() end) end
			return control
		end

		-- Universal control API -----------------------------------------------------
		-- Every returned control can now be managed the same way from user scripts:
		-- :Get(), :Set(), :Show(), :Hide(), :Enable(), :Disable(), :Destroy(),
		-- :SetName(), :SetDescription(), :SetCallback(), :GetFrame().
		local function _universalControl(control, opts)
			control = control or {}
			opts = opts or {}
			local frame = control.frame
			control._enabled = control._enabled ~= false

			local function findLabel(names)
				if not frame then return nil end
				for _, name in ipairs(names) do
					local hit = frame:FindFirstChild(name, true)
					if hit and hit:IsA("TextLabel") then return hit end
				end
				return nil
			end

			function control:GetFrame() return self.frame end
			function control:IsVisible() return self.frame and self.frame.Visible == true or false end
			function control:SetVisible(v)
				self._manualVisible = v == true
				if self.frame then self.frame.Visible = self._manualVisible end
				pcall(function() Tab:_ApplyControlSearch() end)
				return self
			end
			function control:Show() return self:SetVisible(true) end
			function control:Hide() return self:SetVisible(false) end

			function control:IsEnabled() return self._enabled ~= false and self.Disabled ~= true end
			function control:SetEnabled(v)
				local enabled = v ~= false
				self._enabled = enabled
				self.Disabled = not enabled
				if type(self.SetDisabled) == "function" then
					pcall(function() self:SetDisabled(not enabled) end)
				end
				if self.frame then
					self.frame.Active = enabled
					pcall(function() tw(self.frame, {BackgroundTransparency = enabled and 0 or 0.34}, TI_FAST) end)
					for _, d in ipairs(self.frame:GetDescendants()) do
						if d:IsA("TextBox") then d.TextEditable = enabled end
						if d:IsA("GuiButton") then d.Active = enabled end
					end
				end
				return self
			end
			function control:Enable() return self:SetEnabled(true) end
			function control:Disable() return self:SetEnabled(false) end

			if type(control.Get) ~= "function" then
				function control:Get() return self.Value end
			end
			if type(control.Set) ~= "function" then
				function control:Set(v, silent)
					self.Value = v
					if not silent and type(opts.callback) == "function" then GUI:_invokeCallback(tostring(opts.name or opts.title or "control"), opts.callback, v) end
					pcall(function() GUI:MarkConfigDirty() end)
					return self
				end
			end

			function control:SetName(text)
				local newText = tostring(text or "")
				opts.name = newText
				local l = findLabel({"ControlTitle", "ButtonTitle", "SectionTitle"})
				if l then l.Text = newText end
				self._searchText = _searchTextFromOptions(self, opts)
				if self.frame then self.frame:SetAttribute("VenturaSearchText", self._searchText) end
				pcall(function() Tab:_ApplyControlSearch() end)
				return self
			end
			function control:GetName()
				local l = findLabel({"ControlTitle", "ButtonTitle", "SectionTitle"})
				return l and l.Text or tostring(opts.name or "")
			end
			function control:SetDescription(text)
				local newText = tostring(text or "")
				opts.description = newText
				local l = findLabel({"ControlDescription", "ButtonDescription", "SectionSubtitle"})
				if l then l.Text = newText end
				self._searchText = _searchTextFromOptions(self, opts)
				if self.frame then self.frame:SetAttribute("VenturaSearchText", self._searchText) end
				pcall(function() Tab:_ApplyControlSearch() end)
				return self
			end
			function control:GetDescription()
				local l = findLabel({"ControlDescription", "ButtonDescription", "SectionSubtitle"})
				return l and l.Text or tostring(opts.description or "")
			end
			function control:SetCallback(fn)
				if type(fn) == "function" then
					opts.callback = fn
					self._callback = fn
				end
				return self
			end
			function control:Destroy()
				if type(self.Clear) == "function" then pcall(function() self:Clear() end) end
				if self._dragConns then for _, c in ipairs(self._dragConns) do pcall(function() c:Disconnect() end) end end
				if self._conns then for _, c in ipairs(self._conns) do pcall(function() c:Disconnect() end) end end
				if self.frame then pcall(function() self.frame:Destroy() end) end
				return nil
			end
			return _registerUsabilityControl(control, opts)
		end

		local function labelPair(parent, title, desc, reservedRight, y)
			reservedRight = reservedRight or 0
			y = y or 0
			local leftInset = CONTROL_TEXT_INSET
			local t=lbl(parent,tostring(title or ""),14,Library.Theme.TextPrimary,FONT_UI_MED)
			t.Name="ControlTitle"
			pcall(function() t:SetAttribute("VenturaTextRole", "TextPrimary") end)
			t.Size=UDim2.new(1,-(reservedRight + leftInset),0,18)
			t.Position=UDim2.new(0,leftInset,0,y)
			t.TextTruncate=Enum.TextTruncate.AtEnd
			t.TextYAlignment=Enum.TextYAlignment.Center
			local d=nil
			if desc and tostring(desc) ~= "" then
				d=lbl(parent,tostring(desc),11,Library.Theme.TextSecondary,FONT_UI)
				d.Name="ControlDescription"
				pcall(function() d:SetAttribute("VenturaTextRole", "TextSecondary") end)
				d.Size=UDim2.new(1,-(reservedRight + leftInset),0,16)
				d.Position=UDim2.new(0,leftInset,0,y+20)
				d.TextTruncate=Enum.TextTruncate.AtEnd
				d.TextYAlignment=Enum.TextYAlignment.Center
			end
			return t,d
		end

		-- ── COMPONENTS ─────────────────────────────────────────────────────────
		-- ──────────────────────────────────────────────────────────────────
		-- COMPONENTS
		-- ──────────────────────────────────────────────────────────────────
		function Tab:Section(opts)
			opts=validate({name="Section",subtitle="",icon=""},opts)
			local title=tostring(opts.name or "Section")
			local sub=tostring(opts.subtitle or "")
			local hasSub=sub ~= ""
			local f=Instance.new("Frame",Tab._scroll)
			f.Name="Section"
			f.BackgroundTransparency=1
			f.BorderSizePixel=0
			f.Size=UDim2.new(1,0,0,hasSub and 42 or 30)

			local accent=Instance.new("Frame",f)
			accent.BackgroundColor3=Library.Theme.Accent; regAccent(accent)
			accent.BorderSizePixel=0
			accent.Size=UDim2.new(0,3,0,hasSub and 30 or 20)
			accent.Position=UDim2.new(0,0,0,hasSub and 7 or 5)
			corner(accent,2)

			local x=opts.icon ~= "" and 28 or 12
			if opts.icon ~= "" then
				local ic=Instance.new("TextLabel",f)
				ic.BackgroundTransparency=1; ic.BorderSizePixel=0
				ic.Size=UDim2.new(0,22,0,22); ic.Position=UDim2.new(0,6,0,hasSub and 5 or 4)
				ic.Text=tostring(opts.icon); ic.TextSize=14; ic.FontFace=FONT_UI_BOLD
				ic.TextColor3=Library.Theme.TextPrimary; ic.TextXAlignment=Enum.TextXAlignment.Center
			end

			local sLbl=lbl(f,title:upper(),10,Library.Theme.TextDisabled,FONT_UI_BOLD)
			sLbl.Name="SectionTitle"
			sLbl.Position=UDim2.new(0,x,0,hasSub and 4 or 5)
			sLbl.Size=UDim2.new(1,-x,0,16)
			sLbl.TextTruncate=Enum.TextTruncate.AtEnd
			if hasSub then
				local subLbl=lbl(f,sub,11,Library.Theme.TextSecondary,FONT_UI)
				subLbl.Name="SectionSubtitle"
				subLbl.Position=UDim2.new(0,x,0,21)
				subLbl.Size=UDim2.new(1,-x,0,16)
				subLbl.TextTruncate=Enum.TextTruncate.AtEnd
			end
			softLine(f, f.Size.Y.Offset-1, x, 0)
			return f
		end
		function Tab:Separator()
			local f=Instance.new("Frame",Tab._scroll)
			f.Name="AccentSeparator"
			f.BackgroundColor3=Library.Theme.Accent; f.BackgroundTransparency=0.45; f.BorderSizePixel=0; f.Size=UDim2.new(1,0,0,1)
			regAccent(f)
			return f
		end

		function Tab:Label(opts)
			opts=validate({text="Label",icon="",color=nil,size=12,align=Enum.TextXAlignment.Left},opts)
			local f=Instance.new("Frame",Tab._scroll)
			f.Name="Label"
			f.BackgroundTransparency=1
			f.BorderSizePixel=0
			f.Size=UDim2.new(1,0,0,28)
			local x=opts.icon ~= "" and 26 or 4
			if opts.icon ~= "" then
				local ic=lbl(f,tostring(opts.icon),14,opts.color or Library.Theme.TextSecondary,FONT_UI_BOLD,Enum.TextXAlignment.Center)
				ic.Size=UDim2.new(0,20,1,0)
			end
			local l2=lbl(f,tostring(opts.text),opts.size,opts.color or Library.Theme.TextSecondary,FONT_UI,opts.align)
			l2.Position=UDim2.new(0,x,0,0)
			l2.Size=UDim2.new(1,-x,1,0)
			l2.TextTruncate=Enum.TextTruncate.AtEnd
			return f
		end
		function Tab:Paragraph(opts)
			opts=validate({title="",text="Paragraph text here.",icon="",color=nil},opts)
			local bodyText=tostring(opts.text or "")
			local titleText=tostring(opts.title or "")
			local hasTitle=titleText ~= ""
			local widthGuess=math.max(260, (Content.AbsoluteSize.X > 0 and Content.AbsoluteSize.X or 540) - 52)
			local bodyH=math.max(18, math.ceil(textHeight(bodyText,widthGuess,12,Enum.Font.SourceSans)) + 4)
			local totalH=bodyH + (hasTitle and 25 or 0) + 22
			local f=base("Paragraph", totalH)
			pad(f,12,14,12,14)
			local x=0
			if opts.icon ~= "" then
				local ic=lbl(f,tostring(opts.icon),16,Library.Theme.Accent,FONT_UI_BOLD,Enum.TextXAlignment.Center)
				ic.Size=UDim2.new(0,24,0,24); ic.Position=UDim2.new(0,0,0,0)
				x=32
			end
			local y=0
			if hasTitle then
				local tl=lbl(f,titleText,14,Library.Theme.TextPrimary,FONT_UI_BOLD)
				tl.Name="ParagraphTitle"
				tl.Size=UDim2.new(1,-x,0,19); tl.Position=UDim2.new(0,x,0,0)
				tl.TextTruncate=Enum.TextTruncate.AtEnd
				y=24
			end
			local bl=Instance.new("TextLabel",f)
			bl.Name="ParagraphBody"
			bl.BackgroundTransparency=1; bl.BorderSizePixel=0
			bl.TextSize=12; bl.TextXAlignment=Enum.TextXAlignment.Left; bl.TextYAlignment=Enum.TextYAlignment.Top
			bl.TextWrapped=true; bl.TextTruncate=Enum.TextTruncate.None
			bl.FontFace=FONT_UI
			bl.TextColor3=opts.color or Library.Theme.TextSecondary; bl.Text=bodyText
			bl.Size=UDim2.new(1,-x,0,bodyH); bl.Position=UDim2.new(0,x,0,y)
			local function resize()
				task.defer(function()
					if not bl.Parent then return end
					local available=math.max(120, bl.AbsoluteSize.X)
					local h=math.max(18, math.ceil(textHeight(bl.Text,available,12,Enum.Font.SourceSans)) + 4)
					bl.Size=UDim2.new(1,-x,0,h)
					f.Size=UDim2.new(1,0,0,h + y + 22)
				end)
			end
			bl:GetPropertyChangedSignal("TextBounds"):Connect(resize)
			resize()
			return f
		end
		function Tab:Badge(opts)
			opts=validate({text="NEW", color=nil, textColor=nil},opts)
			local bgCol  = opts.color     or Library.Theme.Accent
			local txtCol = opts.textColor or Color3.fromRGB(255,255,255)
			local w      = math.max(#opts.text*8+16, 40)
			local f=Instance.new("Frame",Tab._scroll)
			f.BackgroundTransparency=1; f.BorderSizePixel=0; f.Size=UDim2.new(1,0,0,26)
			local pill=Instance.new("Frame",f)
			pill.BackgroundColor3=bgCol; pill.BorderSizePixel=0
			pill.Size=UDim2.new(0,w,0,20); pill.Position=UDim2.new(0,4,0.5,-10); corner(pill,4)
			local bl=Instance.new("TextLabel",pill)
			bl.BackgroundTransparency=1; bl.Size=UDim2.new(1,0,1,0)
			bl.TextSize=11; bl.TextXAlignment=Enum.TextXAlignment.Center
			bl.FontFace=Font.new("rbxasset://fonts/families/Ubuntu.json",Enum.FontWeight.Bold)
			bl.TextColor3=txtCol; bl.Text=opts.text
			return f
		end

		-- ── NEW: Tab:ButtonGrid — multi-column quick-action buttons ─────────────────
		-- Pass a list of {name, callback, icon} tables for compact button grid
		function Tab:ButtonGrid(opts)
			opts=validate({name="",buttons={},columns=2,tooltip=""},opts)
			local cols=math.clamp(tonumber(opts.columns) or 2,1,4)
			local rows=math.max(1, math.ceil(#opts.buttons/cols))
			local rowH=34; local gap=4
			local totalH=rows*(rowH+gap)-gap+8
			local f=Instance.new("Frame",Tab._scroll)
			f.Name="ButtonGrid"; f.BackgroundTransparency=1; f.BorderSizePixel=0
			f.Size=UDim2.new(1,0,0,totalH)
			addTooltip(f, opts.tooltip)
			for i,btn in ipairs(opts.buttons) do
				local row=math.ceil(i/cols)-1; local col=(i-1)%cols
				local w=1/cols
				local b=Instance.new("TextButton",f)
				b.Name="ButtonGridButton"
				pcall(function() b:SetAttribute("VenturaThemeRole", "Surface") end)
				b.BackgroundColor3=Library.Theme.Surface; b.BorderSizePixel=0
				b.AnchorPoint=Vector2.new(0,0); b.AutoButtonColor=false
				b.Size=UDim2.new(w,-(gap*(cols-1)/cols),0,rowH)
				b.Position=UDim2.new(col*w,col*gap,0,row*(rowH+gap))
				b.Text=""; corner(b,5); stroke(b,Library.Theme.Border)
				local icon=btn.icon or ""
				local lc=Instance.new("TextLabel",b)
				lc.BackgroundTransparency=1; lc.BorderSizePixel=0
				lc.Size=UDim2.new(1,-8,1,0); lc.Position=UDim2.new(0,4,0,0)
				lc.Text=(icon~="" and icon.." " or "")..tostring(btn.name or "Button")
				lc.FontFace=Font.new("rbxasset://fonts/families/Ubuntu.json", Enum.FontWeight.Bold)
				lc.TextSize=12
				lc.Name="ButtonGridText"
				lc.TextColor3=Library.Theme.TextPrimary
				pcall(function() lc:SetAttribute("VenturaTextRole", "TextPrimary") end)
				lc.TextXAlignment=Enum.TextXAlignment.Center
				lc.TextTruncate=Enum.TextTruncate.AtEnd
				b.MouseEnter:Connect(function()
					tw(b,{BackgroundColor3=Library.Theme.SurfaceHover})
					tw(lc,{TextColor3=Library.Theme.Accent})
				end)
				b.MouseLeave:Connect(function()
					tw(b,{BackgroundColor3=Library.Theme.Surface})
					tw(lc,{TextColor3=Library.Theme.TextPrimary})
				end)
				b.InputBegan:Connect(function(i)
					if i.UserInputType==Enum.UserInputType.MouseButton1
						or i.UserInputType==Enum.UserInputType.Touch then
						pcall(btn.callback or function() end)
					end
				end)
			end
			return f
		end

		function Tab:Image(opts)
			opts=validate({url="",width=nil,height=80,tooltip=""},opts)
			local imgId = resolveIcon(opts.url)
			local h = tonumber(opts.height) or 80
			local f=base("Image", h+8); f.BackgroundTransparency=1; f.BorderSizePixel=0
			local st = f:FindFirstChildOfClass("UIStroke"); if st then st:Destroy() end
			local img=Instance.new("ImageLabel",f)
			img.BackgroundTransparency=1; img.BorderSizePixel=0
			img.Image=imgId.value or ""; img.ScaleType=Enum.ScaleType.Fit
			img.Size=opts.width and UDim2.new(0,opts.width,0,h) or UDim2.new(1,-8,0,h)
			img.Position=UDim2.new(0,4,0,4)
			addTooltip(f,opts.tooltip)
			return f
		end

		function Tab:ProgressBar(opts)
			opts=validate({name="Progress",default=0,suffix="%",color=nil,tooltip=""},opts)
			local PB={Value=math.clamp(opts.default,0,100)}
			PB.frame=base("ProgressBar",52); pad(PB.frame,7,10,8,10)
			local nl=lbl(PB.frame,opts.name,13,Library.Theme.TextPrimary); nl.Size=UDim2.new(1,-40,0,18)
			local vl=lbl(PB.frame,tostring(PB.Value)..opts.suffix,12,Library.Theme.TextSecondary,nil,Enum.TextXAlignment.Right)
			vl.AnchorPoint=Vector2.new(1,0); vl.Size=UDim2.new(0,36,0,18); vl.Position=UDim2.new(1,0,0,0)
			local trackF=Instance.new("Frame",PB.frame)
			trackF.BackgroundColor3=Color3.fromRGB(13,13,13); trackF.BorderSizePixel=0
			trackF.AnchorPoint=Vector2.new(0,1); trackF.Size=UDim2.new(1,0,0,7)
			trackF.Position=UDim2.new(0,0,1,0); corner(trackF,4); stroke(trackF,Color3.fromRGB(42,42,42))
			local fillF=Instance.new("Frame",trackF)
			fillF.BackgroundColor3=opts.color or Library.Theme.Accent; if not opts.color then regAccent(fillF) end
			fillF.BorderSizePixel=0; corner(fillF,4)
			fillF.Size=UDim2.new(math.clamp(opts.default/100,0,1),0,1,0)
			addTooltip(PB.frame,opts.tooltip)
			function PB:Set(v)
				v=math.clamp(v,0,100); PB.Value=v
				tw(fillF,{Size=UDim2.new(v/100,0,1,0)},TI_FAST)
				vl.Text=tostring(v)..opts.suffix
				return PB
			end
			function PB:Get() return PB.Value end
			return _universalControl(PB, opts)
		end

		-- ── INTERACTIVE ────────────────────────────────────────────────────────
		function Tab:Button(opts)
			opts=validate({name="Button",description="",tooltip="",icon="",badge=nil,badgeColor=nil,callback=function()end,disabled=false},opts)
			local hasDesc=tostring(opts.description or "") ~= ""
			local hasIcon=tostring(opts.icon or "") ~= ""
			local h=hasDesc and 64 or 50
			local Btn={Disabled=opts.disabled == true}
			Btn.frame=base("Button",h); pad(Btn.frame,0,16,0,16)
			local bStroke=Btn.frame:FindFirstChildOfClass("UIStroke")

			local accent=Instance.new("Frame",Btn.frame)
			accent.BackgroundColor3=Library.Theme.Accent; regAccent(accent)
			accent.BorderSizePixel=0; accent.Size=UDim2.new(0,3,1,-16); accent.Position=UDim2.new(0,0,0,8); accent.BackgroundTransparency=0.25; corner(accent,3)

			local xStart=hasIcon and 52 or 22
			local iconBg=nil
			if hasIcon then
				iconBg=Instance.new("Frame",Btn.frame)
				iconBg.Name="ButtonIconBox"
				pcall(function() iconBg:SetAttribute("VenturaThemeRole", "Background") end)
				iconBg.BackgroundColor3=Library.Theme.Background; iconBg.BorderSizePixel=0
				iconBg.Size=UDim2.new(0,32,0,32); iconBg.Position=UDim2.new(0,12,0.5,-16)
				corner(iconBg,9); stroke(iconBg,Library.Theme.Border)
				local ic=lbl(iconBg,tostring(opts.icon),15,Library.Theme.TextPrimary,FONT_UI_BOLD,Enum.TextXAlignment.Center)
				ic.Name="ButtonIconText"
				pcall(function() ic:SetAttribute("VenturaTextRole", "TextPrimary") end)
				ic.TextYAlignment=Enum.TextYAlignment.Center
			end

			local rightReserve=64
			if opts.badge then rightReserve=rightReserve + math.max(clampTextWidth(opts.badge,9,28,84)+8,36) end
			local nl=lbl(Btn.frame,tostring(opts.name),14,Library.Theme.TextPrimary,FONT_UI_MED)
			nl.Name="ButtonTitle"
			nl.Size=UDim2.new(1,-(xStart+rightReserve),0,19); nl.Position=UDim2.new(0,xStart,0,hasDesc and 11 or 15)
			nl.TextTruncate=Enum.TextTruncate.AtEnd; nl.TextYAlignment=Enum.TextYAlignment.Center
			local dl=nil
			if hasDesc then
				dl=lbl(Btn.frame,tostring(opts.description),11,Library.Theme.TextSecondary,FONT_UI)
				dl.Name="ButtonDescription"
				dl.Size=UDim2.new(1,-(xStart+rightReserve),0,17); dl.Position=UDim2.new(0,xStart,0,34)
				dl.TextTruncate=Enum.TextTruncate.AtEnd; dl.TextYAlignment=Enum.TextYAlignment.Center
			end
			local badgeFrame=nil
			if opts.badge then
				local bw=math.max(clampTextWidth(opts.badge,9,28,84)+14,34)
				badgeFrame=Instance.new("Frame",Btn.frame)
				badgeFrame.BackgroundColor3=opts.badgeColor or Library.Theme.Accent; if not opts.badgeColor then regAccent(badgeFrame) end
				badgeFrame.BorderSizePixel=0; badgeFrame.AnchorPoint=Vector2.new(1,0.5)
				badgeFrame.Size=UDim2.new(0,bw,0,18); badgeFrame.Position=UDim2.new(1,-40,0.5,0); corner(badgeFrame,9)
				local bpl=lbl(badgeFrame,tostring(opts.badge),9,Color3.fromRGB(255,255,255),FONT_UI_BOLD,Enum.TextXAlignment.Center)
				bpl.TextTruncate=Enum.TextTruncate.AtEnd
			end
			local arrBg=Instance.new("Frame",Btn.frame)
			arrBg.Name="ButtonArrowBox"
			pcall(function() arrBg:SetAttribute("VenturaThemeRole", "Background") end)
			arrBg.AnchorPoint=Vector2.new(1,0.5); arrBg.Position=UDim2.new(1,-6,0.5,0)
			arrBg.Size=UDim2.new(0,26,0,26); arrBg.BackgroundColor3=Library.Theme.Background; arrBg.BorderSizePixel=0; corner(arrBg,8); stroke(arrBg,Library.Theme.Border)
			local arr=Instance.new("ImageLabel",arrBg)
			arr.Name="ButtonArrowIcon"
			arr.BackgroundTransparency=1; arr.AnchorPoint=Vector2.new(0.5,0.5)
			arr.Image="rbxassetid://12974428978"; arr.ImageColor3=Library.Theme.TextSecondary
			arr.Size=UDim2.new(0,11,0,11); arr.Position=UDim2.fromScale(0.5,0.5); arr.Rotation=-90
			addTooltip(Btn.frame,(opts.tooltip ~= "" and opts.tooltip or opts.description))

			local function setDisabled(v)
				Btn.Disabled = v == true
				Btn.frame.Active = not Btn.Disabled
				tw(Btn.frame,{BackgroundTransparency=Btn.Disabled and 0.35 or 0},TI_FAST)
				tw(nl,{TextColor3=Btn.Disabled and Library.Theme.TextDisabled or Library.Theme.TextPrimary},TI_FAST)
				if dl then tw(dl,{TextColor3=Btn.Disabled and Library.Theme.TextDisabled or Library.Theme.TextSecondary},TI_FAST) end
				tw(arr,{ImageTransparency=Btn.Disabled and 0.55 or 0},TI_FAST)
				if iconBg then tw(iconBg,{BackgroundTransparency=Btn.Disabled and 0.2 or 0},TI_FAST) end
			end
			setDisabled(Btn.Disabled)

			Btn.frame.InputBegan:Connect(function(i)
				if Btn.Disabled then return end
				if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
					tw(Btn.frame,{BackgroundColor3=Library.Theme.SurfaceHover},TweenInfo.new(0.08))
					tw(arrBg,{BackgroundColor3=Library.Theme.Accent},TweenInfo.new(0.08))
					tw(arr,{ImageColor3=Color3.fromRGB(255,255,255)},TweenInfo.new(0.08))
					pcall(opts.callback)
				end
			end)
			Btn.frame.InputEnded:Connect(function(i)
				if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
					tw(arrBg,{BackgroundColor3=Library.Theme.Background},TI_FAST); tw(arr,{ImageColor3=Library.Theme.TextSecondary},TI_FAST)
				end
			end)
			Btn.frame.MouseEnter:Connect(function()
				if Btn.Disabled then return end
				tw(Btn.frame,{BackgroundColor3=Library.Theme.SurfaceHover}); tw(bStroke,{Color=Library.Theme.BorderHover}); tw(accent,{BackgroundTransparency=0})
				if iconBg then tw(iconBg,{BackgroundColor3=Library.Theme.SurfaceHover}) end
			end)
			Btn.frame.MouseLeave:Connect(function()
				tw(Btn.frame,{BackgroundColor3=Library.Theme.Surface}); tw(bStroke,{Color=Library.Theme.Border}); tw(accent,{BackgroundTransparency=0.25}); tw(arrBg,{BackgroundColor3=Library.Theme.Background}); tw(arr,{ImageColor3=Library.Theme.TextSecondary})
				if iconBg then tw(iconBg,{BackgroundColor3=Library.Theme.Background}) end
			end)
			function Btn:SetDisabled(v) setDisabled(v) end
			function Btn:SetText(v) opts.name=tostring(v or ""); nl.Text=opts.name; return Btn end
			function Btn:SetName(v) return Btn:SetText(v) end
			function Btn:Fire() if not Btn.Disabled then pcall(opts.callback) end; return Btn end
			function Btn:Click() return Btn:Fire() end
			return _universalControl(Btn, opts)
		end
		function Tab:Toggle(opts)
			opts=validate({name="Toggle",description="",tooltip="",default=false,callback=function()end,onText="ON",offText="OFF"},opts)
			local hasDesc=tostring(opts.description or "") ~= ""
			local h=hasDesc and 64 or 50
			local Toggle={Value=opts.default == true, _callback=opts.callback, _autoStopOnDestroy=opts.autoStopOnDestroy ~= false}
			table.insert(GUI._toggleControls, Toggle)
			Toggle.frame=base("Toggle",h); pad(Toggle.frame,0,16,0,16)
			local bStroke=Toggle.frame:FindFirstChildOfClass("UIStroke")
			local nl,dl=labelPair(Toggle.frame,opts.name,opts.description,130,hasDesc and 10 or 16)

			local stateLbl=lbl(Toggle.frame,"",10,Library.Theme.TextSecondary,FONT_MONO_BOLD,Enum.TextXAlignment.Right)
			stateLbl.AnchorPoint=Vector2.new(1,0.5); stateLbl.Position=UDim2.new(1,-66,0.5,0); stateLbl.Size=UDim2.new(0,46,0,18)
			stateLbl.TextYAlignment=Enum.TextYAlignment.Center

			local pill=Instance.new("Frame",Toggle.frame)
			pill.Name="TogglePill"
			pill:SetAttribute("VenturaOn", Toggle.Value)
			pill.BackgroundColor3=Toggle.Value and Library.Theme.Accent or Library.Theme.Background
			pill.BorderSizePixel=0; pill.AnchorPoint=Vector2.new(1,0.5)
			pill.Size=UDim2.new(0,52,0,26); pill.Position=UDim2.new(1,-2,0.5,0); corner(pill,13)
			local pStroke=stroke(pill,Toggle.Value and Library.Theme.Accent or Library.Theme.Border,1)
			local glow=Instance.new("Frame",pill)
			glow.BackgroundColor3=Color3.fromRGB(255,255,255); glow.BackgroundTransparency=Toggle.Value and 0.88 or 1
			glow.BorderSizePixel=0; glow.Size=UDim2.new(1,0,1,0); corner(glow,13)
			local knob=Instance.new("Frame",pill)
			knob.BackgroundColor3=Color3.fromRGB(246,246,250); knob.BorderSizePixel=0
			knob.AnchorPoint=Vector2.new(0,0.5); knob.Size=UDim2.new(0,22,0,22); corner(knob,11)
			stroke(knob, Color3.fromRGB(210,210,220), 1)
			local busy=false
			local function render(v, instant)
				Toggle.Value = v == true
				pill:SetAttribute("VenturaOn", Toggle.Value)
				local goalBg = Toggle.Value and Library.Theme.Accent or Library.Theme.Background
				local goalStroke = Toggle.Value and Library.Theme.Accent or Library.Theme.Border
				local goalPos = Toggle.Value and UDim2.new(1,-24,0.5,0) or UDim2.new(0,2,0.5,0)
				stateLbl.Text = Toggle.Value and tostring(opts.onText) or tostring(opts.offText)
				local stateCol = Toggle.Value and Library.Theme.Accent or Library.Theme.TextDisabled
				if instant then
					pill.BackgroundColor3=goalBg; knob.Position=goalPos; pStroke.Color=goalStroke; glow.BackgroundTransparency=Toggle.Value and 0.88 or 1; stateLbl.TextColor3=stateCol
				else
					tw(pill,{BackgroundColor3=goalBg}); tw(knob,{Position=goalPos}); tw(pStroke,{Color=goalStroke}); tw(glow,{BackgroundTransparency=Toggle.Value and 0.88 or 1}); tw(stateLbl,{TextColor3=stateCol})
				end
			end
			render(Toggle.Value, true)
			addTooltip(Toggle.frame,opts.tooltip)
			Toggle.frame.InputBegan:Connect(function(i)
				if Toggle.Disabled or busy then return end
				if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
					busy=true
					render(not Toggle.Value)
					GUI:_invokeCallback(tostring(opts.name or opts.title or "control"), opts.callback, Toggle.Value)
					pcall(function() GUI:MarkConfigDirty() end)
					task.delay(0.08,function() busy=false end)
				end
			end)
			Toggle.frame.MouseEnter:Connect(function() tw(Toggle.frame,{BackgroundColor3=Library.Theme.SurfaceHover}); tw(bStroke,{Color=Library.Theme.BorderHover}) end)
			Toggle.frame.MouseLeave:Connect(function() tw(Toggle.frame,{BackgroundColor3=Library.Theme.Surface}); tw(bStroke,{Color=Library.Theme.Border}) end)
			function Toggle:Set(v, silent)
				render(v)
				if not silent then GUI:_invokeCallback(tostring(opts.name or opts.title or "control"), opts.callback, Toggle.Value); pcall(function() GUI:MarkConfigDirty() end) end
				return Toggle
			end
			function Toggle:_stopForDestroy()
				if Toggle.Value ~= true then return end
				render(false, true)
				GUI:_invokeCallback(tostring(opts.name or opts.title or "control"), opts.callback, false)
			end
			function Toggle:Get() return Toggle.Value end
			_registerConfigControl(Toggle, opts, "toggle")
			_registerReconnectControl(Toggle, opts, "toggle")
			return _universalControl(Toggle, opts)
		end
		function Tab:Slider(opts)
			opts=validate({
				name="Slider", description="", tooltip="",
				min=0, max=100, default=50,
				suffix="", prefix="", round=1,
				color=nil, valueColor=nil,
				showRange=true, compact=false, valueFormatter=nil,
				callback=function()end,
				-- v5.53: smooth visuals update every frame while dragging.
				-- Callbacks now apply live while dragging + once on drop, but are coalesced/throttled
				-- so heavy callbacks do not stack and destroy FPS.
				callbackThrottle=0.055,
				liveCallback=true,
				callbackOnDrag=true,
				callbackOnDrop=true,
				applyOnDrop=true,
				-- v5.64: mouse wheel no longer changes sliders by default.
				-- Scrolling should scroll the page, not accidentally edit values.
				wheel=false,
				wheelStep=nil,
				keyboard=true,
				instant=false,
			},opts)

			local minVal = tonumber(opts.min) or 0
			local maxVal = tonumber(opts.max) or 100
			if maxVal < minVal then minVal, maxVal = maxVal, minVal end
			local step = tonumber(opts.round)
			if step == nil then step = 1 end
			local locked, range, decimals

			local function decimalsFromStep(x)
				if not x or x <= 0 then return 2 end
				local str=tostring(x)
				if str:find("e") or str:find("E") then return 6 end
				local dot=str:find("%.")
				return dot and math.min(#str-dot,6) or 0
			end

			local function rebuildScale()
				minVal = tonumber(minVal) or 0
				maxVal = tonumber(maxVal) or 100
				if maxVal < minVal then minVal, maxVal = maxVal, minVal end
				locked = maxVal == minVal
				range = locked and 1 or (maxVal - minVal)
				step = tonumber(step)
				if step == nil then step = 1 end
				decimals = decimalsFromStep(step)
			end
			rebuildScale()

			local function cleanNumber(v)
				v = tonumber(v) or 0
				if decimals <= 0 then return tostring(math.floor(v + 0.5)) end
				local s=string.format("%."..decimals.."f", v)
				return s:gsub("0+$",""):gsub("%.$","")
			end

			local function snap(v)
				if locked then return minVal end
				v=math.clamp(tonumber(v) or minVal, minVal, maxVal)
				if step and step > 0 then
					v=minVal + (math.floor(((v-minVal)/step)+0.5)*step)
				end
				v=math.clamp(v,minVal,maxVal)
				if decimals <= 0 then return math.floor(v + 0.5) end
				local m=10^decimals
				return math.floor(v*m+0.5)/m
			end

			local function displayValue(v)
				if type(opts.valueFormatter)=="function" then
					local ok,txt=pcall(opts.valueFormatter,v)
					if ok and txt ~= nil then return tostring(txt) end
				end
				return tostring(opts.prefix or "") .. cleanNumber(v) .. tostring(opts.suffix or "")
			end

			local Slider={
				Value=snap(opts.default),
				Dragging=false,
				Disabled=false,
				_dragConns={},
				_dragChanged=false,
				_dragLastX=nil,
				_callbackPendingValue=nil,
				_callbackRunning=false,
				_lastCallbackValue=nil,
				_lastDisplayText=nil,
				_lastValuePillWidth=nil,
				_lastAlpha=nil,
			}

			-- v5.53 slider fix:
			-- No always-on UIS connections per slider. Drag listeners/render loop only exist while dragging.
			-- Visuals update once per RenderStepped frame. Callbacks apply live while dragging
			-- and again on drop, but are coalesced so heavy callbacks cannot stack up.
			local callbackThrottle = math.max(0.025, tonumber(opts.callbackThrottle or opts.throttle or 0.055) or 0.055)
			local liveCallback = not (opts.liveCallback == false or opts.callbackOnDrag == false)
			local callbackOnDrop = not (opts.callbackOnDrop == false or opts.applyOnDrop == false)
			local lastCallbackAt = 0

			local function _flushSliderCallback(force) end

			local function _runSliderCallback(value)
				Slider._callbackRunning = true
				task.defer(function()
					_safeCall("slider callback", opts.callback, value)
					Slider._callbackRunning = false
					-- If a heavy callback was still running while the user kept dragging, run only the newest queued value.
					if Slider._callbackPendingValue ~= nil and Slider.Dragging and liveCallback then
						_flushSliderCallback(false)
					end
				end)
			end

			function _flushSliderCallback(force)
				if type(opts.callback) ~= "function" then Slider._callbackPendingValue = nil; return end
				local value = snap(Slider._callbackPendingValue ~= nil and Slider._callbackPendingValue or Slider.Value)
				if not force then
					local now = os.clock()
					if callbackThrottle > 0 and (now - lastCallbackAt) < callbackThrottle then return end
				end
				if not force and Slider._lastCallbackValue == value then
					Slider._callbackPendingValue = nil
					return
				end
				if Slider._callbackRunning then
					Slider._callbackPendingValue = value
					return
				end
				Slider._callbackPendingValue = nil
				Slider._lastCallbackValue = value
				lastCallbackAt = os.clock()
				_runSliderCallback(value)
			end

			local function fireSliderCallback(value, force)
				if type(opts.callback) ~= "function" then return end
				value = snap(value)
				if Slider.Dragging and not force and not liveCallback then return end
				if not Slider.Dragging and not force then return end
				Slider._callbackPendingValue = value
				_flushSliderCallback(force == true)
			end

			local hasDesc=tostring(opts.description or "") ~= ""
			local h=opts.compact and 66 or (opts.showRange == false and (hasDesc and 82 or 74) or (hasDesc and 94 or 86))
			Slider.frame=base("Slider",h); pad(Slider.frame,12,18,12,18)
			Slider.frame.ClipsDescendants = false
			local bStroke=Slider.frame:FindFirstChildOfClass("UIStroke")
			local nl,dl=labelPair(Slider.frame,opts.name,opts.description,172,0)

			local valuePill=Instance.new("Frame",Slider.frame)
			valuePill.Name="SliderValuePill"
			valuePill.AnchorPoint=Vector2.new(1,0); valuePill.Position=UDim2.new(1,-2,0,0)
			valuePill.Size=UDim2.new(0,108,0,24)
			valuePill.BackgroundColor3=Library.Theme.Background; valuePill.BorderSizePixel=0; corner(valuePill,8)
			valuePill:SetAttribute("VenturaThemeRole", "Background")
			local valueStroke=stroke(valuePill,Library.Theme.Border)
			valueStroke:SetAttribute("VenturaThemeRole", "Border"); valueStroke:SetAttribute("VenturaThemeProp", "Color")
			local vl=lbl(valuePill,"",11,opts.valueColor or Library.Theme.TextPrimary,FONT_MONO_BOLD,Enum.TextXAlignment.Center)
			vl.Name="SliderValueText"; vl.Size=UDim2.new(1,-10,1,0); vl.Position=UDim2.new(0,5,0,0); vl.TextTruncate=Enum.TextTruncate.AtEnd
			vl:SetAttribute("VenturaTextRole", "TextPrimary")

			local trackY=hasDesc and 48 or 38
			local track=Instance.new("Frame",Slider.frame)
			track.Name="SliderTrack"
			track.BackgroundColor3=Library.Theme.Background; track.BorderSizePixel=0
			track.Size=UDim2.new(1,0,0,10); track.Position=UDim2.new(0,0,0,trackY); track.ZIndex=3
			track:SetAttribute("VenturaThemeRole", "Background")
			corner(track,6)
			local trackStroke=stroke(track,Library.Theme.Border)
			trackStroke:SetAttribute("VenturaThemeRole", "Border"); trackStroke:SetAttribute("VenturaThemeProp", "Color")

			local fill=Instance.new("Frame",track)
			fill.Name="SliderFill"
			fill.BackgroundColor3=opts.color or Library.Theme.Accent
			fill.BorderSizePixel=0; fill.ZIndex=4; corner(fill,6)
			if not opts.color then regAccent(fill) end
			local fillGrad=Instance.new("UIGradient", fill)
			fillGrad.Name="SliderFillGradient"
			fillGrad.Rotation=0
			fillGrad.Transparency=NumberSequence.new({
				NumberSequenceKeypoint.new(0,0.06),
				NumberSequenceKeypoint.new(0.55,0),
				NumberSequenceKeypoint.new(1,0.10),
			})
			local shine=Instance.new("Frame",fill)
			shine.Name="SliderShine"
			shine.BackgroundColor3=Color3.fromRGB(255,255,255); shine.BackgroundTransparency=0.84; shine.BorderSizePixel=0; shine.Size=UDim2.new(1,0,0.42,0); shine.ZIndex=5; corner(shine,6)
			shine:SetAttribute("VenturaNoTheme", true)

			local thumbGlow=Instance.new("Frame",track)
			thumbGlow.Name="SliderThumbGlow"
			thumbGlow.BackgroundColor3=opts.color or Library.Theme.Accent
			thumbGlow.BackgroundTransparency=0.76; thumbGlow.BorderSizePixel=0
			thumbGlow.AnchorPoint=Vector2.new(0.5,0.5); thumbGlow.Size=UDim2.new(0,26,0,26); thumbGlow.Position=UDim2.new(0,0,0.5,0); thumbGlow.ZIndex=5; corner(thumbGlow,13)
			if not opts.color then regAccent(thumbGlow) end

			local thumb=Instance.new("Frame",track)
			thumb.Name="SliderThumb"
			thumb.BackgroundColor3=Color3.fromRGB(248,248,252); thumb.BorderSizePixel=0
			thumb.AnchorPoint=Vector2.new(0.5,0.5); thumb.Size=UDim2.new(0,20,0,20); thumb.Position=UDim2.new(0,0,0.5,0); thumb.ZIndex=6; corner(thumb,10)
			thumb:SetAttribute("VenturaNoTheme", true)
			local thumbStroke=stroke(thumb,opts.color or Library.Theme.Accent,1.2)
			if not opts.color then regAccent(thumbStroke) end
			local thumbInner=Instance.new("Frame",thumb)
			thumbInner.Name="SliderThumbInner"
			thumbInner.BackgroundColor3=Library.Theme.Background; thumbInner.BackgroundTransparency=0.22; thumbInner.BorderSizePixel=0
			thumbInner.AnchorPoint=Vector2.new(0.5,0.5); thumbInner.Size=UDim2.new(0,7,0,7); thumbInner.Position=UDim2.fromScale(0.5,0.5); thumbInner.ZIndex=7; corner(thumbInner,4)
			thumbInner:SetAttribute("VenturaThemeRole", "Background")

			local hitbox=Instance.new("TextButton",Slider.frame)
			hitbox.Name="SliderHitbox"
			hitbox.BackgroundTransparency=1; hitbox.BorderSizePixel=0; hitbox.Text=""; hitbox.AutoButtonColor=false
			hitbox.Position=UDim2.new(0,-8,0,trackY-18); hitbox.Size=UDim2.new(1,16,0,46); hitbox.ZIndex=8
			hitbox.Selectable = opts.keyboard ~= false
			hitbox:SetAttribute("VenturaNoTheme", true)

			local minLbl,maxLbl
			local function rangeText(v)
				return tostring(opts.prefix or "")..cleanNumber(v)..tostring(opts.suffix or "")
			end
			if opts.showRange ~= false then
				minLbl=lbl(Slider.frame,rangeText(minVal),10,Library.Theme.TextDisabled,FONT_MONO)
				minLbl.Name="SliderMinLabel"; minLbl.Position=UDim2.new(0,0,0,trackY+18); minLbl.Size=UDim2.new(0,110,0,14)
				minLbl:SetAttribute("VenturaTextRole", "TextDisabled")
				maxLbl=lbl(Slider.frame,rangeText(maxVal),10,Library.Theme.TextDisabled,FONT_MONO,Enum.TextXAlignment.Right)
				maxLbl.Name="SliderMaxLabel"; maxLbl.AnchorPoint=Vector2.new(1,0); maxLbl.Position=UDim2.new(1,0,0,trackY+18); maxLbl.Size=UDim2.new(0,110,0,14)
				maxLbl:SetAttribute("VenturaTextRole", "TextDisabled")
			end

			local function refreshRangeLabels()
				if minLbl then minLbl.Text = rangeText(minVal) end
				if maxLbl then maxLbl.Text = rangeText(maxVal) end
			end

			local function setVisual(v, force)
				v = snap(v)
				local a=locked and 1 or math.clamp((v-minVal)/range,0,1)
				if force or Slider._lastAlpha == nil or math.abs(a - Slider._lastAlpha) > 0.0008 then
					Slider._lastAlpha = a
					fill.Size=UDim2.new(a,0,1,0)
					thumb.Position=UDim2.new(a,0,0.5,0)
					thumbGlow.Position=UDim2.new(a,0,0.5,0)
				end
				local txt=displayValue(v)
				if force or txt ~= Slider._lastDisplayText then
					Slider._lastDisplayText = txt
					vl.Text = txt
					local w=math.clamp(clampTextWidth(txt,11,64,174)+28,82,184)
					if force or w ~= Slider._lastValuePillWidth then
						Slider._lastValuePillWidth = w
						valuePill.Size=UDim2.new(0,w,0,24)
					end
				end
			end

			local function render(v, silent, forceVisual)
				local nv=snap(v)
				local changed=nv ~= Slider.Value
				if not changed and not forceVisual then return false end
				Slider.Value=nv
				if Slider.Dragging and changed then Slider._dragChanged = true end
				setVisual(nv, forceVisual)
				if changed and not silent then fireSliderCallback(nv, false) end
				return changed
			end

			local function valueFromX(x)
				local w = math.max(track.AbsoluteSize.X,1)
				local a=math.clamp(((tonumber(x) or track.AbsolutePosition.X)-track.AbsolutePosition.X)/w,0,1)
				return minVal + range*a
			end

			local function isOnThumb(i)
				local pos = i and i.Position
				if not pos then return false end
				local center = thumb.AbsolutePosition + (thumb.AbsoluteSize / 2)
				local dx = pos.X - center.X
				local dy = pos.Y - center.Y
				return (dx*dx + dy*dy) <= (24*24)
			end

			local function cleanupDragConnections()
				for i = #Slider._dragConns, 1, -1 do
					local c = Slider._dragConns[i]
					pcall(function() if c and c.Disconnect then c:Disconnect() end end)
					Slider._dragConns[i] = nil
				end
			end

			local function setDragVisual(on)
				if on then
					if opts.instant then
						thumb.Size=UDim2.new(0,24,0,24)
						thumbGlow.Size=UDim2.new(0,36,0,36); thumbGlow.BackgroundTransparency=0.58
						valuePill.BackgroundColor3=Library.Theme.SurfaceHover
						if bStroke then bStroke.Color=Library.Theme.BorderHover end
						vl.TextColor3=opts.valueColor or Library.Theme.Accent
					else
						tw(thumb,{Size=UDim2.new(0,24,0,24)},TI_FAST)
						tw(thumbGlow,{Size=UDim2.new(0,36,0,36), BackgroundTransparency=0.58},TI_FAST)
						tw(valuePill,{BackgroundColor3=Library.Theme.SurfaceHover},TI_FAST)
						if bStroke then tw(bStroke,{Color=Library.Theme.BorderHover},TI_FAST) end
						tw(vl,{TextColor3=opts.valueColor or Library.Theme.Accent},TI_FAST)
					end
				else
					if opts.instant then
						thumb.Size=UDim2.new(0,20,0,20)
						thumbGlow.Size=UDim2.new(0,26,0,26); thumbGlow.BackgroundTransparency=0.76
						valuePill.BackgroundColor3=Library.Theme.Background
						if bStroke then bStroke.Color=Library.Theme.Border end
						vl.TextColor3=opts.valueColor or Library.Theme.TextPrimary
					else
						tw(thumb,{Size=UDim2.new(0,20,0,20)},TI_FAST)
						tw(thumbGlow,{Size=UDim2.new(0,26,0,26), BackgroundTransparency=0.76},TI_FAST)
						tw(valuePill,{BackgroundColor3=Library.Theme.Background},TI_FAST)
						if bStroke then tw(bStroke,{Color=Library.Theme.Border},TI_FAST) end
						tw(vl,{TextColor3=opts.valueColor or Library.Theme.TextPrimary},TI_FAST)
					end
				end
			end

			local function finishDrag()
				if not Slider.Dragging then return end
				Slider.Dragging=false
				cleanupDragConnections()
				setDragVisual(false)
				if Slider._dragChanged then
					if callbackOnDrop then fireSliderCallback(Slider.Value, true) end
					pcall(function() GUI:MarkConfigDirty() end)
				end
				Slider._dragChanged=false
				Slider._dragLastX=nil
			end

			local function beginDrag(i, preserveThumbValue)
				if Slider.Disabled or locked then setVisual(Slider.Value, true); return end
				cleanupDragConnections()
				Slider.Dragging=true
				Slider._dragChanged=false
				Slider._dragStartValue=Slider.Value
				Slider._dragLastX=(i and i.Position and i.Position.X) or nil
				if not preserveThumbValue and Slider._dragLastX then render(valueFromX(Slider._dragLastX), false) end
				setDragVisual(true)

				-- Coalesce mouse/touch spam into one visual update per frame. This keeps
				-- the thumb smooth while avoiding dozens of property writes per input burst.
				local renderConn = RunService.RenderStepped:Connect(function()
					if not Slider.Dragging then return end
					local x = Slider._dragLastX
					if x then render(valueFromX(x), false) end
				end)
				local moveConn = UIS.InputChanged:Connect(function(input)
					if not Slider.Dragging then return end
					if input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch then
						Slider._dragLastX=input.Position.X
					end
				end)
				local endConn = UIS.InputEnded:Connect(function(input)
					if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
						if Slider._dragLastX then render(valueFromX(Slider._dragLastX), false, true) end
						finishDrag()
					end
				end)
				table.insert(Slider._dragConns, renderConn)
				table.insert(Slider._dragConns, moveConn)
				table.insert(Slider._dragConns, endConn)
			end

			local function stepAmount(mult)
				local amt = tonumber(opts.wheelStep)
				if not amt or amt <= 0 then
					amt = (step and step > 0) and step or math.max(range / 100, 0.01)
				end
				return amt * (tonumber(mult) or 1)
			end

			function Slider:Step(mult, silent)
				if Slider.Disabled or locked then return Slider end
				local changed = render(Slider.Value + stepAmount(mult), silent == true, true)
				if changed and not silent then
					fireSliderCallback(Slider.Value, true)
					pcall(function() GUI:MarkConfigDirty() end)
				end
				return Slider
			end

			hitbox.InputBegan:Connect(function(i)
				if Slider.Disabled then return end
				if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
					beginDrag(i, isOnThumb(i))
				elseif opts.keyboard ~= false and i.UserInputType==Enum.UserInputType.Keyboard then
					if i.KeyCode==Enum.KeyCode.Left or i.KeyCode==Enum.KeyCode.Down then
						Slider:Step(-1)
					elseif i.KeyCode==Enum.KeyCode.Right or i.KeyCode==Enum.KeyCode.Up then
						Slider:Step(1)
					end
				end
			end)

			-- v5.64: do not bind MouseWheel to sliders by default. This prevents accidental
			-- value changes while scrolling tab content/settings pages.
			-- Drag, click-to-set, keyboard arrows, Set(), and Step() still work.
			local wheelConn
			local function setWheelEnabled(enabled)
				if wheelConn then
					pcall(function() wheelConn:Disconnect() end)
					wheelConn = nil
				end
				if enabled == true then
					wheelConn = hitbox.InputChanged:Connect(function(i)
						if Slider.Disabled then return end
						if i.UserInputType == Enum.UserInputType.MouseWheel then
							local dir = (i.Position and i.Position.Z and i.Position.Z > 0) and 1 or -1
							Slider:Step(dir)
						end
					end)
				end
			end
			if opts.wheel == true then
				-- Legacy opt-in only. Normal sliders ignore scroll wheel.
				setWheelEnabled(true)
			end

			Slider.frame.AncestryChanged:Connect(function()
				if not Slider.frame:IsDescendantOf(game) then
					Slider.Dragging=false
					cleanupDragConnections()
				end
			end)

			Slider.frame.MouseEnter:Connect(function()
				if Slider.Disabled then return end
				tw(Slider.frame,{BackgroundColor3=Library.Theme.SurfaceHover})
				if bStroke then tw(bStroke,{Color=Library.Theme.BorderHover}) end
			end)
			Slider.frame.MouseLeave:Connect(function()
				if not Slider.Dragging then
					tw(Slider.frame,{BackgroundColor3=Library.Theme.Surface})
					if bStroke then tw(bStroke,{Color=Library.Theme.Border}) end
				end
			end)

			addTooltip(Slider.frame,opts.tooltip)

			function Slider:Set(v, silent)
				local changed=render(v,silent == true,true)
				if changed and not silent then
					fireSliderCallback(Slider.Value, true)
					pcall(function() GUI:MarkConfigDirty() end)
				end
				return Slider
			end
			function Slider:Get() return Slider.Value end
			function Slider:SetFormatter(fn)
				if type(fn)=="function" then opts.valueFormatter=fn; setVisual(Slider.Value, true) end
				return Slider
			end
			function Slider:SetRange(newMin, newMax, silent)
				minVal = tonumber(newMin) or minVal
				maxVal = tonumber(newMax) or maxVal
				rebuildScale(); refreshRangeLabels()
				Slider:Set(math.clamp(Slider.Value, minVal, maxVal), silent == true)
				setVisual(Slider.Value, true)
				return Slider
			end
			function Slider:SetMin(newMin, silent) return Slider:SetRange(newMin, maxVal, silent) end
			function Slider:SetMax(newMax, silent) return Slider:SetRange(minVal, newMax, silent) end
			function Slider:SetStep(newStep)
				step = tonumber(newStep) or step
				rebuildScale(); refreshRangeLabels(); Slider:Set(Slider.Value, true); setVisual(Slider.Value, true)
				return Slider
			end
			function Slider:SetPrefix(prefix)
				opts.prefix = tostring(prefix or ""); refreshRangeLabels(); setVisual(Slider.Value, true); return Slider
			end
			function Slider:SetSuffix(suffix)
				opts.suffix = tostring(suffix or ""); refreshRangeLabels(); setVisual(Slider.Value, true); return Slider
			end
			function Slider:SetDisabled(disabled)
				Slider.Disabled = disabled == true
				if Slider.Disabled then finishDrag() end
				Slider.frame.BackgroundTransparency = Slider.Disabled and 0.28 or 0
				track.BackgroundTransparency = Slider.Disabled and 0.35 or 0
				fill.BackgroundTransparency = Slider.Disabled and 0.45 or 0
				thumb.BackgroundTransparency = Slider.Disabled and 0.25 or 0
				vl.TextColor3 = Slider.Disabled and Library.Theme.TextDisabled or (opts.valueColor or Library.Theme.TextPrimary)
				return Slider
			end
			function Slider:EnableWheel(state)
				setWheelEnabled(state == true)
				return Slider
			end
			function Slider:SetWheelEnabled(state)
				return Slider:EnableWheel(state)
			end
			function Slider:GetWheelEnabled()
				return wheelConn ~= nil
			end
			function Slider:_stopForDestroy()
				finishDrag()
				cleanupDragConnections()
				setWheelEnabled(false)
			end

			render(Slider.Value,true,true)
			refreshRangeLabels()
			_registerConfigControl(Slider, opts, "slider")
			_registerReconnectControl(Slider, opts, "slider")
			return _universalControl(Slider, opts)
		end
		function Tab:Dropdown(opts)
			opts=validate({name="Dropdown",description="",tooltip="",items={},default=nil,multi=false,placeholder="Select...",callback=function()end},opts)
			local DD={Open=false,Selected=opts.default,Multi={}}
			if opts.multi and type(opts.default)=="table" then for _,v in ipairs(opts.default) do DD.Multi[v]=true end end
			local hasDesc=tostring(opts.description or "") ~= ""
			local closedH=hasDesc and 64 or 54
			DD.frame=base("Dropdown",closedH); DD.frame.ClipsDescendants=true; pad(DD.frame,0,0,0,0)
			local st=DD.frame:FindFirstChildOfClass("UIStroke")
			local header=Instance.new("TextButton",DD.frame)
			header.Name="DDHeader"; header.AutoButtonColor=false; header.BackgroundTransparency=1; header.BorderSizePixel=0
			header.Size=UDim2.new(1,0,0,closedH); header.Text=""; header.ZIndex=2
			local title,desc=labelPair(DD.frame,opts.name,opts.description,178,hasDesc and 11 or 18)
			local function selectedList()
				local s={}; for _,item in ipairs(opts.items) do if DD.Multi[item] then table.insert(s,item) end end; return s
			end
			local function labelText()
				if opts.multi then local s=selectedList(); return #s>0 and table.concat(s,", ") or tostring(opts.placeholder) end
				return DD.Selected and tostring(DD.Selected) or tostring(opts.placeholder)
			end
			local valueBg=Instance.new("Frame",DD.frame)
			valueBg.Name="DropdownValue"
			valueBg.AnchorPoint=Vector2.new(1,0.5); valueBg.Position=UDim2.new(1,-42,0,closedH/2)
			valueBg.Size=UDim2.new(0,148,0,30); valueBg.BackgroundColor3=Library.Theme.Background; valueBg.BorderSizePixel=0; corner(valueBg,9)
			local valueStroke=stroke(valueBg,Library.Theme.BorderHover,1.2)
			local selLbl=lbl(valueBg,labelText(),11,Library.Theme.TextSecondary,FONT_UI_MED,Enum.TextXAlignment.Left)
			selLbl.Size=UDim2.new(1,-18,1,0); selLbl.Position=UDim2.new(0,10,0,0); selLbl.TextTruncate=Enum.TextTruncate.AtEnd
			local arrowImg=Instance.new("ImageLabel",DD.frame)
			arrowImg.BackgroundTransparency=1; arrowImg.AnchorPoint=Vector2.new(1,0.5)
			arrowImg.Image="rbxassetid://12974428978"; arrowImg.ImageColor3=Library.Theme.TextSecondary
			arrowImg.Size=UDim2.new(0,13,0,13); arrowImg.Position=UDim2.new(1,-16,0,closedH/2); arrowImg.ZIndex=3
			addTooltip(header,opts.tooltip)
			local optPanel=Instance.new("Frame",DD.frame)
			optPanel.Name="DropdownList"
			optPanel.BackgroundColor3=Library.Theme.Background
			optPanel.BorderSizePixel=0
			optPanel.Position=UDim2.new(0,12,0,closedH+8)
			optPanel.Size=UDim2.new(1,-24,0,0)
			optPanel.Visible=false; optPanel.ZIndex=4
			corner(optPanel,9); stroke(optPanel,Library.Theme.BorderHover,1.25)
			local optHolder=Instance.new("Frame",optPanel)
			optHolder.BackgroundTransparency=1; optHolder.BorderSizePixel=0
			optHolder.Size=UDim2.new(1,-14,0,0); optHolder.Position=UDim2.new(0,7,0,7)
			optHolder.Visible=true; optHolder.ZIndex=5
			local ol=Instance.new("UIListLayout",optHolder); ol.Padding=UDim.new(0,5); ol.SortOrder=Enum.SortOrder.LayoutOrder
			local function setOpen(v)
				DD.Open=v==true; optPanel.Visible=DD.Open
				tw(arrowImg,{Rotation=DD.Open and 180 or 0})
				tw(st,{Color=DD.Open and Library.Theme.BorderHover or Library.Theme.Border})
				tw(valueStroke,{Color=DD.Open and Library.Theme.Accent or Library.Theme.BorderHover})
			end
			local function refresh()
				for _,c in ipairs(optHolder:GetChildren()) do if c:IsA("TextButton") then c:Destroy() end end
				local rowH,total=34,0
				for _,item in ipairs(opts.items) do
					local isSel=(opts.multi and DD.Multi[item]) or (not opts.multi and DD.Selected==item)
					local opt=Instance.new("TextButton",optHolder)
					opt.AutoButtonColor=false; opt.BorderSizePixel=0
					opt.BackgroundColor3=isSel and Library.Theme.SurfaceHover or Library.Theme.Surface
					opt.TextSize=12; opt.TextXAlignment=Enum.TextXAlignment.Left
					opt.FontFace=FONT_UI_MED
					opt.TextColor3=isSel and Library.Theme.TextPrimary or Library.Theme.TextSecondary
					opt.Size=UDim2.new(1,0,0,rowH); opt.Text=tostring(item); opt.ZIndex=6; opt.TextTruncate=Enum.TextTruncate.AtEnd
					corner(opt,8); local optInitialStroke=stroke(opt,isSel and Library.Theme.Accent or Library.Theme.Border,1); if isSel then regAccent(optInitialStroke) end; pad(opt,0,34,0,16)
					if isSel then
						local dot=Instance.new("Frame",opt); dot.BackgroundColor3=Library.Theme.Accent; regAccent(dot); dot.BorderSizePixel=0
						dot.AnchorPoint=Vector2.new(1,0.5); dot.Size=UDim2.new(0,7,0,7); dot.Position=UDim2.new(1,-13,0.5,0); corner(dot,4)
					end
					local optStroke=opt:FindFirstChildOfClass("UIStroke")
					opt.MouseEnter:Connect(function()
						local nowSel=(opts.multi and DD.Multi[item]) or (not opts.multi and DD.Selected==item)
						if not nowSel then tw(opt,{BackgroundColor3=Library.Theme.SurfaceHover,TextColor3=Library.Theme.TextPrimary}); safeTween(optStroke,{Color=Library.Theme.BorderHover}) end
					end)
					opt.MouseLeave:Connect(function()
						local nowSel=(opts.multi and DD.Multi[item]) or (not opts.multi and DD.Selected==item)
						if not nowSel then tw(opt,{BackgroundColor3=Library.Theme.Surface,TextColor3=Library.Theme.TextSecondary}); safeTween(optStroke,{Color=Library.Theme.Border}) end
					end)
					opt.MouseButton1Click:Connect(function()
						if opts.multi then
							DD.Multi[item]=not DD.Multi[item]; local s=selectedList(); selLbl.Text=labelText(); GUI:_invokeCallback(tostring(opts.name or opts.title or "control"), opts.callback,s); refresh()
						else
							DD.Selected=item; selLbl.Text=labelText(); GUI:_invokeCallback(tostring(opts.name or opts.title or "control"), opts.callback,item); setOpen(false); DD.frame.Size=UDim2.new(1,0,0,closedH); refresh()
						end
						pcall(function() GUI:MarkConfigDirty() end)
					end)
					total=total+rowH+5
				end
				total=math.max(total-5,0)
				optHolder.Size=UDim2.new(1,-14,0,total)
				optPanel.Size=UDim2.new(1,-24,0,total+14)
				DD.frame.Size=UDim2.new(1,0,0,DD.Open and (closedH+24+total) or closedH)
			end
			header.MouseButton1Click:Connect(function() if DD.Disabled then return end; setOpen(not DD.Open); refresh() end)
			DD.frame.MouseEnter:Connect(function() tw(DD.frame,{BackgroundColor3=Library.Theme.SurfaceHover}) end)
			DD.frame.MouseLeave:Connect(function() if not DD.Open then tw(DD.frame,{BackgroundColor3=Library.Theme.Surface}) end end)
			refresh()
			function DD:Set(v, silent)
				if opts.multi then
					DD.Multi={}; if type(v)=="table" then for _,x in ipairs(v) do DD.Multi[x]=true end end
					selLbl.Text=labelText(); if not silent then GUI:_invokeCallback(tostring(opts.name or opts.title or "control"), opts.callback, selectedList()) end
				else
					DD.Selected=v; selLbl.Text=labelText(); if not silent then GUI:_invokeCallback(tostring(opts.name or opts.title or "control"), opts.callback, v) end
				end
				refresh()
				return DD
			end
			function DD:Get() return opts.multi and selectedList() or DD.Selected end
			function DD:GetItems() return opts.items end
			function DD:SetItems(newItems)
				opts.items=type(newItems)=="table" and newItems or {}
				if opts.multi then local keep={}; for _,item in ipairs(opts.items) do if DD.Multi[item] then keep[item]=true end end; DD.Multi=keep
				else local valid=false; for _,item in ipairs(opts.items) do if item==DD.Selected then valid=true break end end; if not valid then DD.Selected=nil end end
				selLbl.Text=labelText(); refresh()
			end
			_registerConfigControl(DD, opts, opts.multi and "multidropdown" or "dropdown")
			_registerReconnectControl(DD, opts, opts.multi and "multidropdown" or "dropdown")
			return _universalControl(DD, opts)
		end

		function Tab:SearchDropdown(opts)
			opts=validate({name="Search Dropdown",description="",tooltip="",items={},default=nil,multi=false,placeholder="Select...",searchPlaceholder="Search...",maxVisible=6,autoFocusSearch=false,clearSearchOnOpen=false,callback=function()end},opts)
			local DD={Open=false,Selected=opts.default,Multi={},_query=""}
			if opts.multi and type(opts.default)=="table" then for _,v in ipairs(opts.default) do DD.Multi[v]=true end end
			local hasDesc=tostring(opts.description or "") ~= ""
			local closedH=hasDesc and 64 or 54
			local searchH=34
			local rowH=34
			local maxVisible=math.clamp(tonumber(opts.maxVisible) or 6, 2, 12)
			DD.frame=base("SearchDropdown",closedH); DD.frame.ClipsDescendants=true; pad(DD.frame,0,0,0,0)
			local st=DD.frame:FindFirstChildOfClass("UIStroke")
			local header=Instance.new("TextButton",DD.frame)
			header.Name="DDHeader"; header.AutoButtonColor=false; header.BackgroundTransparency=1; header.BorderSizePixel=0
			header.Size=UDim2.new(1,0,0,closedH); header.Text=""; header.ZIndex=2
			local title,desc=labelPair(DD.frame,opts.name,opts.description,178,hasDesc and 11 or 18)
			local function selectedList() local s={}; for _,item in ipairs(opts.items) do if DD.Multi[item] then table.insert(s,item) end end; return s end
			local function labelText()
				if opts.multi then local s=selectedList(); return #s>0 and table.concat(s,", ") or tostring(opts.placeholder) end
				return DD.Selected and tostring(DD.Selected) or tostring(opts.placeholder)
			end
			local valueBg=Instance.new("Frame",DD.frame)
			valueBg.Name="DropdownValue"; valueBg.AnchorPoint=Vector2.new(1,0.5); valueBg.Position=UDim2.new(1,-42,0,closedH/2)
			valueBg.Size=UDim2.new(0,148,0,30); valueBg.BackgroundColor3=Library.Theme.Background; valueBg.BorderSizePixel=0; corner(valueBg,9)
			local valueStroke=stroke(valueBg,Library.Theme.BorderHover,1.2)
			local selLbl=lbl(valueBg,labelText(),11,Library.Theme.TextSecondary,FONT_UI_MED,Enum.TextXAlignment.Left)
			selLbl.Size=UDim2.new(1,-18,1,0); selLbl.Position=UDim2.new(0,10,0,0); selLbl.TextTruncate=Enum.TextTruncate.AtEnd
			local arrowImg=Instance.new("ImageLabel",DD.frame)
			arrowImg.BackgroundTransparency=1; arrowImg.AnchorPoint=Vector2.new(1,0.5)
			arrowImg.Image="rbxassetid://12974428978"; arrowImg.ImageColor3=Library.Theme.TextSecondary
			arrowImg.Size=UDim2.new(0,13,0,13); arrowImg.Position=UDim2.new(1,-16,0,closedH/2); arrowImg.ZIndex=3
			addTooltip(header,opts.tooltip)
			local optPanel=Instance.new("Frame",DD.frame)
			optPanel.Name="DropdownList"; optPanel.BackgroundColor3=Library.Theme.Background; optPanel.BorderSizePixel=0
			optPanel.Position=UDim2.new(0,12,0,closedH+8); optPanel.Size=UDim2.new(1,-24,0,0); optPanel.Visible=false; optPanel.ZIndex=4
			corner(optPanel,9); stroke(optPanel,Library.Theme.BorderHover,1.25)
			local searchBg=Instance.new("Frame",optPanel)
			searchBg.Name="DropdownSearchBox"; searchBg.BackgroundColor3=Library.Theme.Surface; searchBg.BorderSizePixel=0
			searchBg.Size=UDim2.new(1,-14,0,searchH); searchBg.Position=UDim2.new(0,7,0,7); searchBg.ZIndex=5; corner(searchBg,8); stroke(searchBg,Library.Theme.Border,1)
			local searchIcon=lbl(searchBg,"🔍",12,Library.Theme.TextDisabled,FONT_UI_BOLD,Enum.TextXAlignment.Center)
			searchIcon.Size=UDim2.new(0,26,1,0); searchIcon.ZIndex=6
			local searchBox=Instance.new("TextBox",searchBg)
			searchBox.BackgroundTransparency=1; searchBox.BorderSizePixel=0; searchBox.Text=""; searchBox.ClearTextOnFocus=false
			searchBox.PlaceholderText=tostring(opts.searchPlaceholder or "Search..."); searchBox.PlaceholderColor3=Library.Theme.TextDisabled
			searchBox.TextColor3=Library.Theme.TextPrimary; searchBox.TextSize=12; searchBox.FontFace=FONT_UI_MED
			searchBox.TextXAlignment=Enum.TextXAlignment.Left; searchBox.TextTruncate=Enum.TextTruncate.AtEnd
			searchBox.Size=UDim2.new(1,-36,1,0); searchBox.Position=UDim2.new(0,30,0,0); searchBox.ZIndex=6
			local scroll=Instance.new("ScrollingFrame",optPanel)
			scroll.Name="DropdownSearchResults"; scroll.BackgroundTransparency=1; scroll.BorderSizePixel=0
			scroll.Position=UDim2.new(0,7,0,searchH+14); scroll.Size=UDim2.new(1,-14,0,0)
			scroll.ScrollBarThickness=2; scroll.ScrollBarImageColor3=Library.Theme.BorderHover; scroll.CanvasSize=UDim2.new(0,0,0,0)
			scroll.AutomaticCanvasSize=Enum.AutomaticSize.Y; scroll.ScrollingDirection=Enum.ScrollingDirection.Y; scroll.ElasticBehavior=Enum.ElasticBehavior.Never; scroll.ZIndex=5
			local ol=Instance.new("UIListLayout",scroll); ol.Padding=UDim.new(0,5); ol.SortOrder=Enum.SortOrder.LayoutOrder
			local function filteredItems()
				local q=tostring(DD._query or ""):lower()
				local out={}
				for _,item in ipairs(opts.items) do
					local txt=tostring(item)
					if q=="" or txt:lower():find(q,1,true) then table.insert(out,item) end
				end
				return out
			end
			local function setOpen(v)
				DD.Open=v==true; optPanel.Visible=DD.Open
				tw(arrowImg,{Rotation=DD.Open and 180 or 0}); tw(st,{Color=DD.Open and Library.Theme.BorderHover or Library.Theme.Border}); tw(valueStroke,{Color=DD.Open and Library.Theme.Accent or Library.Theme.BorderHover})
				if DD.Open then
					if opts.clearSearchOnOpen == true and searchBox.Text ~= "" then
						searchBox.Text = ""
						DD._query = ""
					end
					if opts.autoFocusSearch == true then
						task.defer(function()
							pcall(function() searchBox:CaptureFocus() end)
						end)
					end
				else
					pcall(function() searchBox:ReleaseFocus() end)
				end
			end
			local function refresh()
				for _,c in ipairs(scroll:GetChildren()) do if c:IsA("TextButton") or c.Name=="DropdownEmpty" then c:Destroy() end end
				local shown=filteredItems(); local total=0
				if #shown == 0 then
					local empty=lbl(scroll,"No results found",12,Library.Theme.TextDisabled,FONT_UI_MED,Enum.TextXAlignment.Center)
					empty.Name="DropdownEmpty"; empty.Size=UDim2.new(1,0,0,rowH); empty.ZIndex=6; total=rowH
				else
					for _,item in ipairs(shown) do
						local isSel=(opts.multi and DD.Multi[item]) or (not opts.multi and DD.Selected==item)
						local opt=Instance.new("TextButton",scroll)
						opt.AutoButtonColor=false; opt.BorderSizePixel=0; opt.BackgroundColor3=isSel and Library.Theme.SurfaceHover or Library.Theme.Surface
						opt.TextSize=12; opt.TextXAlignment=Enum.TextXAlignment.Left; opt.FontFace=FONT_UI_MED; opt.TextColor3=isSel and Library.Theme.TextPrimary or Library.Theme.TextSecondary
						opt.Size=UDim2.new(1,-2,0,rowH); opt.Text=tostring(item); opt.ZIndex=6; opt.TextTruncate=Enum.TextTruncate.AtEnd
						corner(opt,8); local optInitialStroke=stroke(opt,isSel and Library.Theme.Accent or Library.Theme.Border,1); if isSel then regAccent(optInitialStroke) end; pad(opt,0,34,0,16)
						if isSel then local dot=Instance.new("Frame",opt); dot.BackgroundColor3=Library.Theme.Accent; regAccent(dot); dot.BorderSizePixel=0; dot.AnchorPoint=Vector2.new(1,0.5); dot.Size=UDim2.new(0,7,0,7); dot.Position=UDim2.new(1,-13,0.5,0); corner(dot,4) end
						local optStroke=opt:FindFirstChildOfClass("UIStroke")
						opt.MouseEnter:Connect(function() local nowSel=(opts.multi and DD.Multi[item]) or (not opts.multi and DD.Selected==item); if not nowSel then tw(opt,{BackgroundColor3=Library.Theme.SurfaceHover,TextColor3=Library.Theme.TextPrimary}); safeTween(optStroke,{Color=Library.Theme.BorderHover}) end end)
						opt.MouseLeave:Connect(function() local nowSel=(opts.multi and DD.Multi[item]) or (not opts.multi and DD.Selected==item); if not nowSel then tw(opt,{BackgroundColor3=Library.Theme.Surface,TextColor3=Library.Theme.TextSecondary}); safeTween(optStroke,{Color=Library.Theme.Border}) end end)
						opt.MouseButton1Click:Connect(function()
							if opts.multi then DD.Multi[item]=not DD.Multi[item]; local s=selectedList(); selLbl.Text=labelText(); GUI:_invokeCallback(tostring(opts.name or opts.title or "control"), opts.callback,s); refresh()
							else DD.Selected=item; selLbl.Text=labelText(); GUI:_invokeCallback(tostring(opts.name or opts.title or "control"), opts.callback,item); setOpen(false); DD.frame.Size=UDim2.new(1,0,0,closedH); refresh() end
							pcall(function() GUI:MarkConfigDirty() end)
						end)
						total=total+rowH+5
					end
					total=math.max(total-5,0)
				end
				local visibleRows=math.min(math.max(#shown,1), maxVisible)
				local resultsH=(visibleRows*rowH)+((visibleRows-1)*5)
				scroll.Size=UDim2.new(1,-14,0,resultsH); scroll.CanvasSize=UDim2.new(0,0,0,total)
				local panelH=searchH+21+resultsH
				optPanel.Size=UDim2.new(1,-24,0,panelH)
				DD.frame.Size=UDim2.new(1,0,0,DD.Open and (closedH+16+panelH) or closedH)
			end
			searchBox:GetPropertyChangedSignal("Text"):Connect(function() DD._query=searchBox.Text; refresh() end)
			searchBox.Focused:Connect(function()
				pcall(function()
					local ss = searchBg:FindFirstChildOfClass("UIStroke")
					if ss then ss.Color = Library.Theme.Accent end
				end)
			end)
			searchBox.FocusLost:Connect(function()
				pcall(function()
					local ss = searchBg:FindFirstChildOfClass("UIStroke")
					if ss then ss.Color = Library.Theme.Border end
				end)
			end)
			header.MouseButton1Click:Connect(function() if DD.Disabled then return end; setOpen(not DD.Open); refresh() end)
			DD.frame.MouseEnter:Connect(function() tw(DD.frame,{BackgroundColor3=Library.Theme.SurfaceHover}) end)
			DD.frame.MouseLeave:Connect(function() if not DD.Open then tw(DD.frame,{BackgroundColor3=Library.Theme.Surface}) end end)
			refresh()
			function DD:Set(v, silent)
				if opts.multi then DD.Multi={}; if type(v)=="table" then for _,x in ipairs(v) do DD.Multi[x]=true end end; selLbl.Text=labelText(); if not silent then GUI:_invokeCallback(tostring(opts.name or opts.title or "control"), opts.callback, selectedList()) end
				else DD.Selected=v; selLbl.Text=labelText(); if not silent then GUI:_invokeCallback(tostring(opts.name or opts.title or "control"), opts.callback, v) end end
				refresh()
				return DD
			end
			function DD:Get() return opts.multi and selectedList() or DD.Selected end
			function DD:GetItems() return opts.items end
			function DD:SetItems(newItems) opts.items=type(newItems)=="table" and newItems or {}; if opts.multi then local keep={}; for _,item in ipairs(opts.items) do if DD.Multi[item] then keep[item]=true end end; DD.Multi=keep else local valid=false; for _,item in ipairs(opts.items) do if item==DD.Selected then valid=true break end end; if not valid then DD.Selected=nil end end; selLbl.Text=labelText(); refresh() end
			function DD:SetSearch(text) searchBox.Text=tostring(text or "") end
			function DD:ClearSearch() searchBox.Text="" end
			_registerConfigControl(DD, opts, opts.multi and "searchmultidropdown" or "searchdropdown")
			_registerReconnectControl(DD, opts, opts.multi and "searchmultidropdown" or "searchdropdown")
			return _universalControl(DD, opts)
		end
		Tab.SearchableDropdown = Tab.SearchDropdown
		Tab.FilterDropdown = Tab.SearchDropdown

		function Tab:TextInput(opts)
			opts=validate({name="Input",description="",placeholder="Type here...",tooltip="",default="",numeric=false,callback=function()end},opts)
			local hasDesc=tostring(opts.description or "") ~= ""
			local TIc={Value=opts.numeric and (tonumber(opts.default) or 0) or tostring(opts.default or "")}

			-- 4.6 fix:
			-- Previous spacing update made the TextBox taller but kept the outer card too short.
			-- Since base() uses ClipsDescendants=true, the bottom half of the input was getting clipped.
			-- The card now owns all spacing manually instead of mixing UIPadding with absolute positions.
			local inputH = 42
			local inputY = hasDesc and 52 or 40
			local cardH  = inputY + inputH + 12
			TIc.frame=base("TextInput",cardH)

			local nl,dl=labelPair(TIc.frame,opts.name,opts.description,0,10)
			local ibg=Instance.new("Frame",TIc.frame)
			ibg.Name="InputBox"
			ibg.BackgroundColor3=Library.Theme.Background; ibg.BorderSizePixel=0
			ibg.Size=UDim2.new(1,-24,0,inputH); ibg.Position=UDim2.new(0,12,0,inputY); corner(ibg,10)
			local ibStroke=stroke(ibg,Library.Theme.Border,1)

			local box=Instance.new("TextBox",ibg)
			box.Name="TextBox"
			box.BackgroundTransparency=1; box.BorderSizePixel=0
			box.TextSize=13; box.FontFace=FONT_UI_MED
			box.TextColor3=Library.Theme.TextPrimary
			box.PlaceholderText=opts.placeholder; box.PlaceholderColor3=Library.Theme.TextDisabled
			box.Text=tostring(TIc.Value); box.ClearTextOnFocus=false
			box.Size=UDim2.new(1,-32,1,-2); box.Position=UDim2.new(0,16,0,1)
			box.TextXAlignment=Enum.TextXAlignment.Left
			box.TextYAlignment=Enum.TextYAlignment.Center
			box.TextTruncate=Enum.TextTruncate.AtEnd

			local function setFocusVisual(focused)
				tw(ibStroke,{Color=focused and Library.Theme.Accent or Library.Theme.Border},TI_FAST)
				tw(ibg,{BackgroundColor3=focused and Library.Theme.SurfaceHover or Library.Theme.Background},TI_FAST)
			end

			box.Focused:Connect(function() setFocusVisual(true) end)
			local function commit(silent)
				if opts.numeric then
					local cleaned=tostring(box.Text):gsub("[^%d%.-]","")
					local n=tonumber(cleaned); if n == nil then n=tonumber(opts.default) or 0 end
					TIc.Value=n; box.Text=tostring(n)
				else
					TIc.Value=tostring(box.Text)
				end
				if not silent then GUI:_invokeCallback(tostring(opts.name or opts.title or "control"), opts.callback, TIc.Value) end
				pcall(function() GUI:MarkConfigDirty() end)
			end
			box.FocusLost:Connect(function() setFocusVisual(false); commit(false) end)
			addTooltip(TIc.frame,opts.tooltip)
			function TIc:Set(v, silent) box.Text=tostring(v); commit(silent); return TIc end
			function TIc:Get() return TIc.Value end
			_registerConfigControl(TIc, opts, opts.numeric and "numberinput" or "textinput")
			_registerReconnectControl(TIc, opts, opts.numeric and "numberinput" or "textinput")
			return _universalControl(TIc, opts)
		end
		function Tab:ColorPicker(opts)
			opts=validate({name="Color",tooltip="",default=Color3.fromRGB(255,100,100),callback=function()end},opts)
			local defaultColor = typeof(opts.default)=="Color3" and opts.default or Color3.fromRGB(255,100,100)
			local CP={Value=defaultColor,Open=false,_conns={}}
			CP.frame=base("ColorPicker",42); CP.frame.ClipsDescendants=true; pad(CP.frame,0,10,0,12)
			local header=Instance.new("TextButton",CP.frame)
			header.BackgroundTransparency=1; header.BorderSizePixel=0
			header.Size=UDim2.new(1,0,0,42); header.Position=UDim2.new(0,0,0,0)
			header.Text=""; header.AutoButtonColor=false; header.ZIndex=5
			local nl=lbl(CP.frame,opts.name,13,Library.Theme.TextPrimary,Font.new("rbxasset://fonts/families/Ubuntu.json",Enum.FontWeight.SemiBold)); nl.Size=UDim2.new(1,-92,0,42); nl.ZIndex=4
			local preview=Instance.new("Frame",CP.frame)
			preview.BackgroundColor3=defaultColor; preview.BorderSizePixel=0
			preview.AnchorPoint=Vector2.new(1,0.5); preview.Size=UDim2.new(0,44,0,22)
			preview.Position=UDim2.new(1,0,0,21); preview.ZIndex=4; corner(preview,7); stroke(preview,Library.Theme.Border)
			local hexLbl=lbl(CP.frame,"#FFFFFF",10,Library.Theme.TextSecondary,Font.new("rbxasset://fonts/families/RobotoMono.json"),Enum.TextXAlignment.Right)
			hexLbl.AnchorPoint=Vector2.new(1,0.5); hexLbl.Size=UDim2.new(0,78,0,16); hexLbl.Position=UDim2.new(1,-52,0,21); hexLbl.ZIndex=4
			addTooltip(CP.frame,opts.tooltip)
			local picker=Instance.new("Frame",CP.frame)
			picker.BackgroundColor3=Library.Theme.Background; picker.BorderSizePixel=0
			picker.Size=UDim2.new(1,0,0,114); picker.Position=UDim2.new(0,0,0,46)
			picker.Visible=false; corner(picker,7); pad(picker,8,10,8,10); stroke(picker,Library.Theme.Border)
			local pL=Instance.new("UIListLayout",picker)
			pL.Padding=UDim.new(0,6); pL.SortOrder=Enum.SortOrder.LayoutOrder
			local h_v,s_v,v_v=Color3.toHSV(defaultColor)
			local _hsvFills={}
			local _syncing = false
			local function cToHex(c)
				return string.format("#%02X%02X%02X", math.floor(c.R*255+0.5), math.floor(c.G*255+0.5), math.floor(c.B*255+0.5))
			end
			local function setFills()
				if _hsvFills.H then _hsvFills.H.Size=UDim2.new(h_v,0,1,0) end
				if _hsvFills.S then _hsvFills.S.Size=UDim2.new(s_v,0,1,0) end
				if _hsvFills.V then _hsvFills.V.Size=UDim2.new(v_v,0,1,0) end
			end
			local function rebuild(silent)
				local c=Color3.fromHSV(h_v,s_v,v_v)
				CP.Value=c; preview.BackgroundColor3=c; hexLbl.Text=cToHex(c); setFills()
				if not silent and not _syncing then GUI:_invokeCallback(tostring(opts.name or opts.title or "control"), opts.callback,c) end
			end
			local function makeHSVSlider(name,init,cb,color)
				local row=Instance.new("Frame",picker)
				row.BackgroundTransparency=1; row.BorderSizePixel=0; row.Size=UDim2.new(1,0,0,24)
				local rl=lbl(row,name,10,Library.Theme.TextSecondary,Font.new("rbxasset://fonts/families/RobotoMono.json",Enum.FontWeight.Bold)); rl.Size=UDim2.new(0,18,1,0)
				local tr=Instance.new("Frame",row)
				tr.BackgroundColor3=Library.Theme.Surface; tr.BorderSizePixel=0
				tr.AnchorPoint=Vector2.new(0,0.5); tr.Size=UDim2.new(1,-24,0,8); tr.Position=UDim2.new(0,24,0.5,0); corner(tr,4); stroke(tr,Library.Theme.Border)
				local fl=Instance.new("Frame",tr)
				fl.BackgroundColor3=color or Library.Theme.Accent; if not color then regAccent(fl) end
				fl.BorderSizePixel=0; fl.Size=UDim2.new(init,0,1,0); corner(fl,4)
				_hsvFills[name] = fl
				local drag2=false
				local function upd2(x)
					local a=math.clamp((x-tr.AbsolutePosition.X)/math.max(tr.AbsoluteSize.X,1),0,1)
					cb(a); rebuild(false)
				end
				table.insert(CP._conns, tr.InputBegan:Connect(function(i)
					if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then drag2=true; upd2(i.Position.X) end
				end))
				table.insert(CP._conns, UIS.InputChanged:Connect(function(i)
					if drag2 and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then upd2(i.Position.X) end
				end))
				table.insert(CP._conns, UIS.InputEnded:Connect(function(i)
					if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then drag2=false end
				end))
			end
			makeHSVSlider("H",h_v,function(a) h_v=a end, Color3.fromRGB(255,90,160))
			makeHSVSlider("S",s_v,function(a) s_v=a end, Color3.fromRGB(100,150,255))
			makeHSVSlider("V",v_v,function(a) v_v=a end, Color3.fromRGB(245,245,245))
			CP.frame.AncestryChanged:Connect(function()
				if not CP.frame:IsDescendantOf(game) then for _,c in ipairs(CP._conns) do pcall(function() c:Disconnect() end) end end
			end)
			header.MouseButton1Click:Connect(function()
				if CP.Disabled then return end
				CP.Open=not CP.Open; picker.Visible=CP.Open
				CP.frame.Size=UDim2.new(1,0,0,CP.Open and 166 or 42)
			end)
			function CP:Set(c, silent)
				if typeof(c) ~= "Color3" then return CP end
				_syncing = true
				CP.Value=c; preview.BackgroundColor3=c; hexLbl.Text=cToHex(c)
				h_v,s_v,v_v=Color3.toHSV(c)
				setFills()
				_syncing = false
				if not silent then GUI:_invokeCallback(tostring(opts.name or opts.title or "control"), opts.callback,c) end
				return CP
			end
			function CP:Get() return CP.Value end
			rebuild(true)
			_registerConfigControl(CP, opts, "color")
			_registerReconnectControl(CP, opts, "color")
			return _universalControl(CP, opts)
		end

		function Tab:Keybind(opts)
			opts=validate({name="Keybind",description="",tooltip="",default=Enum.KeyCode.E,callback=function()end},opts)
			local defaultKey=_safeEnumKey(opts.default, Enum.KeyCode.E)
			local hasDesc=tostring(opts.description or "") ~= ""
			local KB={Value=defaultKey,Listening=false,_callback=opts.callback}
			KB.frame=base("Keybind",hasDesc and 58 or 48); pad(KB.frame,0,12,0,14)
			local nl,dl=labelPair(KB.frame,opts.name,opts.description,100,hasDesc and 9 or 15)
			local kBg=Instance.new("Frame",KB.frame)
			kBg.Name="KeybindBox"
			pcall(function() kBg:SetAttribute("VenturaThemeRole", "Background") end)
			kBg.BackgroundColor3=Library.Theme.Background; kBg.BorderSizePixel=0
			kBg.AnchorPoint=Vector2.new(1,0.5); kBg.Size=UDim2.new(0,82,0,26)
			kBg.Position=UDim2.new(1,0,0.5,0); corner(kBg,7); stroke(kBg,Library.Theme.Border)
			local kLbl=lbl(kBg,KB.Value.Name,11,Library.Theme.TextSecondary,FONT_MONO_BOLD,Enum.TextXAlignment.Center)
			kLbl.Name="KeybindLabel"
			pcall(function() kLbl:SetAttribute("VenturaTextRole", "TextSecondary") end)
			addTooltip(KB.frame,opts.tooltip)
			function KB:_refreshLabel() kLbl.Text=self.Value and self.Value.Name or "None" end
			function KB:_stopListening(resetText)
				self.Listening=false; keybindListening=false
				if GUI._activeKeybind == self then GUI._activeKeybind=nil end
				if resetText then self:_refreshLabel() end
				tw(kBg,{BackgroundColor3=Library.Theme.Background})
			end
			local function startListening()
				if GUI._activeKeybind and GUI._activeKeybind ~= KB then GUI._activeKeybind:_stopListening(true) end
				KB.Listening=true; keybindListening=true; GUI._activeKeybind=KB
				GUI._keybindMouseGuardUntil = os.clock() + 0.12
				kLbl.Text="Press key..."; tw(kBg,{BackgroundColor3=Library.Theme.SurfaceHover})
			end
			kBg.InputBegan:Connect(function(i)
				if KB.Disabled then return end
				if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then startListening() end
			end)
			table.insert(GUI._keybindWidgets, KB)
			KB.frame.AncestryChanged:Connect(function()
				if not KB.frame:IsDescendantOf(game) then
					if GUI._activeKeybind == KB then KB:_stopListening(true) end
					for i=#GUI._keybindWidgets,1,-1 do if GUI._keybindWidgets[i]==KB then table.remove(GUI._keybindWidgets,i) end end
				end
			end)
			function KB:Set(k, silent)
				local parsedKey = _safeEnumKey(k, nil)
				if parsedKey then KB.Value = parsedKey end
				KB:_refreshLabel()
				if not silent then _safeCall("keybind callback", opts.callback, KB.Value); pcall(function() GUI:MarkConfigDirty() end) end
				return KB
			end
			function KB:Get() return KB.Value end
			_registerConfigControl(KB, opts, "keybind")
			_registerReconnectControl(KB, opts, "keybind")
			return _universalControl(KB, opts)
		end
