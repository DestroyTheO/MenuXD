	function GUI:SetGlassIntensity(value)
		local current = Library.Themes and Library.Themes[GUI:GetTheme()]
		if not current then return false end
		local surface = math.clamp(tonumber(value) or 0.18, 0, 0.75)
		current.Transparency = current.Transparency or {}
		current.Transparency.Surface = surface
		current.Transparency.Background = math.clamp(surface + 0.10, 0, 0.85)
		current.Transparency.Nav = math.clamp(surface, 0, 0.80)
		current.Transparency.Topbar = math.clamp(surface + 0.02, 0, 0.82)
		current.Transparency.UserBox = math.clamp(surface - 0.02, 0, 0.72)
		current.Transparency.Input = current.Transparency.Background
		GUI:_RefreshThemeVisuals()
		_applyThemeDesign(current, GUI:GetTheme())
		return true
	end

