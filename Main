			star.Name = "BubbleStar"
			star.AnchorPoint = Vector2.new(0.5, 0.5)
			star.Position = UDim2.fromScale(spec[1], spec[2])
			star.Size = UDim2.new(0, spec[3], 0, spec[3])
			star.BackgroundColor3 = Color3.fromRGB(235, 245, 255)
			star.BackgroundTransparency = 0.12
			star.BorderSizePixel = 0
