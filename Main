	local function _setSpaceBackground(enabled, style)
		enabled = enabled == true
		local nextStyle = tostring(style or GUI._spaceStyle or "stars"):lower()
		local styleChanged = V._spaceStyleToken ~= nil and V._spaceStyleToken ~= nextStyle
		V._spaceEnabled = enabled
		GUI._spaceStyle = nextStyle
		if enabled then
			_makeSpaceLayer(styleChanged)
			V._spaceStyleToken = nextStyle
			V._spaceLayer.Visible = true
			V._spaceLayer.ZIndex = 0
			V._spaceLayer.Size = UDim2.new(1, 0, 1, 0)
			V._spaceLayer.Position = UDim2.new(0, 0, 0, 0)
			V._spaceLayer.ClipsDescendants = true
			if not V._spaceConn then
				V._spaceConn = RunService.RenderStepped:Connect(_stepSpaceStars)
				track(V._spaceConn)
			end
		else
			if V._spaceLayer then V._spaceLayer.Visible = false end
		end
	end


	-- v5.45 theme design overlay ----------------------------------------------
	-- Adds a light gradient/vignette layer above the star layer so themes feel
	-- visually different without touching config behavior or component state.
	V._themeDesignLayer, V._themeDesignGradient = nil, nil
	V._themeDesignVisible = true
	local function _ensureThemeDesignLayer()
		if V._themeDesignLayer and V._themeDesignLayer.Parent then return V._themeDesignLayer end
		local layer = Instance.new("Frame", Main)
		layer.Name = "ThemeDesignOverlay"
		layer.BackgroundColor3 = Library.Theme.Background
		layer.BackgroundTransparency = 0.86
		layer.BorderSizePixel = 0
		layer.Size = UDim2.new(1, 0, 1, 0)
		layer.Position = UDim2.new(0, 0, 0, 0)
		layer.Active = false
		layer.ZIndex = 0
		local grad = Instance.new("UIGradient", layer)
		V._themeDesignLayer = layer
		V._themeDesignGradient = grad
		return layer
	end

	local function _applyThemeDesign(themeData, themeName)
		if V._themeDesignVisible == false then
			if V._themeDesignLayer then V._themeDesignLayer.Visible = false end
			return false
		end
		themeData = type(themeData) == "table" and themeData or {}
		local layer = _ensureThemeDesignLayer()
		local grad = V._themeDesignGradient or layer:FindFirstChildOfClass("UIGradient")
		V._themeDesignGradient = grad
		local style = tostring(themeData.DesignStyle or themeData.AnimationStyle or themeName or "soft"):lower()
		local accent = Library.Theme.Accent or Color3.fromRGB(115, 185, 255)
		local bg = Library.Theme.Background or Color3.fromRGB(8, 8, 12)
		local hover = Library.Theme.SurfaceHover or Library.Theme.Surface or bg
		local text = Library.Theme.TextPrimary or Color3.fromRGB(240, 245, 255)
		local function _designTransparency(fallback)
			local pack = type(themeData.Transparency) == "table" and themeData.Transparency or nil
			local value = type(pack) == "table" and (pack.Overlay or pack.Default) or nil
			return math.clamp(tonumber(value) or tonumber(fallback) or 0.90, 0, 0.95)
		end
		layer.Visible = true
		layer.BackgroundColor3 = bg:Lerp(accent, (style == "neon" or style == "hologram") and 0.18 or 0.08)
		layer.BackgroundTransparency = 0.86
		if not grad then return true end
		grad.Rotation = 35
		grad.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.32),
			NumberSequenceKeypoint.new(0.52, 0.82),
			NumberSequenceKeypoint.new(1, 0.38),
		})
		if style == "glass-clear" or style == "clear" or style == "phantom" then
			grad.Rotation = 65
			layer.BackgroundTransparency = _designTransparency(0.90)
			grad.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, text:Lerp(accent, 0.18)),
				ColorSequenceKeypoint.new(0.48, bg:Lerp(accent, 0.08)),
				ColorSequenceKeypoint.new(1, accent:Lerp(Color3.fromRGB(255,255,255), 0.25)),
			})
		elseif style == "liquid" or style == "rain-glass" then
			grad.Rotation = 110
			layer.BackgroundTransparency = _designTransparency(0.90)
			grad.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(70, 210, 255):Lerp(accent, 0.25)),
				ColorSequenceKeypoint.new(0.56, bg:Lerp(hover, 0.28)),
				ColorSequenceKeypoint.new(1, accent:Lerp(bg, 0.35)),
			})
		elseif style == "prism" or style == "crystal-clear" then
			grad.Rotation = 28
			layer.BackgroundTransparency = _designTransparency(0.89)
			grad.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 95, 220):Lerp(accent, 0.22)),
				ColorSequenceKeypoint.new(0.45, Color3.fromRGB(90, 210, 255):Lerp(bg, 0.42)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(160, 120, 255):Lerp(accent, 0.25)),
			})
		elseif style == "smoke" or style == "cyberglass" or style == "firefly" then
			grad.Rotation = style == "cyberglass" and 0 or 78
			layer.BackgroundTransparency = _designTransparency(0.88)
			grad.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, bg:Lerp(accent, 0.18)),
				ColorSequenceKeypoint.new(0.52, hover:Lerp(bg, 0.44)),
				ColorSequenceKeypoint.new(1, text:Lerp(accent, 0.16)),
			})
		elseif style == "hologram" or style == "neon" or style == "split" then
			grad.Rotation = 18
			grad.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, accent),
				ColorSequenceKeypoint.new(0.48, bg),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 85, 210):Lerp(accent, 0.25)),
			})
		elseif style == "crystal" or style == "chrome" or style == "royal" or style == "copper" then
			grad.Rotation = 72
			layer.BackgroundTransparency = 0.84
			grad.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, text:Lerp(accent, 0.30)),
				ColorSequenceKeypoint.new(0.38, bg:Lerp(Color3.fromRGB(255,255,255), style == "chrome" and 0.08 or 0.02)),
				ColorSequenceKeypoint.new(1, accent:Lerp(bg, 0.22)),
			})
		elseif style == "grid" or style == "pixel" or style == "candy" then
			grad.Rotation = 0
			grad.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, accent:Lerp(bg, 0.20)),
				ColorSequenceKeypoint.new(0.50, hover:Lerp(bg, 0.18)),
				ColorSequenceKeypoint.new(1, bg:Lerp(accent, 0.18)),
			})
		elseif style == "abyss" or style == "jade" or style == "redline" or style == "blueflame" then
			grad.Rotation = style == "redline" and 12 or 115
			layer.BackgroundTransparency = 0.85
			grad.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, bg:Lerp(Color3.fromRGB(0,0,0), 0.25)),
				ColorSequenceKeypoint.new(0.46, accent:Lerp(bg, 0.34)),
				ColorSequenceKeypoint.new(1, hover:Lerp(accent, 0.26)),
			})
		elseif style == "frost" or style == "snow" or style == "moon" then
			grad.Rotation = 80
			grad.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, text:Lerp(accent, 0.22)),
				ColorSequenceKeypoint.new(0.55, bg),
				ColorSequenceKeypoint.new(1, accent:Lerp(Color3.fromRGB(255,255,255), 0.35)),
			})
		elseif style == "terminal" or style == "matrix" or style == "glass" then
			grad.Rotation = 0
			grad.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, bg),
				ColorSequenceKeypoint.new(0.45, hover:Lerp(accent, 0.20)),
				ColorSequenceKeypoint.new(1, accent:Lerp(bg, 0.45)),
			})
		elseif style == "storm" or style == "vortex" then
			grad.Rotation = style == "vortex" and 135 or 62
			grad.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, bg:Lerp(Color3.fromRGB(0,0,0), 0.20)),
				ColorSequenceKeypoint.new(0.50, accent:Lerp(bg, 0.35)),
				ColorSequenceKeypoint.new(1, hover:Lerp(accent, 0.18)),
			})
		elseif style == "sunset" or style == "luxury" then
			grad.Rotation = 25
			grad.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 170, 75):Lerp(accent, 0.28)),
				ColorSequenceKeypoint.new(0.54, bg),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 220, 120):Lerp(accent, 0.18)),
			})
		elseif style == "vampire" or style == "shadow" then
			grad.Rotation = 120
			grad.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, bg:Lerp(Color3.fromRGB(0,0,0), 0.35)),
				ColorSequenceKeypoint.new(0.48, accent:Lerp(bg, 0.46)),
				ColorSequenceKeypoint.new(1, bg),
			})
		else
			grad.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, hover:Lerp(accent, 0.15)),
				ColorSequenceKeypoint.new(0.55, bg),
				ColorSequenceKeypoint.new(1, accent:Lerp(bg, 0.62)),
			})
		end
		return true
	end


	-- Predeclare minimized BEFORE scale helpers. In Lua, locals declared later are not captured,
	-- so the old helper accidentally checked a global `minimized` instead of the real one.
	V.minimized = false

	-- Scale helper: winW/winH stay as the BASE logical size, currentScale is applied only when rendering.
	-- This fixes configs where scale saved correctly but the actual window reopened at the unscaled size.
	local function getScaledWindowSize(heightOverride)
		WIN_MAX_W, WIN_MAX_H = getViewportLimit()
		local scale = math.clamp(tonumber(currentScale) or 100, 50, 200) / 100
		local scaledW = math.clamp(math.floor((tonumber(winW) or 820) * scale + 0.5), WIN_MIN_W, WIN_MAX_W)
		if heightOverride then
			-- Titlebar/minimized height must NOT be multiplied by UI scale.
			return scaledW, tonumber(heightOverride) or 34
		end
		local scaledH = math.clamp(math.floor((tonumber(winH) or 580) * scale + 0.5), WIN_MIN_H, WIN_MAX_H)
		return scaledW, scaledH
	end

	local function applyWindowScale(animated, heightOverride)
		local sw, sh = getScaledWindowSize(heightOverride)
		local target = { Size = UDim2.new(0, sw, 0, sh) }
		if animated then
			tw(MainWrap, target, TI_SLOW)
		else
			MainWrap.Size = target.Size
		end
		-- 5.8: no drag borders. Scale changes keep the current position exactly as-is.
		-- If a script explicitly enables dragBounds=true, old clamping can be added by user code.
		return sw, sh
	end

	local _responsiveScaleEnabled = options.responsiveScale ~= false
	local _lockWindowPosition = options.lockWindowPosition ~= false
	local _resizeSnapEnabled = (not _lockWindowPosition) and options.resizeSnap == true
	local _resizeSnapMode = tostring(options.resizeSnapMode or "center"):lower()
	local _lastViewportSize = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1280, 720)

	local function _snapMainToViewport(sw, sh)
		local cam = workspace.CurrentCamera
		local vps = cam and cam.ViewportSize or Vector2.new(1280, 720)
		if _resizeSnapMode == "corner" or _resizeSnapMode == "top-left" or _resizeSnapMode == "topleft" then
			MainWrap.Position = UDim2.new(0, math.floor(sw / 2 + 14), 0, math.floor(sh / 2 + 14))
		else
			MainWrap.Position = UDim2.new(0, math.floor(vps.X / 2), 0, math.floor(vps.Y / 2))
		end
	end

	local function _snapSmallUIsToViewport()
		-- Window resize recovery: no drag borders during normal use, but resize keeps UI visible.
		if V.wmFrame and V.wmFrame.Parent then
			V.wmFrame.AnchorPoint = Vector2.new(1, 0)
			V.wmFrame.Position = UDim2.new(1, V.WM_DEFAULT_X, 0, V.WM_DEFAULT_Y)
		end
		if V.minimizeBubble and V.minimizeBubble.Parent then
			V.minimizeBubble.Position = UDim2.new(0, 18, 0, 78)
		end
	end

	local function _applyResponsiveScale(forceSnap)
		if not _responsiveScaleEnabled or _destroyed or not MainWrap or not MainWrap.Parent then return end
		local preserved = (_runtimeRoot.windowPosition and typeof(_runtimeRoot.windowPosition) == "UDim2")
			and _runtimeRoot.windowPosition or MainWrap.Position

		WIN_MAX_W, WIN_MAX_H = getViewportLimit()
		applyWindowScale(false, V.minimized and 34 or nil)

		local cam = workspace.CurrentCamera
		local vps = cam and cam.ViewportSize or Vector2.new(1280, 720)
		local viewportChanged = (math.abs(vps.X - _lastViewportSize.X) > 1 or math.abs(vps.Y - _lastViewportSize.Y) > 1)
		_lastViewportSize = vps

		if _lockWindowPosition then
			MainWrap.Position = preserved
			_runtimeRoot.windowPosition = preserved
		elseif _resizeSnapEnabled and (forceSnap == true or viewportChanged) then
			_snapMainToViewport(select(1, getScaledWindowSize()), select(2, getScaledWindowSize()))
			_snapSmallUIsToViewport()
		else
			_runtimeRoot.windowPosition = MainWrap.Position
		end
	end
	task.defer(function() _applyResponsiveScale(false) end)
	pcall(function()
		track(workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
			_applyResponsiveScale(false)
			pcall(function() GUI:MarkConfigDirty() end)
		end))
	end)

	-- Inner border: child of Main, fills 100%, transparent bg, UIStroke clips with Main's corners
	local _borderFrame=Instance.new("Frame",Main)
	_borderFrame.Name="MainBorder"; _borderFrame.BorderSizePixel=0
	_borderFrame.BackgroundTransparency=1
	_borderFrame.Size=UDim2.new(1,0,1,0); _borderFrame.Position=UDim2.new(0,0,0,0)
	_borderFrame.ZIndex=9; _borderFrame.Active=false
	corner(_borderFrame,8)
	local _mainStroke=Instance.new("UIStroke",_borderFrame)
	_mainStroke.Color=Library.Theme.Border; _mainStroke.Thickness=1
	_mainStroke.ApplyStrokeMode=Enum.ApplyStrokeMode.Border
	local _borderOverlay=_borderFrame -- alias so refs below still compile

	local _doTypewriter = false  -- set true once titleLabel exists

	local function showMainWindow()
		MainWrap.Visible=true
		local sw, sh = getScaledWindowSize()
		tw(MainWrap,{Size=UDim2.new(0,sw,0,sh)},TI_SLOW, function()
			-- After open tween, convert scale position to pixel offset
			-- AbsolutePosition with AnchorPoint(0.5,0.5) gives top-left corner
			-- The center point = top-left + half size
			local saved = _runtimeRoot.windowPosition
			if saved and typeof(saved) == "UDim2" then
				MainWrap.Position = saved
			end
			_runtimeRoot.windowPosition = MainWrap.Position
		end)
		_doTypewriter = true
	end

	local function runKeyGate(onPass)
		if not (options.keyEnabled and options.key) then onPass(); return end
		local validKeys = type(options.key)=="table" and options.key or {options.key}

		local chatWasEnabled = true
		pcall(function()
			chatWasEnabled = game:GetService("StarterGui"):GetCoreGuiEnabled(Enum.CoreGuiType.Chat)
			game:GetService("StarterGui"):SetCoreGuiEnabled(Enum.CoreGuiType.Chat, false)
		end)
		local function restoreChat()
			pcall(function()
				game:GetService("StarterGui"):SetCoreGuiEnabled(Enum.CoreGuiType.Chat, chatWasEnabled)
			end)
		end

		local KeyFrame=Instance.new("ImageButton",SG)
		KeyFrame.Name="KeyGate"; KeyFrame.Size=UDim2.fromScale(1,1)
		KeyFrame.BackgroundColor3=Color3.fromRGB(8,8,8)
		KeyFrame.BackgroundTransparency=1; KeyFrame.ZIndex=200
		KeyFrame.Image=""; KeyFrame.AutoButtonColor=false
		tw(KeyFrame,{BackgroundTransparency=0.15},TweenInfo.new(0.3))

		local hasLink   = options.keyLink and options.keyLink ~= ""
		local panelH    = hasLink and 260 or 220
		local kPanel=Instance.new("Frame",KeyFrame)
		kPanel.Size=UDim2.new(0,320,0,math.max(panelH-20, 200)); kPanel.AnchorPoint=Vector2.new(0.5,0.5)
		kPanel.Position=UDim2.fromScale(0.5,0.5)
		kPanel.BackgroundColor3=Color3.fromRGB(14,14,14)
		kPanel.BorderSizePixel=0; kPanel.ZIndex=201
		corner(kPanel,8); stroke(kPanel,Library.Theme.Border)
		tw(kPanel,{Size=UDim2.new(0,340,0,panelH)},TI_SLOW)

		local kAccentBar=Instance.new("Frame",kPanel)
		kAccentBar.Size=UDim2.new(1,0,0,3); kAccentBar.BackgroundColor3=Library.Theme.Accent; regAccent(kAccentBar)
		kAccentBar.BorderSizePixel=0; kAccentBar.ZIndex=202; corner(kAccentBar,3)

		local kTitle=Instance.new("TextLabel",kPanel)
		kTitle.BackgroundTransparency=1; kTitle.ZIndex=202
		kTitle.Size=UDim2.new(1,-24,0,28); kTitle.Position=UDim2.new(0,12,0,14)
		kTitle.Text=options.name; kTitle.TextXAlignment=Enum.TextXAlignment.Center
		kTitle.TextSize=16; kTitle.TextColor3=Color3.fromRGB(220,220,220)
		kTitle.FontFace=Font.new("rbxasset://fonts/families/RobotoMono.json",Enum.FontWeight.Bold)

		local kSub=Instance.new("TextLabel",kPanel)
		kSub.BackgroundTransparency=1; kSub.ZIndex=202
		kSub.Size=UDim2.new(1,-24,0,18); kSub.Position=UDim2.new(0,12,0,44)
		kSub.Text="Click the box below, then type your key"
		kSub.TextXAlignment=Enum.TextXAlignment.Center
		kSub.TextSize=11; kSub.TextColor3=Color3.fromRGB(100,100,100)
		kSub.FontFace=Font.new("rbxasset://fonts/families/Ubuntu.json")

		local kInputBg=Instance.new("Frame",kPanel)
		kInputBg.Size=UDim2.new(1,-32,0,36); kInputBg.Position=UDim2.new(0,16,0,72)
		kInputBg.BackgroundColor3=Color3.fromRGB(22,22,22)
		kInputBg.BorderSizePixel=0; kInputBg.ZIndex=202
		corner(kInputBg,6); stroke(kInputBg,Library.Theme.Border)

		local kInput=Instance.new("TextBox",kInputBg)
		kInput.Size=UDim2.new(1,-16,1,0); kInput.Position=UDim2.new(0,8,0,0)
		kInput.BackgroundTransparency=1; kInput.BorderSizePixel=0; kInput.ZIndex=203
		kInput.PlaceholderText="Click here and type your key..."
		kInput.PlaceholderColor3=Color3.fromRGB(60,60,60)
		kInput.Text=""; kInput.TextColor3=Color3.fromRGB(210,210,210)
		kInput.TextSize=13; kInput.ClearTextOnFocus=false
		kInput.FontFace=Font.new("rbxasset://fonts/families/RobotoMono.json")
		kInput.TextXAlignment=Enum.TextXAlignment.Left
		task.defer(function() pcall(function() kInput:ReleaseFocus() end) end)
		kInput.Focused:Connect(function()
			tw(kInputBg,{BackgroundColor3=Color3.fromRGB(28,28,28)})
			safeTween(kInputBg:FindFirstChildOfClass("UIStroke"),{Color=Library.Theme.Accent})
		end)
		kInput.FocusLost:Connect(function()
			tw(kInputBg,{BackgroundColor3=Color3.fromRGB(22,22,22)})
			safeTween(kInputBg:FindFirstChildOfClass("UIStroke"),{Color=Library.Theme.Border})
		end)

		local kStatus=Instance.new("TextLabel",kPanel)
		kStatus.BackgroundTransparency=1; kStatus.ZIndex=202
		kStatus.Size=UDim2.new(1,-32,0,16); kStatus.Position=UDim2.new(0,16,0,114)
		kStatus.Text=""; kStatus.TextXAlignment=Enum.TextXAlignment.Center
		kStatus.TextSize=11; kStatus.TextColor3=Color3.fromRGB(200,80,80)
		kStatus.FontFace=Font.new("rbxasset://fonts/families/Ubuntu.json")

		local kBtn=Instance.new("TextButton",kPanel)
		kBtn.Size=UDim2.new(1,-32,0,34); kBtn.Position=UDim2.new(0,16,0,hasLink and 167 or 136)
		kBtn.BackgroundColor3=Library.Theme.Accent; kBtn.BorderSizePixel=0
		kBtn.TextColor3=Color3.fromRGB(255,255,255); kBtn.TextSize=13
		kBtn.Text="Confirm Key"; kBtn.ZIndex=202; corner(kBtn,6)
		kBtn.FontFace=Font.new("rbxasset://fonts/families/Ubuntu.json",Enum.FontWeight.Bold)
		kBtn.MouseEnter:Connect(function() tw(kBtn,{BackgroundColor3=Color3.fromRGB(
			math.clamp(Library.Theme.Accent.R*255+22,0,255),
			math.clamp(Library.Theme.Accent.G*255+22,0,255),
			math.clamp(Library.Theme.Accent.B*255+22,0,255))},TI_FAST) end)
		kBtn.MouseLeave:Connect(function() tw(kBtn,{BackgroundColor3=Library.Theme.Accent},TI_FAST) end)

		local kAttempts=Instance.new("TextLabel",kPanel)
		kAttempts.BackgroundTransparency=1; kAttempts.ZIndex=202
		kAttempts.Size=UDim2.new(1,-32,0,14); kAttempts.Position=UDim2.new(0,16,0,hasLink and 208 or 177)
		kAttempts.Text="3 attempts remaining"; kAttempts.TextXAlignment=Enum.TextXAlignment.Center
		kAttempts.TextSize=10; kAttempts.TextColor3=Color3.fromRGB(55,55,55)
		kAttempts.FontFace=Font.new("rbxasset://fonts/families/Ubuntu.json")

		-- "Get Key" link button — only shown if keyLink is provided
		if hasLink then
			local kLinkBtn = Instance.new("TextButton", kPanel)
			kLinkBtn.Size              = UDim2.new(1,-32,0,30)
			kLinkBtn.Position          = UDim2.new(0,16,0,panelH-46)
			kLinkBtn.BackgroundColor3  = Color3.fromRGB(22,22,30)
			kLinkBtn.BorderSizePixel   = 0
			kLinkBtn.TextColor3        = Library.Theme.Accent
			kLinkBtn.TextSize          = 12
			kLinkBtn.Text              = "🔑  Get Key"
			kLinkBtn.ZIndex            = 202
			kLinkBtn.AutoButtonColor   = false
			kLinkBtn.FontFace          = Font.new("rbxasset://fonts/families/Ubuntu.json", Enum.FontWeight.Bold)
			corner(kLinkBtn, 6)
			local kLinkStroke = stroke(kLinkBtn, Library.Theme.Accent, 1)
			regAccent(kLinkStroke)
			kLinkBtn.MouseEnter:Connect(function()
				tw(kLinkBtn, {BackgroundColor3 = Color3.fromRGB(28,28,40)})
			end)
			kLinkBtn.MouseLeave:Connect(function()
				tw(kLinkBtn, {BackgroundColor3 = Color3.fromRGB(22,22,30)})
			end)
			kLinkBtn.MouseButton1Click:Connect(function()
				pcall(function()
					game:GetService("GuiService"):OpenBrowserWindow(options.keyLink)
				end)
			end)
		end

		local _keyDone = false
		local attempts = 3

		local function submitKey()
			if _keyDone then return end
			local entered = (kInput.Text or ""):gsub("^%s+",""):gsub("%s+$","")
			local valid = false
			for _,k in ipairs(validKeys) do if entered==k then valid=true; break end end

			if valid then
				_keyDone=true
				pcall(function() kInput:ReleaseFocus() end)
				kStatus.TextColor3=Color3.fromRGB(60,200,90); kStatus.Text="✓  Key accepted!"
				kBtn.Active=false
				if options.onKeySuccess then pcall(options.onKeySuccess) end
				task.spawn(function()
					task.wait(0.55)
					for _,d in ipairs(KeyFrame:GetDescendants()) do
						pcall(function() tw(d,{TextTransparency=1,ImageTransparency=1},TweenInfo.new(0.3)) end)
					end
					tw(KeyFrame,{BackgroundTransparency=1},TweenInfo.new(0.35),function()
						restoreChat()
						pcall(function() KeyFrame:Destroy() end)
						onPass()
					end)
				end)
			else
				attempts=attempts-1
				kInput.Text=""
				if attempts<=0 then
					_keyDone=true
					pcall(function() kInput:ReleaseFocus() end)
					kStatus.TextColor3=Color3.fromRGB(200,60,60); kStatus.Text="✗  Too many failed attempts."
					kBtn.Active=false; kAttempts.Text="Script locked."
					if options.onKeyFail then pcall(options.onKeyFail) end
					restoreChat()
					task.delay(2.5,function() pcall(function() SG:Destroy() end) end)
				else
					kStatus.TextColor3=Color3.fromRGB(200,60,60); kStatus.Text="✗  Wrong key — try again."
					kAttempts.Text=attempts.." attempt"..(attempts==1 and "" or "s").." remaining"
					tw(kInputBg,{BackgroundColor3=Color3.fromRGB(42,16,16)},TI_FAST)
					task.delay(0.4,function()
						if not _keyDone then tw(kInputBg,{BackgroundColor3=Color3.fromRGB(22,22,22)},TI_FAST) end
					end)
				end
			end
		end

		kBtn.MouseButton1Click:Connect(submitKey)
		kInput.FocusLost:Connect(function(enter) if enter then submitKey() end end)
	end

task.spawn(function()
	local minLoadTime = math.max(0, tonumber(options.loadingTime) or 0)
	local startClock = os.clock()
	while os.clock() - startClock < minLoadTime do
		task.wait(0.03)
	end
	-- v5.81: do not hide the loader until deferred/heavy tabs have actually finished building.
	-- This prevents the window from opening first and then visibly adding Themes/Settings afterward.
	local safeLoadWaitStart = os.clock()
	while _safeLoadState.enabled and _safeLoadState.uiReady ~= true and not _destroyed do
		if os.clock() - safeLoadWaitStart > 15 then
			_safeLoadSetLabel("Safe load timed out — opening anyway...")
			break
		end
		_safeLoadSetLabel(_safeLoadState.lastLabel ~= "" and _safeLoadState.lastLabel or "Finishing safe load...")
		task.wait(math.max(0.015, math.min(_safeLoadState.delay or 0.025, 0.08)))
	end
	_safeLoadSetLabel(_safeLoadState.enabled and "Opening window..." or "Ready.")
	_subLoop = false
	if Loader and Loader.Parent then
		for _,d in ipairs(Loader:GetDescendants()) do
			pcall(function() tw(d,{TextTransparency=1,ImageTransparency=1,BackgroundTransparency=1},TweenInfo.new(0.25)) end)
		end
		tw(Loader,{BackgroundTransparency=1},TweenInfo.new(0.25),function()
			pcall(function() Loader:Destroy() end)
			runKeyGate(showMainWindow)
		end)
	else
		runKeyGate(showMainWindow)
	end
end)

	local Topbar=Instance.new("Frame",Main)
	Topbar.Name="Topbar"; Topbar.BorderSizePixel=0
	Topbar.BackgroundColor3=Library.Theme.Topbar
	Topbar.Size=UDim2.new(1,0,0,34); corner(Topbar,8)

	-- topExt removed: Main's UICorner handles corner squaring cleanly

	local accentLine=Instance.new("Frame",Topbar)
	accentLine.Name="TopbarAccentLine"
	accentLine.BackgroundColor3=Library.Theme.Accent; regAccent(accentLine); accentLine.BorderSizePixel=0
	accentLine.AnchorPoint=Vector2.new(0,1); accentLine.Size=UDim2.new(1,0,0,1)
	accentLine.Position=UDim2.new(0,0,1,0); accentLine.BackgroundTransparency=0.45

	local _titleText = tostring(options.name or "")
	local titleLabel=lbl(Topbar,_titleText,13,Library.Theme.TextPrimary,
		Font.new("rbxasset://fonts/families/RobotoMono.json",Enum.FontWeight.SemiBold))
	titleLabel.Size=UDim2.new(1,-90,1,0); pad(titleLabel,0,0,0,38)

	-- Typewriter loop: type forward then delete back, on repeat
	task.spawn(function()
		repeat task.wait(0.05) until _doTypewriter
		local full = _titleText
		task.wait(0.2)
		while not _destroyed do
			full = _titleText
			-- Type forward
			for i = 1, #full do
				if _destroyed then return end
				titleLabel.Text = string.sub(full, 1, i)
				task.wait(0.075)
			end
			task.wait(1.4) -- pause at full text
			-- Delete backward
			for i = #full - 1, 0, -1 do
				if _destroyed then return end
				titleLabel.Text = string.sub(full, 1, i)
				task.wait(0.045)
			end
			task.wait(0.35) -- pause before retyping
		end
	end)

	local function makeTopBtn(img,xOff)
		-- Larger invisible hit frame so clicks register reliably on compact controls
		local hit=Instance.new("TextButton",Topbar)
		hit.BackgroundTransparency=1; hit.BorderSizePixel=0
		hit.AnchorPoint=Vector2.new(1,0.5)
		hit.Size=UDim2.new(0,26,0,26)
		hit.Position=UDim2.new(1,xOff+6,0.5,0)
		hit.Text=""; hit.ZIndex=5; hit.AutoButtonColor=false

		local b=Instance.new("ImageLabel",hit)
		b.BackgroundTransparency=1; b.BorderSizePixel=0
		b.AnchorPoint=Vector2.new(0.5,0.5)
		b.Image=img; b.ImageColor3=Library.Theme.TextSecondary
		b.Size=UDim2.new(0,14,0,14); b.Position=UDim2.fromScale(0.5,0.5)
		b.ZIndex=6

		hit.MouseEnter:Connect(function() tw(b,{ImageColor3=Library.Theme.TextPrimary}) end)
		hit.MouseLeave:Connect(function() tw(b,{ImageColor3=Library.Theme.TextSecondary}) end)
		return hit
	end
	local exitBtn = makeTopBtn("rbxassetid://11419709766",-8)
	-- 5.34: the old topbar minimize button was removed. RightControl/toggle now owns the bubble.

