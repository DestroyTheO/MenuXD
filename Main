-- ══════════════════════════════════════════════════════════════════════
-- RUNTIME GUARD
-- ══════════════════════════════════════════════════════════════════════
-- Prevents old RenderStepped/input connections from staying alive when the
-- library is re-executed. This fixes duplicate animations, old tooltip loops,
-- stale resize listeners, and "ghost" UI behavior after reruns.
local _runtimeRoot do
	local ok, env = pcall(function()
		return (type(getgenv) == "function" and getgenv()) or shared or _G
	end)
	env = ok and env or _G
	env.__VenturaUIRuntime = env.__VenturaUIRuntime or { connections = {}, instances = {}, shutdowns = {} }
	env.__VenturaUIRuntime.connections = env.__VenturaUIRuntime.connections or {}
	env.__VenturaUIRuntime.instances = env.__VenturaUIRuntime.instances or {}
	env.__VenturaUIRuntime.shutdowns = env.__VenturaUIRuntime.shutdowns or {}
	env.__VenturaUIRuntime.activeWindow = env.__VenturaUIRuntime.activeWindow or nil
	env.__VenturaUIRuntime.activeScreenGui = env.__VenturaUIRuntime.activeScreenGui or nil
	env.__VenturaUIRuntime.activeCharacter = env.__VenturaUIRuntime.activeCharacter or nil
	env.__VenturaUIRuntime.respawnGuardUntil = tonumber(env.__VenturaUIRuntime.respawnGuardUntil) or 0
	env.__VenturaUIRuntime.respawnReuseCredits = math.max(0, math.floor(tonumber(env.__VenturaUIRuntime.respawnReuseCredits) or 0))
	env.__VenturaUIRuntime.respawnCharacter = env.__VenturaUIRuntime.respawnCharacter or nil
	env.__VenturaUIRuntime.lastBuilderAction = tostring(env.__VenturaUIRuntime.lastBuilderAction or "none")
	_runtimeRoot = env.__VenturaUIRuntime
end

-- Returns a chain-safe object used only when a StarterCharacterScript reruns the
-- builder after respawn. The original GUI and callbacks remain active, while the
-- duplicate builder pass is harmlessly absorbed instead of adding a second UI.
local function _makeRespawnBuilderSink(existingWindow)
	local sink = {}
	local function passthrough(_, ...) return sink end
	setmetatable(sink, {
		__index = function(_, key)
			if key == "_existingWindow" then return existingWindow end
			if key == "IsRespawnDuplicate" then return function() return true end end
			if key == "GetExistingWindow" then return function() return existingWindow end end
			if key == "Get" then return function(_, fallback) return fallback end end
			if key == "IsOpen" or key == "IsVisible" then return function() return false end end
			return passthrough
		end,
		__newindex = function() end,
	})
	return sink
end

local function _runtimeDisconnectAll()
	-- v5.37 hotfix: tell the previous window to stop gameplay/effect callbacks before destroying old UI.
	-- Kept intentionally conservative so a bad old callback cannot prevent the new UI from loading.
	for i = #(_runtimeRoot.shutdowns or {}), 1, -1 do
		local shutdown = _runtimeRoot.shutdowns[i]
		pcall(function()
			if type(shutdown) == "function" then shutdown("runtime-reexecute") end
		end)
		_runtimeRoot.shutdowns[i] = nil
	end
	for i = #(_runtimeRoot.connections or {}), 1, -1 do
		local conn = _runtimeRoot.connections[i]
		pcall(function()
			if conn and type(conn.Disconnect) == "function" then conn:Disconnect() end
		end)
		_runtimeRoot.connections[i] = nil
	end
	for i = #(_runtimeRoot.instances or {}), 1, -1 do
		local inst = _runtimeRoot.instances[i]
		pcall(function()
			if inst and inst.Destroy and inst.Parent then inst:Destroy() end
		end)
		_runtimeRoot.instances[i] = nil
	end
end

local function _runtimeTrackConnection(conn)
	if conn and type(conn.Disconnect) == "function" then
		table.insert(_runtimeRoot.connections, conn)
	end
	return conn
end

local function _runtimeTrackInstance(inst)
	if inst and inst.Destroy then
		table.insert(_runtimeRoot.instances, inst)
	end
	return inst
end

local function _runtimeTrackShutdown(fn)
	if type(fn) == "function" then
		table.insert(_runtimeRoot.shutdowns, fn)
	end
	return fn
end

local function _runtimeUntrackShutdown(fn)
	local list = _runtimeRoot.shutdowns or {}
	for i = #list, 1, -1 do
		if list[i] == fn or list[i] == nil then
			table.remove(list, i)
		end
	end
end

local function _safeEnumKey(key, fallback)
	if typeof(key) == "EnumItem" and key.EnumType == Enum.KeyCode and key ~= Enum.KeyCode.Unknown then
		return key
	end
	if type(key) == "string" then
		local ok, enumKey = pcall(function() return Enum.KeyCode[key] end)
		if ok and typeof(enumKey) == "EnumItem" and enumKey.EnumType == Enum.KeyCode and enumKey ~= Enum.KeyCode.Unknown then
			return enumKey
		end
	end
	return fallback
end

local function _safeCall(label, fn, ...)
	if type(fn) ~= "function" then return false end
	local ok, err = pcall(fn, ...)
	if not ok then
		warn("[VenturaUI] " .. tostring(label or "callback") .. " failed: " .. tostring(err))
	end
	return ok
end


