function Library:GetVersion()
	return Library.Version
end

function Library:CreateWindow(options)
	return Library:new(options)
end

function Library:New(options)
	return Library:new(options)
end

function Library:MakeWindow(options)
	return Library:new(options)
end

function Library:IsFileAPISupported()
	return hasFileAPI()
end

function Library:GetThemeNames()
	local out = {}
	for name in pairs(Library.Themes or {}) do table.insert(out, name) end
	table.sort(out, function(a, b) return tostring(a):lower() < tostring(b):lower() end)
	return out
end

function Library:GetAccentNames()
	local out = {}
	for name, color in pairs(Library.Accents or {}) do
		if typeof(color) == "Color3" then table.insert(out, name) end
	end
	table.sort(out, function(a, b) return tostring(a):lower() < tostring(b):lower() end)
	return out
end

function Library:GetAccentColor(name, fallback)
	local color = Library.Accents and Library.Accents[tostring(name or "")]
	if typeof(color) == "Color3" then return color end
	return fallback or Library.Theme.Accent
end

function Library:GetThemesByStyle(style)
	style = tostring(style or ""):lower()
	local out = {}
	for name, data in pairs(Library.Themes or {}) do
		local ds = type(data) == "table" and tostring(data.DesignStyle or data.AnimationStyle or ""):lower() or ""
		if style == "" or ds == style then table.insert(out, name) end
	end
	table.sort(out, function(a, b) return tostring(a):lower() < tostring(b):lower() end)
	return out
end

function Library:GetThemeCategories()
	local out, seen = {"All"}, {All = true}
	for _, data in pairs(Library.Themes or {}) do
		if type(data) == "table" then
			local category = tostring(data.Category or data.DesignStyle or data.AnimationStyle or "Other")
			category = category:sub(1,1):upper() .. category:sub(2)
			if category ~= "" and not seen[category] then seen[category] = true; table.insert(out, category) end
		end
	end
	table.sort(out, function(a, b) if a == "All" then return true elseif b == "All" then return false end return a:lower() < b:lower() end)
	return out
end

function Library:GetThemesByCategory(category)
	category = tostring(category or "All")
	if category == "" or category:lower() == "all" then return Library:GetThemeNames() end
	local out = {}
	for name, data in pairs(Library.Themes or {}) do
		local c = type(data) == "table" and tostring(data.Category or data.DesignStyle or data.AnimationStyle or "Other") or "Other"
		if c:lower() == category:lower() then table.insert(out, name) end
	end
	table.sort(out)
	return out
end

function Library:RegisterThemePack(pack)
	if type(pack) ~= "table" then return false end
	local name = tostring(pack.name or pack.Name or ""):match("^%s*(.-)%s*$")
	if name == "" then return false end
	local colors = type(pack.colors) == "table" and pack.colors or pack
	local effects = type(pack.effects) == "table" and pack.effects or {}
	local theme = {}
	for k, v in pairs(colors) do theme[k] = v end
	theme.Category = pack.category or pack.Category or pack.style or pack.Style or theme.Category or "Custom"
	theme.DesignStyle = effects.design or effects.style or theme.DesignStyle or theme.Category
	theme.AnimationStyle = effects.animation or theme.AnimationStyle or "nova"
	theme.Stars = effects.particles ~= false
	theme.Animated = effects.animation ~= false
	theme.SmartContrast = pack.smartContrast ~= false
	if effects.glass ~= nil then
		local g = math.clamp(tonumber(effects.glass) or 0.18, 0, 0.85)
		theme.Transparency = {Main=math.clamp(g - 0.12,0,0.85), Background=g, Surface=math.clamp(g + 0.04,0,0.90), Nav=g, Topbar=g, UserBox=g, Overlay=0.90}
	end
	Library.Themes[name] = theme
	return true
end


function Library:GetTransparentThemeNames()
	local out = {}
	for name, data in pairs(Library.Themes or {}) do
		if type(data) == "table" and type(data.Transparency) == "table" then table.insert(out, name) end
	end
	table.sort(out, function(a, b) return tostring(a):lower() < tostring(b):lower() end)
	return out
end
Library.GetGlassThemeNames = Library.GetTransparentThemeNames

function Library:GetAnimationStyles()
	local out, seen = {}, {}
	local defaults = {"nova","galaxy","aurora","void","embers","toxic","ocean","sakura","luxury","matrix","neon","snow","storm","vortex","mist","bubbles","comets","fireflies","scanlines","prism","liquid","smoke","rain","meteor","orbit","pulsegrid","quantum","nebulaflow","wave","stardust","eclipse","firestorm","laser","waterfall","confetti","hyperspeed","blackhole","lightning","datastream","shards","solarwind","circuit","dreamcloud","heartbeat","gravwell","ripple","rainbow","forge","icecomet","lavalamp","shadowmist","neonpulse","galaxyring","electricgrid","matrixbloom","bloodcircuit","aurorafrost","eclipsepulse","toxicpulse","chromewave","hazerain","diamonds","tidalpulse","starfall","royalflow","portal","constellation","magnetic","plasmafield","snowburst","neonrain","sunburst","liquidgrid","nebularipple","starspiral","matrixflare","glassrain","cosmicdust","electricpulse","aurorawave","pixelstorm","crystalorbit","darkmatter","goldenembers","neoncomets"}
	for _, style in ipairs(defaults) do
		if not seen[style] then seen[style] = true; table.insert(out, style) end
	end
	for _, data in pairs(Library.Themes or {}) do
		if type(data) == "table" then
			local style = tostring(data.AnimationStyle or "")
			if style ~= "" and not seen[style] then seen[style] = true; table.insert(out, style) end
		end
	end
	table.sort(out, function(a, b) return tostring(a):lower() < tostring(b):lower() end)
	return out
end

function Library:SelfTest()
	local stabilityFeatures = {"owned-cleanup","shared-input","callback-diagnostics","control-registry","reactive-values","lazy-builders","config-migrations","performance-mode","normalized-position"}
	local guiParentName = "unknown"
	pcall(function()
		local parent = getScreenGuiParent()
		guiParentName = parent and parent:GetFullName() or "nil"
	end)

	return {
		ok = true,
		version = Library.Version,
		fileAPI = hasFileAPI(),
		mobile = MOBILE == true,
		touch = UIS.TouchEnabled == true,
		keyboard = UIS.KeyboardEnabled == true,
		studio = RunService:IsStudio() == true,
		guiParent = guiParentName,
		runtime = Library:GetRuntimeCounts(),
	}
end

-- Cache the parsed library table for lightweight loaders. A cached loader can
-- avoid downloading and compiling the full source after character-script reruns.
_runtimeRoot.libraryCache = Library
_runtimeRoot.libraryVersion = Library.Version

return Library
