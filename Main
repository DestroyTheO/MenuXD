	function GUI:RegisterTheme(name, themeData, applyNow)
		name = tostring(name or ""):match("^%s*(.-)%s*$")
		if name == "" or type(themeData) ~= "table" then return false end
		local newTheme = {}
		for k, v in pairs(themeData) do newTheme[k] = v end
		Library.Themes[name] = newTheme
		if GUI._themeDropdown and type(GUI._themeDropdown.SetItems) == "function" then
			pcall(function() GUI._themeDropdown:SetItems(GUI:GetThemes()) end)
		end
		if applyNow then return GUI:SetTheme(name) end
		return true
	end

	function GUI:RegisterAccent(name, color, applyNow)
		name = tostring(name or ""):match("^%s*(.-)%s*$")
		if name == "" or typeof(color) ~= "Color3" then return false end
		Library.Accents[name] = color
		if GUI._accentDropdown and type(GUI._accentDropdown.SetItems) == "function" then
			pcall(function() GUI._accentDropdown:SetItems(GUI:GetAccentPresets()) end)
		end
		if applyNow then return GUI:SetAccentPreset(name) end
		return true
	end

	function GUI:ExportConfig(copyToClipboard)
		local raw = GUI:_configPayload()
		if copyToClipboard then pcall(function() setclipboard(raw) end) end
		return raw
	end

	function GUI:ImportConfig(raw, saveAfter)
		if type(raw) ~= "string" or raw == "" then return false end
		local ok, data = pcall(function() return GUI:_decodeConfig(raw) end)
		if not ok or type(data) ~= "table" or not next(data) then return false end
		GUI:ApplyConfig(data)
		if saveAfter then GUI:SaveConfig(true) end
		return true
	end

	function GUI:_c3ToHex(c)
		return string.format("%02X%02X%02X",
			math.floor(c.R*255+0.5), math.floor(c.G*255+0.5), math.floor(c.B*255+0.5))
	end
	function GUI:_hexToC3(h)
		h = (h or ""):gsub("#","")
		if #h < 6 then return Library.Theme.Accent end
		return Color3.fromRGB(
			tonumber(h:sub(1,2),16) or 0,
			tonumber(h:sub(3,4),16) or 0,
			tonumber(h:sub(5,6),16) or 0)
	end
	function GUI:_encodeConfig(t)
		local lines = {}
		for k,v in pairs(t) do
			if type(v) == "string" then
				table.insert(lines, k .. "=" .. v)
			else
				table.insert(lines, k .. "=" .. tostring(v))
			end
		end
		table.sort(lines)
		return table.concat(lines, "\n")
	end
	function GUI:_decodeConfig(s)
		local t = {}
		for line in (s.."\n"):gmatch("([^\n]*)\n") do
			local k, v = line:match("^([^=]+)=(.*)$")
			if k and v then
				k = k:match("^%s*(.-)%s*$"); v = v:match("^%s*(.-)%s*$")
				if v == "true" then t[k] = true
				elseif v == "false" then t[k] = false
				elseif tonumber(v) then t[k] = tonumber(v)
				else t[k] = v end
			end
		end
		return t
	end

	GUI._saveQueued = false
	function GUI:_configPayload()
		local payload = {
			profile   = _cfgEsc(V._cfgProfile),
			accent    = GUI:_c3ToHex(Library.Theme.Accent),
			theme     = GUI._savedTheme or options.theme or "Dark",
			scale     = currentScale,
			winW      = math.floor(winW),
			winH      = math.floor(winH),
			renderW   = math.floor((MainWrap and MainWrap.AbsoluteSize.X > 0) and MainWrap.AbsoluteSize.X or select(1, getScaledWindowSize())),
			renderH   = math.floor((MainWrap and MainWrap.AbsoluteSize.Y > 0) and MainWrap.AbsoluteSize.Y or select(2, getScaledWindowSize())),
			toggleKey = keys.toggle.Name,
			miniVisible = V.floatingMiniAllowed and V.miniVisible == true or false,
			miniX = (V.floatingMiniAllowed and V.miniFrame) and V.miniFrame.Position.X.Offset or 0,
			miniY = (V.floatingMiniAllowed and V.miniFrame) and V.miniFrame.Position.Y.Offset or 0,
			watermarkStatsVisible = V.wmStatsVisible == true,
			watermarkRuntimeVisible = V.wmRuntimeVisible == true,
			watermarkRuntimeLabel = _cfgEsc(V.wmRuntimeLabel or "RAN"),
			watermarkX = V.wmFrame and V.wmFrame.Position.X.Offset or V.WM_DEFAULT_X,
			watermarkY = V.wmFrame and V.wmFrame.Position.Y.Offset or V.WM_DEFAULT_Y,
			watermarkScaleX = V.wmFrame and V.wmFrame.Position.X.Scale or 1,
			watermarkScaleY = V.wmFrame and V.wmFrame.Position.Y.Scale or 0,
			watermarkWidth = V.wmWidth,
			watermarkHeight = V.wmHeight,
			watermarkAutoSize = V.wmAutoSize == true,
			minimizeBubbleX = V.minimizeBubble and V.minimizeBubble.Position.X.Offset or 18,
			minimizeBubbleY = V.minimizeBubble and V.minimizeBubble.Position.Y.Offset or 78,
			responsiveScale = _responsiveScaleEnabled == true,
			resizeSnap = (not _lockWindowPosition) and _resizeSnapEnabled == true,
			resizeSnapMode = _resizeSnapMode,
			dragBounds = options.dragBounds == true,
			windowX = MainWrap and MainWrap.Position.X.Offset or 0,
			windowY = MainWrap and MainWrap.Position.Y.Offset or 0,
			windowScaleX = MainWrap and MainWrap.Position.X.Scale or 0,
			windowScaleY = MainWrap and MainWrap.Position.Y.Scale or 0,
			windowNormX = (MainWrap and workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize.X > 0) and (MainWrap.AbsolutePosition.X / workspace.CurrentCamera.ViewportSize.X) or 0.5,
			windowNormY = (MainWrap and workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize.Y > 0) and (MainWrap.AbsolutePosition.Y / workspace.CurrentCamera.ViewportSize.Y) or 0.5,
		}
		for id, control in pairs(GUI._configControls or {}) do
			if control and type(control.Get) == "function" then
				local ok, value = pcall(function() return control:Get() end)
				if ok then payload[_cfgKey(id)] = _cfgEncodeValue(value) end
			end
		end
		return GUI:_encodeConfig(payload)
	end

	GUI._configDirty = false
	function GUI:MarkConfigDirty()
		GUI._configDirty = true
		return true
	end
	function GUI:IsConfigDirty()
		return GUI._configDirty == true
	end
	function GUI:ClearConfigDirty()
		GUI._configDirty = false
		return true
	end

	function GUI:ResetConfig(profileName, applyNow)
		if profileName then _setConfigProfileInternal(profileName) end
		local data = {
			profile = _cfgEsc(V._cfgProfile),
			theme = options.theme or "Dark",
			accent = GUI:_c3ToHex(options.accent or Color3.fromRGB(100,150,255)),
			scale = 100,
			winW = math.floor(_defaultWinW or 820),
			winH = math.floor(_defaultWinH or 580),
			toggleKey = (options.toggleKey or Enum.KeyCode.Insert).Name,
			watermarkStatsVisible = options.watermarkStats ~= false,
			watermarkRuntimeVisible = options.watermarkRuntime ~= false,
			watermarkRuntimeLabel = _cfgEsc(options.watermarkRuntimeLabel or "RAN"),
			watermarkWidth = math.clamp(tonumber(options.watermarkWidth or options.topRightBarWidth or options.statusBarWidth) or textWidth(tostring(options.watermark or options.name or "VenturaUI"), 13, Enum.Font.RobotoMono) + 38, V.wmMinWidth, V.wmMaxWidth),
			watermarkHeight = math.clamp(tonumber(options.watermarkHeight or options.topRightBarHeight or options.statusBarHeight) or 30, V.wmMinHeight, V.wmMaxHeight),
			watermarkAutoSize = (options.watermarkAutoSize ~= false),
			watermarkX = V.WM_DEFAULT_X,
			watermarkY = V.WM_DEFAULT_Y,
			watermarkScaleX = 1,
			watermarkScaleY = 0,
			responsiveScale = true,
			resizeSnap = false,
			resizeSnapMode = "center",
			dragBounds = false,
		}
		for id, control in pairs(GUI._configControls or {}) do
			local defaultValue = control and control._configDefaultValue
			if defaultValue ~= nil then data[_cfgKey(id)] = _cfgEncodeValue(defaultValue) end
		end
		if applyNow ~= false then
			GUI:ApplyConfig(data)
		end
		GUI._loadedConfigData = data
		GUI:MarkConfigDirty()
		return data
	end

	function GUI:SaveConfig(force, profileName)
		if GUI._configApplying then return true end
		if type(force) == "string" and profileName == nil then profileName = force; force = true end
		if profileName then _setConfigProfileInternal(profileName) end
		if not hasFileAPI() then
			warn("[VenturaUI] SaveConfig skipped: executor does not support writefile/readfile/isfile/isfolder/makefolder.")
			return false
		end
		if GUI._saveQueued and not force then return true end
		GUI._saveQueued = true
		local function writeNow()
			GUI._saveQueued = false
			if _destroyed then return false end
			local ok, err = pcall(function()
				_ensureConfigFolders()
				_addProfileToIndex(V._cfgProfile)
				writefile(V._cfgFile, GUI:_configPayload())
				_writeAutoLoadProfile(V._cfgProfile)
			end)
			if not ok then warn("[VenturaUI] SaveConfig failed: " .. tostring(err)) else GUI._configDirty = false end
			return ok
		end
		if force then return writeNow() end
		task.delay(0.15, writeNow)
		return true
	end

	function GUI:LoadConfig(profileName)
		if profileName then _setConfigProfileInternal(profileName) end
		if _isProfileDeleted(V._cfgProfile) then return nil end
		if not hasFileAPI() then return nil end
		local targetFile = V._cfgFile
		local okExists, exists = pcall(isfile, targetFile)
		-- Backwards compatibility: older Ventura versions used VenturaUI/<WindowName>.json with no profile folder.
		if (not okExists or not exists) and V._cfgProfile == "Default" then
			local legacyFile = V._cfgFolder .. "/" .. V._cfgBaseName .. ".json"
			local okLegacy, legacyExists = pcall(isfile, legacyFile)
			if okLegacy and legacyExists then targetFile = legacyFile; exists = true; okExists = true end
		end
		if not okExists or not exists then return nil end
		local ok, raw = pcall(readfile, targetFile)
		if not ok or not raw or raw == "" then return nil end
		local ok2, data = pcall(function() return GUI:_decodeConfig(raw) end)
		if not ok2 or not data or not next(data) then return nil end
		return data
	end

	function GUI:GetConfigProfile()
		return V._cfgProfile
	end

	function GUI:GetConfigPath()
		return V._cfgFile
	end

	function GUI:GetConfigProfiles()
		return _readProfileIndex()
